{% extends "layouts/base.njk" %}

{% block content %}
<div class="max-w-6xl mx-auto p-4 md:p-6 w-full font-mono">

  <!-- Top Breadcrumb / Return Bar -->
  <div class="flex items-center justify-between mb-4 flex-wrap gap-2 text-xs">
    <div class="flex items-center gap-2 text-muted">
      <a href="/directory" class="text-mac hover:underline font-bold" onclick="if(window.retroAudio) retroAudio.playClick();">:&gt; CYBERSPACE_DIRECTORY</a>
      <span>/</span>
      <span class="text-prompt font-bold">@{{ profileUser.handle }}</span>
      <span class="text-mac font-bold font-mono">[@{{ profileUser.uin }}]</span>
    </div>
    <div class="flex items-center gap-2">
      <a href="/directory" class="pixel-btn pixel-btn--sm text-xs py-0.5 px-2.5" onclick="if(window.retroAudio) retroAudio.playClick();">
        <span>[ Directory ]</span>
      </a>
      <a href="/" class="pixel-btn pixel-btn--sm text-xs py-0.5 px-2.5" onclick="if(window.retroAudio) retroAudio.playClick();">
        <span>[ &lt; Workstation ]</span>
      </a>
    </div>
  </div>

  <!-- Main Profile Grid: Identity Card (Left) + Transmissions Stream (Right) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

    <!-- LEFT COLUMN: Station Identity (4 cols) -->
    <div class="lg:col-span-4 flex flex-col gap-4">

      <!-- Profile Identity Window Box -->
      <div class="retro-card p-0 m-0">
        <div class="window-header flex items-center justify-between p-2">
          <div class="flex items-center gap-2">
            <span class="font-bold text-xs truncate">[:&gt; STATION_ID.SYS]</span>
          </div>
          {% if profileUser.isAway %}
            <span class="text-xs text-amber font-bold">[AWAY]</span>
          {% else %}
            <span class="text-xs text-prompt font-bold">[ONLINE]</span>
          {% endif %}
        </div>

        <div class="p-4 flex flex-col items-center text-center gap-3">
          <!-- Avatar Frame -->
          <div>
            <img
              src="{{ profileUser.avatarPath }}"
              alt="@{{ profileUser.handle }} Avatar"
              class="w-32 h-32 pixel-box border-4 border-black object-cover bg-black"
              onerror="this.onerror=null;this.src='/icons/default-avatar.svg';"
            />
          </div>

          <!-- Handle & Callsign -->
          <div class="flex flex-col items-center gap-1 mt-1">
            <h1 class="text-lg md:text-xl font-bold text-mac tracking-wide m-0">
              @{{ profileUser.handle }}
            </h1>
            <div class="flex items-center gap-2 flex-wrap justify-center">
              <span class="pixel-badge pixel-badge--cyan text-xs font-bold py-0.5 px-2 font-mono">
                Node #{{ profileUser.uin }}
              </span>
            </div>
          </div>

          <!-- Bio / Status Message -->
          <div class="w-full text-left bg-black border border-main p-2.5 text-xs text-prompt space-y-1">
            <div class="text-[10px] text-muted uppercase font-bold tracking-wider">
              CYBER_BROADCAST_STATUS:
            </div>
            <p class="whitespace-pre-wrap leading-relaxed">
              "{{ profileUser.statusMessage }}"
            </p>
          </div>

          <!-- Station Telemetry Stats -->
          <div class="w-full grid grid-cols-3 gap-2 border-t border-b border-main py-2 text-xs">
            <div class="flex flex-col">
              <span class="text-muted text-[10px]">PHOTOS</span>
              <span class="font-bold text-mac text-sm">{{ posts.length }}</span>
            </div>
            <div class="flex flex-col">
              <span class="text-muted text-[10px]">LIKES</span>
              <span class="font-bold text-crimson text-sm">{{ profileUser.totalLikes }}</span>
            </div>
            <div class="flex flex-col">
              <span class="text-muted text-[10px]">VISITS</span>
              <span class="font-bold text-prompt text-sm">{{ profileUser.hits }}</span>
            </div>
          </div>

          <!-- Action Buttons / Links -->
          <div class="w-full flex flex-col gap-2 pt-2">
            <!-- Friend / Follow Action -->
            {% if currentUser and not isSelf %}
              <button
                type="button"
                id="profileFriendBtn"
                onclick="toggleProfileFriend('{{ profileUser.handle }}')"
                class="pixel-btn {% if isFriend %}pixel-btn--yellow{% else %}pixel-btn--green{% endif %} text-xs font-bold py-2 w-full flex items-center justify-center gap-1.5"
              >
                <span id="profileFriendBtnIcon">{% if isFriend %}✓{% else %}+{% endif %}</span>
                <span id="profileFriendBtnText">{% if isFriend %}Friends (Click to Unfriend){% else %}Add Friend{% endif %}</span>
              </button>
            {% elif isSelf %}
              <div class="pixel-badge pixel-badge--cyan text-xxs font-bold py-1 px-2 text-center w-full">
                THIS IS YOUR STATION
              </div>
              <a
                href="/#settings"
                class="pixel-btn pixel-btn--sm text-xs font-bold py-2 w-full flex items-center justify-center gap-1.5"
                onclick="if(window.retroAudio) retroAudio.playClick();"
              >
                <span>⚙ Edit Station Settings</span>
              </a>
            {% else %}
              <a
                href="/login"
                class="pixel-btn pixel-btn--green text-xs font-bold py-2 w-full flex items-center justify-center gap-1.5"
                onclick="if(window.retroAudio) retroAudio.playClick();"
              >
                <span>+ Log In to Add Friend</span>
              </a>
            {% endif %}

            {% if profileUser.cleanRootSiteUrl %}
              <a
                href="{{ profileUser.cleanRootSiteUrl }}"
                target="_blank"
                rel="noopener noreferrer"
                class="pixel-btn pixel-btn--yellow text-xs font-bold py-2 w-full flex items-center justify-center gap-1"
                onclick="if(window.retroAudio) retroAudio.playClick();"
              >
                <span>Visit Personal Website ↗</span>
              </a>
            {% endif %}

            {% if profileUser.galleryUrl %}
              <a
                href="{{ profileUser.galleryUrl }}"
                target="_blank"
                rel="noopener noreferrer"
                class="pixel-btn pixel-btn--green text-xs font-bold py-2 w-full flex items-center justify-center gap-1"
                onclick="if(window.retroAudio) retroAudio.playClick();"
              >
                <span>View Neogram Photo Gallery ↗</span>
              </a>
            {% endif %}
          </div>

          <!-- Station Metadata Footer -->
          <div class="text-[11px] text-muted pt-2 border-t border-main w-full text-left space-y-1">
            <div><strong>Commissioned:</strong> {{ profileUser.createdAt | formatDate }}</div>
            {% if profileUser.lastDeployedAt %}
              <div><strong>Last Deployed:</strong> {{ profileUser.lastDeployedAt | formatDate }}</div>
            {% endif %}
          </div>
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: Transmissions & Photographs Stream (8 cols) -->
    <div class="lg:col-span-8 flex flex-col gap-4">

      <!-- Gallery Archive Window Frame -->
      <div class="retro-card p-0 m-0">
        <div class="window-header flex items-center justify-between p-2">
          <div class="flex items-center gap-2">
            <span class="font-bold text-xs">
              [:&gt; TRANSMISSIONS_ARCHIVE.EXE - Broadcasted Photographs ({{ posts.length }})]
            </span>
          </div>
          {% if profileUser.galleryUrl %}
            <a
              href="{{ profileUser.galleryUrl }}"
              target="_blank"
              rel="noopener noreferrer"
              class="pixel-btn pixel-btn--sm pixel-btn--yellow text-xs py-0.5 px-2"
              onclick="if(window.retroAudio) retroAudio.playClick();"
            >
              <span>Static Gallery ↗</span>
            </a>
          {% endif %}
        </div>

        <div class="p-4">
          {% if sites and sites.length > 1 %}
            <div class="flex items-center gap-1.5 mb-3 flex-wrap text-xs font-mono bg-black p-2 border border-main">
              <span class="text-muted text-xxs uppercase font-bold">FILTER TRANSMISSIONS:</span>
              <button
                type="button"
                id="userFilterAllBtn"
                class="pixel-btn pixel-btn--sm pixel-btn--yellow font-bold text-3xs py-0.5 px-2"
                onclick="filterUserPosts('all')"
              >
                ALL SITES ({{ posts.length }})
              </button>
              {% for s in sites %}
                <button
                  type="button"
                  id="userFilterBtn-{{ s.id }}"
                  class="pixel-btn pixel-btn--sm text-3xs py-0.5 px-2"
                  onclick="filterUserPosts('{{ s.id }}')"
                >
                  {{ s.name }}
                </button>
              {% endfor %}
            </div>
          {% endif %}

          {% if not posts or posts.length == 0 %}
            <!-- Empty State -->
            <div class="p-8 border-2 border-dashed border-main text-center bg-black text-prompt space-y-2">
              <div class="font-bold text-sm">NO PHOTOGRAPHS DETECTED IN STORAGE LEDGER</div>
              <p class="text-xs text-muted max-w-md mx-auto">
                Station @{{ profileUser.handle }} has not broadcasted any public photographs yet. Check back once their transmitter goes live!
              </p>
            </div>
          {% else %}
            <!-- Transmissions Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="userPostsGrid">
              {% for post in posts %}
                <div class="retro-card p-2 flex flex-col gap-2 bg-window border border-main" data-user-post data-site-id="{{ post.siteId or '' }}" data-post-id="{{ post.id }}">
                  
                  <!-- Thumbnail Viewport with Filter Tag & Retro 404 Fallback -->
                  <div
                    class="relative bg-black border border-main overflow-hidden group retro-photo-viewport cursor-pointer"
                    role="button"
                    tabindex="0"
                    onclick="openPhotoModal('{{ post.id }}')"
                    onkeydown="if(event.key==='Enter'||event.key===' ') { event.preventDefault(); openPhotoModal('{{ post.id }}'); }"
                    title="Click to view full photo transmission"
                  >
                    <img
                      src="{{ post.thumbnailPath or post.imagePath }}"
                      alt="{{ post.caption or 'Photo' }}"
                      loading="lazy"
                      class="w-full h-48 object-cover relative z-10 transition-transform group-hover:scale-105 pointer-events-none"
                      onerror="this.classList.add('neogram-img--broken'); var vp=this.closest('.retro-photo-viewport'); if(vp) vp.classList.add('has-broken-image');"
                    />

                    {% if post.filterApplied and post.filterApplied != 'none' %}
                      <div class="absolute top-1.5 left-1.5 z-10">
                        <span class="pixel-badge pixel-badge--green text-[10px] py-0.5 px-1.5 font-bold uppercase tracking-wider">
                          {{ post.filterApplied }}
                        </span>
                      </div>
                    {% endif %}

                    {% if post.photos and post.photos.length > 1 %}
                      <div class="absolute bottom-1.5 right-1.5 z-10">
                        <span class="pixel-badge pixel-badge--cyan text-[10px] py-0 px-1 font-bold">
                          ⧉ {{ post.photos.length }}
                        </span>
                      </div>
                    {% endif %}
                  </div>

                  <!-- Caption & Metadata -->
                  <div class="flex flex-col gap-1 flex-1">
                    {% if post.siteName %}
                      <div>
                        <span class="pixel-badge pixel-badge--yellow font-bold text-3xs">
                          {{ post.siteName }}
                        </span>
                      </div>
                    {% endif %}
                    <p class="text-xs font-mono line-clamp-2 leading-relaxed m-0 text-main">
                      {{ post.caption }}
                    </p>

                    <div class="flex items-center justify-between text-[11px] text-muted pt-2 mt-auto border-t border-main">
                      <span id="cardLikes-{{ post.id }}">{{ post.likes or 0 }} likes</span>
                      <span>{{ post.createdAt | formatDateTime }}</span>
                    </div>

                    <button
                      type="button"
                      class="pixel-btn pixel-btn--yellow text-xs font-bold py-1.5 px-2 text-center mt-1 w-full flex items-center justify-center gap-1"
                      onclick="openPhotoModal('{{ post.id }}')"
                    >
                      <span>View &amp; Comment :&gt;</span>
                    </button>
                  </div>

                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

    </div>

  </div>

</div>

<!-- Retro Photo Transmission Viewer Modal -->
<div id="photoModalBackdrop" class="fixed inset-0 bg-black/80 z-[10000] flex items-center justify-center p-2 sm:p-4 hidden" onclick="if(event.target === this) closePhotoModal();">
  <div class="retro-card p-0 m-0 w-full max-w-4xl max-h-[92vh] flex flex-col shadow-2xl bg-window border-2 border-main overflow-hidden">
    <!-- Window Header -->
    <div class="window-header flex items-center justify-between p-2 shrink-0">
      <div class="flex items-center gap-2 truncate">
        <span class="font-bold text-xs truncate" id="photoModalTitle">[:&gt; PHOTO_VIEWER.EXE]</span>
      </div>
      <button type="button" class="pixel-btn pixel-btn--sm pixel-btn--crimson text-xs py-0 px-2 font-bold" onclick="closePhotoModal()" title="Close Viewer [Esc]">
        ✕
      </button>
    </div>

    <!-- Modal Content: Scrollable Body -->
    <div class="p-3 sm:p-4 overflow-y-auto flex-1 font-mono text-xs">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-start">
        
        <!-- Media Column (7 cols) -->
        <div class="md:col-span-7 flex flex-col gap-2">
          <div class="relative bg-black border-2 border-main overflow-hidden flex items-center justify-center crt-scanlines min-h-[260px] max-h-[60vh]">
            <img id="photoModalImage" src="" alt="Photo" class="w-full h-auto max-h-[58vh] object-contain transition-all" />
            
            <!-- Multi-photo Nav Buttons -->
            <div id="photoModalCarouselControls" class="absolute inset-x-2 top-1/2 -translate-y-1/2 flex items-center justify-between pointer-events-none hidden">
              <button type="button" id="photoModalPrevBtn" onclick="navigatePhotoSlide(-1)" class="pixel-btn pixel-btn--sm pointer-events-auto py-1 px-2 font-bold bg-black/80 text-prompt border border-prompt">
                ◀ PREV
              </button>
              <button type="button" id="photoModalNextBtn" onclick="navigatePhotoSlide(1)" class="pixel-btn pixel-btn--sm pointer-events-auto py-1 px-2 font-bold bg-black/80 text-prompt border border-prompt">
                NEXT ▶
              </button>
            </div>
            
            <!-- Slide indicator -->
            <div id="photoModalSlideCounter" class="absolute bottom-2 right-2 pixel-badge pixel-badge--cyan text-xxs font-bold hidden">
              1 / 1
            </div>
          </div>

          <!-- Tags & Shader row -->
          <div class="flex items-center gap-1.5 flex-wrap pt-1" id="photoModalTags">
            <span id="photoModalShaderBadge" class="pixel-badge pixel-badge--green text-xxs uppercase font-bold">SHADER: RAW</span>
            <span id="photoModalMoodBadge" class="pixel-badge pixel-badge--cyan text-xxs font-bold hidden"></span>
            <span id="photoModalWebringBadge" class="pixel-badge pixel-badge--magenta text-xxs font-bold hidden"></span>
            <span id="photoModalLocationBadge" class="pixel-badge pixel-badge--yellow text-xxs font-bold hidden"></span>
          </div>
        </div>

        <!-- Meta & Comments Column (5 cols) -->
        <div class="md:col-span-5 flex flex-col gap-3">
          <!-- Author Info -->
          <div class="flex items-center justify-between border-b border-main pb-2">
            <div class="flex items-center gap-2">
              <img id="photoModalAvatar" src="{{ profileUser.avatarPath }}" alt="Avatar" class="w-8 h-8 pixel-box border border-black object-cover bg-black" onerror="this.onerror=null;this.src='/icons/default-avatar.svg';" />
              <div>
                <span id="photoModalAuthor" class="font-bold text-mac block text-xs">@{{ profileUser.handle }}</span>
                <span id="photoModalDate" class="text-muted text-xxs block">Date</span>
              </div>
            </div>
            <span id="photoModalSiteBadge" class="pixel-badge pixel-badge--yellow text-3xs font-bold hidden"></span>
          </div>

          <!-- Caption -->
          <div class="bg-black border border-main p-2.5 text-xs text-prompt leading-relaxed whitespace-pre-wrap max-h-32 overflow-y-auto" id="photoModalCaption">
          </div>

          <!-- Like Action Strip -->
          <div class="flex items-center justify-between p-2 bg-window border border-main">
            <button type="button" id="photoModalLikeBtn" onclick="handlePhotoLike()" class="pixel-btn pixel-btn--yellow text-xs font-bold py-1.5 px-3 flex items-center gap-1.5">
              <span>⚡ RADICAL</span>
              <span id="photoModalLikeCount">(0)</span>
            </button>
            <a id="photoModalStaticLink" href="#" target="_blank" rel="noopener noreferrer" class="pixel-btn pixel-btn--sm pixel-btn--green text-xxs font-bold py-1 px-2 hidden" onclick="if(window.retroAudio) retroAudio.playClick();">
              <span>Static Host ↗</span>
            </a>
          </div>

          <!-- Comments Ledger -->
          <div class="flex flex-col gap-2 pt-1 border-t border-main">
            <div class="flex items-center justify-between text-xxs uppercase text-muted font-bold">
              <span>TRANSMISSION_LEDGER:</span>
              <span id="photoModalCommentCount">0 comments</span>
            </div>

            <!-- Comments List -->
            <div id="photoModalCommentsList" class="flex flex-col gap-2 max-h-44 overflow-y-auto pr-1">
              <div class="text-muted text-center py-4 border border-dashed border-main text-xxs">
                NO COMMENTS LOGGED YET
              </div>
            </div>

            <!-- Comment Form -->
            <div id="photoModalCommentFormBox" class="pt-2 border-t border-main">
              {% if currentUser %}
                <form id="photoModalCommentForm" onsubmit="handlePhotoCommentSubmit(event)" class="flex flex-col gap-1.5">
                  <textarea id="photoModalCommentInput" rows="2" placeholder="Leave a cyberspace transmission..." required class="retro-input text-xs w-full p-1.5 resize-none font-mono"></textarea>
                  <div class="flex items-center justify-between">
                    <span id="photoModalCommentStatus" class="text-xxs text-muted"></span>
                    <button type="submit" id="photoModalCommentSubmitBtn" class="pixel-btn pixel-btn--green pixel-btn--sm text-xs font-bold py-1 px-3">
                      <span>Transmit :&gt;</span>
                    </button>
                  </div>
                </form>
              {% else %}
                <div class="text-center p-2 bg-black border border-main">
                  <p class="text-xxs text-muted mb-1.5">Connect Cyber-Pass to leave a transmission:</p>
                  <a href="/login" class="pixel-btn pixel-btn--green pixel-btn--sm text-xs font-bold py-1 px-3 inline-block" onclick="if(window.retroAudio) retroAudio.playClick();">
                    <span>+ Log In to Comment</span>
                  </a>
                </div>
              {% endif %}
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</div>

<script id="userPostsData" type="application/json">
  {{ posts | dump | safe }}
</script>

<script>
  var isFriendProfile = {{ 'true' if isFriend else 'false' }};
  var rawUserPosts = [];
  try {
    var rawText = document.getElementById('userPostsData').textContent;
    rawUserPosts = JSON.parse(rawText || '[]');
  } catch (e) {
    rawUserPosts = [];
  }

  var userPostsMap = {};
  rawUserPosts.forEach(function(p) {
    userPostsMap[p.id] = p;
  });

  var currentActivePost = null;
  var currentSlideIndex = 0;

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatIsoDateTime(iso) {
    if (!iso) return '';
    try {
      var d = new Date(iso);
      return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    } catch (e) {
      return iso;
    }
  }

  function openPhotoModal(postId) {
    var post = userPostsMap[postId];
    if (!post) return;
    currentActivePost = post;
    currentSlideIndex = 0;

    if (window.retroAudio) window.retroAudio.playClick();

    // Set title
    var titleEl = document.getElementById('photoModalTitle');
    if (titleEl) {
      titleEl.textContent = '[:> PHOTO_VIEWER.EXE - ' + (post.id.slice(0, 8)) + '.bitmap]';
    }

    // Set Author & Date
    var authorEl = document.getElementById('photoModalAuthor');
    if (authorEl) authorEl.textContent = '@' + (post.author || '{{ profileUser.handle }}');

    var dateEl = document.getElementById('photoModalDate');
    if (dateEl) dateEl.textContent = formatIsoDateTime(post.createdAt);

    // Site Badge
    var siteBadge = document.getElementById('photoModalSiteBadge');
    if (siteBadge) {
      if (post.siteName) {
        siteBadge.textContent = post.siteName;
        siteBadge.classList.remove('hidden');
      } else {
        siteBadge.classList.add('hidden');
      }
    }

    // Caption
    var captionEl = document.getElementById('photoModalCaption');
    if (captionEl) captionEl.textContent = post.caption || 'No caption provided.';

    // Tags & Badges
    var shaderBadge = document.getElementById('photoModalShaderBadge');
    if (shaderBadge) shaderBadge.textContent = 'SHADER: ' + (post.filterApplied ? post.filterApplied.toUpperCase() : 'RAW');

    var moodBadge = document.getElementById('photoModalMoodBadge');
    if (moodBadge) {
      if (post.mood) {
        moodBadge.textContent = post.mood;
        moodBadge.classList.remove('hidden');
      } else {
        moodBadge.classList.add('hidden');
      }
    }

    var webringBadge = document.getElementById('photoModalWebringBadge');
    if (webringBadge) {
      if (post.webring) {
        webringBadge.textContent = 'ring: ' + post.webring;
        webringBadge.classList.remove('hidden');
      } else {
        webringBadge.classList.add('hidden');
      }
    }

    var locationBadge = document.getElementById('photoModalLocationBadge');
    if (locationBadge) {
      if (post.location) {
        locationBadge.textContent = 'loc: ' + post.location;
        locationBadge.classList.remove('hidden');
      } else {
        locationBadge.classList.add('hidden');
      }
    }

    // Like count
    updateModalLikeDisplay(post.likes || 0);

    // Static Host link
    var staticLink = document.getElementById('photoModalStaticLink');
    if (staticLink) {
      var staticUrl = post.livePhotoUrl || (post.galleryUrl ? (post.galleryUrl + 'photos/' + post.id + '/') : '');
      if (staticUrl) {
        staticLink.href = staticUrl;
        staticLink.classList.remove('hidden');
      } else {
        staticLink.classList.add('hidden');
      }
    }

    // Update Image & Carousel
    updateModalImageSlide();

    // Load comments
    loadModalComments(post.id);

    // Show backdrop & update hash
    var backdrop = document.getElementById('photoModalBackdrop');
    if (backdrop) backdrop.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    try {
      history.replaceState(null, '', '#photo-' + post.id);
    } catch (e) {}
  }
  window.openPhotoModal = openPhotoModal;

  function closePhotoModal() {
    if (window.retroAudio) window.retroAudio.playClick();
    var backdrop = document.getElementById('photoModalBackdrop');
    if (backdrop) backdrop.classList.add('hidden');
    document.body.style.overflow = '';
    currentActivePost = null;

    try {
      history.replaceState(null, '', window.location.pathname + window.location.search);
    } catch (e) {}
  }
  window.closePhotoModal = closePhotoModal;

  function updateModalImageSlide() {
    if (!currentActivePost) return;
    var post = currentActivePost;
    var imgEl = document.getElementById('photoModalImage');
    var carouselControls = document.getElementById('photoModalCarouselControls');
    var counterEl = document.getElementById('photoModalSlideCounter');

    var photos = (post.photos && post.photos.length > 0) ? post.photos : [{ imagePath: post.imagePath || post.imageUrl }];
    if (currentSlideIndex < 0) currentSlideIndex = photos.length - 1;
    if (currentSlideIndex >= photos.length) currentSlideIndex = 0;

    var currentPic = photos[currentSlideIndex];
    if (imgEl && currentPic) {
      imgEl.src = currentPic.imagePath || currentPic.imageUrl || post.imagePath;
      imgEl.className = 'w-full h-auto max-h-[58vh] object-contain transition-all filter-' + (post.filterApplied || 'none');
    }

    if (photos.length > 1) {
      if (carouselControls) carouselControls.classList.remove('hidden');
      if (counterEl) {
        counterEl.textContent = (currentSlideIndex + 1) + ' / ' + photos.length;
        counterEl.classList.remove('hidden');
      }
    } else {
      if (carouselControls) carouselControls.classList.add('hidden');
      if (counterEl) counterEl.classList.add('hidden');
    }
  }

  function navigatePhotoSlide(dir) {
    if (window.retroAudio) window.retroAudio.playClick();
    currentSlideIndex += dir;
    updateModalImageSlide();
  }
  window.navigatePhotoSlide = navigatePhotoSlide;

  function updateModalLikeDisplay(likes) {
    var likeCountEl = document.getElementById('photoModalLikeCount');
    if (likeCountEl) likeCountEl.textContent = '(' + likes + ')';
    if (currentActivePost) {
      var cardLikeEl = document.getElementById('cardLikes-' + currentActivePost.id);
      if (cardLikeEl) cardLikeEl.textContent = likes + ' likes';
    }
  }

  async function handlePhotoLike() {
    if (!currentActivePost) return;
    if (window.retroAudio) window.retroAudio.playClick();
    try {
      var res = await fetch('/api/posts/' + encodeURIComponent(currentActivePost.id) + '/like', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      var data = await res.json();
      if (data.ok) {
        if (window.retroAudio) window.retroAudio.playSuccess();
        currentActivePost.likes = data.likes;
        updateModalLikeDisplay(data.likes);
      } else {
        alert('[:> REACTION ERROR] ' + (data.error || 'Could not record radical like'));
      }
    } catch (e) {
      alert('[:> NETWORK FAULT] ' + e.message);
    }
  }
  window.handlePhotoLike = handlePhotoLike;

  async function loadModalComments(postId) {
    var listEl = document.getElementById('photoModalCommentsList');
    var countEl = document.getElementById('photoModalCommentCount');
    if (listEl) {
      listEl.innerHTML = '<div class="text-muted text-center py-4 text-xxs">LOADING TRANSMISSIONS...</div>';
    }

    try {
      var res = await fetch('/api/posts/' + encodeURIComponent(postId) + '/comments');
      var data = await res.json();
      var comments = (data.ok && Array.isArray(data.comments)) ? data.comments : [];

      if (countEl) countEl.textContent = comments.length + ' comments';

      if (!listEl) return;
      if (comments.length === 0) {
        listEl.innerHTML = '<div class="text-muted text-center py-4 border border-dashed border-main text-xxs">NO COMMENTS LOGGED YET</div>';
        return;
      }

      listEl.innerHTML = comments.map(function(c) {
        var authorStr = escapeHtml(c.author || 'visitor');
        var timeStr = formatIsoDateTime(c.createdAt || c.timestamp);
        var textStr = escapeHtml(c.text || c.body || '');
        return '<div class="p-1.5 bg-black border border-main text-xxs space-y-0.5">' +
          '<div class="flex items-center justify-between text-muted text-3xs">' +
            '<span class="font-bold text-mac">@' + authorStr + '</span>' +
            '<span>' + timeStr + '</span>' +
          '</div>' +
          '<p class="text-prompt m-0 leading-relaxed whitespace-pre-wrap">' + textStr + '</p>' +
        '</div>';
      }).join('');
    } catch (e) {
      if (listEl) {
        listEl.innerHTML = '<div class="text-amber text-center py-2 text-xxs">[:> COULD NOT FETCH COMMENTS]</div>';
      }
    }
  }

  async function handlePhotoCommentSubmit(e) {
    e.preventDefault();
    if (!currentActivePost) return;
    var input = document.getElementById('photoModalCommentInput');
    var statusEl = document.getElementById('photoModalCommentStatus');
    var btn = document.getElementById('photoModalCommentSubmitBtn');
    if (!input || !input.value.trim()) return;

    var text = input.value.trim();
    if (window.retroAudio) window.retroAudio.playClick();
    if (statusEl) statusEl.textContent = 'Transmitting...';
    if (btn) btn.disabled = true;

    try {
      var res = await fetch('/api/posts/' + encodeURIComponent(currentActivePost.id) + '/comments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: text })
      });
      var data = await res.json();
      if (data.ok) {
        if (window.retroAudio) window.retroAudio.playSuccess();
        input.value = '';
        if (statusEl) statusEl.textContent = 'Transmission received!';
        setTimeout(function() { if (statusEl) statusEl.textContent = ''; }, 2500);
        loadModalComments(currentActivePost.id);
      } else {
        if (statusEl) statusEl.textContent = '';
        alert('[:> TRANSMISSION ERROR] ' + (data.error || 'Could not post comment'));
      }
    } catch (err) {
      if (statusEl) statusEl.textContent = '';
      alert('[:> NETWORK FAULT] ' + err.message);
    } finally {
      if (btn) btn.disabled = false;
    }
  }
  window.handlePhotoCommentSubmit = handlePhotoCommentSubmit;

  // Keyboard navigation & hash support
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && currentActivePost) {
      closePhotoModal();
    } else if (currentActivePost) {
      if (e.key === 'ArrowLeft') navigatePhotoSlide(-1);
      else if (e.key === 'ArrowRight') navigatePhotoSlide(1);
    }
  });

  window.addEventListener('DOMContentLoaded', function() {
    if (window.location.hash && window.location.hash.startsWith('#photo-')) {
      var targetId = window.location.hash.replace('#photo-', '');
      if (userPostsMap[targetId]) {
        openPhotoModal(targetId);
      }
    }
  });

  function filterUserPosts(siteId) {
    if (window.retroAudio) window.retroAudio.playClick();
    var allBtn = document.getElementById('userFilterAllBtn');
    if (allBtn) {
      if (siteId === 'all') allBtn.classList.add('pixel-btn--yellow');
      else allBtn.classList.remove('pixel-btn--yellow');
    }
    document.querySelectorAll('[id^="userFilterBtn-"]').forEach(function(btn) {
      if (btn.id === 'userFilterBtn-' + siteId) btn.classList.add('pixel-btn--yellow');
      else btn.classList.remove('pixel-btn--yellow');
    });

    var cards = document.querySelectorAll('#userPostsGrid [data-site-id]');
    cards.forEach(function(card) {
      var itemSiteId = card.getAttribute('data-site-id');
      if (siteId === 'all' || itemSiteId === siteId) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }
  window.filterUserPosts = filterUserPosts;

  async function toggleProfileFriend(handle) {
    if (window.retroAudio) window.retroAudio.playClick();
    var btn = document.getElementById('profileFriendBtn');
    var icon = document.getElementById('profileFriendBtnIcon');
    var text = document.getElementById('profileFriendBtnText');

    var method = isFriendProfile ? 'DELETE' : 'POST';
    try {
      var res = await fetch('/api/users/' + encodeURIComponent(handle) + '/follow', {
        method: method,
        headers: { 'Content-Type': 'application/json' }
      });
      var data = await res.json();
      if (data.ok) {
        if (window.retroAudio) window.retroAudio.playSuccess();
        isFriendProfile = !isFriendProfile;
        if (isFriendProfile) {
          btn.classList.remove('pixel-btn--green');
          btn.classList.add('pixel-btn--yellow');
          if (icon) icon.textContent = '✓';
          if (text) text.textContent = 'Friends (Click to Unfriend)';
        } else {
          btn.classList.remove('pixel-btn--yellow');
          btn.classList.add('pixel-btn--green');
          if (icon) icon.textContent = '+';
          if (text) text.textContent = 'Add Friend';
        }
      } else {
        alert('[:> FRIEND ERROR] ' + (data.error || 'Could not update friend status'));
      }
    } catch (e) {
      alert('[:> NETWORK FAULT] ' + e.message);
    }
  }
</script>
{% endblock %}
