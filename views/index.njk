  async function loadGuestbookEntries() {
    var container = document.getElementById('gbSignaturesList');
    var badge = document.getElementById('gbCountBadge');
    if (!container) return;

    try {
      var res = await fetch('/api/guestbook/' + userHandle);
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to fetch');

      if (badge) badge.textContent = data.entries.length + ' SIGNATURES';

      if (data.entries.length === 0) {
        container.innerHTML = '<div class="text-center py-4 text-xs text-muted">:&gt; No signatures recorded yet. Share your guestbook link!</div>';
        return;
      }

      var html = '';
      data.entries.forEach(function(entry) {
        var site = entry.visitorWebsite ? '<div class="text-xs"><a href="' + entry.visitorWebsite + '" target="_blank" class="text-mac underline">🌐 ' + entry.visitorWebsite + '</a></div>' : '';
        html += '<div class="retro-card p-2 flex flex-col gap-1 text-xs border border-main">' +
          '<div class="flex items-center justify-between border-b border-main pb-1">' +
            '<div class="flex items-center gap-1.5">' +
              '<span>' + (entry.moodIcon || '😎') + '</span>' +
              '<span class="font-bold">' + entry.visitorName + '</span>' +
              '<span class="text-muted text-xs">(' + (entry.visitorLocation || 'Cyberspace') + ')</span>' +
            '</div>' +
            '<button type="button" onclick="deleteGuestbookEntry(\'' + entry.id + '\')" class="text-crimson font-bold text-xs hover:underline" title="Delete signature">[Delete]</button>' +
          '</div>' + site +
          '<div class="whitespace-pre-wrap p-1 text-xs font-mono bg-window">"' + entry.message + '"</div>' +
        '</div>';
      });

      container.innerHTML = html;
    } catch (e) {
      container.innerHTML = '<div class="text-center py-4 text-xs text-crimson">Failed to load signatures: ' + e.message + '</div>';
    }
  }

  async function deleteGuestbookEntry(id) {
    if (!confirm('Delete this visitor signature from your ledger?')) return;
    if (window.retroAudio) window.retroAudio.playClick();

    try {
      var res = await fetch('/api/guestbook/' + id, { method: 'DELETE' });
      var data = await res.json();
      if (data.ok) {
        if (window.retroAudio) window.retroAudio.playSuccess();
        loadGuestbookEntries();
      } else {
        alert(data.error || 'Failed to delete');
      }
    } catch (e) {
      alert(e.message);
    }
  }

  async function loadNetworkUsers() {
    var container = document.getElementById('networkUsersList');
    if (!container) return;

    try {
      var res = await fetch('/api/network/users');
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to fetch');

      if (data.users.length === 0) {
        container.innerHTML = '<div class="text-center py-4 text-xs text-muted">No other creators detected on BBS.</div>';
        return;
      }

      var html = '';
      data.users.forEach(function(u) {
        var actionBtn = '';
        if (u.isSelf) {
          actionBtn = '<span class="text-xs text-muted font-bold">[YOU]</span>';
        } else if (u.isFollowing) {
          actionBtn = '<button type="button" onclick="toggleFollowUser(\'' + u.handle + '\', true)" class="pixel-btn pixel-btn--yellow text-xs py-0.5 px-2">✓ Following</button>';
        } else {
          actionBtn = '<button type="button" onclick="toggleFollowUser(\'' + u.handle + '\', false)" class="pixel-btn text-xs py-0.5 px-2">+ Follow</button>';
        }

        var site = u.siteUrl ? '<a href="' + u.siteUrl + '" target="_blank" class="text-mac underline text-xs">🌐 Site</a>' : '';

        html += '<div class="retro-card p-2 flex items-center justify-between gap-2 border border-main text-xs">' +
          '<div class="flex items-center gap-2">' +
            '<span class="text-base">👾</span>' +
            '<div>' +
              '<div class="font-bold text-prompt">@' + u.handle + '</div>' +
              '<div class="text-muted text-xs">' + u.postCount + ' photos • ' + u.followersCount + ' followers ' + (site ? '• ' + site : '') + '</div>' +
            '</div>' +
          '</div>' +
          '<div>' + actionBtn + '</div>' +
        '</div>';
      });

      container.innerHTML = html;
    } catch (e) {
      container.innerHTML = '<div class="text-center py-4 text-xs text-crimson">Failed to load network: ' + e.message + '</div>';
    }
  }

