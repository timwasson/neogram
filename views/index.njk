{% extends "layouts/base.njk" %}

{% block content %}
<div class="max-w-5xl w-full mx-auto px-2 py-3 sm:p-4 flex-1">

  {% if currentUser %}
    <!-- ==============================================================
         AUTHENTICATED CREATOR STUDIO & DIRECT PHOTO PUBLISHING ENGINE
         ============================================================== -->
    <div class="pixel-box mb-6">
      <div class="window-header">
        <div class="flex items-center gap-2">
          <span>[:&gt; NEOGRAM_STUDIO.EXE - Direct Mobile/Static Photo Publisher]</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs text-prompt">CARRIER: ACTIVE</span>
        </div>
      </div>

      <div class="p-5">


        <!-- TAB 0: CYBERSPACE NETWORK (FOLLOWER FEED, FRIENDS ROSTER, STATION DIRECTORY) -->
        <div id="feedStudioSection">
          <div class="workstation-sublayout">

            <!-- LEFT-HAND MENU (Horizontal Strip on Mobile < 820px) -->
            <aside class="workstation-subnav" aria-label="Network navigation">
              <div class="workstation-subnav__header">
                <span>NETWORK HUB</span>
                <span class="text-prompt">3 VIEWS</span>
              </div>
              <div class="workstation-subnav__list">
                <button
                  type="button"
                  id="networkSubBtn-feed"
                  class="workstation-subnav__btn is-active"
                  onclick="switchNetworkSubTab('feed')"
                >
                  <span class="workstation-subnav__btn-label">
                    <svg class="retro-svg-icon retro-svg-icon--sm" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="10"/><path d="M4 6h8M4 9h5"/></svg>
                    <span>Follower Feed</span>
                  </span>
                  <span class="workstation-subnav__btn-arrow">›</span>
                </button>
                <button
                  type="button"
                  id="networkSubBtn-friends"
                  class="workstation-subnav__btn"
                  onclick="switchNetworkSubTab('friends')"
                >
                  <span class="workstation-subnav__btn-label">
                    <svg class="retro-svg-icon retro-svg-icon--sm" viewBox="0 0 16 16" aria-hidden="true"><circle cx="6" cy="5.5" r="2"/><path d="M2 13c0-2 1.8-3.2 4-3.2s4 1.2 4 3.2"/><path d="M12 5v4M10 7h4"/></svg>
                    <span>Friends ({{ friends.length or 0 }})</span>
                  </span>
                  <span class="workstation-subnav__btn-arrow">›</span>
                </button>
                <button
                  type="button"
                  id="networkSubBtn-directory"
                  class="workstation-subnav__btn"
                  onclick="switchNetworkSubTab('directory')"
                >
                  <span class="workstation-subnav__btn-label">
                    <svg class="retro-svg-icon retro-svg-icon--sm" viewBox="0 0 16 16" aria-hidden="true"><circle cx="6" cy="5.5" r="2"/><path d="M2 13c0-2 1.8-3.2 4-3.2s4 1.2 4 3.2"/><circle cx="11.5" cy="6" r="1.5"/><path d="M11.5 9.5c1.5 0 2.5 1 2.5 2.8"/></svg>
                    <span>Directory ({{ totalDirectoryCount or 0 }})</span>
                  </span>
                  <span class="workstation-subnav__btn-arrow">›</span>
                </button>
              </div>
            </aside>

            <!-- RIGHT-HAND CONTENT PANE -->
            <div class="workstation-subpane">

              <!-- ============================================================
                   SUB-PAGE 1: FOLLOWER FEED
                   ============================================================ -->
              <div id="networkSubPane-feed">
                <!-- Welcome & What's Next Onboarding Card (Shown prominently if user has no mounted site) -->
                {% if not userSites or userSites.length == 0 %}
                  <div id="welcomeStationCard" class="pixel-box p-4 mb-5 bg-window border-4 border-cyan">
                    <div class="window-header mb-3 flex items-center justify-between">
                      <div class="flex items-center gap-2">
                        <span class="font-bold text-black font-mono">[:&gt; WELCOME_STATION.EXE - Account Active &amp; Node Online]</span>
                      </div>
                      <span class="text-xs font-mono font-bold text-black bg-cyan px-1.5 py-0.5 border border-black">[PROFILE COMPLETE]</span>
                    </div>

                    <div class="p-3 bg-black border border-main text-xs font-mono mb-3">
                      <div class="flex items-center justify-between flex-wrap gap-2 mb-2 pb-2 border-b border-main">
                        <div class="flex items-center gap-2">
                          <span class="status-led status-led--online"></span>
                          <span class="text-mac font-bold text-sm">Welcome to Cyberspace, @{{ currentUser.handle }}!</span>
                        </div>
                        <span class="pixel-badge pixel-badge--cyan font-bold">NODE UIN: #{{ currentUser.uin or '100101' }}</span>
                      </div>
                      <p class="text-muted leading-relaxed m-0">
                        Your Neogram station profile is fully provisioned and complete! You don't need a static website or Neocities account to participate in the retro cyberspace webring.
                      </p>
                    </div>

                    <!-- Station features available immediately -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-4 text-xs font-mono">
                      <div class="p-2.5 bg-black border border-main flex items-start gap-2">
                        <div>
                          <span class="text-prompt font-bold block mb-0.5">Instant Messaging (NIM)</span>
                          <span class="text-muted leading-relaxed block">
                            Chat in real-time with buddy lists, sound chimes, away statuses, and offline store-and-forward queue.
                          </span>
                          <button type="button" onclick="if(window.AimClient) window.AimClient.open();" class="text-mac hover:underline font-bold mt-1 inline-block">
                            Launch NIM Messenger ↗
                          </button>
                        </div>
                      </div>

                      <div class="p-2.5 bg-black border border-main flex items-start gap-2">
                        <div>
                          <span class="text-prompt font-bold block mb-0.5">1-Click Cyber-Pass</span>
                          <span class="text-muted leading-relaxed block">
                            Sign visitor guestbooks and post comments across any static website powered by Neogram with 1-click authentication.
                          </span>
                        </div>
                      </div>

                      <div class="p-2.5 bg-black border border-main flex items-start gap-2">
                        <div>
                          <span class="text-prompt font-bold block mb-0.5">Cyberspace Directory</span>
                          <span class="text-muted leading-relaxed block">
                            Explore registered stations, check real-time presence indicators, and follow your favorite web creators.
                          </span>
                          <button type="button" onclick="switchNetworkSubTab('directory')" class="text-mac hover:underline font-bold mt-1 inline-block">
                            Open Station Directory ↗
                          </button>
                        </div>
                      </div>

                      <div class="p-2.5 bg-black border border-main flex items-start gap-2">
                        <div>
                          <span class="text-prompt font-bold block mb-0.5">Personal Follower Feed</span>
                          <span class="text-muted leading-relaxed block">
                            Follow stations across cyberspace to watch their photo transmissions and updates stream live in your feed below.
                          </span>
                        </div>
                      </div>
                    </div>

                    <!-- WHAT'S NEXT: ADD A STATIC SITE -->
                    <div class="p-3 bg-desktop border-2 border-amber">
                      <div class="flex items-center gap-2 mb-2">
                        <span class="font-bold text-xs uppercase tracking-wider text-amber font-mono">[:&gt; WHAT'S NEXT? — UNLOCK CREATOR STUDIO]:</span>
                      </div>
                      <p class="text-xs text-main leading-relaxed mb-3">
                        Want to publish photographs, upload a profile avatar, and deploy to your own personal static website? Adding a static site target enables all creator studio features:
                      </p>

                      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mb-3 text-xxs font-mono text-muted">
                        <div class="p-2 bg-black border border-main">
                          <span class="text-prompt font-bold block mb-0.5">Photo Publishing</span>
                          <span>Snap &amp; publish photos with authentic 90s CRT, VGA, and GameBoy shaders.</span>
                        </div>
                        <div class="p-2 bg-black border border-main">
                          <span class="text-prompt font-bold block mb-0.5">Profile Avatar</span>
                          <span>Upload custom 128x128 WebP profile avatars for your station.</span>
                        </div>
                        <div class="p-2 bg-black border border-main">
                          <span class="text-prompt font-bold block mb-0.5">Static Deployments</span>
                          <span>Push auto-compiled 11ty galleries to Neocities, Nekoweb, or GitHub Pages.</span>
                        </div>
                      </div>

                      <div class="flex items-center justify-between flex-wrap gap-2 pt-2 border-t border-main">
                        <button
                          type="button"
                          onclick="switchDashboardTab('settings/sites', event); setTimeout(function() { toggleProvisionForm(true); }, 150);"
                          class="pixel-btn pixel-btn--yellow font-bold text-xs py-1.5 px-4"
                        >
                          <span>+ ADD A STATIC SITE TARGET :&gt;</span>
                        </button>
                        <span class="text-xxs text-muted font-mono">
                          Enables image uploads, custom avatar, hit counters &amp; static gallery builds.
                        </span>
                      </div>
                    </div>
                  </div>
                {% endif %}

                <!-- Master Feed Overview Box -->
                <div class="p-2.5 bg-black border-2 border-main mb-4 flex items-center justify-between flex-wrap gap-2 text-xs font-mono">
                  <div class="flex items-center gap-2">
                    <div>
                      <span class="text-muted text-3xs block uppercase tracking-wider">CYBERSPACE BROADCAST STREAM:</span>
                      <span class="text-prompt font-bold text-xs">
                        {{ followerFeedPosts.length or 0 }} TRANSMISSION{% if followerFeedPosts.length != 1 %}S{% endif %}
                        <span class="text-muted text-xxs font-normal">({{ followedCount or 0 }} station{% if followedCount != 1 %}s{% endif %} followed)</span>
                      </span>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <button type="button" onclick="switchNetworkSubTab('directory')" class="pixel-btn pixel-btn--sm pixel-btn--yellow text-3xs font-bold py-1 px-2.5">
                      <span>+ FIND CREATORS</span>
                    </button>
                    <button type="button" onclick="switchNetworkSubTab('friends')" class="pixel-btn pixel-btn--sm text-3xs font-bold py-1 px-2.5">
                      <span>BUDDY ROSTER</span>
                    </button>
                  </div>
                </div>

                <!-- Feed Transmissions Grid -->
                {% if not followerFeedPosts or followerFeedPosts.length == 0 %}
                  <div class="retro-card p-6 text-center flex flex-col items-center gap-3">
                    <div class="text-sm font-bold text-mac">[:&gt; FOLLOWER FEED WAITING FOR TRANSMISSIONS]</div>
                    <p class="text-xs text-muted max-w-md mx-auto leading-relaxed">
                      {% if followedCount == 0 %}
                        You aren't following any station nodes yet. Browse the Cyberspace Directory to discover retro static sites, follow creators, and their photos will appear right here in your live feed!
                      {% else %}
                        You are following {{ followedCount }} station{% if followedCount != 1 %}s{% endif %}, but they haven't broadcasted any photographs yet. When they publish, their transmissions will stream here live.
                      {% endif %}
                    </p>
                    <div class="flex items-center gap-2 mt-2">
                      <button type="button" onclick="switchNetworkSubTab('directory')" class="pixel-btn pixel-btn--green font-bold text-xs py-1.5 px-4">
                        <span>Explore Cyberspace Directory →</span>
                      </button>
                    </div>
                  </div>
                {% else %}
                  <div class="workstation-card-grid gap-4" id="workstationFeedGrid">
                    {% for post in followerFeedPosts %}
                      <article class="retro-card p-0 flex flex-col justify-between" id="feedPost-{{ post.id }}">
                        <!-- Card Header -->
                        <div class="window-header flex items-center justify-between p-2 text-xs">
                          <a
                            href="/user/@{{ post.author }}"
                            class="flex items-center gap-1.5 font-bold text-mac hover:underline truncate"
                            onclick="if(window.retroAudio) retroAudio.playClick();"
                          >
                            <span>@{{ post.author }}</span>
                            {% if post.uin %}<span class="text-muted font-normal text-xxs">[#{{ post.uin }}]</span>{% endif %}
                          </a>
                          <span class="pixel-badge pixel-badge--cyan text-xxs font-bold uppercase shrink-0">
                            {{ post.filterApplied or 'RAW' }}
                          </span>
                        </div>

                        <!-- Photo Viewport with Retro 404 Fallback -->
                        <div class="relative bg-black border-b border-main overflow-hidden flex items-center justify-center crt-scanlines retro-photo-viewport">
                          <a
                            href="/user/@{{ post.author }}"
                            class="block w-full"
                            onclick="if(window.retroAudio) retroAudio.playClick();"
                          >
                            <img
                              src="{{ post.thumbnailUrl or post.imageUrl or post.thumbnailPath or post.imagePath }}"
                              alt="{{ post.caption }}"
                              class="w-full h-56 object-cover filter-{{ post.filterApplied or 'none' }}"
                              loading="lazy"
                              onerror="this.classList.add('neogram-img--broken'); var vp=this.closest('.retro-photo-viewport'); if(vp) vp.classList.add('has-broken-image');"
                            />
                          </a>
                        </div>

                        <!-- Body Details -->
                        <div class="p-3 flex flex-col gap-2 flex-1 justify-between text-xs">
                          <div>
                            <div class="flex items-center justify-between text-xxs text-muted mb-1 flex-wrap gap-1">
                              <span>{{ post.location or 'Cyberspace' }}</span>
                              <span>{{ post.createdAt | formatDateTime }}</span>
                            </div>

                            <p class="text-xs text-main leading-relaxed m-0 whitespace-pre-wrap">
                              {{ post.caption }}
                            </p>
                          </div>

                          <!-- Tags & Meta -->
                          <div class="pt-2 border-t border-main mt-2">
                            <div class="flex items-center gap-1 flex-wrap mb-2">
                              {% if post.mood %}
                                <span class="pixel-badge pixel-badge--cyan text-xxs">{{ post.mood }}</span>
                              {% endif %}
                              {% if post.webring %}
                                <span class="pixel-badge pixel-badge--magenta text-xxs">ring: {{ post.webring }}</span>
                              {% endif %}
                            </div>

                            <div class="flex items-center justify-between text-xs pt-1">
                              <div class="flex items-center gap-2 text-muted text-xxs">
                                <span>{{ post.likes or 0 }} likes</span>
                                <span>{{ post.commentCount or 0 }} comments</span>
                              </div>

                              <div class="flex items-center gap-1.5">
                                {% if post.galleryUrl or post.siteUrl %}
                                  <a
                                    href="{{ post.galleryUrl or post.siteUrl }}"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="pixel-btn pixel-btn--sm pixel-btn--green text-xxs font-bold py-0.5 px-2"
                                    onclick="if(window.retroAudio) retroAudio.playClick();"
                                    title="Open author's live static gallery"
                                  >
                                    <span>Gallery ↗</span>
                                  </a>
                                {% endif %}
                                <a
                                  href="/user/@{{ post.author }}"
                                  class="pixel-btn pixel-btn--sm pixel-btn--yellow text-xxs font-bold py-0.5 px-2"
                                  onclick="if(window.retroAudio) retroAudio.playClick();"
                                >
                                  <span>Station :&gt;</span>
                                </a>
                              </div>
                            </div>
                          </div>
                        </div>
                      </article>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>

              <!-- ============================================================
                   SUB-PAGE 2: FRIENDS ROSTER (Following List & Management)
                   ============================================================ -->
              <div id="networkSubPane-friends" class="hidden">
                <div class="p-2.5 bg-black border-2 border-main mb-4 flex items-center justify-between flex-wrap gap-2 text-xs font-mono">
                  <div class="flex items-center gap-2">
                    <div>
                      <span class="text-muted text-3xs block uppercase tracking-wider">FRIENDS_ROSTER.SYS // CYBERSPACE_FRIENDS.EXE:</span>
                      <span class="text-prompt font-bold text-xs" id="workstationFriendsCountLabel">
                        {{ friends.length or 0 }} ACTIVE BUDDY CONNECTION{% if friends.length != 1 %}S{% endif %}
                      </span>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <button type="button" onclick="switchNetworkSubTab('directory')" class="pixel-btn pixel-btn--sm pixel-btn--yellow text-3xs font-bold py-1 px-2.5">
                      <span>+ FIND FRIENDS IN DIRECTORY :&gt;</span>
                    </button>
                    <button type="button" onclick="switchNetworkSubTab('feed')" class="pixel-btn pixel-btn--sm text-3xs font-bold py-1 px-2.5">
                      <span>VIEW STREAM</span>
                    </button>
                  </div>
                </div>

                {% if not friends or friends.length == 0 %}
                  <div class="retro-card p-6 text-center flex flex-col items-center gap-3">
                    <div class="text-sm font-bold text-mac">[:&gt; NO FRIENDS IN CARRIER DIRECTORY YET]</div>
                    <p class="text-xs text-muted max-w-md mx-auto leading-relaxed">
                      You haven't followed any station nodes yet. Browse the Station Directory to add friends and build your static webring.
                    </p>
                    <button type="button" onclick="switchNetworkSubTab('directory')" class="pixel-btn pixel-btn--green font-bold text-xs py-1.5 px-4">
                      <span>Explore Station Directory →</span>
                    </button>
                  </div>
                {% else %}
                  <div class="workstation-card-grid gap-3" id="friendsRosterGrid">
                    {% for friend in friends %}
                      <article
                        class="retro-card p-3 flex flex-col justify-between border border-main text-xs relative m-0"
                        id="friendCard-{{ friend.handle }}"
                      >
                        <div class="flex items-start gap-2.5">
                          <a href="{{ friend.profileUrl }}" class="relative shrink-0" onclick="if(window.retroAudio) retroAudio.playClick();">
                            <img
                              src="{{ friend.avatarPath }}"
                              alt="@{{ friend.handle }} Avatar"
                              class="w-12 h-12 pixel-box border-2 border-black object-cover bg-black"
                              onerror="this.onerror=null;this.src='/icons/default-avatar.svg';"
                            />
                            <span
                              class="directory-status-dot directory-status-dot--{{ friend.status }}"
                              title="Status: {{ friend.status | upper }}"
                            ></span>
                          </a>

                          <div class="flex flex-col min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-1">
                              <a
                                href="{{ friend.profileUrl }}"
                                class="text-mac font-bold hover:underline truncate"
                                title="@{{ friend.handle }}"
                                onclick="if(window.retroAudio) retroAudio.playClick();"
                              >
                                @{{ friend.handle }}
                              </a>
                              <span class="pixel-badge pixel-badge--cyan text-xxs font-bold shrink-0">
                                #{{ friend.uin }}
                              </span>
                            </div>

                            <div class="text-prompt text-xxs truncate mt-0.5" title="{{ friend.statusMessage }}">
                              "{{ friend.statusMessage }}"
                            </div>

                            <div class="text-muted text-xxs mt-1">
                              {{ friend.postCount }} photo{% if friend.postCount != 1 %}s{% endif %}
                            </div>
                          </div>
                        </div>

                        <div class="flex items-center justify-between gap-1 pt-2 border-t border-main mt-3 text-xxs">
                          <div class="flex items-center gap-1 truncate">
                            {% if friend.cleanRootSiteUrl %}
                              <a
                                href="{{ friend.cleanRootSiteUrl }}"
                                target="_blank"
                                rel="noopener"
                                class="text-mac hover:underline font-bold"
                                title="Visit {{ friend.cleanRootSiteUrl }}"
                              >
                                Site ↗
                              </a>
                              <span class="text-muted">•</span>
                            {% endif %}
                            <a
                              href="{{ friend.profileUrl }}"
                              class="text-prompt hover:underline font-bold"
                              onclick="if(window.retroAudio) retroAudio.playClick();"
                            >
                              Profile :&gt;
                            </a>
                          </div>

                          <button
                            type="button"
                            onclick="handleUnfriendInWorkstation('{{ friend.handle }}', this)"
                            class="pixel-btn pixel-btn--sm text-xxs py-0 px-2 text-crimson hover:bg-crimson hover:text-white"
                            title="Remove @{{ friend.handle }} from friends"
                          >
                            <span>Unfriend</span>
                          </button>
                        </div>
                      </article>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>

              <!-- ============================================================
                   SUB-PAGE 3: STATION DIRECTORY (Online / Away / Inactive)
                   ============================================================ -->
              <div id="networkSubPane-directory" class="hidden">
                <!-- Top Directory Status Bar -->
                <div class="p-2.5 bg-black border-2 border-main mb-3 flex items-center justify-between flex-wrap gap-2 text-xs font-mono">
                  <div class="flex items-center gap-2">
                    <div>
                      <span class="text-muted text-3xs block uppercase tracking-wider">CYBERSPACE_DIRECTORY.SYS:</span>
                      <span class="text-prompt font-bold text-xs">
                        {{ totalDirectoryCount or 0 }} REGISTERED STATION NODES
                      </span>
                    </div>
                  </div>
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="pixel-badge pixel-badge--green font-bold text-xxs flex items-center gap-1">
                      <span class="status-led status-led--online"></span>
                      <span>ACTIVE: {{ activeUsers.length or 0 }}</span>
                    </span>
                    <span class="pixel-badge pixel-badge--amber font-bold text-xxs flex items-center gap-1">
                      <span class="status-led status-led--away"></span>
                      <span>AWAY: {{ awayUsers.length or 0 }}</span>
                    </span>
                    <span class="pixel-badge font-bold text-xxs flex items-center gap-1">
                      <span class="status-led status-led--offline"></span>
                      <span>INACTIVE: {{ inactiveUsers.length or 0 }}</span>
                    </span>
                  </div>
                </div>

                <!-- Interactive Search Filter Bar -->
                <div class="directory-search-box mb-3">
                  <span class="text-prompt font-bold text-xs shrink-0">:&gt; SEARCH:</span>
                  <input
                    type="text"
                    id="directorySearchInput"
                    placeholder="Filter stations by @handle or #UID..."
                    aria-label="Filter stations by handle or UID"
                    autocomplete="off"
                    oninput="filterWorkstationDirectory()"
                  />
                  <button
                    type="button"
                    id="directoryClearBtn"
                    class="pixel-btn pixel-btn--sm text-xxs py-0.5 px-2 hidden"
                    onclick="clearWorkstationDirectorySearch()"
                    title="Clear search filter"
                  >
                    <span>Clear</span>
                  </button>
                </div>
                <div id="directorySearchResultText" class="text-xxs text-muted mb-3 hidden font-mono"></div>

                <!-- 1. ACTIVE STATIONS -->
                <section class="directory-section mb-4" id="activeSection" aria-label="Active Stations">
                  <div class="directory-section-header">
                    <div class="flex items-center gap-2">
                      <span class="status-led status-led--online"></span>
                      <span class="font-bold uppercase tracking-wider text-xs">
                        1. ACTIVE STATIONS (<span id="activeCount">{{ activeUsers.length or 0 }}</span>)
                      </span>
                    </div>
                    <span class="pixel-badge pixel-badge--green font-bold text-xxs">ONLINE</span>
                  </div>
                  <div class="p-3">
                    {% if not activeUsers or activeUsers.length == 0 %}
                      <div class="p-4 border border-dashed border-main text-center bg-black text-prompt text-xs">
                        NO STATIONS CURRENTLY TRANSMITTING LIVE
                      </div>
                    {% else %}
                      <div class="directory-grid" id="activeGrid">
                        {% for user in activeUsers %}
                          <article class="directory-card directory-card--active" data-handle="{{ user.handle | lower }}" data-uin="{{ user.uin }}">
                            <a href="{{ user.profileUrl }}" class="directory-avatar-frame" onclick="if(window.retroAudio) retroAudio.playClick();">
                              <img src="{{ user.avatarPath }}" alt="@{{ user.handle }}" class="directory-avatar-img" loading="lazy" onerror="this.onerror=null;this.src='/icons/default-avatar.svg';" />
                              <span class="directory-status-dot directory-status-dot--active" title="Active (Online)"></span>
                            </a>
                            <div class="flex flex-col gap-1 min-w-0 flex-1">
                              <div class="flex items-center justify-between gap-1">
                                <a href="{{ user.profileUrl }}" class="text-mac font-bold hover:underline text-xs truncate">@{{ user.handle }}</a>
                                <span class="pixel-badge pixel-badge--cyan font-bold text-xxs shrink-0">#{{ user.uin }}</span>
                              </div>
                              <div class="text-prompt text-xxs truncate">"{{ user.statusMessage }}"</div>
                              <div class="flex items-center justify-between pt-1 border-t border-main text-xxs text-muted mt-0.5">
                                <span>{{ user.postCount }} photo{% if user.postCount != 1 %}s{% endif %}</span>
                                <a href="{{ user.profileUrl }}" class="pixel-btn pixel-btn--sm text-xxs py-0 px-2 font-bold">Profile :&gt;</a>
                              </div>
                            </div>
                          </article>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                </section>

                <!-- 2. AWAY STATIONS -->
                <section class="directory-section mb-4" id="awaySection" aria-label="Away Stations">
                  <div class="directory-section-header">
                    <div class="flex items-center gap-2">
                      <span class="status-led status-led--away"></span>
                      <span class="font-bold uppercase tracking-wider text-xs">
                        2. "AWAY" STATIONS (<span id="awayCount">{{ awayUsers.length or 0 }}</span>)
                      </span>
                    </div>
                    <span class="pixel-badge pixel-badge--amber font-bold text-xxs">AWAY</span>
                  </div>
                  <div class="p-3">
                    {% if not awayUsers or awayUsers.length == 0 %}
                      <div class="p-4 border border-dashed border-main text-center bg-black text-amber text-xs">
                        NO STATIONS CURRENTLY MARKED AS AWAY
                      </div>
                    {% else %}
                      <div class="directory-grid" id="awayGrid">
                        {% for user in awayUsers %}
                          <article class="directory-card directory-card--away" data-handle="{{ user.handle | lower }}" data-uin="{{ user.uin }}">
                            <a href="{{ user.profileUrl }}" class="directory-avatar-frame" onclick="if(window.retroAudio) retroAudio.playClick();">
                              <img src="{{ user.avatarPath }}" alt="@{{ user.handle }}" class="directory-avatar-img" loading="lazy" onerror="this.onerror=null;this.src='/icons/default-avatar.svg';" />
                              <span class="directory-status-dot directory-status-dot--away" title="Away"></span>
                            </a>
                            <div class="flex flex-col gap-1 min-w-0 flex-1">
                              <div class="flex items-center justify-between gap-1">
                                <a href="{{ user.profileUrl }}" class="text-mac font-bold hover:underline text-xs truncate">@{{ user.handle }}</a>
                                <span class="pixel-badge pixel-badge--cyan font-bold text-xxs shrink-0">#{{ user.uin }}</span>
                              </div>
                              <div class="text-amber text-xxs truncate">"{{ user.statusMessage }}"</div>
                              <div class="flex items-center justify-between pt-1 border-t border-main text-xxs text-muted mt-0.5">
                                <span>{{ user.postCount }} photo{% if user.postCount != 1 %}s{% endif %}</span>
                                <a href="{{ user.profileUrl }}" class="pixel-btn pixel-btn--sm text-xxs py-0 px-2 font-bold">Profile :&gt;</a>
                              </div>
                            </div>
                          </article>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                </section>

                <!-- 3. INACTIVE STATIONS -->
                <section class="directory-section" id="inactiveSection" aria-label="Inactive Stations">
                  <div class="directory-section-header">
                    <div class="flex items-center gap-2">
                      <span class="status-led status-led--offline"></span>
                      <span class="font-bold uppercase tracking-wider text-xs">
                        3. INACTIVE STATIONS (<span id="inactiveCount">{{ inactiveUsers.length or 0 }}</span>)
                      </span>
                    </div>
                    <span class="pixel-badge font-bold text-xxs">STANDBY</span>
                  </div>
                  <div class="p-3">
                    {% if not inactiveUsers or inactiveUsers.length == 0 %}
                      <div class="p-4 border border-dashed border-main text-center bg-black text-muted text-xs">
                        NO INACTIVE STATIONS IN REGISTRY
                      </div>
                    {% else %}
                      <div class="directory-grid" id="inactiveGrid">
                        {% for user in inactiveUsers %}
                          <article class="directory-card directory-card--inactive" data-handle="{{ user.handle | lower }}" data-uin="{{ user.uin }}">
                            <a href="{{ user.profileUrl }}" class="directory-avatar-frame" onclick="if(window.retroAudio) retroAudio.playClick();">
                              <img src="{{ user.avatarPath }}" alt="@{{ user.handle }}" class="directory-avatar-img" loading="lazy" onerror="this.onerror=null;this.src='/icons/default-avatar.svg';" />
                              <span class="directory-status-dot directory-status-dot--inactive" title="Inactive"></span>
                            </a>
                            <div class="flex flex-col gap-1 min-w-0 flex-1">
                              <div class="flex items-center justify-between gap-1">
                                <a href="{{ user.profileUrl }}" class="text-mac font-bold hover:underline text-xs truncate">@{{ user.handle }}</a>
                                <span class="pixel-badge pixel-badge--cyan font-bold text-xxs shrink-0">#{{ user.uin }}</span>
                              </div>
                              <div class="text-muted text-xxs truncate">"{{ user.statusMessage }}"</div>
                              <div class="flex items-center justify-between pt-1 border-t border-main text-xxs text-muted mt-0.5">
                                <span>{{ user.postCount }} photo{% if user.postCount != 1 %}s{% endif %}</span>
                                <a href="{{ user.profileUrl }}" class="pixel-btn pixel-btn--sm text-xxs py-0 px-2 font-bold">Profile :&gt;</a>
                              </div>
                            </div>
                          </article>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                </section>
              </div>

            </div>
          </div>
        </div>
        <!-- END TAB 0: NETWORK -->

        <!-- TAB 1: UPLOAD STUDIO SECTION -->
        <div id="uploadStudioSection" class="hidden">
          <!-- No Mounted Static Site Notice (When user has 0 sites) -->
          {% if not userSites or userSites.length == 0 %}
            <div id="noSiteUploadBanner" class="pixel-box p-4 mb-5 bg-window border-4 border-amber">
              <div class="window-header mb-3 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-black font-mono">[:&gt; PUBLISHER_LOCKED.EXE - Static Site Target Required]</span>
                </div>
                <span class="text-xs font-mono font-bold text-black bg-amber px-1.5 py-0.5 border border-black">[SITE REQUIRED]</span>
              </div>
              
              <p class="text-xs text-main mb-3 leading-relaxed">
                Photo publishing in Neogram operates under our <strong>Zero-Retention Policy</strong>: your photos are never permanently stored on Neogram servers—they publish directly to your personal static site (Neocities, Nekoweb, or GitHub Pages).
              </p>

              <div class="p-3 bg-black border border-main text-xs font-mono text-muted mb-3 flex items-start gap-2.5">
                <div>
                  <span class="text-prompt font-bold block mb-1">Why mount a static site target?</span>
                  <span>Mounting a static site unlocks the full Creator Studio: snap photos with 90s CRT shaders, upload a profile avatar, and compile an authentic retro static gallery on your personal website!</span>
                </div>
              </div>

              <div class="flex items-center justify-between flex-wrap gap-2 pt-2 border-t border-main">
                <button
                  type="button"
                  onclick="switchDashboardTab('settings/sites', event); setTimeout(function() { toggleProvisionForm(true); }, 150);"
                  class="pixel-btn pixel-btn--yellow font-bold text-xs py-1.5 px-3"
                >
                  <span>+ MOUNT A STATIC SITE TARGET :&gt;</span>
                </button>
                <button
                  type="button"
                  onclick="switchDashboardTab('feed', event);"
                  class="pixel-btn font-bold text-xs py-1.5 px-3"
                >
                  <span>Return to Follower Feed</span>
                </button>
              </div>
            </div>
          {% elif activeSite and not activeSite.hasApiKey %}
            <div class="p-2.5 bg-black border border-amber text-xs font-mono mb-4 flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-2">
                <span class="text-amber font-bold">[NOTE]</span>
                <span class="text-muted">Target site "<strong>{{ activeSite.name }}</strong>" has no API key linked yet. Photos will save locally and auto-deploy once connected in Settings.</span>
              </div>
              <a
                href="#settings/hosting"
                onclick="switchDashboardTab('settings/hosting', event)"
                class="pixel-btn pixel-btn--yellow text-3xs font-bold py-0.5 px-2"
              >
                <span>Link Key :&gt;</span>
              </a>
            </div>
          {% endif %}

          <!-- Active Mounted Target Site Bar -->
          <div class="p-2.5 bg-black border-2 border-main mb-4 flex items-center justify-between flex-wrap gap-2 text-xs font-mono">
            <div class="flex items-center gap-2">
              <div>
                <span class="text-muted text-3xs block uppercase tracking-wider">TARGET STATIC SITE:</span>
                <span class="text-prompt font-bold text-xs" id="uploadActiveSiteLabel">
                  {{ activeSite.name if activeSite else 'Primary Site' }}
                  {% if activeSite and activeSite.siteUrl %}<span class="text-muted text-xxs font-normal">({{ activeSite.siteUrl }}{% if activeSite.deployPath %}/{{ activeSite.deployPath }}/{% else %}/{% endif %})</span>{% endif %}
                </span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              {% if userSites and userSites.length > 1 %}
                <button
                  type="button"
                  onclick="toggleSiteMenu()"
                  class="pixel-btn pixel-btn--sm pixel-btn--yellow text-3xs font-bold py-1 px-2.5"
                  title="Switch to another mounted site target"
                >
                  <span>⇄ SWITCH TARGET</span>
                </button>
              {% endif %}
              <button
                type="button"
                onclick="switchDashboardTab('settings/sites', event)"
                class="pixel-btn pixel-btn--sm text-3xs font-bold py-1 px-2.5"
                title="Manage site credentials and provision new sites"
              >
                <span>MANAGE SITES</span>
              </button>
            </div>
          </div>

          <!-- 2-Column Publishing Grid -->
          <form id="publishForm" onsubmit="handlePublishPost(event)">
            <input type="hidden" name="siteId" id="uploadSiteId" value="{{ activeSite.id if activeSite else '' }}">
            <div class="flex-responsive">
            
            <!-- LEFT COLUMN: Image Source & Filter Shader -->
            <div class="flex-1 flex flex-col gap-3">
              <label class="block text-xs font-bold uppercase tracking-wider text-mac">
                1. Select or Snap Photo:
              </label>

              <!-- Photo Upload & Dynamic Preview Area (Swaps between Dropzone and Live Preview) -->
              <div id="photoStage" class="flex flex-col gap-3">
                <!-- State 1: Dropzone Well (Visible initially, no sample image) -->
                <div
                  id="uploadDropzone"
                  class="dropzone-well"
                  onclick="triggerFileInput(event)"
                  ondragenter="handleDragEnter(event)"
                  ondragover="handleDragOver(event)"
                  ondragleave="handleDragLeave(event)"
                  ondrop="handleFileDrop(event)"
                >
                  <svg class="retro-svg-icon retro-svg-icon--xl mb-2 text-mac" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 5h2.5l1-2h5l1 2H14v8H2V5z"/><circle cx="8" cy="9" r="2.2"/></svg>
                  <div class="font-bold text-sm tracking-wider uppercase mb-1">
                    CLICK TO BROWSE OR DRAG &amp; DROP PHOTOS
                  </div>
                  <div class="text-xs text-muted mb-4">
                    Supports 1 to 5 photos per gallery (JPEG, PNG, WebP, GIF, BMP)
                  </div>
                  
                  <div class="flex items-center justify-center">
                    <button
                      type="button"
                      id="selectPhotoBtn"
                      class="pixel-btn pixel-btn--yellow font-bold text-xs flex items-center gap-1.5"
                      onclick="triggerFileInput(event)"
                      title="Snap photos with camera or choose up to 5 from gallery"
                    >
                      <svg class="retro-svg-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 5h2.5l1-2h5l1 2H14v8H2V5z"/><circle cx="8" cy="9" r="2.2"/></svg>
                      <span>SNAP OR CHOOSE PHOTOS (UP TO 5)</span>
                    </button>
                  </div>
                </div>

                <!-- State 2: Live Preview Viewport & Shader Controls (Visible once photo is uploaded/selected) -->
                <div
                  id="previewContainer"
                  class="hidden flex flex-col gap-3"
                  ondragover="handleDragOver(event)"
                  ondrop="handleFileDrop(event)"
                >
                  <!-- Live Preview Viewport (Exact 320px frame) -->
                  <div class="preview-viewport crt-scanlines">
                    <img
                      id="previewImg"
                      src=""
                      alt="Neogram Snapshot Preview"
                      class="preview-viewport__img filter-crt"
                    />
                  </div>

                  <!-- Multi-Photo Gallery Thumbnail Strip (when > 1 photo selected) -->
                  <div id="multiPhotoStrip" class="hidden flex items-center gap-2 overflow-x-auto p-1 bg-window border border-main"></div>

                  <!-- Selected File Status Bar with Change / Clear Actions -->
                  <div class="pixel-box p-2 bg-desktop flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2 truncate">
                      <span id="selectedFileName" class="font-bold text-prompt truncate">photo.jpg</span>
                      <span id="selectedFileSize" class="text-muted text-xs">(0 KB)</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <button
                        type="button"
                        class="pixel-btn pixel-btn--sm"
                        onclick="triggerFileInput(event)"
                        title="Select different photo files"
                      >
                        <span>Change</span>
                      </button>
                      <button
                        type="button"
                        class="pixel-btn pixel-btn--danger pixel-btn--sm"
                        onclick="clearSelectedPhoto()"
                        title="Remove selected photos"
                      >
                        <span>Clear</span>
                      </button>
                    </div>
                  </div>

                  <!-- Filter Selector Grid -->
                  <div id="filterGridSection">
                    <span class="text-xs text-muted block mb-1 font-bold">Applied Retro Filter Shader:</span>
                    <div class="filter-grid" id="filterGrid">
                      <button type="button" class="filter-btn is-active" data-filter="crt" onclick="setFilter('crt')">
                        <div class="filter-swatch filter-crt"><span>░▒▓</span></div>
                        <span>CRT Phosphor</span>
                      </button>
                      <button type="button" class="filter-btn" data-filter="vga" onclick="setFilter('vga')">
                        <div class="filter-swatch filter-vga"><span style="color:#00ffff;">■</span><span style="color:#ff00ff;">■</span><span style="color:#ffff00;">■</span></div>
                        <span>16-Color VGA</span>
                      </button>
                      <button type="button" class="filter-btn" data-filter="gameboy" onclick="setFilter('gameboy')">
                        <div class="filter-swatch filter-gameboy"><span style="color:#9bbc0f;">●●</span></div>
                        <span>GameBoy 1-Bit</span>
                      </button>
                      <button type="button" class="filter-btn" data-filter="cyberpunk" onclick="setFilter('cyberpunk')">
                        <div class="filter-swatch filter-cyberpunk"><span style="color:#ff007f;">◆</span><span style="color:#00f0ff;">◆</span></div>
                        <span>Neon Cyber</span>
                      </button>
                      <button type="button" class="filter-btn" data-filter="sepia" onclick="setFilter('sepia')">
                        <div class="filter-swatch filter-sepia"><span style="color:#d2b48c;">▲▲</span></div>
                        <span>1996 Polaroid</span>
                      </button>
                      <button type="button" class="filter-btn" data-filter="none" onclick="setFilter('none')">
                        <div class="filter-swatch filter-none"><span style="color:#ffffff;">24b</span></div>
                        <span>Raw 24-Bit</span>
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Clean Hidden File Input (Outside containers to prevent bubbling conflicts) -->
                <input
                  type="file"
                  id="imageFileInput"
                  name="imageFiles"
                  accept="image/*"
                  multiple
                  style="display:none;"
                  onchange="handleFileInputChange(event)"
                />
              </div>
            </div>

            <!-- RIGHT COLUMN: Post Metadata & Publishing Engine -->
            <div class="flex-1 flex flex-col gap-3">
              <label class="block text-xs font-bold uppercase tracking-wider text-mac">
                2. Caption &amp; Log Entry:
              </label>

              <!-- Caption Textarea -->
              <div>
                <label for="captionInput" class="block text-xs font-bold mb-1">
                  Post Caption &amp; Log Entry:
                </label>
                <textarea
                  id="captionInput"
                  name="caption"
                  rows="6"
                  required
                  placeholder=":> Enter your thoughts, hardware specs, or retro web commentary..."
                  class="retro-input leading-normal"
                ></textarea>
              </div>

              <!-- Terminal Telemetry Log (During Upload) -->
              <div id="transmissionLog" class="transmission-terminal hidden">
                <div id="transmissionText">[:&gt; CARRIER LINK READY]</div>
              </div>

              <!-- Reusable Alert Box -->
              <div id="publishAlert" class="retro-alert flex-col items-start gap-2">
                <div>
                  <span id="publishAlertTag" class="retro-alert__tag"></span>
                  <span id="publishAlertMsg"></span>
                </div>
                <div id="publishAlertActions" class="hidden mt-1 flex items-center gap-2 flex-wrap"></div>
              </div>

              <!-- Action Submit Button -->
              <div class="mt-2">
                <button
                  type="submit"
                  id="publishBtn"
                  class="pixel-btn pixel-btn--green w-full py-2.5 font-bold text-sm"
                >
                  <span>TRANSMIT &amp; PUBLISH TO STATIC HOST :&gt;</span>
                </button>
              </div>
            </div>

          </div>
        </form>
        </div><!-- END TAB 1 -->

        <!-- TAB 2: MANAGE GALLERY / ARCHIVE SECTION -->
        <div id="manageGallerySection" class="hidden">
          <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
            <div class="text-xs text-muted">
              Showing <strong class="text-main" id="manageTotalCount">{{ posts.length or 0 }}</strong> published transmissions anchored to your sovereign static JSON feed.
            </div>
            <button
              type="button"
              onclick="triggerStaticRebuild()"
              id="rebuildStaticBtn"
              class="pixel-btn pixel-btn--sm pixel-btn--green text-xs font-bold"
            >
              <span>Rebuild 11ty Static Site</span>
            </button>
          </div>

          <div id="rebuildAlert" class="retro-alert hidden mb-3">
            <span id="rebuildAlertTag" class="retro-alert__tag"></span>
            <span id="rebuildAlertMsg"></span>
          </div>

          {% if userSites and userSites.length > 1 %}
            <div class="flex items-center gap-1.5 mb-3 flex-wrap text-xs font-mono bg-black p-2 border border-main">
              <span class="text-muted text-xxs uppercase font-bold">FILTER BY TARGET:</span>
              <button
                type="button"
                id="filterSiteAllBtn"
                class="pixel-btn pixel-btn--sm pixel-btn--yellow font-bold text-3xs py-0.5 px-2"
                onclick="filterManagePosts('all')"
              >
                ALL SITES ({{ posts.length }})
              </button>
              {% for s in userSites %}
                <button
                  type="button"
                  id="filterSiteBtn-{{ s.id }}"
                  class="pixel-btn pixel-btn--sm text-3xs py-0.5 px-2"
                  onclick="filterManagePosts('{{ s.id }}')"
                >
                  {{ s.name }}
                </button>
              {% endfor %}
            </div>
          {% endif %}

          {% if not posts or posts.length == 0 %}
            <div class="pixel-box p-6 text-center bg-window">
              <div class="font-bold text-mac text-xs mb-1">[:&gt; ARCHIVE EMPTY]</div>
              <p class="text-muted text-xs mb-3">
                No photographs uploaded to your gallery yet. Switch to the Upload Studio tab to publish your first photo.
              </p>
              <button type="button" onclick="switchDashboardTab('upload')" class="pixel-btn pixel-btn--yellow text-xs font-bold">
                <span>Open Upload Studio</span>
              </button>
            </div>
          {% else %}
            <div class="flex flex-col gap-4" id="managePostsList">
              {% for post in posts %}
                <div class="pixel-box p-3 bg-window border-2 border-main" id="manage-post-{{ post.id }}" data-site-id="{{ post.siteId or '' }}">
                  <div class="flex flex-col sm:flex-row gap-4 items-start">
                    
                    <!-- Thumbnail Viewport with Active Filter Shader & Retro 404 Fallback -->
                    <div class="w-full sm:w-36 h-36 bg-black flex items-center justify-center p-1 crt-scanlines border-2 border-main shrink-0 overflow-hidden retro-photo-viewport">
                      <img
                        src="{{ post.thumbnailPath or post.imagePath }}"
                        alt="{{ post.caption }}"
                        class="max-h-full max-w-full object-contain filter-{{ post.filterApplied or 'none' }}"
                        id="manage-img-{{ post.id }}"
                        loading="lazy"
                        onerror="this.classList.add('neogram-img--broken'); var vp=this.closest('.retro-photo-viewport'); if(vp) vp.classList.add('has-broken-image');"
                      />
                    </div>

                    <!-- Metadata & Details -->
                    <div class="flex-1 flex flex-col justify-between w-full h-full">
                      <div>
                        <div class="flex items-center justify-between text-xs mb-1">
                          <span class="font-bold text-prompt">ID: <code>{{ post.id | truncate(16) }}</code></span>
                          <span class="text-muted text-xs">{{ post.createdAt | formatDate }}</span>
                        </div>

                        <p class="text-xs text-main leading-relaxed mb-2" id="manage-caption-{{ post.id }}">
                          {{ post.caption }}
                        </p>

                        <div class="flex flex-wrap gap-1 mb-2 text-xs">
                          {% if post.siteName %}
                          <span class="pixel-badge pixel-badge--yellow font-bold" id="manage-site-{{ post.id }}" title="Target: {{ post.siteName }}">
                            {{ post.siteName }}
                          </span>
                          {% endif %}
                          {% if post.mood %}
                          <span class="pixel-badge pixel-badge--cyan font-bold" id="manage-mood-{{ post.id }}">
                            {{ post.mood }}
                          </span>
                          {% endif %}
                          {% if post.webring %}
                          <span class="pixel-badge pixel-badge--magenta font-bold" id="manage-webring-{{ post.id }}">
                            ring: {{ post.webring }}
                          </span>
                          {% endif %}
                          <span class="pixel-badge pixel-badge--amber font-bold" id="manage-filter-{{ post.id }}">
                            shader: {{ post.filterApplied or 'none' }}
                          </span>
                        </div>
                      </div>

                      <!-- Metrics & Action Buttons -->
                      <div class="flex items-center justify-between flex-wrap gap-2 pt-2 border-t border-main mt-auto">
                        <div class="text-xs text-muted flex items-center gap-3">
                          <span><strong class="text-main">{{ post.likes or 0 }}</strong> likes</span>
                          <span><strong class="text-main">{{ post.commentCount or 0 }}</strong> comments</span>
                        </div>

                        <div class="flex items-center gap-2 flex-wrap">
                          <a
                            href="{% if post.livePhotoUrl %}{{ post.livePhotoUrl }}{% elif activeSite and activeSite.siteUrl %}{{ activeSite.siteUrl }}/{{ activeSite.deployPath or 'neogram' }}/photos/{{ post.id }}/{% else %}/user/@{{ currentUser.handle or 'wasson' }}{% endif %}"
                            target="_blank"
                            rel="noopener"
                            class="pixel-btn pixel-btn--sm pixel-btn--green font-bold text-xs"
                            title="Open live photo on static host"
                          >
                            <span>View Live ↗</span>
                          </a>
                          <button
                            type="button"
                            class="pixel-btn pixel-btn--sm font-bold text-xs"
                            data-url="{% if post.livePhotoUrl %}{{ post.livePhotoUrl }}{% elif activeSite and activeSite.siteUrl %}{{ activeSite.siteUrl }}/{{ activeSite.deployPath or 'neogram' }}/photos/{{ post.id }}/{% else %}/user/@{{ currentUser.handle or 'wasson' }}{% endif %}"
                            onclick="copyPostWebUrl(this.getAttribute('data-url'), this)"
                            title="Copy live URL to clipboard"
                          >
                            <span>Copy Link</span>
                          </button>
                          <button
                            type="button"
                            class="pixel-btn pixel-btn--sm pixel-btn--yellow font-bold text-xs"
                            onclick="openEditModalById('{{ post.id }}')"
                          >
                            <span>Edit</span>
                          </button>
                          <button
                            type="button"
                            class="pixel-btn pixel-btn--sm pixel-btn--blue font-bold text-xs"
                            onclick="openCommentsModalById('{{ post.id }}')"
                            title="Moderate comments stored on your static site"
                          >
                            <span>Comments (<span id="post-comment-count-{{ post.id }}">{{ post.commentCount or 0 }}</span>)</span>
                          </button>
                          <button
                            type="button"
                            class="pixel-btn pixel-btn--sm pixel-btn--red font-bold text-xs"
                            onclick="confirmDeletePost('{{ post.id }}', this)"
                          >
                            <span>Delete</span>
                          </button>
                            <span>Delete</span>
                          </button>
                        </div>
                      </div>

                    </div>

                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        <!-- Retro Edit Modal Dialog (Accessible Native HTML5 Dialog) -->
        <dialog id="editModalDialog" class="pixel-dialog" closedby="any" aria-labelledby="editDialogTitle">
          <div class="pixel-box max-w-lg w-full bg-window border-4 border-black">
            <div class="window-header flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="font-bold" id="editDialogTitle">[:&gt; EDIT_TRANSMISSION.EXE - Modify Metadata]</span>
              </div>
              <button type="button" class="pixel-btn pixel-btn--sm font-bold" onclick="closeEditModal()" aria-label="Close dialog">
                <span>[X]</span>
              </button>
            </div>

            <form id="editPostForm" onsubmit="handleSaveEditPost(event)" class="p-4 space-y-3">
              <input type="hidden" id="editPostId" name="id" />

              <!-- Alert in modal -->
              <div id="editModalAlert" class="retro-alert hidden">
                <span id="editModalAlertTag" class="retro-alert__tag"></span>
                <span id="editModalAlertMsg"></span>
              </div>

              <!-- Caption -->
              <div>
                <label for="editCaptionInput" class="block text-xs font-bold mb-1">
                  Transmission Caption:
                </label>
                <textarea
                  id="editCaptionInput"
                  name="caption"
                  rows="3"
                  required
                  class="retro-input text-xs"
                ></textarea>
              </div>

              <!-- Filter Shader Selector -->
              <div>
                <label for="editFilterSelect" class="block text-xs font-bold mb-1">
                  Retro Filter Shader:
                </label>
                <select id="editFilterSelect" name="filterApplied" class="retro-input text-xs">
                  <option value="crt">CRT Phosphor</option>
                  <option value="vga">16-Color VGA</option>
                  <option value="gameboy">GameBoy 1-Bit</option>
                  <option value="cyberpunk">Neon Cyber</option>
                  <option value="sepia">1996 Polaroid</option>
                  <option value="none">Raw 24-Bit</option>
                </select>
              </div>

              <!-- Action Buttons -->
              <div class="flex items-center justify-end gap-2 pt-2 border-t border-main">
                <button type="button" class="pixel-btn text-xs font-bold" onclick="closeEditModal()">
                  <span>Cancel</span>
                </button>
                <button type="submit" id="editSaveBtn" class="pixel-btn pixel-btn--green text-xs font-bold py-1.5 px-3">
                  <span>SAVE CHANGES :&gt;</span>
                </button>
              </div>
            </form>
          </div>
        </dialog>

        <!-- Retro Comments Moderation Dialog (Accessible Native HTML5 Dialog) -->
        <dialog id="commentsModalDialog" class="pixel-dialog" closedby="any" aria-labelledby="commentsDialogTitle">
          <div class="pixel-box max-w-lg w-full bg-window border-4 border-black font-mono">
            <div class="window-header flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="font-bold text-xs" id="commentsDialogTitle">[:&gt; COMMENTS_MODERATOR.EXE - Self-Hosted Ledger]</span>
              </div>
              <button type="button" class="pixel-btn pixel-btn--sm font-bold" onclick="closeCommentsModal()" aria-label="Close dialog">
                <span>[X]</span>
              </button>
            </div>

            <div class="p-4 space-y-3">
              <div class="text-xs text-muted">
                :&gt; Reading self-hosted comments directly from your static host JSON file. Purging a comment updates the file on your remote site.
              </div>

              <div id="commentsModalList" class="max-h-64 overflow-y-auto space-y-2 border-2 border-main p-2 bg-desktop">
                <div class="text-xs text-muted text-center py-4">Loading comments from static host...</div>
              </div>

              <div class="flex items-center justify-end pt-2 border-t border-main">
                <button type="button" class="pixel-btn text-xs font-bold" onclick="closeCommentsModal()">
                  <span>Close Window</span>
                </button>
              </div>
            </div>
          </div>
        </dialog>

        <!-- TAB 3: STATION SETTINGS SECTION (6 Focused Sub-Pages with Left Menu) -->
        <div id="settingsSection" class="hidden">
          <div class="workstation-sublayout">

            <!-- LEFT-HAND MENU (Horizontal Strip on Mobile < 820px) -->
            <aside class="workstation-subnav" aria-label="Settings navigation">
              <div class="workstation-subnav__header">
                <span>STATION CONFIG</span>
                <span class="text-prompt">6 PAGES</span>
              </div>
              <div class="workstation-subnav__list">
                <button
                  type="button"
                  id="settingsSubBtn-profile"
                  class="workstation-subnav__btn is-active"
                  onclick="switchSettingsSubTab('profile')"
                >
                  <span class="workstation-subnav__btn-label">
                    <svg class="retro-svg-icon retro-svg-icon--sm" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="5.5" r="2.5"/><path d="M3 13.5c0-2.5 2.2-4 5-4s5 1.5 5 4"/></svg>
                    <span>Profile &amp; ID</span>
                  </span>
                  <span class="workstation-subnav__btn-arrow">›</span>
                </button>
                <button
                  type="button"
                  id="settingsSubBtn-sites"
                  class="workstation-subnav__btn"
                  onclick="switchSettingsSubTab('sites')"
                >
                  <span class="workstation-subnav__btn-label">
                    <svg class="retro-svg-icon retro-svg-icon--sm" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="10"/><path d="M2 6h12"/></svg>
                    <span>Mounted Sites</span>
                  </span>
                  <span class="workstation-subnav__btn-arrow">›</span>
                </button>
                <button
                  type="button"
                  id="settingsSubBtn-hosting"
                  class="workstation-subnav__btn"
                  onclick="switchSettingsSubTab('hosting')"
                >
                  <span class="workstation-subnav__btn-label">
                    <svg class="retro-svg-icon retro-svg-icon--sm" viewBox="0 0 16 16" aria-hidden="true"><circle cx="5.5" cy="8" r="3"/><path d="M8.5 8H14v2.5M11.5 8v2"/></svg>
                    <span>Hosting &amp; Keys</span>
                  </span>
                  <span class="workstation-subnav__btn-arrow">›</span>
                </button>
                <button
                  type="button"
                  id="settingsSubBtn-deploy"
                  class="workstation-subnav__btn"
                  onclick="switchSettingsSubTab('deploy')"
                >
                  <span class="workstation-subnav__btn-label">
                    <svg class="retro-svg-icon retro-svg-icon--sm" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v9M5 5l3-3 3 3M3 13h10"/></svg>
                    <span>Deploy &amp; Status</span>
                  </span>
                  <span class="workstation-subnav__btn-arrow">›</span>
                </button>
                <button
                  type="button"
                  id="settingsSubBtn-notifications"
                  class="workstation-subnav__btn"
                  onclick="switchSettingsSubTab('notifications')"
                >
                  <span class="workstation-subnav__btn-label">
                    <svg class="retro-svg-icon retro-svg-icon--sm" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2a4 4 0 0 0-4 4v3l-1.5 2h11L12 9V6a4 4 0 0 0-4-4z"/><path d="M6.5 13a1.5 1.5 0 0 0 3 0"/></svg>
                    <span>Notifications</span>
                  </span>
                  <span class="workstation-subnav__btn-arrow">›</span>
                </button>
                <button
                  type="button"
                  id="settingsSubBtn-data"
                  class="workstation-subnav__btn"
                  onclick="switchSettingsSubTab('data')"
                >
                  <span class="workstation-subnav__btn-label">
                    <svg class="retro-svg-icon retro-svg-icon--sm" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8M5 7l3 3 3-3M3 13h10"/></svg>
                    <span>Data &amp; Reset</span>
                  </span>
                  <span class="workstation-subnav__btn-arrow">›</span>
                </button>
              </div>
            </aside>

            <!-- RIGHT-HAND CONTENT PANE (Strictly 1 Focused Sub-Page Visible at a Time) -->
            <div class="workstation-subpane">

              <!-- ============================================================
                   SETTINGS SUB-PAGE 1: PROFILE & CYBER IDENTITY
                   ============================================================ -->
              <div id="settingsSubPane-profile">
                <div class="retro-card p-4 m-0">
                  <div class="window-header mb-4 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <span class="font-bold">[:&gt; CYBER_IDENTITY.SYS - Profile &amp; Call-Sign]</span>
                    </div>
                    <span class="text-xs font-mono text-prompt font-bold">[ONLINE]</span>
                  </div>

                  <div id="profileAlert" class="retro-alert hidden mb-3">
                    <span id="profileAlertTag" class="retro-alert__tag"></span>
                    <span id="profileAlertMsg"></span>
                  </div>

                  <form id="profileForm" onsubmit="handleSaveProfile(event)">
                    <div class="flex-responsive">

                      <!-- LEFT COLUMN: Avatar & Permanent UIN -->
                      <div class="flex-1 flex flex-col gap-3">
                        <label class="block text-xs font-bold uppercase tracking-wider text-mac">
                          1. Station Avatar &amp; Node Anchor:
                        </label>

                        <div class="p-3 bg-black border border-main flex items-center gap-4">
                          <div class="relative flex flex-col items-center shrink-0">
                            <img
                              id="settingsAvatarPreview"
                              src="{{ currentUser.avatarPath or '/icons/default-avatar.svg' }}"
                              alt="Avatar Preview"
                              class="w-16 h-16 border-2 border-main object-cover bg-black"
                              onerror="this.onerror=null;this.src='/icons/default-avatar.svg';"
                            />
                            <div id="avatarStatusBadge" class="text-3xs font-mono text-center text-muted mt-1">
                              {% if currentUser.avatarPath %}CUSTOM{% else %}DEFAULT{% endif %}
                            </div>
                          </div>

                          <div class="flex-1 flex flex-col gap-2">
                            <div class="flex items-center flex-wrap gap-2">
                              <button
                                type="button"
                                class="pixel-btn pixel-btn--sm pixel-btn--yellow font-bold text-xs"
                                onclick="document.getElementById('avatarFileInput').click()"
                              >
                                <span>Change Image...</span>
                              </button>
                              <button
                                type="button"
                                id="resetAvatarBtn"
                                class="pixel-btn pixel-btn--sm pixel-btn--crimson text-xs"
                                onclick="handleResetAvatar()"
                              >
                                <span>Reset to Default</span>
                              </button>
                            </div>
                            <input
                              type="file"
                              id="avatarFileInput"
                              accept="image/*"
                              class="hidden"
                              onchange="handleAvatarFileChange(event)"
                            />
                            <span class="text-xxs text-muted font-mono">
                              PNG, JPEG, GIF or WebP. Auto-cropped to 128×128 square.
                            </span>
                          </div>
                        </div>

                        <!-- Permanent Node UIN (ICQ Protocol) -->
                        <div class="p-3 bg-black border border-main">
                          <div class="flex items-center justify-between">
                            <div>
                              <span class="text-3xs text-muted font-mono block uppercase">Permanent Node UIN (Immutable Identity):</span>
                              <span class="font-bold text-prompt font-pixel text-base tracking-widest">#{{ currentUser.uin or '100101' }}</span>
                            </div>
                            <div class="text-right">
                              <span class="text-3xs text-muted font-mono block">ANCHOR</span>
                              <span class="text-xs text-mac font-bold font-mono">ICQ-STATIC-NODE</span>
                            </div>
                          </div>
                          <span class="text-3xs text-muted font-mono block mt-1.5 pt-1.5 border-t border-main">
                            <strong>Station Tip:</strong> Your web counters and guestbooks stay permanently tied to this number even if you change your @handle later.
                          </span>
                        </div>
                      </div>

                      <!-- RIGHT COLUMN: Call-Sign & Save Action -->
                      <div class="flex-1 flex flex-col justify-between gap-3">
                        <div class="flex flex-col gap-3">
                          <label class="block text-xs font-bold uppercase tracking-wider text-mac">
                            2. Cyber Call-Sign / Handle:
                          </label>

                          <div>
                            <label for="settingsHandleInput" class="block text-xs font-bold mb-1">
                              Public Station Handle:
                            </label>
                            <div class="flex items-center gap-1.5">
                              <span class="font-bold text-prompt font-mono text-sm">@</span>
                              <input
                                type="text"
                                id="settingsHandleInput"
                                name="handle"
                                value="{{ currentUser.handle }}"
                                required
                                pattern="[a-z0-9_-]{3,30}"
                                placeholder="e.g. cyber_surfer"
                                class="retro-input text-xs flex-1"
                              />
                            </div>
                            <span class="text-xs text-muted block mt-1.5 leading-relaxed">
                              3–30 lowercase letters, numbers, underscores, or hyphens. Your station profile URL is anchored to your immutable UIN (<code>/user/@{{ currentUser.uin }}</code>) so it never breaks even if you change your call-sign.
                            </span>
                          </div>
                        </div>

                        <div class="pt-3 border-t border-main mt-2">
                          <button
                            type="submit"
                            id="saveProfileBtn"
                            class="pixel-btn pixel-btn--green font-bold text-xs w-full py-2.5"
                          >
                            <span>UPDATE PROFILE &amp; CALL-SIGN :&gt;</span>
                          </button>
                        </div>
                      </div>

                    </div>
                  </form>
                </div>
              </div>

              <!-- ============================================================
                   SETTINGS SUB-PAGE 2: MOUNTED STATIC SITES MANAGER
                   ============================================================ -->
              <div id="settingsSubPane-sites" class="hidden">
                <div class="retro-card p-4 m-0">
                  <div class="window-header mb-4 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <span class="font-bold">[:&gt; SITES_MANAGER.SYS — Mounted Static Targets]</span>
                    </div>
                    <span class="text-xs font-mono text-prompt font-bold">[{{ userSites.length or 0 }} MOUNTED]</span>
                  </div>

                  <div id="sitesManagerAlert" class="retro-alert hidden mb-3">
                    <span id="sitesManagerAlertTag" class="retro-alert__tag"></span>
                    <span id="sitesManagerAlertMsg"></span>
                  </div>

                  <div class="flex-responsive">

                    <!-- LEFT COLUMN: Configured Sites Roster -->
                    <div class="flex-1 flex flex-col gap-3">
                      <label class="block text-xs font-bold uppercase tracking-wider text-mac">
                        1. Mounted Static Targets ({{ userSites.length or 0 }}):
                      </label>

                      <div class="flex flex-col gap-2" id="configuredSitesList">
                        {% if userSites and userSites.length > 0 %}
                          {% for s in userSites %}
                            <div class="p-3 bg-black border-2 border-main flex flex-col gap-2 font-mono text-xs {% if activeSite and activeSite.id == s.id %}border-yellow-400{% endif %}" id="site-card-{{ s.id }}">
                              <div class="flex items-center justify-between flex-wrap gap-1">
                                <div class="flex items-center gap-1.5">
                                  <span class="text-prompt font-bold text-sm">{{ s.name }}</span>
                                  <span class="text-3xs text-muted">({{ s.slug }})</span>
                                </div>
                                <div class="flex items-center gap-1">
                                  {% if s.is_default %}
                                    <span class="pixel-badge pixel-badge--cyan font-bold text-3xs">[PRIMARY]</span>
                                  {% endif %}
                                  {% if activeSite and activeSite.id == s.id %}
                                    <span class="pixel-badge pixel-badge--yellow font-bold text-3xs">[ACTIVE]</span>
                                  {% endif %}
                                  <span class="pixel-badge text-3xs uppercase">{{ s.deployment_type or 'neocities' }}</span>
                                </div>
                              </div>

                              <div class="text-xxs text-muted flex flex-col gap-0.5">
                                <div>URL: <a href="{{ s.site_url or '#' }}" target="_blank" class="text-mac hover:underline font-bold">{{ s.site_url or 'Not configured' }}</a></div>
                                <div>Deploy Path: <code>/{{ s.deploy_path }}/</code> | Status: {% if s.has_api_key or s.deployment_credentials %}<span class="text-prompt">Key Connected</span>{% else %}<span class="text-amber">No API Key</span>{% endif %}</div>
                              </div>

                              <div class="flex items-center gap-1.5 flex-wrap pt-1 border-t border-main mt-1">
                                {% if not (activeSite and activeSite.id == s.id) %}
                                  <button
                                    type="button"
                                    onclick="handleNavSwitchSite('{{ s.id }}')"
                                    class="pixel-btn pixel-btn--sm pixel-btn--yellow text-3xs font-bold py-0.5 px-2"
                                    title="Switch active workstation session to this site"
                                  >
                                    <span>⇄ Switch Target</span>
                                  </button>
                                {% endif %}
                                {% if not s.is_default %}
                                  <button
                                    type="button"
                                    onclick="handleSetDefaultSite('{{ s.id }}')"
                                    class="pixel-btn pixel-btn--sm text-3xs py-0.5 px-2"
                                    title="Set as primary default target"
                                  >
                                    <span>Set Primary</span>
                                  </button>
                                {% endif %}
                                <button
                                  type="button"
                                  onclick="loadSiteIntoSettingsEditor('{{ s.id }}'); switchSettingsSubTab('hosting');"
                                  class="pixel-btn pixel-btn--sm text-3xs py-0.5 px-2"
                                  title="Edit credentials and paths in Hosting & Keys"
                                >
                                  <span>Edit Config</span>
                                </button>
                                <button
                                  type="button"
                                  onclick="switchSettingsSubTab('deploy'); deploySiteDirectly('{{ s.id }}')"
                                  class="pixel-btn pixel-btn--sm pixel-btn--cyan text-3xs font-bold py-0.5 px-2"
                                  title="Build and publish to remote host"
                                >
                                  <span>Deploy</span>
                                </button>
                                {% if userSites.length > 1 %}
                                  <button
                                    type="button"
                                    onclick="handleDeleteSite('{{ s.id }}', '{{ s.name }}', this)"
                                    class="pixel-btn pixel-btn--sm pixel-btn--danger text-3xs py-0.5 px-2 ml-auto"
                                    title="Unmount and delete this site target"
                                  >
                                    <span>Delete</span>
                                  </button>
                                {% endif %}
                              </div>
                            </div>
                          {% endfor %}
                        {% else %}
                          <div class="p-4 bg-black border-2 border-main text-center text-xs font-mono text-muted">
                            <div class="font-bold text-mac mb-1">[:&gt; NO STATIC SITES MOUNTED YET]</div>
                            <p class="leading-relaxed mb-3 max-w-md mx-auto">
                              Mount your first static site target using the form on the right to unlock photo publishing, profile avatars, and custom widgets.
                            </p>
                            <button
                              type="button"
                              onclick="toggleProvisionForm(true)"
                              class="pixel-btn pixel-btn--yellow text-xs font-bold py-1 px-3"
                            >
                              <span>+ Focus New Site Form :&gt;</span>
                            </button>
                          </div>
                        {% endif %}
                      </div>
                    </div>

                    <!-- RIGHT COLUMN: Provision New Site Target Form -->
                    <div class="flex-1 flex flex-col gap-3">
                      <div class="flex items-center justify-between">
                        <label class="block text-xs font-bold uppercase tracking-wider text-mac">
                          2. Provision New Static Site Target:
                        </label>
                        <button
                          type="button"
                          id="toggleProvisionFormBtn"
                          onclick="toggleProvisionForm()"
                          class="hidden"
                          aria-hidden="true"
                        >
                          <span id="provisionFormCaret">▴</span>
                        </button>
                      </div>

                      <div id="provisionFormContainer" class="p-3 bg-black border-2 border-main font-mono text-xs">
                        <form id="provisionSiteForm" onsubmit="handleProvisionSite(event)" class="space-y-3">
                          <div>
                            <label class="block font-bold text-mac mb-1">Target Site Name:</label>
                            <input
                              type="text"
                              id="newSiteName"
                              placeholder="e.g. Cyber-Shrine or Photo Blog"
                              required
                              class="retro-input text-xs"
                              oninput="autoGenerateSlug(this.value)"
                            />
                          </div>

                          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div>
                              <label class="block font-bold mb-1">Subdomain / Slug:</label>
                              <input
                                type="text"
                                id="newSiteSlug"
                                placeholder="e.g. cyber-shrine"
                                required
                                pattern="[a-z0-9_-]{2,50}"
                                class="retro-input text-xs"
                              />
                            </div>
                            <div>
                              <label class="block font-bold mb-1">Host Provider:</label>
                              <select id="newSiteDeployType" class="retro-input text-xs" onchange="updateNewSiteProviderUI()">
                                <option value="neocities" selected>Neocities</option>
                                <option value="nekoweb">Nekoweb (Live REST API)</option>
                                <option value="none">Cold-Start / Sandbox</option>
                                <option value="github">GitHub Pages (Git Commit REST API)</option>
                                <option value="sftp" disabled>SFTP (v1.1)</option>
                              </select>
                            </div>
                          </div>

                          <div>
                            <label class="block font-bold mb-1">Target Site URL:</label>
                            <input
                              type="url"
                              id="newSiteUrl"
                              placeholder="https://yoursite.neocities.org"
                              class="retro-input text-xs"
                            />
                          </div>

                          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div>
                              <label class="block font-bold mb-1">Publish Subfolder:</label>
                              <input
                                type="text"
                                id="newSiteDeployPath"
                                value="neogram"
                                placeholder="neogram"
                                class="retro-input text-xs"
                              />
                            </div>
                            <div>
                              <label id="newSiteApiKeyLabel" class="block font-bold mb-1">API Key / Token (Optional):</label>
                              <input
                                type="password"
                                id="newSiteApiKey"
                                placeholder="Optional API Key"
                                class="retro-input text-xs"
                              />
                            </div>
                          </div>

                          <div class="space-y-1 pt-1 border-t border-main">
                            <label class="flex items-center gap-2 cursor-pointer">
                              <input type="checkbox" id="newSiteIsDefault" />
                              <span class="text-xs">Set as Primary Default Site</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer">
                              <input type="checkbox" id="newSiteAutoDeploy" checked />
                              <span class="text-xs">Auto-deploy on photo upload</span>
                            </label>
                          </div>

                          <div class="pt-2">
                            <button type="submit" id="btnSubmitNewSite" class="pixel-btn pixel-btn--green font-bold text-xs py-2 px-3 w-full">
                              <span>PROVISION TARGET :&gt;</span>
                            </button>
                          </div>
                        </form>
                      </div>
                    </div>

                  </div>
                </div>
              </div>

              <!-- ============================================================
                   SETTINGS SUB-PAGE 3: HOSTING VAULT & API KEYS
                   ============================================================ -->
              <div id="settingsSubPane-hosting" class="hidden">
                <div class="retro-card p-4 m-0">
                  <div class="window-header mb-3 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <span class="font-bold">[:&gt; TARGET_VAULT_CREDENTIALS.SYS - Encrypted at Rest]</span>
                    </div>
                    <span class="text-xs font-mono text-prompt font-bold">[AES-256-GCM]</span>
                  </div>

                  <div id="settingsAlert" class="retro-alert hidden mb-3">
                    <span id="settingsAlertTag" class="retro-alert__tag"></span>
                    <span id="settingsAlertMsg"></span>
                  </div>

                  {% if not userSites or userSites.length == 0 %}
                    <div class="p-4 bg-black border border-main text-xs font-mono text-muted text-center leading-relaxed">
                      <span class="text-prompt font-bold block mb-1">[:&gt; TARGET VAULT UNINITIALIZED]</span>
                      No static site targets currently mounted. Open <strong>Mounted Sites</strong> to mount a Neocities, Nekoweb, or Sandbox site first.
                      <div class="mt-3">
                        <button type="button" onclick="switchSettingsSubTab('sites')" class="pixel-btn pixel-btn--yellow text-xs font-bold py-1 px-3">
                          <span>Go to Mounted Sites :&gt;</span>
                        </button>
                      </div>
                    </div>
                  {% else %}
                    <form id="settingsForm" onsubmit="handleSaveSettings(event)">
                      <!-- Target Site Selector Bar -->
                      <div class="p-2.5 bg-black border-2 border-main mb-4 flex items-center justify-between flex-wrap gap-2">
                        <div class="flex items-center gap-2">
                          <span class="text-xs font-bold text-mac uppercase font-mono">EDITING CONFIGURATION FOR:</span>
                        </div>
                        <select
                          id="settingsSiteSelector"
                          onchange="loadSiteIntoSettingsEditor(this.value)"
                          class="retro-input text-xs font-mono font-bold"
                          style="width: auto; max-width: 100%; min-width: 0;"
                        >
                          {% for s in userSites %}
                            <option value="{{ s.id }}" {% if activeSite and activeSite.id == s.id %}selected{% endif %}>
                              {{ s.name }} ({{ s.slug }}) {% if s.is_default %}[Primary]{% endif %}
                            </option>
                          {% endfor %}
                        </select>
                      </div>
