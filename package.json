{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,SASS\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run sass:watch\"",
    "dev:server": "tsx watch server/index.ts",
    "sass:build": "sass src/styles/main.scss public/css/neogram.css --no-source-map",
    "sass:watch": "sass src/styles/main.scss public/css/neogram.css --watch --no-source-map",
    "build:static": "tsx -e \"import { buildStaticGallery } from './server/services/staticBuilder'; buildStaticGallery();\"",
    "build:11ty": "npx @11ty/eleventy --config=eleventy/eleventy.config.js",
    "start:server": "tsx server/index.ts",
    "extension:sync": "node -e \"const fs = require('fs'); fs.mkdirSync('extension/shared', { recursive: true }); fs.copyFileSync('public/css/neogram.css', 'extension/shared/neogram.css'); fs.copyFileSync('public/js/retroAudio.js', 'extension/shared/retroAudio.js'); console.log('[:> EXTENSION] Shared assets synced.');\"",
    "extension:package": "npm run extension:sync && cd extension && zip -r ../neogram-aim-extension.zip . -x '*.DS_Store*'",
    "build": "npm run sass:build && npm run build:static && npm run extension:sync",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "nunjucks": "^3.2.4",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "sass": "^1.105.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
