&lt;div id="app"&gt;
  &lt;div id="profile-container"&gt;&lt;/div&gt;
  &lt;div id="gallery-container"&gt;Loading photos from self-hosted feed...&lt;/div&gt;
&lt;/div&gt;

&lt;style&gt;
  #app { font-family: monospace; max-width: 900px; margin: 0 auto; padding: 20px; }
  .profile-header { display: flex; align-items: center; gap: 16px; border: 2px solid #000; padding: 16px; background: #ffffcc; margin-bottom: 24px; }
  .profile-avatar { width: 64px; height: 64px; border: 2px solid #000; image-rendering: pixelated; }
  .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
  .photo-card { border: 2px solid #000; box-shadow: 4px 4px 0 #000; background: #fff; display: flex; flex-col; overflow: hidden; }
  .photo-img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; border-bottom: 2px solid #000; }
  .photo-body { padding: 12px; font-size: 13px; }
  .action-btn { background: #ffff00; border: 2px solid #000; padding: 4px 10px; font-weight: bold; cursor: pointer; font-family: monospace; }
  .action-btn:hover { background: #00ff66; }
  .comments-list { margin-top: 8px; border-top: 1px dashed #ccc; padding-top: 8px; font-size: 11px; }
  .comment-input { width: 100%; box-sizing: border-box; padding: 4px; font-family: monospace; margin-top: 4px; border: 1px solid #000; }
&lt;/style&gt;

&lt;script&gt;
// Replace with your self-hosted feed URL or relative path if hosted on the same site:
const FEED_URL = 'https://{{ stationHandle }}.neocities.org/{{ deployPath }}/feed.json';

async function initNeogramApp() {
  const profileEl = document.getElementById('profile-container');
  const galleryEl = document.getElementById('gallery-container');

  try {
    const res = await fetch(FEED_URL);
    if (!res.ok) throw new Error('HTTP ' + res.status + ' loading feed');
    const data = await res.json();

    // 1. Render User Profile Header
    profileEl.innerHTML = `
      &lt;div class="profile-header"&gt;
        &lt;img src="${data.user.avatarUrl}" alt="${data.user.handle}" class="profile-avatar" /&gt;
        &lt;div&gt;
          &lt;h2 style="margin: 0;"&gt;@${data.user.handle} &lt;span style="font-size: 12px; color: #666;"&gt;[#${data.user.uin || 'NODE'}]&lt;/span&gt;&lt;/h2&gt;
          &lt;p style="margin: 4px 0; color: #444;"&gt;${data.user.statusMessage || ''}&lt;/p&gt;
          &lt;button class="action-btn" onclick="followStation('${data.endpoints.followUrl}')"&gt;➕ Add Friend&lt;/button&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    `;

    // 2. Render Photos Grid
    if (!data.posts || data.posts.length === 0) {
      galleryEl.innerHTML = '&lt;p&gt;No transmissions found in self-hosted feed.&lt;/p&gt;';
      return;
    }

    galleryEl.innerHTML = `
      &lt;div class="photo-grid"&gt;
        ${data.posts.map(post =&gt; `
          &lt;div class="photo-card" id="card-${post.id}"&gt;
            &lt;img src="${post.thumbnailUrl}" alt="${post.caption || 'Photo'}" class="photo-img" loading="lazy" /&gt;
            &lt;div class="photo-body"&gt;
              &lt;p style="margin: 0 0 8px 0; font-weight: bold;"&gt;${post.caption || ':&gt; Snapshot'}&lt;/p&gt;
              &lt;div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; margin-bottom: 8px;"&gt;
                &lt;span&gt;📅 ${new Date(post.createdAt).toLocaleDateString()}&lt;/span&gt;
                &lt;button class="action-btn" id="like-btn-${post.id}" onclick="likePhoto('${post.id}', '${post.actions.likeUrl}')"&gt;
                  ⚡ &lt;span id="likes-count-${post.id}"&gt;${post.likes}&lt;/span&gt; Likes
                &lt;/button&gt;
              &lt;/div&gt;

              &lt;!-- Comments Ledger --&gt;
              &lt;details&gt;
                &lt;summary style="cursor: pointer; font-size: 11px;"&gt;💬 Comments (${(post.comments || []).length})&lt;/summary&gt;
                &lt;div class="comments-list" id="comments-${post.id}"&gt;
                  ${(post.comments || []).map(c =&gt; `&lt;div&gt;&lt;strong&gt;@${c.author}:&lt;/strong&gt; ${c.text}&lt;/div&gt;`).join('')}
                &lt;/div&gt;
                &lt;form onsubmit="submitComment(event, '${post.id}', '${post.actions.commentUrl}')" style="margin-top: 6px;"&gt;
                  &lt;input type="text" placeholder="Your name" class="comment-input" required /&gt;
                  &lt;input type="text" placeholder="Write a comment..." class="comment-input" required /&gt;
                  &lt;button type="submit" class="action-btn" style="margin-top: 4px; width: 100%;"&gt;Post Comment&lt;/button&gt;
                &lt;/form&gt;
              &lt;/details&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        `).join('')}
      &lt;/div&gt;
    `;
  } catch (err) {
    galleryEl.innerHTML = `&lt;p style="color: red;"&gt;Failed to load self-hosted feed: ${err.message}&lt;/p&gt;`;
  }
}

// 3. Like Photo Action
async function likePhoto(postId, likeUrl) {
  const countEl = document.getElementById('likes-count-' + postId);
  const current = parseInt(countEl.textContent, 10) || 0;
  countEl.textContent = current + 1; // Optimistic bump

  try {
    const res = await fetch(likeUrl, { method: 'POST' });
    const json = await res.json();
    if (json.likes) countEl.textContent = json.likes;
  } catch (err) {
    console.warn('Like failed:', err);
  }
}

// 4. Submit Comment Action
async function submitComment(event, postId, commentUrl) {
  event.preventDefault();
  const form = event.target;
  const authorInput = form.elements[0];
  const textInput = form.elements[1];

  const author = authorInput.value.trim();
  const body = textInput.value.trim();
  if (!author || !body) return;

  const commentsList = document.getElementById('comments-' + postId);
  const tempComment = document.createElement('div');
  tempComment.innerHTML = `&lt;strong&gt;@${author}:&lt;/strong&gt; ${body} &lt;em style="color: #888;"&gt;(sending...)&lt;/em&gt;`;
  commentsList.appendChild(tempComment);

  try {
    const res = await fetch(commentUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ author: author, body: body })
    });
    if (res.ok) {
      tempComment.querySelector('em').remove();
      form.reset();
    } else {
      tempComment.style.color = 'red';
      tempComment.innerHTML += ' (failed)';
    }
  } catch (err) {
    tempComment.style.color = 'red';
    tempComment.innerHTML += ' (error)';
  }
}

// 5. Follow Station Action
async function followStation(followUrl) {
  try {
    const res = await fetch(followUrl, { method: 'POST', credentials: 'include' });
    const json = await res.json();
    if (res.ok) {
      alert('✓ Successfully added to your Cyberspace Friends Network!');
    } else {
      alert(json.error || 'Please log in to Neogram to follow this station.');
    }
  } catch (err) {
    alert('Network error connecting to station.');
  }
}

