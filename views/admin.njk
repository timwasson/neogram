</div>

<script>
  let currentActiveFilter = 'all';

  function handleMarqueeInput(textarea) {
    const val = textarea.value;
    document.getElementById('marqueeCharCount').textContent = val.length + ' / 500 characters';
    document.getElementById('marqueePreview').textContent = val || ':> NO ANNOUNCEMENT ACTIVE_';
  }

  function resetMarqueeDefault() {
    const def = ':> NEOGRAM UNIX WORKSTATION // HYBRID MAC-SYSTEM7 + BSD-X11 // RETRO PHOTO PUBLISHING ENGINE FOR NEOCITIES & PERSONAL SITES // NO SAAS SLOP // 28.8K V.34 DIAL-UP OK // SYSTEM PROMPT READY_';
    const ta = document.getElementById('marqueeTextInput');
    ta.value = def;
    handleMarqueeInput(ta);
  }

  async function updateMarqueeTicker(e) {
    e.preventDefault();
    const text = document.getElementById('marqueeTextInput').value.trim();
    const btn = document.getElementById('btnSaveMarquee');
    const alert = document.getElementById('marqueeStatusAlert');

    btn.disabled = true;
    btn.textContent = 'Transmitting...';

    try {
      if (window.retroAudio) retroAudio.playClick();
      const res = await fetch('/api/admin/marquee', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-neogram-sysop-op': '1',
        },
        body: JSON.stringify({ text }),
      });

      const data = await res.json();
      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Failed to update ticker.');
      }

      alert.textContent = '✓ Broadcasted successfully!';
      alert.classList.remove('hidden');

      // Update top live ticker directly if in DOM
      const topContent = document.getElementById('terminalMarqueeContent');
      if (topContent) topContent.textContent = data.ticker;

      setTimeout(() => alert.classList.add('hidden'), 4000);
    } catch (err) {
      window.alert('[:> TRANSMISSION ERROR] ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<span>Broadcast to Cyberspace</span>';
    }
  }

  async function pollPipelineTelemetry() {
    const btn = document.getElementById('btnRefreshPipeline');
    if (btn) btn.textContent = '↻ Polling...';

    try {
      const res = await fetch('/api/admin/pipeline');
      const data = await res.json();
      if (data.ok && data.telemetry) {
        const t = data.telemetry;
        const strip = document.getElementById('pipelineStatusStrip');
        const led = document.getElementById('pipelineLed');
        const statusText = document.getElementById('pipelineStatusText');
        const timerText = document.getElementById('pipelineTimer');

        if (t.isBusy && t.currentJob) {
          strip.classList.add('pipeline-status-strip--busy');
          led.classList.add('pipeline-led--busy');
          statusText.textContent = `BUSY // PROCESSING JOB: ${t.currentJob.taskName} (Queue Depth: ${t.activeCount})`;
          timerText.textContent = `Started: ${new Date(t.currentJob.startedAt).toLocaleTimeString()}`;
        } else {
          strip.classList.remove('pipeline-status-strip--busy');
          led.classList.remove('pipeline-led--busy');
          statusText.textContent = 'PIPELINE IDLE // WAITING FOR TRANSMISSIONS (Queue Depth: 0)';
          timerText.textContent = 'Baud: 28.8K V.34 OK';
        }

        // Render queue breakdown & sweep telemetry
        const highCount = document.getElementById('highQueueCount');
        const lowCount = document.getElementById('lowQueueCount');
        if (highCount) highCount.textContent = t.highPendingCount || 0;
        if (lowCount) lowCount.textContent = t.lowPendingCount || 0;

        if (t.sweep) {
          const s = t.sweep;
          const stripEl = document.getElementById('sweepTelemetryStrip');
          const btnCancel = document.getElementById('btnCancelSweep');
          const btnInit = document.getElementById('btnInitiateSweep');
          const stateTag = document.getElementById('sweepStateTag');
          const currentTarget = document.getElementById('sweepCurrentTarget');
          const progressText = document.getElementById('sweepProgressText');
          const fillBar = document.getElementById('fleetSweepFill');
          const successCount = document.getElementById('sweepSuccessCount');
          const failCount = document.getElementById('sweepFailCount');
          const errorsBox = document.getElementById('sweepErrorsBox');
          const errorsList = document.getElementById('sweepErrorsList');

          if (s.isActive) {
            if (stripEl) stripEl.classList.remove('hidden');
            if (btnCancel) btnCancel.classList.remove('hidden');
            if (btnInit) btnInit.classList.add('hidden');
            if (stateTag) {
              stateTag.textContent = 'SWEEP ACTIVE';
              stateTag.className = 'text-xs font-mono text-amber font-bold';
            }
            if (fillBar) fillBar.classList.add('fleet-sweep-fill--active');
          } else {
            if (btnCancel) btnCancel.classList.add('hidden');
            if (btnInit) btnInit.classList.remove('hidden');
            if (stateTag) {
              stateTag.textContent = s.total > 0 ? 'SWEEP FINISHED' : 'IDLE';
              stateTag.className = 'text-xs font-mono text-muted';
            }
            if (fillBar) fillBar.classList.remove('fleet-sweep-fill--active');
          }

          if (currentTarget) currentTarget.textContent = `Target: ${s.currentSite || (s.isActive ? 'Pacing delay...' : 'Idle')}`;
          const pct = s.total > 0 ? Math.round((s.processed / s.total) * 100) : 0;
          if (progressText) progressText.textContent = `${s.processed} / ${s.total} Stations (${pct}%)`;
          if (fillBar) fillBar.style.width = `${pct}%`;
          if (successCount) successCount.textContent = s.succeeded;
          if (failCount) failCount.textContent = s.failed;

          if (errorsBox && errorsList) {
            if (s.errors && s.errors.length > 0) {
              errorsBox.classList.remove('hidden');
              errorsList.innerHTML = s.errors.map(e => `<li>[!] [${e.handle} - ${e.siteName}]: ${e.error}</li>`).join('');
            } else {
              errorsBox.classList.add('hidden');
            }
          }
        }

        // Render recent jobs
        if (t.history && t.history.length > 0) {
          const tbody = document.getElementById('pipelineHistoryBody');
          tbody.innerHTML = t.history.map(job => `
            <tr>
              <th scope="row">${job.id}</th>
              <td>${job.taskName}</td>
              <td>${job.queueWaitMs || 0}ms</td>
              <td>${job.durationMs || 0}ms</td>
              <td>
                <span class="sysop-badge ${job.status === 'SUCCESS' ? 'sysop-badge--active' : 'sysop-badge--banned'}">
                  ${job.status}
                </span>
              </td>
              <td>${new Date(job.startedAt).toLocaleTimeString()}</td>
            </tr>
          `).join('');
        }
      }
    } catch (_err) {
      // Ignore background poll errors
    } finally {
      if (btn) btn.textContent = '↻ Refresh Pipeline';
    }
  }

  // Poll pipeline telemetry every 8 seconds while tab is active
  setInterval(pollPipelineTelemetry, 8000);

  async function promptInitiateSweep() {
    if (window.retroAudio) retroAudio.playClick();
    const modeAssets = document.getElementById('sweepModeAssets');
    const mode = (modeAssets && modeAssets.checked) ? 'assets' : 'full';
    const modeLabel = mode === 'assets' ? 'ASSET DELTA SWEEP (CSS/JS)' : 'FULL 11TY STATIC REBUILD';

    const targetQa = document.getElementById('sweepTargetQa');
    const target = (targetQa && targetQa.checked) ? 'qa' : 'all';
    const targetLabel = target === 'qa' ? 'QA FLEET ONLY (@qa.neogram.club)' : 'ALL CYBERSPACE STATIONS';

    const confirmMsg = `WARNING: Initiate cyberspace deployment sweep?\n\nTarget: ${targetLabel}\nMode: ${modeLabel}\nPacing: 3,500ms delay between hosts (flood-safe).\n\nType 'SWEEP' below to confirm:`;
    const response = prompt(confirmMsg);
    if (!response || response.trim().toUpperCase() !== 'SWEEP') {
      if (response !== null) alert('Fleet sweep confirmation rejected: text did not match SWEEP.');
      return;
    }

    try {
      const res = await fetch('/api/admin/pipeline/sweep', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-neogram-sysop-op': '1',
        },
        body: JSON.stringify({ mode, target, throttleDelayMs: 3500 }),
      });

      const data = await res.json();
      if (!res.ok || !data.ok) {
        alert(data.error || 'Failed to initiate fleet sweep.');
        return;
      }

      if (window.retroAudio) retroAudio.playSuccess();
      alert(`[:> FLEET SWEEP DISPATCHED]\n\n${data.message}`);
      pollPipelineTelemetry();
    } catch (err) {
      alert('Network transmission failed: ' + err.message);
    }
  }

  async function cancelFleetSweep() {
    if (window.retroAudio) retroAudio.playClick();
    if (!confirm('Are you sure you want to ABORT the active cyberspace fleet sweep? Pending station jobs will be cancelled.')) {
      return;
    }

    try {
      const res = await fetch('/api/admin/pipeline/sweep/cancel', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-neogram-sysop-op': '1',
        },
        body: JSON.stringify({}),
      });

      const data = await res.json();
      if (!res.ok || !data.ok) {
        alert(data.error || 'Failed to cancel fleet sweep.');
        return;
      }

      alert(`[:> SWEEP CANCELLED]\n\n${data.message}`);
      pollPipelineTelemetry();
    } catch (err) {
      alert('Network transmission failed: ' + err.message);
    }
  }

  function promptSoftBanUser(userId, handle) {
    if (window.retroAudio) retroAudio.playClick();
    document.getElementById('banTargetUserId').value = userId;
    document.getElementById('banModalHandle').textContent = '@' + handle;
    document.getElementById('banReasonInput').value = 'Violated terms of service';
    document.getElementById('banModalBackdrop').classList.remove('hidden');
    document.getElementById('banReasonInput').focus();
  }

  function closeBanModal() {
    document.getElementById('banModalBackdrop').classList.add('hidden');
  }

  async function confirmSoftBan() {
    const userId = document.getElementById('banTargetUserId').value;
    const reason = document.getElementById('banReasonInput').value.trim() || 'Violated terms of service';
    const btn = document.getElementById('btnConfirmBan');

    btn.disabled = true;
    btn.textContent = 'Suspending...';

    try {
      const res = await fetch(`/api/admin/users/${userId}/ban`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-neogram-sysop-op': '1',
        },
        body: JSON.stringify({ reason }),
      });

      const data = await res.json();
      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Failed to soft-ban user.');
      }

      closeBanModal();
      location.reload();
    } catch (err) {
      window.alert('[:> MODERATION ERROR] ' + err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Confirm Soft Ban';
    }
  }

  async function reinstateUser(userId, handle) {
    if (!window.confirm(`Reinstate station node @${handle}? This will re-enable their login and social features.`)) {
      return;
    }

    try {
      if (window.retroAudio) retroAudio.playClick();
      const res = await fetch(`/api/admin/users/${userId}/unban`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-neogram-sysop-op': '1',
        },
      });

      const data = await res.json();
      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Failed to reinstate user.');
      }

      location.reload();
    } catch (err) {
      window.alert('[:> MODERATION ERROR] ' + err.message);
    }
  }

  function setNodeFilter(filter, btn) {
    currentActiveFilter = filter;
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('pixel-btn--active'));
    btn.classList.add('pixel-btn--active');
    filterNodesTable();
  }

  function filterNodesTable() {
    const query = document.getElementById('nodeSearchInput').value.toLowerCase().trim();
    const rows = document.querySelectorAll('.node-row');

    rows.forEach(row => {
      const handle = row.dataset.handle || '';
      const email = row.dataset.email || '';
      const uin = row.dataset.uin || '';
      const isBanned = row.dataset.banned === 'true';

      const matchesQuery = !query || handle.includes(query) || email.includes(query) || uin.includes(query);

      let matchesStatus = true;
      if (currentActiveFilter === 'active') {
        matchesStatus = !isBanned;
      } else if (currentActiveFilter === 'banned') {
        matchesStatus = isBanned;
      }

      if (matchesQuery && matchesStatus) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  async function provisionQaFleet(mode) {
    try {
      if (window.retroAudio) retroAudio.playClick();
      const res = await fetch('/api/admin/qa-fleet/provision', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-neogram-sysop-op': '1',
        },
        body: JSON.stringify({ mode }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Failed to provision QA fleet.');
      }
      location.reload();
    } catch (err) {
      window.alert('[:> QA FLEET ERROR] ' + err.message);
    }
  }

  function openQaSiteModalFromDataset(btn) {
    const d = btn.dataset;
    openQaSiteModal(
      d.userId,
      d.handle,
      d.siteId,
      d.siteName,
      d.siteSlug,
      d.deployType,
      d.siteUrl,
      d.deployPath,
      d.buildHtml === 'true',
      d.autoDeploy === 'true'
    );
  }

  function openQaSiteModal(userId, handle, siteId, name, slug, deployType, siteUrl, deployPath, buildHtml, autoDeploy) {
    if (window.retroAudio) retroAudio.playClick();
    document.getElementById('qaModalUserId').value = userId;
    document.getElementById('qaModalSiteId').value = siteId || '';
    document.getElementById('qaSiteModalTitle').textContent = siteId
      ? `[:> EDIT SITE & API KEY FOR @${handle.toUpperCase()}]`
      : `[:> ADD NEW SITE FOR @${handle.toUpperCase()}]`;
    document.getElementById('qaModalSiteName').value = name || `${handle} Site`;
    document.getElementById('qaModalSiteSlug').value = slug || 'main';
    document.getElementById('qaModalDeployType').value = deployType || 'neocities';
    document.getElementById('qaModalSiteUrl').value = siteUrl || `https://${handle}.neocities.org`;
    document.getElementById('qaModalDeployPath').value = deployPath !== undefined ? deployPath : 'neogram';
    document.getElementById('qaModalApiKey').value = '';
    document.getElementById('qaModalBuildHtml').checked = buildHtml !== false;
    document.getElementById('qaModalAutoDeploy').checked = autoDeploy !== false;
    document.getElementById('qaSiteModalBackdrop').classList.remove('hidden');
    document.getElementById('qaModalApiKey').focus();
  }

  function closeQaSiteModal() {
    document.getElementById('qaSiteModalBackdrop').classList.add('hidden');
  }

  async function saveQaSiteConfig(e) {
    e.preventDefault();
    const userId = document.getElementById('qaModalUserId').value;
    const siteId = document.getElementById('qaModalSiteId').value;
    const btn = document.getElementById('btnSaveQaSite');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    try {
      const res = await fetch(`/api/admin/qa-fleet/${userId}/sites`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-neogram-sysop-op': '1',
        },
        body: JSON.stringify({
          siteId: siteId || undefined,
          name: document.getElementById('qaModalSiteName').value.trim(),
          slug: document.getElementById('qaModalSiteSlug').value.trim(),
          deploymentType: document.getElementById('qaModalDeployType').value,
          siteUrl: document.getElementById('qaModalSiteUrl').value.trim(),
          deployPath: document.getElementById('qaModalDeployPath').value.trim(),
          apiKey: document.getElementById('qaModalApiKey').value.trim(),
          buildHtml: document.getElementById('qaModalBuildHtml').checked,
          autoDeploy: document.getElementById('qaModalAutoDeploy').checked,
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Failed to save QA site settings.');
      }
      closeQaSiteModal();
      location.reload();
    } catch (err) {
      window.alert('[:> QA SITE CONFIG ERROR] ' + err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Save Site & Encrypt Key';
    }
  }

  let isPurgingQaPosts = false;
  async function purgeQaPosts(btn) {
    if (isPurgingQaPosts) return;
    if (!btn) btn = document.getElementById('btnPurgeQaPosts');

    if (btn && !btn.dataset.confirmed) {
      if (window.retroAudio) retroAudio.playClick();
      btn.dataset.confirmed = 'true';
      btn.innerHTML = '<span style="color:#ffcc00;font-weight:bold;">⚠️ Click again to confirm QA Purge</span>';
      setTimeout(() => {
        if (btn && btn.dataset.confirmed === 'true') {
          delete btn.dataset.confirmed;
          btn.innerHTML = '<span>Purge QA Test Posts</span>';
        }
      }, 5000);
      return;
    }

    isPurgingQaPosts = true;
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span>⏳ Purging QA Test Posts...</span>';
    }

    try {
      if (window.retroAudio) retroAudio.playClick();
      const res = await fetch('/api/admin/qa-fleet/purge-posts', {
        method: 'POST',
        headers: { 'x-neogram-sysop-op': '1' },
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to purge QA posts.');

      if (btn) {
        btn.innerHTML = '<span style="color:#00ff66;font-weight:bold;">✓ ' + (data.message || 'Purged successfully!') + '</span>';
      }
      setTimeout(() => {
        location.reload();
      }, 1500);
    } catch (err) {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<span style="color:#ff3333;font-weight:bold;">[:> ERROR] ' + err.message + '</span>';
        setTimeout(() => {
          btn.innerHTML = '<span>Purge QA Test Posts</span>';
        }, 4000);
      } else {
        window.alert('[:> ERROR] ' + err.message);
      }
    } finally {
      isPurgingQaPosts = false;
    }
  }

  let isWipingQaFleet = false;
  async function wipeQaFleet(btn) {
    if (isWipingQaFleet) return;
    if (!btn) btn = document.getElementById('btnWipeQaFleet');

    if (btn && !btn.dataset.confirmed) {
      if (window.retroAudio) retroAudio.playClick();
      btn.dataset.confirmed = 'true';
      btn.innerHTML = '<span style="color:#ffcc00;font-weight:bold;">⚠️ Click again to confirm Wipe</span>';
      setTimeout(() => {
        if (btn && btn.dataset.confirmed === 'true') {
          delete btn.dataset.confirmed;
          btn.innerHTML = '<span>Wipe QA Fleet</span>';
        }
      }, 5000);
      return;
    }

    isWipingQaFleet = true;
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span>⏳ Wiping QA Fleet...</span>';
    }

    try {
      if (window.retroAudio) retroAudio.playClick();
      const res = await fetch('/api/admin/qa-fleet/wipe', {
        method: 'POST',
        headers: { 'x-neogram-sysop-op': '1' },
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to wipe QA fleet.');

      if (btn) {
        btn.innerHTML = '<span style="color:#00ff66;font-weight:bold;">✓ QA Fleet Wiped!</span>';
      }
      setTimeout(() => {
        location.reload();
      }, 1500);
    } catch (err) {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<span style="color:#ff3333;font-weight:bold;">[:> ERROR] ' + err.message + '</span>';
        setTimeout(() => {
          btn.innerHTML = '<span>Wipe QA Fleet</span>';
        }, 4000);
      } else {
        window.alert('[:> ERROR] ' + err.message);
      }
    } finally {
      isWipingQaFleet = false;
    }
  }
</script>
{% endblock %}
