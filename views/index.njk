  async function handleDeleteSite(siteId, siteName, btn) {
    if (btn) {
      if (btn.getAttribute('data-confirming') === 'true') {
        clearTimeout(btn._confirmTimer);
        btn.removeAttribute('data-confirming');
        btn.innerHTML = '<span>Deleting...</span>';
      } else {
        btn.setAttribute('data-confirming', 'true');
        btn.innerHTML = '<span>Confirm?</span>';
        btn.classList.add('animate-pulse');
        btn._confirmTimer = setTimeout(function() {
          btn.removeAttribute('data-confirming');
          btn.innerHTML = '<span>Delete</span>';
          btn.classList.remove('animate-pulse');
        }, 4000);
        if (window.retroAudio) window.retroAudio.playClick();
        return;
      }
    } else {
      if (!confirm('Are you sure you want to unmount and delete site target "' + siteName + '"? Photos published to this site will be removed.')) return;
