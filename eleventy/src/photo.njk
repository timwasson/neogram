---
pagination:
  data: posts
  size: 1
  alias: post
permalink: "photos/{{ post.id }}/index.html"
layout: "layouts/base.njk"
eleventyComputed:
  title: "Photo by @{{ post.author }}"
---

<!-- Back Link to Static Gallery Grid -->
<div class="mb-4">
  <a href="{{ '/' | url }}" class="pixel-btn pixel-btn--yellow text-xs font-bold py-1.5 px-3 inline-flex items-center gap-2">
    <span>← BACK TO PHOTO GALLERY GRID</span>
  </a>
</div>

<div class="pixel-box bg-window mb-6">
  <div class="window-header flex items-center justify-between text-xs">
    <div class="flex items-center gap-2">
      <span>💾</span>
      <span class="font-bold">[:&gt; {{ post.id }}.bitmap]</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-prompt uppercase font-bold">SHADER: {{ post.filterApplied or 'RAW' }}</span>
      <span class="text-xs text-muted">100% BITMAP</span>
    </div>
  </div>

  <div class="p-5">
    <div class="flex flex-col lg:flex-row gap-6">

      <!-- LEFT: Full Resolution Photo Viewport -->
      <div class="lg:w-7/12 flex flex-col gap-3">
        <div class="bg-black p-1 min-h-[380px] flex items-center justify-center relative overflow-hidden crt-scanlines border-2 border-main">
          <img
            src="{{ post.imagePath }}"
            alt="{{ post.caption }}"
            class="max-h-[500px] max-w-full object-contain filter-{{ post.filterApplied or 'none' }}"
          />
        </div>

        <!-- Tag row -->
        <div class="flex flex-wrap gap-2 text-xs">
          {% if post.mood %}
            <span class="pixel-badge pixel-badge--cyan font-bold">{{ post.mood }}</span>
          {% endif %}
          {% if post.webring %}
            <span class="pixel-badge pixel-badge--magenta font-bold">ring: {{ post.webring }}</span>
          {% endif %}
          {% if post.location %}
            <span class="pixel-badge pixel-badge--amber font-bold">loc: {{ post.location }}</span>
          {% endif %}
        </div>
      </div>

      <!-- RIGHT: Metadata & Centralized Comment Ledger -->
      <div class="lg:w-5/12 flex flex-col gap-4">
        <!-- Author & Caption -->
        <div class="border-b-2 border-main pb-3">
          <div class="flex items-center justify-between text-xs font-bold mb-1">
            <span class="text-prompt text-sm">@{{ post.author }}</span>
            <span class="text-muted text-xs">{{ post.createdAt | formatDate }}</span>
          </div>
          <p class="text-xs sm:text-sm leading-relaxed mt-2 text-main">
            {{ post.caption }}
          </p>
        </div>

        <!-- Reactions Bar -->
        <div class="flex items-center gap-2 flex-wrap">
          <button
            type="button"
            id="likeBtn"
            onclick="handleLikePost('{{ post.id }}')"
            class="pixel-btn text-xs py-1.5 px-3 font-bold"
          >
            <span>❤️ LIKE (<span id="likeCount">{{ post.likes or 0 }}</span>)</span>
          </button>

          <button
            type="button"
            onclick="handleRadicalPost()"
            class="pixel-btn text-xs py-1.5 px-3 font-bold"
          >
            <span>⚡ RADICAL</span>
          </button>

          <button
            type="button"
            onclick="handleBookmarkPost()"
            class="pixel-btn text-xs py-1.5 px-3 font-bold"
          >
            <span>💾 BOOKMARK</span>
          </button>
        </div>

        <!-- Centralized Comments Ledger -->
        <div class="flex-1 flex flex-col mt-2">
          <div class="window-header flex items-center justify-between text-xs px-2 py-1">
            <span class="font-bold">💬 COMMENT LEDGER (<span id="commentCount">{{ post.comments.length or 0 }}</span>)</span>
            <span class="text-prompt text-xs">LIVE SYNC</span>
          </div>

          <!-- Comments Scroll Container -->
          <div id="commentsLedger" class="bg-black/20 border-2 border-main p-3 space-y-2.5 max-h-60 overflow-y-auto text-xs font-mono">
            {% if not post.comments or post.comments.length == 0 %}
              <div id="emptyCommentsNotice" class="text-muted italic py-3 text-center text-xs">
                [:&gt; No visitor comments recorded on static ledger yet. Be the first to leave your mark.]
              </div>
            {% else %}
              {% for comment in post.comments %}
                <div class="border-b border-main/30 pb-2">
                  <div class="flex items-center justify-between text-xs font-bold text-prompt">
                    <span>{{ comment.avatar or '💬' }} @{{ comment.author }}</span>
                    <span class="text-muted text-xs">{{ comment.timestamp | formatDate }}</span>
                  </div>
                  <p class="mt-1 text-xs text-main">{{ comment.text }}</p>
                </div>
              {% endfor %}
            {% endif %}
          </div>

          <!-- Add Comment Form (Posts to Neogram Backend) -->
          <form id="commentForm" onsubmit="handleStaticCommentSubmit(event, '{{ post.id }}')" class="mt-3 flex flex-col gap-2">
            <div class="flex gap-2">
              <input
                type="text"
                id="commentAuthor"
                placeholder="Visitor Handle"
                value="visitor_surfer"
                required
                class="retro-input text-xs w-1/3"
              />
              <input
                type="text"
                id="commentText"
                placeholder="Write a comment..."
                required
                class="retro-input text-xs flex-1"
              />
            </div>
            <button
              type="submit"
              id="commentSubmitBtn"
              class="pixel-btn pixel-btn--green text-xs font-bold py-1.5"
            >
              <span>COMMIT COMMENT TO LEDGER :&gt;</span>
            </button>
          </form>
        </div>

      </div>

    </div>
  </div>
</div>

<script>
  var API_BASE = '{{ site.apiUrl or "http://localhost:4000" }}';

  function handleLikePost(postId) {
    if (window.retroAudio) window.retroAudio.playClick();
    fetch(API_BASE + '/api/posts/' + postId + '/like', { method: 'POST' })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.ok) {
          var el = document.getElementById('likeCount');
          if (el) el.textContent = data.likes;
          if (window.retroAudio) window.retroAudio.playSuccess();
        }
      })
      .catch(function(err) {
        console.error('Like error:', err);
      });
  }

  function handleRadicalPost() {
    if (window.retroAudio) window.retroAudio.playSuccess();
    alert('[:> RADICAL! Reaction broadcasted.]');
  }

  function handleBookmarkPost() {
    if (window.retroAudio) window.retroAudio.playClick();
    alert('[:> Photograph bookmarked to your local cache.]');
  }

  function handleStaticCommentSubmit(e, postId) {
    e.preventDefault();
    var authorInput = document.getElementById('commentAuthor');
    var textInput = document.getElementById('commentText');
    var submitBtn = document.getElementById('commentSubmitBtn');

    var author = authorInput.value.trim();
    var text = textInput.value.trim();
    if (!text) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'TRANSMITTING...';
    if (window.retroAudio) window.retroAudio.playClick();

    fetch(API_BASE + '/api/posts/' + postId + '/comments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ author: author, text: text })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'COMMIT COMMENT TO LEDGER :>';

      if (data.ok && data.comment) {
        textInput.value = '';
        var emptyNotice = document.getElementById('emptyCommentsNotice');
        if (emptyNotice) emptyNotice.remove();

        var ledger = document.getElementById('commentsLedger');
        var item = document.createElement('div');
        item.className = 'border-b border-main/30 pb-2';
        item.innerHTML = 
          '<div class="flex items-center justify-between text-xs font-bold text-prompt">' +
          '  <span>💬 @' + (data.comment.author || author) + '</span>' +
          '  <span class="text-muted text-xs">Just now</span>' +
          '</div>' +
          '<p class="mt-1 text-xs text-main">' + (data.comment.text || text) + '</p>';
        ledger.appendChild(item);
        ledger.scrollTop = ledger.scrollHeight;

        var countEl = document.getElementById('commentCount');
        if (countEl) countEl.textContent = parseInt(countEl.textContent || '0', 10) + 1;

        if (window.retroAudio) window.retroAudio.playSuccess();
      } else {
        alert('Comment could not be posted: ' + (data.error || 'Server error'));
      }
    })
    .catch(function(err) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'COMMIT COMMENT TO LEDGER :>';
      alert('Network error while committing comment.');
    });
  }
</script>
