  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function sanitizeUrl(url) {
    if (!url) return '';
    var clean = String(url).trim();
    if (/^https?:\/\//i.test(clean)) {
      return clean;
    }
    return '';
  }

  async function loadGuestbookEntries() {
    var container = document.getElementById('gbSignaturesList');
    var badge = document.getElementById('gbCountBadge');
    if (!container) return;

    try {
      var slugPart = currentEmbedSiteSlug ? ('/' + encodeURIComponent(currentEmbedSiteSlug)) : '';
      var res = await fetch('/api/guestbook/' + userHandle + slugPart);
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to fetch');

      if (badge) badge.textContent = data.entries.length + ' SIGNATURES';

      var gbAllowAnonInput = document.getElementById('gbAllowAnonInput');
      if (gbAllowAnonInput && data.allowAnonymous !== undefined) {
        gbAllowAnonInput.checked = !!data.allowAnonymous;
      }

      if (data.entries.length === 0) {
        container.innerHTML = '<div class="text-center py-4 text-xs text-muted">:&gt; No signatures recorded yet. Share your guestbook link!</div>';
        return;
      }

      var html = '';
      data.entries.forEach(function(entry) {
        var safeUrl = sanitizeUrl(entry.visitorWebsite);
        var site = safeUrl ? '<div class="text-xs"><a href="' + escapeHtml(safeUrl) + '" target="_blank" rel="noopener noreferrer" class="text-mac underline">' + escapeHtml(safeUrl) + ' ↗</a></div>' : '';
        var authorHtml = '';
        if (entry.isAnonymous) {
          authorHtml = '<span class="font-bold">' + escapeHtml(entry.visitorName) + '</span> <span class="text-muted text-3xs">[Guest]</span>';
        } else {
          var uinBadge = entry.uin ? ' <span class="text-muted font-normal text-3xs">[#' + entry.uin + ']</span>' : '';
          authorHtml = '<a href="/user/@' + encodeURIComponent(entry.visitorName) + '" target="_blank" class="font-bold text-mac hover:underline">@' + escapeHtml(entry.visitorName) + '</a>' + uinBadge;
        }

        var visitorBadge = entry.visitorNumber ? ' <span class="text-prompt font-bold text-3xs">[Visitor #' + entry.visitorNumber + ']</span>' : '';

        var metaParts = [];
        if (entry.visitorLocation && entry.visitorLocation !== 'Cyberspace') metaParts.push(escapeHtml(entry.visitorLocation));
        var metaStr = metaParts.length ? (' <span class="text-muted text-3xs">(' + metaParts.join(', ') + ')</span>') : '';

        html += '<div class="retro-card p-2 flex flex-col gap-1 text-xs border border-main">' +
          '<div class="flex items-center justify-between border-b border-main pb-1">' +
            '<div class="flex items-center gap-1.5 flex-wrap">' +
              authorHtml +
              visitorBadge +
              metaStr +
            '</div>' +
            '<button type="button" onclick="deleteGuestbookEntry(\'' + escapeHtml(entry.id) + '\', this)" class="text-crimson font-bold text-xs hover:underline" title="Delete signature">[Delete]</button>' +
          '</div>' + site +
          '<div class="whitespace-pre-wrap p-1 text-xs font-mono bg-window">"' + escapeHtml(entry.message) + '"</div>' +
        '</div>';
      });

      container.innerHTML = html;
    } catch (e) {
      container.innerHTML = '<div class="text-center py-4 text-xs text-crimson">Failed to load signatures: ' + escapeHtml(e.message) + '</div>';
    }
  }

  async function deleteGuestbookEntry(id, btn) {
    if (btn) {
      if (btn.getAttribute('data-confirming') === 'true') {
        clearTimeout(btn._confirmTimer);
        btn.removeAttribute('data-confirming');
        btn.textContent = '[Deleting...]';
      } else {
        btn.setAttribute('data-confirming', 'true');
        btn.textContent = '[Confirm Delete?]';
        btn._confirmTimer = setTimeout(function() {
          btn.removeAttribute('data-confirming');
          btn.textContent = '[Delete]';
        }, 4000);
        if (window.retroAudio) window.retroAudio.playClick();
        return;
      }
    } else {
      if (!confirm('Delete this visitor signature from your ledger?')) return;
    }
    if (window.retroAudio) window.retroAudio.playClick();

    try {
      var res = await fetch('/api/guestbook/' + id, { method: 'DELETE' });
