<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/neogram.css">
    <link rel="stylesheet" href="/embed/neogram-embed.css">
    <script src="/js/retroAudio.js?v=2.2.0"></script>
  </head>
  <body class="p-4 bg-desktop">
    <div class="neogram-guestbook max-w-2xl mx-auto">
      <div class="neogram-guestbook__header flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span>✍️</span>
          <span>guestbook_daemon.cgi — @{{ handle }}'s VISITOR LEDGER</span>
        </div>
        <span class="text-xs font-mono font-normal">[{{ entries.length }} Signatures]</span>
      </div>

      <p class="text-xs font-mono text-muted mb-4">
        :&gt; Leave a note on this retro station! Signatures are logged directly to the visitor ledger.
      </p>

      <!-- State A: Signature Form (when Cyber-Pass is active) -->
      <form id="guestbookForm" class="retro-card p-3 mb-6 flex flex-col gap-3 font-mono text-xs hidden">
        <div class="flex items-center justify-between text-xs font-mono p-1 border border-main bg-window">
          <div class="flex items-center gap-1">
            <span>⚡ IDENTIFIED CALLSIGN:</span>
            <span id="gbAuthHandle" class="font-bold text-mac">@visitor</span>
            <span id="gbAuthUin" class="text-muted font-normal">[#000000]</span>
          </div>
          <button type="button" onclick="disconnectGbPass()" class="text-muted text-xs hover:underline" title="Disconnect pass">[Disconnect ✕]</button>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <div class="flex-1 flex flex-col gap-1">
            <label for="gbWebsite" class="font-bold">HOMEPAGE URL:</label>
            <input type="text" id="gbWebsite" name="visitorWebsite" placeholder="https://..." class="p-2 border-2 border-main font-mono text-xs" />
          </div>
          <div class="flex-1 flex flex-col gap-1">
            <label for="gbLocation" class="font-bold">LOCATION / BBS NODE:</label>
            <input type="text" id="gbLocation" name="visitorLocation" placeholder="Node #313 // Cyberspace" class="p-2 border-2 border-main font-mono text-xs" />
          </div>
          <div class="w-full sm:w-40 flex flex-col gap-1">
            <label for="gbMood" class="font-bold">MOOD:</label>
            <select id="gbMood" name="moodIcon" class="p-2 border-2 border-main font-mono text-xs cursor-pointer">
              <option value="😎">😎 Radical</option>
              <option value="💾">💾 Techie</option>
              <option value="🕹️">🕹️ Gamer</option>
              <option value="✨">✨ Surfer</option>
              <option value="👾">👾 Cyber</option>
            </select>
          </div>
        </div>

        <div class="flex flex-col gap-1">
          <label for="gbMessage" class="font-bold">MESSAGE / GREETS: *</label>
          <textarea id="gbMessage" name="message" rows="3" required placeholder="Great photos and aesthetic! Greetings from the dial-up web..." class="p-2 border-2 border-main font-mono text-xs"></textarea>
        </div>

        <div class="flex items-center justify-between pt-1">
          <span class="text-xs text-muted">* Written to self-hosted JSON ledger</span>
          <button type="submit" id="gbSubmitBtn" class="pixel-btn pixel-btn--blue font-bold px-4 py-2">
            <span>✍️ Sign Guestbook</span>
          </button>
        </div>

        <div id="gbStatusMsg" class="hidden text-xs font-mono font-bold p-2 retro-alert retro-alert--success"></div>
      </form>

      <!-- State B: Unauthenticated Lock Banner -->
      <div id="gbPassPrompt" class="p-3 border-2 border-dashed border-main text-center bg-window mb-6">
        <div class="text-xs font-bold text-mac mb-1">🔒 NEOGRAM CYBER-PASS REQUIRED</div>
        <p class="text-xs text-muted mb-3">
          Visitors must identify via their Neogram station to sign this public visitor ledger.
        </p>
        <button
          type="button"
          onclick="openGbPassModal()"
          class="pixel-btn pixel-btn--yellow font-bold text-xs py-2 px-4"
        >
          <span>⚡ Connect Cyber-Pass / Login :&gt;</span>
        </button>
      </div>

      <!-- Ledger of Signatures -->
      <div class="flex flex-col gap-3 font-mono">
        <div class="flex items-center justify-between border-b-2 border-main pb-1 font-bold text-xs">
          <span>PUBLIC SIGNATURE ARCHIVE</span>
          <span class="text-xs font-normal text-muted">Latest signatures first</span>
        </div>

        <div id="signaturesList" class="flex flex-col gap-3">
          {% for entry in entries %}
            <div class="retro-card p-3 flex flex-col gap-2 text-xs">
              <div class="flex items-center justify-between border-b border-main pb-1">
                <div class="flex items-center gap-2">
                  <span class="text-base">{{ entry.moodIcon }}</span>
                  <span class="font-bold">{{ entry.visitorName }}</span>
                  <span class="text-muted text-xs">from {{ entry.visitorLocation }}</span>
                </div>
                <span class="text-xs text-muted">{{ entry.createdAt | formatDate }}</span>
              </div>

              {% if entry.visitorWebsite %}
                <div class="text-xs">
                  <a href="{{ entry.visitorWebsite }}" target="_blank" rel="noopener noreferrer" class="text-mac underline">
                    🌐 {{ entry.visitorWebsite }}
                  </a>
                </div>
              {% endif %}

              <p class="whitespace-pre-wrap p-2 border border-main text-xs font-mono bg-window">
                "{{ entry.message }}"
              </p>
            </div>
          {% else %}
            <div id="noEntriesMsg" class="text-center py-6 text-xs text-muted font-mono">
              :&gt; No entries logged yet. Be the first visitor to sign this guestbook!
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <script>
      (function() {
        function escapeHtml(str) {
          if (!str) return '';
          return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
        }

        function sanitizeUrl(url) {
          if (!url) return '';
          var clean = String(url).trim();
          if (/^https?:\/\//i.test(clean)) {
            return clean;
          }
          return '';
        }

        function getStoredPass() {
          try {
            var raw = localStorage.getItem('neogram_pass');
            return raw ? JSON.parse(raw) : null;
          } catch (_err) {
            return null;
          }
        }

        function renderGbAuthUI() {
          var pass = getStoredPass();
          var form = document.getElementById('guestbookForm');
          var prompt = document.getElementById('gbPassPrompt');
          var handleEl = document.getElementById('gbAuthHandle');
          var uinEl = document.getElementById('gbAuthUin');

          if (pass && pass.token) {
            if (form) form.classList.remove('hidden');
            if (prompt) prompt.classList.add('hidden');
            if (handleEl) handleEl.textContent = '@' + pass.handle;
            if (uinEl) uinEl.textContent = pass.uin ? '[#' + pass.uin + ']' : '';
          } else {
            if (form) form.classList.add('hidden');
            if (prompt) prompt.classList.remove('hidden');
          }
        }

        window.disconnectGbPass = function() {
          try {
            localStorage.removeItem('neogram_pass');
          } catch (_err) {}
          if (window.retroAudio) retroAudio.playClick();
          renderGbAuthUI();
        };

        window.openGbPassModal = function() {
          if (window.retroAudio) retroAudio.playClick();
          var origin = encodeURIComponent(window.location.origin);
          var popup = window.open(
            '/auth/connect?origin=' + origin,
            'neogram_auth',
            'width=440,height=480,menubar=no,toolbar=no,location=no,status=no'
          );
        };

        window.addEventListener('message', function(e) {
          if (e.data && (e.data.type === 'NEOGRAM_CYBER_PASS' || e.data.type === 'NEOGRAM_EXTENSION_PASS')) {
            try {
              localStorage.setItem('neogram_pass', JSON.stringify({
                token: e.data.token,
                handle: e.data.handle,
                uin: e.data.uin,
              }));
            } catch (_err) {}
            renderGbAuthUI();
            if (window.retroAudio) retroAudio.playSuccess();
          }
        });

        renderGbAuthUI();

        var form = document.getElementById('guestbookForm');
        var submitBtn = document.getElementById('gbSubmitBtn');
        var statusMsg = document.getElementById('gbStatusMsg');
        var list = document.getElementById('signaturesList');
        var noEntries = document.getElementById('noEntriesMsg');

        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          var pass = getStoredPass();
          if (!pass || !pass.token) {
            window.openGbPassModal();
            return;
          }

          if (window.retroAudio) retroAudio.playClick();

          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>⏳ Signing...</span>';
          statusMsg.classList.add('hidden');

          var payload = {
            visitorWebsite: document.getElementById('gbWebsite').value,
            visitorLocation: document.getElementById('gbLocation').value,
            moodIcon: document.getElementById('gbMood').value,
            message: document.getElementById('gbMessage').value,
          };

          try {
            var res = await fetch('/api/guestbook/{{ handle }}', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': 'Bearer ' + pass.token
              },
              body: JSON.stringify(payload),
            });

            var data = await res.json();
            if (!res.ok || !data.ok) {
              throw new Error(data.error || 'Failed to submit signature');
            }

            if (window.retroAudio) retroAudio.playSuccess();

            statusMsg.textContent = '✓ Signature committed to self-hosted ledger on static host!';
            statusMsg.className = 'text-xs font-mono font-bold p-2 retro-alert retro-alert--success';
            statusMsg.classList.remove('hidden');

            document.getElementById('gbMessage').value = '';

            // Prepend new signature to list
            if (noEntries) noEntries.remove();
            var card = document.createElement('div');
            card.className = 'retro-card p-3 flex flex-col gap-2 text-xs';
            var safeUrl = sanitizeUrl(payload.visitorWebsite);
            var siteHtml = safeUrl ? '<div class="text-xs"><a href="' + escapeHtml(safeUrl) + '" target="_blank" rel="noopener noreferrer" class="text-mac underline">🌐 ' + escapeHtml(safeUrl) + '</a></div>' : '';
            var uinBadge = pass.uin ? ' <span class="text-muted font-normal">[#' + pass.uin + ']</span>' : '';
            card.innerHTML = 
              '<div class="flex items-center justify-between border-b border-main pb-1">' +
                '<div class="flex items-center gap-2">' +
                  '<span class="text-base">' + escapeHtml(payload.moodIcon || '😎') + '</span>' +
                  '<span class="font-bold">@' + escapeHtml(pass.handle) + '</span>' + uinBadge +
                  '<span class="text-muted text-xs">from ' + escapeHtml(payload.visitorLocation || 'Cyberspace') + '</span>' +
                '</div>' +
                '<span class="text-xs text-muted">Just now</span>' +
              '</div>' + siteHtml +
              '<p class="whitespace-pre-wrap p-2 border border-main text-xs font-mono bg-window">"' + escapeHtml(payload.message) + '"</p>';
            list.insertBefore(card, list.firstChild);

          } catch (err) {
            if (window.retroAudio) retroAudio.playError();
            statusMsg.textContent = 'ERROR: ' + err.message;
            statusMsg.className = 'text-xs font-mono font-bold p-2 retro-alert retro-alert--error';
            statusMsg.classList.remove('hidden');
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>✍️ Sign Guestbook</span>';
          }
        });
      })();
    </script>
  </body>
</html>
