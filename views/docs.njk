{% extends "layouts/base.njk" %}

{% block content %}
<div class="max-w-6xl mx-auto p-4 w-full font-mono">

  <!-- Top Breadcrumb & Station Link -->
  <div class="flex items-center justify-between mb-4 flex-wrap gap-2 text-xs">
    <div class="flex items-center gap-2 text-muted">
      <span class="text-prompt font-bold">:&gt; DOCS_CYBERSPACE.HLP</span>
      <span>/</span>
      <span>STATION_MANUAL_v2.0</span>
      {% if isAuthenticated %}
        <span class="pixel-badge pixel-badge--cyan text-xxs font-bold">NODE: #{{ stationUin }} (@{{ stationHandle }})</span>
      {% else %}
        <span class="pixel-badge text-xxs">GUEST_MODE</span>
      {% endif %}
    </div>
    <div class="flex items-center gap-2">
      <a href="/" class="pixel-btn pixel-btn--sm text-xs py-0.5 px-3" onclick="if(window.retroAudio) retroAudio.playClick();">
        <span>[ &lt; Return to Workstation ]</span>
      </a>
    </div>
  </div>

  <!-- Master Documentation Window Frame -->
  <div class="pixel-box mb-6">
    <!-- Window Header -->
    <div class="window-header flex items-center justify-between p-2">
      <div class="flex items-center gap-2">
        <span>📖</span>
        <span class="font-bold text-xs">[:&gt; NEOGRAM_DOCUMENTATION_CENTER.HLP — Station Manual &amp; Static Embed Specs]</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="pixel-badge pixel-badge--green text-xxs font-bold">ONLINE // CARRIER 33.6K</span>
      </div>
    </div>

    <!-- Pinstripes -->
    <div class="mac-pinstripes"></div>

    <div class="p-4 flex flex-col gap-5">

      <!-- Terminal Welcome Banner -->
      <div class="p-3 bg-black border border-main text-xs space-y-2">
        <div class="flex items-center justify-between text-muted text-[10px] uppercase font-bold tracking-wider">
          <span>STATIC PUBLISHING ENGINE &amp; SOCIAL WIDGET MANUAL</span>
          <span>REVISION: 2.0.4-PROD</span>
        </div>
        <p class="text-prompt leading-relaxed m-0">
          Welcome to the <strong>Neogram Cyberspace Documentation</strong>. Neogram bridges mobile-first photo publishing with 90s web nostalgia, enabling creators to snap photos, compile isolated static galleries, and embed interactive hit counters, visitor guestbooks, and comment ledgers onto personal static websites (Neocities, GitHub Pages, or self-hosted servers).
        </p>
        <div class="flex items-center gap-3 text-xxs text-muted pt-1 border-t border-main flex-wrap">
          <span>🔒 <strong>ZERO RETENTION:</strong> 0 MB local media storage</span>
          <span>🛡️ <strong>SAFE SUBDIRECTORIES:</strong> Non-destructive root protection</span>
          <span>🔢 <strong>PERMANENT ANCHOR:</strong> Immutable numeric UIN (#{{ stationUin }})</span>
        </div>
      </div>

      <!-- Main Layout: Sidebar Navigation & Content Pane -->
      <div class="docs-layout">

        <!-- LEFT COLUMN: Topic Navigation Menu -->
        <aside class="docs-sidebar">
          <div class="text-xs font-bold text-muted uppercase tracking-wider mb-1 flex items-center justify-between">
            <span>TOPIC INDEX:</span>
            <span class="text-xxs text-prompt">[SELECT TOPIC]</span>
          </div>

          <button
            type="button"
            id="tabBtn-neocities"
            class="docs-topic-btn {% if activeTopic == 'neocities' %}is-active{% endif %}"
            onclick="switchDocTopic('neocities')"
          >
            <span>🚀 Neocities Setup</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-counter"
            class="docs-topic-btn {% if activeTopic == 'counter' %}is-active{% endif %}"
            onclick="switchDocTopic('counter')"
          >
            <span>🔢 Dynamic Hit Counter</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-guestbook"
            class="docs-topic-btn {% if activeTopic == 'guestbook' %}is-active{% endif %}"
            onclick="switchDocTopic('guestbook')"
          >
            <span>✍️ Visitor Guestbook</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-feeds"
            class="docs-topic-btn {% if activeTopic == 'feeds' %}is-active{% endif %}"
            onclick="switchDocTopic('feeds')"
          >
            <span>📡 Feeds &amp; Comments</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-pipeline"
            class="docs-topic-btn {% if activeTopic == 'pipeline' %}is-active{% endif %}"
            onclick="switchDocTopic('pipeline')"
          >
            <span>⚙️ Publishing Pipeline</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-styling"
            class="docs-topic-btn {% if activeTopic == 'styling' %}is-active{% endif %}"
            onclick="switchDocTopic('styling')"
          >
            <span>🎨 BEM Theming &amp; CSS</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-chat"
            class="docs-topic-btn {% if activeTopic == 'chat' %}is-active{% endif %}"
            onclick="switchDocTopic('chat')"
          >
            <span>💬 NIM Chat &amp; Extension</span>
            <span class="text-xxs">›</span>
          </button>

          <!-- Raw Markdown Files Box -->
          <div class="mt-4 p-3 bg-window border border-main text-xs flex flex-col gap-2">
            <span class="font-bold text-xxs uppercase tracking-wider text-muted">DOCUMENTATION REPO FILES:</span>
            <div class="flex flex-col gap-1 text-xxs">
              <a href="/docs/neocities-setup.md" class="text-mac underline truncate">📄 neocities-setup.md</a>
              <a href="/docs/embeds.md" class="text-mac underline truncate">📄 embeds.md</a>
              <a href="/docs/publishing-pipeline.md" class="text-mac underline truncate">📄 publishing-pipeline.md</a>
              <a href="/docs/custom-styling.md" class="text-mac underline truncate">📄 custom-styling.md</a>
              <a href="/docs/buddylist-chat.md" class="text-mac underline truncate">📄 buddylist-chat.md</a>
            </div>
          </div>
        </aside>

        <!-- RIGHT COLUMN: Topic Content Panes -->
        <div class="docs-content">

          <!-- ========================================================= -->
          <!-- TOPIC 1: NEOCITIES SETUP GUIDE                            -->
          <!-- ========================================================= -->
          <section id="docSection-neocities" class="docs-section-pane flex flex-col gap-6 {% if activeTopic != 'neocities' %}hidden{% endif %}">
            
            <div class="border-b-2 border-main pb-2">
              <div class="flex items-center gap-2">
                <span class="text-xl">🚀</span>
                <h1 class="text-base font-bold text-prompt m-0 uppercase">Neocities Static Hosting &amp; Setup Guide</h1>
              </div>
              <p class="text-xs text-muted mt-1 m-0">
                Connect your personal Neocities site to enable automated publishing, isolated gallery compilation, and live media uploads.
              </p>
            </div>

            <!-- Flow Overview Box -->
            <div class="p-3 bg-black border border-main text-xs space-y-2">
              <div class="text-mac font-bold uppercase tracking-wider text-xxs">DATA FLOW PIPELINE</div>
              <div class="p-2 border border-muted bg-surface-sunken text-prompt font-mono text-xs overflow-x-auto leading-relaxed">
[Mobile / Workstation Photo] ──&gt; [Sharp WebP Transform] ──&gt; [Eleventy Build] ──&gt; [Neocities API Upload] ──&gt; [Local Purge: 0 MB]
              </div>
              <p class="text-muted text-xs m-0">
                Neogram never acts as a permanent media host. When you upload, photos are optimized, published directly to your Neocities account, and local files are immediately erased from the server.
              </p>
            </div>

            <!-- Step by Step Walkthrough -->
            <div class="flex flex-col gap-4">
              
              <!-- STEP 1 -->
              <div class="retro-card p-4 m-0 flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <span class="docs-step-badge">1</span>
                  <h3 class="font-bold text-xs uppercase text-prompt m-0">Obtain your Neocities API Key</h3>
                </div>
                <p class="text-xs leading-relaxed text-main m-0">
                  Log in to your account at <a href="https://neocities.org" target="_blank" rel="noopener noreferrer" class="text-mac underline font-bold">neocities.org</a>, then navigate to your site settings at <a href="https://neocities.org/settings#api_key" target="_blank" rel="noopener noreferrer" class="text-mac underline font-bold">neocities.org/settings#api_key</a>. Scroll down to the <strong>API Key</strong> section and copy your token string.
                </p>
                <div class="p-2 bg-window border border-main text-xxs text-muted font-mono">
                  KEY TOKEN EXAMPLE: <code>0123456789abcdef0123456789abcdef</code> (Keep this key private!)
                </div>
              </div>

              <!-- STEP 2 -->
              <div class="retro-card p-4 m-0 flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <span class="docs-step-badge">2</span>
                  <h3 class="font-bold text-xs uppercase text-prompt m-0">Configure Station Settings in Neogram</h3>
                </div>
                <p class="text-xs leading-relaxed text-main m-0">
                  In the top workstation navigation bar, click <strong>⚙ Settings</strong>. Scroll to the window titled <strong>[:&gt; CYBER_HOSTING.SYS — STATIC DEPLOY PIPELINE]</strong> and enter your hosting credentials:
                </p>
                <ul class="list-disc list-inside text-xs space-y-1 text-muted pl-2">
                  <li><strong>Hosting Provider:</strong> <code>Neocities API (Primary)</code></li>
                  <li><strong>Neocities API Key:</strong> Paste your API key token (encrypted in PostgreSQL with AES-256-GCM)</li>
                  <li><strong>Site Subdomain:</strong> Enter your Neocities subdomain (e.g. <code>{{ stationHandle }}</code>)</li>
                  <li><strong>Target Subfolder (`deploy_path`):</strong> <code>neogram</code> (Default safe subfolder)</li>
                  <li><strong>Auto-Deploy on Transmit:</strong> Check this box to push updates automatically whenever you post</li>
                </ul>
              </div>

              <!-- STEP 3 -->
              <div class="retro-card p-4 m-0 flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <span class="docs-step-badge">3</span>
                  <h3 class="font-bold text-xs uppercase text-prompt m-0">Safe Subdirectory Invariant (Root Protection)</h3>
                </div>
                <div class="docs-callout docs-callout--tip m-0">
                  <strong>ROOT SITE NON-DESTRUCTION GUARANTEE:</strong><br />
                  Neogram defaults to publishing under <code>/neogram/</code>. Your existing homepage (<code>index.html</code>), custom styling, blog posts, and fan listings on Neocities are <strong>never overwritten or modified</strong>.
                </div>
                <p class="text-xs text-muted m-0">
                  Your photo gallery will be live at: <a href="https://{{ stationHandle }}.neocities.org/neogram/" target="_blank" class="text-mac underline font-bold">https://{{ stationHandle }}.neocities.org/neogram/</a>
                </p>
              </div>

              <!-- STEP 4 -->
              <div class="retro-card p-4 m-0 flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <span class="docs-step-badge">4</span>
                  <h3 class="font-bold text-xs uppercase text-prompt m-0">Verify Connection &amp; Test</h3>
                </div>
                <p class="text-xs leading-relaxed text-main m-0">
                  Click the <strong>[ 🔌 Test Neocities Connection ]</strong> button. Neogram will ping the Neocities API and verify your site. Once confirmed, click <strong>[ 💾 SAVE HOSTING CONFIG ]</strong>.
                </p>
                <p class="text-xs leading-relaxed text-muted m-0">
                  Now, whenever you snap or upload a photo in the <strong>↑ Upload Studio</strong>, your photo will automatically be compiled and deployed live!
                </p>
              </div>

            </div>

            <!-- Future Providers Roadmap -->
            <div class="p-3 bg-window border border-main text-xs space-y-1">
              <span class="font-bold text-xxs uppercase tracking-wider text-muted">EXPANDING TO OTHER PROVIDERS (ROADMAP):</span>
              <p class="text-muted m-0">
                Neogram's modular static publisher architecture is designed to support <strong>GitHub Pages (Git PAT commits)</strong>, <strong>Nekoweb API</strong>, and universal <strong>SFTP / SSH</strong> in upcoming releases.
              </p>
            </div>

          </section>

          <!-- ========================================================= -->
          <!-- TOPIC 2: DYNAMIC WEB HIT COUNTER                          -->
          <!-- ========================================================= -->
          <section id="docSection-counter" class="docs-section-pane flex flex-col gap-6 {% if activeTopic != 'counter' %}hidden{% endif %}">
            
            <div class="border-b-2 border-main pb-2">
              <div class="flex items-center gap-2">
                <span class="text-xl">🔢</span>
                <h1 class="text-base font-bold text-prompt m-0 uppercase">Dynamic SVG Web Hit Counter</h1>
              </div>
              <p class="text-xs text-muted mt-1 m-0">
                A high-contrast, privacy-friendly dynamic SVG hit counter for your static site. Automatically increments visits without cookies or third-party ad trackers.
              </p>
            </div>

            <!-- Live SVG Preview Card -->
            <div class="retro-card p-4 m-0 flex flex-col gap-3">
              <div class="window-header flex items-center justify-between">
                <span>*** LIVE SVG HARDWARE PALETTE PREVIEW ***</span>
                <span class="text-xxs text-prompt">HTTP GET /counter/*.svg</span>
              </div>

              <div class="p-4 bg-black border-2 border-main flex flex-col items-center justify-center gap-3">
                <div class="p-3 border-2 border-main bg-black">
                  <img
                    id="docCounterPreviewImg"
                    src="{{ appUrl }}/counter/{{ stationHandle }}.svg?style=green_led"
                    alt="Neogram Live Hit Counter"
                    class="block"
                  />
                </div>
                <span id="docCounterUrlLabel" class="text-xxs font-mono text-muted break-all text-center">
                  {{ appUrl }}/counter/{{ stationHandle }}.svg?style=green_led
                </span>
              </div>

              <!-- Interactive Palette Switcher -->
              <div class="font-mono text-xs">
                <label class="block font-bold mb-1.5 uppercase text-xxs text-muted">SELECT HARDWARE PALETTE:</label>
                <div class="docs-palette-grid">
                  <button type="button" class="pixel-btn pixel-btn--yellow text-xs py-1" onclick="switchDocCounterStyle('green_led')">
                    🟢 Green Phosphor
                  </button>
                  <button type="button" class="pixel-btn text-xs py-1" onclick="switchDocCounterStyle('red_nixie')">
                    🔴 Red Nixie Tube
                  </button>
                  <button type="button" class="pixel-btn text-xs py-1" onclick="switchDocCounterStyle('odometer')">
                    ⚪ Mechanical B&amp;W
                  </button>
                  <button type="button" class="pixel-btn text-xs py-1" onclick="switchDocCounterStyle('blue_vfd')">
                    🔵 Cyan VFD Tube
                  </button>
                </div>
              </div>
            </div>

            <!-- Code Snippet Box 1: Standard HTML Image Tag -->
            <div class="docs-code-card">
              <div class="docs-code-header">
                <span class="font-bold text-prompt">HTML EMBED SNIPPET (BY CALL-SIGN HANDLE)</span>
                <button
                  type="button"
                  id="btnCopyCounterHandle"
                  class="pixel-btn pixel-btn--blue pixel-btn--sm text-xxs font-bold"
                  onclick="copyDocSnippet('btnCopyCounterHandle', 'codeCounterHandle')"
                >
                  📋 COPY CODE
                </button>
              </div>
              <pre class="docs-code-pre" id="codeCounterHandle">&lt;!-- Neogram Dynamic Web Hit Counter --&gt;
&lt;div class="neogram-counter"&gt;
  &lt;img 
    src="{{ appUrl }}/counter/{{ stationHandle }}.svg?style=green_led" 
    alt="You are visitor number" 
    loading="eager"
  /&gt;
&lt;/div&gt;</pre>
            </div>

            <!-- Code Snippet Box 2: Permanent UIN Anchor Tag -->
            <div class="docs-code-card">
              <div class="docs-code-header">
                <span class="font-bold text-prompt">PERMANENT UIN ANCHOR (IMMUTABLE NODE ID #{{ stationUin }})</span>
                <button
                  type="button"
                  id="btnCopyCounterUin"
                  class="pixel-btn pixel-btn--blue pixel-btn--sm text-xxs font-bold"
                  onclick="copyDocSnippet('btnCopyCounterUin', 'codeCounterUin')"
                >
                  📋 COPY CODE
                </button>
              </div>
              <pre class="docs-code-pre" id="codeCounterUin">&lt;!-- Immutable Numeric UIN Hit Counter (Never breaks if handle changes) --&gt;
&lt;div class="neogram-counter"&gt;
  &lt;img 
    src="{{ appUrl }}/counter/{{ stationUin }}.svg?style=green_led" 
    alt="Station Visitor Count" 
  /&gt;
&lt;/div&gt;</pre>
            </div>

            <!-- Code Snippet Box 3: Linked Profile Counter -->
            <div class="docs-code-card">
              <div class="docs-code-header">
                <span class="font-bold text-prompt">CLICKABLE BADGE LINKING TO STATION PROFILE</span>
                <button
                  type="button"
                  id="btnCopyCounterLink"
                  class="pixel-btn pixel-btn--blue pixel-btn--sm text-xxs font-bold"
                  onclick="copyDocSnippet('btnCopyCounterLink', 'codeCounterLink')"
                >
                  📋 COPY CODE
                </button>
              </div>
              <pre class="docs-code-pre" id="codeCounterLink">&lt;!-- Clickable Hit Counter linking to Cyberspace Station Profile --&gt;
&lt;a href="{{ appUrl }}/user/@{{ stationHandle }}" target="_blank" rel="noopener noreferrer" title="View Station Telemetry on Neogram"&gt;
  &lt;img src="{{ appUrl }}/counter/{{ stationHandle }}.svg?style=green_led" alt="Hit Counter" /&gt;
&lt;/a&gt;</pre>
            </div>

            <!-- Technical Invariants Callout -->
            <div class="docs-callout docs-callout--tip">
              <strong>NO CACHE INVARIANT:</strong> All counter SVGs return <code>Cache-Control: no-cache, no-store, must-revalidate</code> headers. Browsers and proxies will not cache stale hit counts.
            </div>

          </section>

          <!-- ========================================================= -->
          <!-- TOPIC 3: VISITOR GUESTBOOK LEDGER                         -->
          <!-- ========================================================= -->
          <section id="docSection-guestbook" class="docs-section-pane flex flex-col gap-6 {% if activeTopic != 'guestbook' %}hidden{% endif %}">
            
            <div class="border-b-2 border-main pb-2">
              <div class="flex items-center gap-2">
                <span class="text-xl">✍️</span>
                <h1 class="text-base font-bold text-prompt m-0 uppercase">Public Visitor Guestbook Ledger</h1>
              </div>
              <p class="text-xs text-muted mt-1 m-0">
                A public guestbook ledger with spam protection, mood icons, verified Neogram Cyber-Pass signatures, and self-hosted static JSON persistence.
              </p>
            </div>

            <div class="p-3 bg-black border border-main text-xs space-y-2">
              <div class="text-prompt font-bold uppercase tracking-wider text-xxs">SELF-HOSTED LEDGER SPECIFICATION</div>
              <p class="text-muted text-xs m-0">
                Guestbook entries are written directly to <code>data/guestbook.json</code> on your Neocities host! You retain 100% data ownership. You can inspect, approve, or delete signatures directly from the <strong>Embeds</strong> tab in your Station Workstation.
              </p>
            </div>

            <!-- Guestbook Iframe Code Snippet -->
            <div class="docs-code-card">
              <div class="docs-code-header">
                <span class="font-bold text-prompt">RESPONSIVE IFRAME EMBED (DROP-IN WIDGET)</span>
                <button
                  type="button"
                  id="btnCopyGbIframe"
                  class="pixel-btn pixel-btn--blue pixel-btn--sm text-xxs font-bold"
                  onclick="copyDocSnippet('btnCopyGbIframe', 'codeGbIframe')"
                >
                  📋 COPY CODE
                </button>
              </div>
              <pre class="docs-code-pre" id="codeGbIframe">&lt;!-- Neogram Public Visitor Guestbook Iframe --&gt;
&lt;iframe
  src="{{ appUrl }}/embed/guestbook/{{ stationHandle }}"
  width="100%"
  height="650"
  frameborder="0"
  style="border: 3px solid #000000; box-shadow: 4px 4px 0px 0px rgba(0,0,0,0.9); background: #161b22;"
  title="Public Visitor Guestbook"
&gt;&lt;/iframe&gt;</pre>
            </div>

            <!-- Direct Station Button Code -->
            <div class="docs-code-card">
              <div class="docs-code-header">
                <span class="font-bold text-prompt">STANDALONE RETRO LINK BUTTON</span>
                <button
                  type="button"
                  id="btnCopyGbBtn"
                  class="pixel-btn pixel-btn--blue pixel-btn--sm text-xxs font-bold"
                  onclick="copyDocSnippet('btnCopyGbBtn', 'codeGbBtn')"
                >
                  📋 COPY CODE
                </button>
              </div>
              <pre class="docs-code-pre" id="codeGbBtn">&lt;!-- Retro Button Linking to Live Guestbook --&gt;
&lt;a 
  href="{{ appUrl }}/embed/guestbook/{{ stationHandle }}" 
  target="_blank" 
  rel="noopener noreferrer"
  style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: #ffff00; color: #000000; font-family: monospace; font-weight: bold; font-size: 12px; border: 2px solid #000000; box-shadow: 2px 2px 0px 0px #000000; text-decoration: none;"
&gt;
  ✍️ Sign My Guestbook :&gt;
&lt;/a&gt;</pre>
            </div>

            <!-- Moderation & Spam Protection -->
            <div class="retro-card p-4 m-0 flex flex-col gap-2">
              <h3 class="font-bold text-xs uppercase text-prompt m-0">Moderation &amp; Spam Protection</h3>
              <p class="text-xs text-muted m-0">
                1. <strong>Rate Limiting:</strong> In-memory sliding window rate limits submissions to maximum 6 signatures per 5 minutes per IP address.<br />
                2. <strong>One-Click Owner Deletion:</strong> Open the <strong>Embeds</strong> tab in the Workstation. Under <strong>SIGNATURES ARCHIVE</strong>, click the <code>[ ✕ Delete ]</code> button next to any unwanted entry. It will be removed from your host's <code>guestbook.json</code> immediately.
              </p>
            </div>

          </section>

          <!-- ========================================================= -->
          <!-- TOPIC 4: FEEDS, COMMENTS & WIDGETS                        -->
          <!-- ========================================================= -->
          <section id="docSection-feeds" class="docs-section-pane flex flex-col gap-6 {% if activeTopic != 'feeds' %}hidden{% endif %}">
            
            <div class="border-b-2 border-main pb-2">
              <div class="flex items-center gap-2">
                <span class="text-xl">📡</span>
                <h1 class="text-base font-bold text-prompt m-0 uppercase">Headless Feeds, Comments &amp; Widgets</h1>
              </div>
              <p class="text-xs text-muted mt-1 m-0">
                Connect your static gallery to external static site generators, build custom client photo carousels, or embed zero-dependency widgets.
              </p>
            </div>

            <!-- Headless JSONFeed 1.1 -->
            <div class="retro-card p-4 m-0 flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-xs uppercase text-prompt m-0">JSONFeed 1.1 Specification</h3>
                <span class="pixel-badge pixel-badge--cyan text-xxs font-bold">STANDARDIZED API</span>
              </div>
              <p class="text-xs text-muted m-0">
                Neogram exposes a compliant JSONFeed at:
                <code class="text-prompt select-all">{{ appUrl }}/api/users/{{ stationHandle }}/feed.json</code>
              </p>
            </div>

            <!-- Vanilla JS Fetch Code Snippet -->
            <div class="docs-code-card">
              <div class="docs-code-header">
                <span class="font-bold text-prompt">VANILLA JAVASCRIPT PHOTO STREAM CONSUMER</span>
                <button
                  type="button"
                  id="btnCopyFeedFetch"
                  class="pixel-btn pixel-btn--blue pixel-btn--sm text-xxs font-bold"
                  onclick="copyDocSnippet('btnCopyFeedFetch', 'codeFeedFetch')"
                >
                  📋 COPY CODE
                </button>
              </div>
              <pre class="docs-code-pre" id="codeFeedFetch">&lt;!-- Container for recent photos --&gt;
&lt;div id="neogram-feed"&gt;Loading photos...&lt;/div&gt;

&lt;script&gt;
  (async function() {
    try {
      const res = await fetch('{{ appUrl }}/api/users/{{ stationHandle }}/feed.json');
      const data = await res.json();
      const el = document.getElementById('neogram-feed');
      if (!data.items || data.items.length === 0) {
        el.innerHTML = '&lt;p&gt;No transmissions yet.&lt;/p&gt;';
        return;
      }
      el.innerHTML = data.items.map(post =&gt; `
        &lt;div style="border: 2px solid #000; margin-bottom: 12px; padding: 8px; background: #fff;"&gt;
          &lt;img src="${post.thumbnailUrl}" alt="${post.caption}" style="max-width: 100%; display: block;" /&gt;
          &lt;p style="font-family: monospace; font-size: 11px; margin-top: 6px;"&gt;${post.caption}&lt;/p&gt;
        &lt;/div&gt;
      `).join('');
    } catch(err) {
      console.error(err);
    }
  })();
&lt;/script&gt;</pre>
