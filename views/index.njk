  async function handleUnfriendInWorkstation(handle, btn) {
    if (btn) {
      if (btn.getAttribute('data-confirming') === 'true') {
        clearTimeout(btn._confirmTimer);
        btn.removeAttribute('data-confirming');
        btn.innerHTML = '<span>Removing...</span>';
      } else {
        btn.setAttribute('data-confirming', 'true');
        btn.innerHTML = '<span>Confirm Remove?</span>';
        btn.classList.add('animate-pulse');
        btn._confirmTimer = setTimeout(function() {
          btn.removeAttribute('data-confirming');
          btn.innerHTML = '<span>Remove</span>';
          btn.classList.remove('animate-pulse');
        }, 4000);
        if (window.retroAudio) window.retroAudio.playClick();
        return;
      }
    } else {
      if (!confirm('Remove @' + handle + ' from your Friends Roster?')) return;
    }
    if (window.retroAudio) window.retroAudio.playClick();
    try {
      var res = await fetch('/api/users/' + encodeURIComponent(handle) + '/follow', { method: 'DELETE' });
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to remove friend.');
      var card = document.getElementById('friendCard-' + handle);
      if (card) card.remove();
      if (window.retroAudio) window.retroAudio.playSuccess();
    } catch (err) {
      if (window.retroAudio) window.retroAudio.playError();
      alert(err.message);
    }
  }
  window.handleUnfriendInWorkstation = handleUnfriendInWorkstation;

  function filterWorkstationDirectory() {
    var input = document.getElementById('directorySearchInput');
    var clearBtn = document.getElementById('directoryClearBtn');
    var statusText = document.getElementById('directorySearchResultText');
    var emptySearch = document.getElementById('directorySearchEmpty');
    if (!input) return;

    var q = (input.value || '').trim().toLowerCase();
    if (clearBtn) {
      if (q) clearBtn.classList.remove('hidden');
      else clearBtn.classList.add('hidden');
    }

    var cards = document.querySelectorAll('#networkSubPane-directory .directory-card');
    var totalMatched = 0;
    var activeVisible = 0;
    var awayVisible = 0;
    var inactiveVisible = 0;

    cards.forEach(function(card) {
      var h = card.getAttribute('data-handle') || '';
      var uin = card.getAttribute('data-uin') || '';
      var matches = !q || h.indexOf(q) !== -1 || uin.indexOf(q) !== -1 || ('@' + h).indexOf(q) !== -1 || ('#' + uin).indexOf(q) !== -1;
      if (matches) {
        card.classList.remove('hidden');
        totalMatched++;
        if (card.closest('#directoryGridActive')) activeVisible++;
        else if (card.closest('#directoryGridAway')) awayVisible++;
        else if (card.closest('#directoryGridInactive')) inactiveVisible++;
      } else {
        card.classList.add('hidden');
      }
    });

    var activeCountEl = document.getElementById('activeCount');
    var awayCountEl = document.getElementById('awayCount');
    var inactiveCountEl = document.getElementById('inactiveCount');
    if (activeCountEl) activeCountEl.textContent = String(activeVisible);
    if (awayCountEl) awayCountEl.textContent = String(awayVisible);
    if (inactiveCountEl) inactiveCountEl.textContent = String(inactiveVisible);

    if (statusText) {
      if (q) {
        statusText.textContent = 'FILTERED: ' + totalMatched + ' MATCHING NODE' + (totalMatched === 1 ? '' : 'S');
        statusText.classList.remove('hidden');
      } else {
        statusText.classList.add('hidden');
      }
    }

    if (emptySearch) {
      if (q && totalMatched === 0) emptySearch.classList.remove('hidden');
      else emptySearch.classList.add('hidden');
    }
  }
  window.filterWorkstationDirectory = filterWorkstationDirectory;

  function clearWorkstationDirectorySearch() {
    var input = document.getElementById('directorySearchInput');
    if (input) {
      input.value = '';
      filterWorkstationDirectory();
      input.focus();
    }
  }
  window.clearWorkstationDirectorySearch = clearWorkstationDirectorySearch;

  function executeDashboardTabSwitch(tab) {
    var rawTab = String(tab || 'upload');
    var parts = rawTab.split('/');
    var mainTab = parts[0];
    var subTab = parts[1] || null;

    if (mainTab === 'edit' || mainTab === 'posts') mainTab = 'manage';
    if (mainTab === 'network') mainTab = 'feed';
    if (mainTab === 'friends') { mainTab = 'feed'; subTab = 'friends'; }
    if (mainTab === 'directory') { mainTab = 'feed'; subTab = 'directory'; }

    var targetHash = mainTab === 'manage' ? 'edit' : mainTab;
    if (mainTab === 'feed' && subTab && subTab !== 'feed') {
      targetHash = 'network/' + subTab;
    } else if (mainTab === 'settings' && subTab && subTab !== 'profile') {
      targetHash = 'settings/' + subTab;
    } else if (mainTab === 'embeds' && subTab && subTab !== 'counter') {
      targetHash = 'embeds/' + subTab;
    }

    if (window.location.hash !== '#' + targetHash) {
      if (history.pushState) {
        history.pushState(null, '', '#' + targetHash);
      } else {
        window.location.hash = '#' + targetHash;
      }
    }

    var feedSec = document.getElementById('feedStudioSection');
    var uploadSec = document.getElementById('uploadStudioSection');
    var manageSec = document.getElementById('manageGallerySection');
    var settingsSec = document.getElementById('settingsSection');
    var embedsSec = document.getElementById('embedsSection');
    var feedBtn = document.getElementById('tabFeedBtn');
    var uploadBtn = document.getElementById('tabUploadBtn');
    var manageBtn = document.getElementById('tabManageBtn');
    var settingsBtn = document.getElementById('tabSettingsBtn');
    var embedsBtn = document.getElementById('tabEmbedsBtn');

    var mobileFeedBtn = document.getElementById('mobileTabFeedBtn');
    var mobileUploadBtn = document.getElementById('mobileTabUploadBtn');
    var mobileManageBtn = document.getElementById('mobileTabManageBtn');
    var mobileSettingsBtn = document.getElementById('mobileTabSettingsBtn');
    var mobileEmbedsBtn = document.getElementById('mobileTabEmbedsBtn');

    if (feedSec) feedSec.classList.add('hidden');
    if (uploadSec) uploadSec.classList.add('hidden');
    if (manageSec) manageSec.classList.add('hidden');
    if (settingsSec) settingsSec.classList.add('hidden');
    if (embedsSec) embedsSec.classList.add('hidden');

    if (feedBtn) feedBtn.classList.remove('pixel-btn--yellow');
    if (uploadBtn) uploadBtn.classList.remove('pixel-btn--yellow');
    if (manageBtn) manageBtn.classList.remove('pixel-btn--yellow');
    if (settingsBtn) settingsBtn.classList.remove('pixel-btn--yellow');
    if (embedsBtn) embedsBtn.classList.remove('pixel-btn--yellow');

    if (mobileFeedBtn) mobileFeedBtn.classList.remove('is-active');
    if (mobileUploadBtn) mobileUploadBtn.classList.remove('is-active');
    if (mobileManageBtn) mobileManageBtn.classList.remove('is-active');
    if (mobileSettingsBtn) mobileSettingsBtn.classList.remove('is-active');
    if (mobileEmbedsBtn) mobileEmbedsBtn.classList.remove('is-active');

    if (mainTab === 'feed') {
      if (feedSec) feedSec.classList.remove('hidden');
      if (feedBtn) feedBtn.classList.add('pixel-btn--yellow');
      if (mobileFeedBtn) mobileFeedBtn.classList.add('is-active');
      switchNetworkSubTab(subTab || currentNetworkSubTab || 'feed', true);
    } else if (mainTab === 'upload') {
      if (uploadSec) uploadSec.classList.remove('hidden');
      if (uploadBtn) uploadBtn.classList.add('pixel-btn--yellow');
      if (mobileUploadBtn) mobileUploadBtn.classList.add('is-active');
    } else if (mainTab === 'manage') {
      if (manageSec) manageSec.classList.remove('hidden');
      if (manageBtn) manageBtn.classList.add('pixel-btn--yellow');
      if (mobileManageBtn) mobileManageBtn.classList.add('is-active');
    } else if (mainTab === 'settings') {
      if (settingsSec) settingsSec.classList.remove('hidden');
      if (settingsBtn) settingsBtn.classList.add('pixel-btn--yellow');
      if (mobileSettingsBtn) mobileSettingsBtn.classList.add('is-active');
      switchSettingsSubTab(subTab || currentSettingsSubTab || 'profile', true);
      if (typeof loadSettings === 'function') loadSettings();
      if (typeof loadNotificationSettings === 'function') loadNotificationSettings();
    } else if (mainTab === 'embeds') {
      if (embedsSec) embedsSec.classList.remove('hidden');
      if (embedsBtn) embedsBtn.classList.add('pixel-btn--yellow');
      if (mobileEmbedsBtn) mobileEmbedsBtn.classList.add('is-active');
      switchEmbedsSubTab(subTab || currentEmbedsSubTab || 'counter', true);
      if (typeof loadEmbedsStudio === 'function') loadEmbedsStudio();
    }
  }

  // Handle URL hash on load & hash change
  function syncDashboardTabFromHash() {
    var hash = window.location.hash ? window.location.hash.replace('#', '') : '';
    if (!hash) {
      var defaultTab = {{ ('feed' if (not userSites or userSites.length == 0) else 'upload') | dump | safe }};
      executeDashboardTabSwitch(defaultTab);
      return;
    }
    if (
      hash === 'feed' ||
      hash === 'network' ||
      hash === 'friends' ||
      hash === 'directory' ||
      hash.indexOf('network/') === 0 ||
      hash === 'edit' ||
      hash === 'manage' ||
      hash === 'posts' ||
      hash === 'settings' ||
      hash.indexOf('settings/') === 0 ||
      hash === 'embeds' ||
      hash.indexOf('embeds/') === 0 ||
      hash === 'upload'
    ) {
      executeDashboardTabSwitch(hash);
    } else {
      var fallbackTab = {{ ('feed' if (not userSites or userSites.length == 0) else 'upload') | dump | safe }};
      executeDashboardTabSwitch(fallbackTab);
    }
  }

  window.addEventListener('DOMContentLoaded', syncDashboardTabFromHash);
  window.addEventListener('hashchange', syncDashboardTabFromHash);
  window.executeDashboardTabSwitch = executeDashboardTabSwitch;

