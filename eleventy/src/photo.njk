---
pagination:
  data: posts
  size: 1
  alias: post
permalink: "photos/{{ post.id }}/index.html"
layout: "layouts/base.njk"
eleventyComputed:
  title: "Photo by @{{ post.author }}"
---

<!-- Back Link to Static Gallery Grid -->
<div class="neogram-nav-back">
  <a href="{{ '/' | url }}" class="neogram-btn neogram-btn--yellow">
    <span>← BACK TO PHOTO GALLERY GRID</span>
  </a>
</div>

<article class="neogram-detail">
  <header class="neogram-detail__header">
    <div class="neogram-detail__title">
      <span>💾</span>
      <span>[:&gt; {{ post.id }}.bitmap]</span>
    </div>
    <div class="neogram-detail__status">
      <span class="neogram-detail__status-shader">SHADER: {{ post.filterApplied or 'RAW' }}</span>
      <span class="neogram-detail__status-sub">100% BITMAP</span>
    </div>
  </header>

  <div class="neogram-detail__body">
    <div class="neogram-detail__layout">

      <!-- LEFT: Full Resolution Photo Viewport -->
      <div class="neogram-detail__media-col">
        <div class="neogram-detail__viewport">
          <img
            src="{{ post.imagePath | url }}"
            alt="{{ post.caption }}"
            class="neogram-detail__image filter-{{ post.filterApplied or 'none' }}"
          />
        </div>

        <!-- Tag row -->
        <div class="neogram-detail__tags">
          {% if post.mood %}
            <span class="neogram-badge neogram-badge--cyan">{{ post.mood }}</span>
          {% endif %}
          {% if post.webring %}
            <span class="neogram-badge neogram-badge--magenta">ring: {{ post.webring }}</span>
          {% endif %}
          {% if post.location %}
            <span class="neogram-badge neogram-badge--amber">loc: {{ post.location }}</span>
          {% endif %}
        </div>
      </div>

      <!-- RIGHT: Metadata & Centralized Comment Ledger -->
      <div class="neogram-detail__info-col">
        <!-- Author & Caption -->
        <div class="neogram-detail__author-box">
          <div class="neogram-detail__author-meta">
            <span class="neogram-detail__author-handle">@{{ post.author }}</span>
            <span class="neogram-detail__author-date">{{ post.createdAt | formatDate }}</span>
          </div>
          <p class="neogram-detail__caption">
            {{ post.caption }}
          </p>
        </div>

        <!-- Reactions Bar -->
        <div class="neogram-detail__reactions">
          <button
            type="button"
            id="likeBtn"
            onclick="handleLikePost('{{ post.id }}')"
            class="neogram-btn"
          >
            <span id="likeBtnText">❤️ LIKE (<span id="likeCount">{{ post.likes or 0 }}</span>)</span>
          </button>

          <button
            type="button"
            onclick="handleRadicalPost()"
            class="neogram-btn"
          >
            <span>⚡ RADICAL</span>
          </button>

          <button
            type="button"
            onclick="handleBookmarkPost()"
            class="neogram-btn"
          >
            <span>💾 BOOKMARK</span>
          </button>
        </div>

        <!-- Self-Hosted Comments Ledger -->
        <section class="neogram-comments">
          <header class="neogram-comments__header">
            <span class="neogram-comments__title">💬 COMMENT LEDGER (<span id="commentCount">{{ post.comments.length or 0 }}</span>)</span>
            <span class="neogram-comments__status">SELF-HOSTED JSON</span>
          </header>

          <!-- Comments Scroll Container -->
          <div id="commentsLedger" class="neogram-comments__ledger">
            {% if not post.comments or post.comments.length == 0 %}
              <div id="emptyCommentsNotice" class="neogram-comments__empty">
                [:&gt; No visitor comments recorded on static ledger yet. Be the first to leave your mark.]
              </div>
            {% else %}
              {% for comment in post.comments %}
                <div class="neogram-comments__item" data-comment-id="{{ comment.id }}">
                  <div class="neogram-comments__item-header">
                    <span class="neogram-comments__item-author">
                      {{ comment.avatar or '💬' }} @{{ comment.author }}
                      {% if comment.uin %}<span class="text-muted font-normal">[#{{ comment.uin }}]</span>{% endif %}
                    </span>
                    <span class="neogram-comments__item-time">{{ comment.timestamp | formatDate }}</span>
                  </div>
                  <p class="neogram-comments__item-body">{{ comment.text }}</p>
                </div>
              {% endfor %}
            {% endif %}
          </div>

          <!-- State A: Authenticated Comment Form (Active Cyber-Pass) -->
          <form id="commentForm" onsubmit="handleStaticCommentSubmit(event, '{{ post.id }}')" class="neogram-comments__form hidden">
            <div class="flex items-center justify-between text-xs font-mono p-1 border border-main bg-window mb-2">
              <div class="flex items-center gap-1">
                <span>⚡ IDENTIFIED CALLSIGN:</span>
                <span id="authStationHandle" class="font-bold text-mac">@visitor</span>
                <span id="authStationUin" class="text-muted font-normal">[#000000]</span>
              </div>
              <button type="button" onclick="disconnectCyberPass()" class="text-muted text-xs hover:underline" title="Disconnect pass">[Disconnect ✕]</button>
            </div>

            <div class="neogram-comments__form-row">
              <input
                type="text"
                id="commentText"
                placeholder="Write a comment..."
                required
                class="neogram-comments__input neogram-comments__input--text"
              />
            </div>
            <button
              type="submit"
              id="commentSubmitBtn"
              class="neogram-btn neogram-btn--green neogram-comments__submit"
            >
              <span>COMMIT COMMENT TO LEDGER :&gt;</span>
            </button>
          </form>

          <!-- State B: Unauthenticated Lock Banner (Prompts to Connect via Neogram) -->
          <div id="cyberPassPrompt" class="p-3 border-2 border-dashed border-main text-center bg-window mt-2">
            <div class="text-xs font-bold text-mac mb-1">🔒 NEOGRAM CYBER-PASS REQUIRED</div>
            <p class="text-xs text-muted mb-3">
              Identify via your Neogram station to leave comments and prevent spam bots.
            </p>
            <button
              type="button"
              onclick="openCyberPassModal()"
              class="neogram-btn neogram-btn--yellow neogram-btn--sm"
            >
              <span>⚡ Connect Cyber-Pass / Login :&gt;</span>
            </button>
          </div>
        </section>

      </div>

    </div>
  </div>
</article>

<script>
  var API_BASE = '{{ site.apiUrl or "http://localhost:4000" }}';
  var COMMENTS_JSON_URL = ('{{ post.imagePath | url }}').replace(/\.[a-zA-Z0-9]+$/, '.comments.json');
  var POST_ID = '{{ post.id }}';

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // =========================================================================
  // 1. CYBER-PASS AUTHENTICATION LAYER
  // =========================================================================

  function getStoredPass() {
    try {
      var raw = localStorage.getItem('neogram_pass');
      return raw ? JSON.parse(raw) : null;
    } catch (_err) {
      return null;
    }
  }

  function setCyberPass(data) {
    if (!data || !data.token || !data.handle) return;
    try {
      localStorage.setItem('neogram_pass', JSON.stringify({
        token: data.token,
        handle: data.handle,
        uin: data.uin,
        avatar: data.avatar || '💬'
      }));
    } catch (_err) {}
    renderAuthUI();
  }

  function disconnectCyberPass() {
    try {
      localStorage.removeItem('neogram_pass');
    } catch (_err) {}
    if (window.retroAudio) window.retroAudio.playClick();
    renderAuthUI();
  }

  function renderAuthUI() {
    var pass = getStoredPass();
    var form = document.getElementById('commentForm');
    var prompt = document.getElementById('cyberPassPrompt');
    var handleEl = document.getElementById('authStationHandle');
    var uinEl = document.getElementById('authStationUin');

    if (pass && pass.token) {
      if (form) form.classList.remove('hidden');
      if (prompt) prompt.classList.add('hidden');
      if (handleEl) handleEl.textContent = '@' + pass.handle;
      if (uinEl) uinEl.textContent = pass.uin ? '[#' + pass.uin + ']' : '';
    } else {
      if (form) form.classList.add('hidden');
      if (prompt) prompt.classList.remove('hidden');
    }
  }

  function openCyberPassModal() {
    if (window.retroAudio) window.retroAudio.playClick();
    var origin = encodeURIComponent(window.location.origin);
    var popupUrl = API_BASE + '/auth/connect?origin=' + origin;
    var popup = window.open(
      popupUrl,
      'neogram_auth',
      'width=440,height=480,menubar=no,toolbar=no,location=no,status=no'
    );
    if (!popup) {
      alert('[:> Pop-up blocked! Please allow pop-ups from this site to connect your Cyber-Pass.]');
    }
  }

  // Cross-Window Listener (handles popup handshake and browser extension content script)
  window.addEventListener('message', function (e) {
    if (e.data && (e.data.type === 'NEOGRAM_CYBER_PASS' || e.data.type === 'NEOGRAM_EXTENSION_PASS')) {
      setCyberPass(e.data);
      if (window.retroAudio) window.retroAudio.playSuccess();
    }
  });

  // =========================================================================
  // 2. LIKING & RADICAL REACTIONS (With LocalStorage Deduping)
  // =========================================================================

  function renderLikeUI() {
    var hasLiked = false;
    try {
      hasLiked = localStorage.getItem('neogram_liked_' + POST_ID) === 'true';
    } catch (_err) {}

    var btn = document.getElementById('likeBtn');
    var textSpan = document.getElementById('likeBtnText');
    var countEl = document.getElementById('likeCount');
    var currentCount = countEl ? countEl.textContent : '0';

    if (hasLiked && btn && textSpan) {
      btn.classList.add('neogram-btn--active');
      textSpan.innerHTML = '❤️ LIKED (<span id="likeCount">' + currentCount + '</span>)';
    }
  }

  function handleLikePost(postId) {
    var hasLiked = false;
    try {
      hasLiked = localStorage.getItem('neogram_liked_' + postId) === 'true';
    } catch (_err) {}

    if (hasLiked) {
      if (window.retroAudio) window.retroAudio.playClick();
      alert('[:> You already transmitted love for this photograph!]');
      return;
    }

    if (window.retroAudio) window.retroAudio.playClick();
    fetch(API_BASE + '/api/posts/' + postId + '/like', { method: 'POST' })
      .then(function (res) { return res.json(); })
      .then(function (data) {
        if (data.ok) {
          try {
            localStorage.setItem('neogram_liked_' + postId, 'true');
          } catch (_err) {}
          var el = document.getElementById('likeCount');
          if (el) el.textContent = data.likes;
          renderLikeUI();
          if (window.retroAudio) window.retroAudio.playSuccess();
        }
      })
      .catch(function (err) {
        console.error('Like error:', err);
      });
  }

  function handleRadicalPost() {
    if (window.retroAudio) window.retroAudio.playSuccess();
    alert('[:> RADICAL! Reaction broadcasted across the webring.]');
  }

  function handleBookmarkPost() {
    if (window.retroAudio) window.retroAudio.playClick();
    alert('[:> Photograph bookmarked to your station memory.]');
  }

  // =========================================================================
  // 3. COMMENT SUBMISSION (STATELESS DISPATCHER)
  // =========================================================================

  function handleStaticCommentSubmit(e, postId) {
    e.preventDefault();
    var pass = getStoredPass();
    if (!pass || !pass.token) {
      openCyberPassModal();
      return;
    }

    var textInput = document.getElementById('commentText');
    var submitBtn = document.getElementById('commentSubmitBtn');
    var text = textInput.value.trim();
    if (!text) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'TRANSMITTING TO HOST...';
    if (window.retroAudio) window.retroAudio.playClick();

    fetch(API_BASE + '/api/posts/' + postId + '/comments', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + pass.token
      },
      body: JSON.stringify({ text: text })
    })
    .then(function (res) { return res.json(); })
    .then(function (data) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'COMMIT COMMENT TO LEDGER :>';

      if (data.ok && data.comment) {
        textInput.value = '';
        var emptyNotice = document.getElementById('emptyCommentsNotice');
        if (emptyNotice) emptyNotice.remove();

        var ledger = document.getElementById('commentsLedger');
        var item = document.createElement('div');
        item.className = 'neogram-comments__item';
        item.setAttribute('data-comment-id', data.comment.id);

        var safeAuthor = escapeHtml(data.comment.author || pass.handle);
        var safeText = escapeHtml(data.comment.text || text);
        var uinBadge = data.comment.uin ? ' <span class="text-muted font-normal">[#' + data.comment.uin + ']</span>' : '';

        item.innerHTML =
          '<div class="neogram-comments__item-header">' +
          '  <span class="neogram-comments__item-author">' + (data.comment.avatar || '💬') + ' @' + safeAuthor + uinBadge + '</span>' +
          '  <span class="neogram-comments__item-time">Just now</span>' +
          '</div>' +
          '<p class="neogram-comments__item-body">' + safeText + '</p>';

        ledger.appendChild(item);
        ledger.scrollTop = ledger.scrollHeight;

        var countEl = document.getElementById('commentCount');
        if (countEl) countEl.textContent = parseInt(countEl.textContent || '0', 10) + 1;

        if (window.retroAudio) window.retroAudio.playSuccess();
      } else {
        if (data.error && data.error.includes('Authentication')) {
          disconnectCyberPass();
          alert('[:> Cyber-Pass expired. Please reconnect your pass.]');
        } else {
          alert('Comment could not be posted: ' + (data.error || 'Server error'));
        }
      }
    })
    .catch(function (_err) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'COMMIT COMMENT TO LEDGER :>';
      alert('Network error while committing comment to remote ledger.');
    });
  }

  // =========================================================================
  // 4. SAME-ORIGIN COMMENTS HYDRATION ON PAGE LOAD
  // =========================================================================

  function hydrateCommentsFromSelfHostedJson() {
    if (!COMMENTS_JSON_URL) return;

    function renderComments(comments) {
      if (!Array.isArray(comments)) return;
      var ledger = document.getElementById('commentsLedger');
      if (!ledger) return;

      var existingIds = {};
      var domItems = ledger.querySelectorAll('[data-comment-id]');
      for (var i = 0; i < domItems.length; i++) {
        var id = domItems[i].getAttribute('data-comment-id');
        if (id) existingIds[id] = true;
      }

      var addedCount = 0;
      comments.forEach(function (c) {
        if (!existingIds[c.id]) {
          if (addedCount === 0) {
            var emptyNotice = document.getElementById('emptyCommentsNotice');
            if (emptyNotice) emptyNotice.remove();
          }
          var item = document.createElement('div');
          item.className = 'neogram-comments__item';
          item.setAttribute('data-comment-id', c.id);
          var safeAuthor = escapeHtml(c.author);
          var safeText = escapeHtml(c.text);
          var uinBadge = c.uin ? ' <span class="text-muted font-normal">[#' + c.uin + ']</span>' : '';

          item.innerHTML =
            '<div class="neogram-comments__item-header">' +
            '  <span class="neogram-comments__item-author">' + (c.avatar || '💬') + ' @' + safeAuthor + uinBadge + '</span>' +
            '  <span class="neogram-comments__item-time">Synced</span>' +
            '</div>' +
            '<p class="neogram-comments__item-body">' + safeText + '</p>';

          ledger.appendChild(item);
          addedCount++;
        }
      });

      if (addedCount > 0 || comments.length > 0) {
        var countEl = document.getElementById('commentCount');
        if (countEl) countEl.textContent = comments.length;
      }
    }

    fetch(COMMENTS_JSON_URL, { cache: 'no-cache' })
      .then(function (res) {
        if (res.ok) return res.json();
        // Fallback: If static JSON is 404 on host (e.g. newly posted or CDN cache delay),
        // seamlessly query Neogram API so comments show immediately with zero delay
        return fetch(API_BASE + '/api/posts/' + POST_ID + '/comments')
          .then(function (apiRes) { return apiRes.ok ? apiRes.json() : null; })
          .catch(function () { return null; });
      })
      .then(function (data) {
        if (data && Array.isArray(data.comments)) {
          renderComments(data.comments);
        }
      })
      .catch(function () {
        // Fallback to API if network error occurs on static host
        fetch(API_BASE + '/api/posts/' + POST_ID + '/comments')
          .then(function (apiRes) { return apiRes.ok ? apiRes.json() : null; })
          .then(function (data) {
            if (data && Array.isArray(data.comments)) {
              renderComments(data.comments);
            }
          })
          .catch(function () {});
      });
  }

  // Initialize UI on load
  document.addEventListener('DOMContentLoaded', function () {
    renderAuthUI();
    renderLikeUI();
    hydrateCommentsFromSelfHostedJson();
  });
</script>
