---
layout: layouts/base.njk
title: Friends Static Photo Grid
permalink: "friends/index.html"
---

<!-- ==============================================================
     FRIENDS STATIC STREAM BANNER
     ============================================================== -->
<section class="neogram-banner">
  <div class="neogram-banner__header">
    <div class="neogram-banner__title">
      <span>[:> @{{ site.author | upper }}'S FRIENDS STATIC STREAM]</span>
    </div>
    <div class="neogram-banner__status">
      <span>● FRIENDS CARRIER NETWORK</span>
    </div>
  </div>

  <div class="neogram-banner__body">
    <div class="neogram-banner__info">
      <p class="neogram-banner__desc">
        Transmissions published by friends and followed stations on the Neogram cyberspace network.
      </p>
      <p class="neogram-banner__node">
        Network relay: <a href="{{ site.neocitiesUrl }}/friends/" target="_blank" rel="noopener noreferrer"><code>{{ site.neocitiesUrl }}/friends/ ↗</code></a> · Synchronized via Neogram Build Queue
      </p>
    </div>

    <div class="neogram-banner__actions">
      <span class="neogram-badge neogram-badge--cyan">{{ friendsPosts.length }} TRANSMISSIONS ARCHIVED</span>
      <a href="{{ '/' | url }}" class="neogram-btn neogram-btn--yellow neogram-btn--sm">
        <span>← Back to My Gallery</span>
      </a>
      <a href="{{ site.apiUrl or 'http://localhost:4000' }}/friends" target="_blank" class="neogram-btn neogram-btn--green neogram-btn--sm">
        <span>Manage Friends :&gt;</span>
      </a>
    </div>
  </div>
</section>

<!-- ==============================================================
     FRIENDS PHOTO GRID (FEDERATED DYNAMIC CONTAINER)
     ============================================================== -->
<div id="neogram-friends-grid" data-station="{{ site.author }}" data-api-host="{{ site.apiUrl or 'https://neogram.club' }}">
{% if not friendsPosts or friendsPosts.length == 0 %}
  <div class="neogram-empty">
    <div class="neogram-empty__title">[:&gt; FEDERATED FRIENDS STREAM READY]</div>
    <p class="neogram-empty__desc">
      Connecting to the Cyberspace Friends Mesh... When followed stations publish photographs, they will stream dynamically into this grid.
    </p>
    <div class="neogram-empty__action">
      <a href="{{ site.apiUrl or 'http://localhost:4000' }}/directory" target="_blank" class="neogram-btn neogram-btn--green neogram-btn--lg">
        <span>Explore Cyberspace Directory</span>
      </a>
    </div>
  </div>
{% else %}
  <div class="neogram-grid">
    {% for post in friendsPosts %}
      <article class="neogram-card">
        <!-- Card Window Header -->
        <div class="neogram-card__header">
          <a
            href="{{ post.profileUrl or ((site.apiUrl or 'http://localhost:4000') + '/user/@' + post.author) }}"
            target="_blank"
            class="neogram-card__author hover:underline"
            title="View @{{ post.author }} on Neogram"
          >
            @{{ post.author }} {% if post.uin %}[#{{ post.uin }}]{% endif %}
          </a>
          <span class="neogram-card__shader">{{ post.filterApplied or 'RAW' }}</span>
        </div>

        <!-- Thumbnail Viewport with CRT & Filter Shaders -->
        {% if post.photos and post.photos.length > 1 %}
          <div class="neogram-slider neogram-slider--card">
            <div class="neogram-slider__track" tabindex="0" role="region" aria-label="Friend photo carousel slider">
              {% for pic in post.photos %}
                <a
                  href="{{ post.profileUrl or ((site.apiUrl or 'http://localhost:4000') + '/user/@' + post.author) }}"
                  target="_blank"
                  class="neogram-slider__slide"
                  id="fcard-{{ post.id }}-{{ loop.index }}"
                >
                  <img
                    src="{{ pic.thumbnailUrl or pic.thumbnailPath or pic.imageUrl or pic.imagePath }}"
                    alt="{{ post.caption }} ({{ loop.index }}/{{ post.photos.length }})"
                    class="neogram-slider__image filter-{{ post.filterApplied or 'none' }}"
                    loading="lazy"
                    onerror="this.classList.add('neogram-img--broken'); if(this.parentElement) this.parentElement.classList.add('has-broken-image');"
                  />
                </a>
              {% endfor %}
            </div>
            <div class="neogram-slider__nav" aria-label="Slide navigation dots">
              {% for pic in post.photos %}
                <a href="#fcard-{{ post.id }}-{{ loop.index }}" class="neogram-slider__dot" aria-label="Slide {{ loop.index }} of {{ post.photos.length }}"></a>
              {% endfor %}
            </div>
            <div class="neogram-slider__counter">
              <span class="neogram-badge neogram-badge--cyan">⧉ {{ post.photos.length }}</span>
            </div>
            <div class="neogram-card__overlay">
              <a
                href="{{ post.profileUrl or ((site.apiUrl or 'http://localhost:4000') + '/user/@' + post.author) }}"
                target="_blank"
                class="neogram-btn neogram-btn--yellow neogram-btn--sm neogram-card__overlay-btn"
              >
                <span>VIEW PROFILE</span>
              </a>
            </div>
          </div>
        {% else %}
          <a
            href="{{ post.profileUrl or ((site.apiUrl or 'http://localhost:4000') + '/user/@' + post.author) }}"
            target="_blank"
            class="neogram-card__media"
            title="View @{{ post.author }}'s profile"
          >
            <img
              src="{{ post.thumbnailUrl or post.imageUrl or post.thumbnailPath or post.imagePath }}"
              alt="{{ post.caption }}"
              class="neogram-card__image filter-{{ post.filterApplied or 'none' }}"
              loading="lazy"
              onerror="this.classList.add('neogram-img--broken'); if(this.parentElement) this.parentElement.classList.add('has-broken-image');"
            />
            <div class="neogram-card__overlay">
              <span class="neogram-btn neogram-btn--yellow neogram-btn--sm neogram-card__overlay-btn">
                <span>VIEW PROFILE</span>
              </span>
            </div>
          </a>
        {% endif %}

        <!-- Metadata & Caption Card Body -->
        <div class="neogram-card__body">
          <div class="neogram-card__content">
            <div class="neogram-card__meta">
              <span class="neogram-card__location">{{ post.location or 'Earth // Cyberspace' }}</span>
              <span class="neogram-card__date">{{ post.createdAt | formatDate }}</span>
            </div>

            <p class="neogram-card__caption">
              {{ post.caption }}
            </p>
          </div>

          <!-- Tags & Actions Footer -->
          <div>
            <div class="neogram-card__tags">
              {% if post.mood %}
                <span class="neogram-badge neogram-badge--cyan">{{ post.mood }}</span>
              {% endif %}
              {% if post.webring %}
                <span class="neogram-badge neogram-badge--magenta">ring: {{ post.webring }}</span>
              {% endif %}
            </div>

            <div class="neogram-card__footer">
              <span class="neogram-card__likes">
                <strong>{{ post.likes or 0 }}</strong> likes
              </span>
              <a
                href="{{ post.profileUrl or ((site.apiUrl or 'http://localhost:4000') + '/user/@' + post.author) }}"
                target="_blank"
                class="neogram-btn neogram-btn--yellow neogram-btn--sm"
              >
                <span>Station Node :&gt;</span>
              </a>
            </div>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
{% endif %}
</div>

<!-- Federated Client-Side Dynamic Stream Hydration -->
<script src="{{ '/embed/friends.js' | url }}"></script>
