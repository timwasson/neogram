<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.title }} - 90s Retro Static Gallery</title>
  <meta name="description" content="{{ site.description }}">
  
  <!-- Neogram Retro Framework (Pure Sass, Zero Tailwind) -->
  <link rel="stylesheet" href="/css/neogram.css">
  <link rel="stylesheet" href="/embed/neogram-embed.css">
</head>
<body class="desktop-bg min-h-screen flex flex-col font-mono text-main antialiased selection-invert">

  <!-- ==============================================================
       TOP RETRO SYSTEM BAR (Mac System 7 / Win95 Styled)
       ============================================================== -->
  <header class="taskbar flex items-center justify-between px-3 py-1 text-xs select-none sticky top-0 z-50">
    <div class="flex items-center gap-2">
      <span class="text-base">🍎</span>
      <span class="font-bold tracking-wider">NEOGRAM STATIC ARCHIVE</span>
      <span class="text-prompt text-xs hidden sm:inline">[:&gt; ELEVENTY GENERATED]</span>
    </div>

    <div class="flex items-center gap-3">
      <a href="/" class="pixel-btn pixel-btn--sm">
        <span>🏠 Gallery Grid</span>
      </a>
      <a href="{{ site.apiUrl or 'http://localhost:4000' }}" target="_blank" class="pixel-btn pixel-btn--yellow pixel-btn--sm">
        <span>🔑 Neogram Studio</span>
      </a>
      <button type="button" id="themeToggleBtn" class="pixel-btn pixel-btn--sm" title="Toggle Theme Skin">
        <span>☾ Theme</span>
      </button>
    </div>
  </header>

  <!-- ==============================================================
       PAGE CONTENT CONTAINER
       ============================================================== -->
  <main class="flex-1 p-3 sm:p-6 max-w-6xl w-full mx-auto">
    {{ content | safe }}
  </main>

  <!-- ==============================================================
       STATIC SITE RETRO FOOTER
       ============================================================== -->
  <footer class="mt-8 border-t-2 border-main p-4 bg-window text-xs font-mono text-center select-none">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 max-w-6xl mx-auto">
      <div class="text-left">
        <div class="font-bold text-prompt">STATIC HOST: <span class="text-main">{{ site.neocitiesUrl }}</span></div>
        <div class="text-muted text-xs">Built with 11ty (Eleventy) &amp; Neogram Sharp Publishing Pipeline</div>
      </div>

      <!-- Retro 88x31 Badges -->
      <div class="flex items-center gap-2 flex-wrap justify-center">
        <span class="pixel-badge pixel-badge--cyan">11TY STATIC</span>
        <span class="pixel-badge pixel-badge--green">NEOCITIES READY</span>
        <span class="pixel-badge pixel-badge--magenta">800x600 BEST</span>
        <span class="pixel-badge pixel-badge--amber">NETSCAPE 4.0</span>
      </div>
    </div>
  </footer>

  <!-- Retro Audio Engine -->
  <script src="/js/retroAudio.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Audio click handler for retro buttons
      if (window.retroAudio) {
        document.querySelectorAll('.pixel-btn, .filter-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            window.retroAudio.playClick();
          });
        });
      }

      // Theme toggle support
      var toggleBtn = document.getElementById('themeToggleBtn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function () {
          var isDark = document.body.classList.toggle('dark');
          var icon = toggleBtn.querySelector('span');
          if (icon) icon.textContent = isDark ? '☾ Theme' : '☼ Theme';
          if (window.retroAudio) window.retroAudio.playClick();
        });
      }
    });
  </script>

  <!-- Optional Neogram Embed Layer -->
  <script src="/embed/embed.js" async></script>
</body>
</html>
