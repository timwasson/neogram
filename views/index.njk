      }
    } catch(e) {}

    var handleInput = document.getElementById('settingsHandleInput');
    var rawHandle = handleInput ? handleInput.value.trim().toLowerCase().replace(/^@+/, '') : '';
    var saveBtn = document.getElementById('saveProfileBtn');
    var alertBox = document.getElementById('profileAlert');
    var alertTag = document.getElementById('profileAlertTag');
    var alertMsg = document.getElementById('profileAlertMsg');

    if (!rawHandle) {
      alertBox.className = 'retro-alert retro-alert--error mb-3';
      alertTag.textContent = '[:> ERROR]:';
      alertMsg.textContent = 'Please specify a call-sign / handle.';
      alertBox.classList.remove('hidden');
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'UPDATING CYBER IDENTITY...';
    alertBox.classList.add('hidden');

    try {
      var formData = new FormData();
      formData.append('handle', rawHandle);

      if (selectedAvatarFile) {
        formData.append('avatarFile', selectedAvatarFile);
      } else if (isAvatarRemoved) {
        formData.append('removeAvatar', 'true');
      }

      var res = await fetch('/api/settings/profile', {
        method: 'POST',
        body: formData
      });

      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to update cyber identity.');

      alertBox.className = 'retro-alert retro-alert--success mb-3';
      alertTag.textContent = '[✓] IDENTITY UPDATED:';
      alertMsg.textContent = 'Call-sign @' + data.user.handle + ' and avatar image updated across the station!';
      alertBox.classList.remove('hidden');

      // Update UI elements across dashboard live
      var navHandle = document.getElementById('navUserHandle');
      if (navHandle) navHandle.textContent = '@' + data.user.handle;

      var headerHandle = document.getElementById('headerUserHandle');
      if (headerHandle) headerHandle.textContent = '@' + data.user.handle;

      var avatarPreview = document.getElementById('settingsAvatarPreview');
      if (avatarPreview) avatarPreview.src = data.user.avatarPath;

      var badge = document.getElementById('avatarStatusBadge');
      if (badge) badge.textContent = data.user.hasCustomAvatar ? 'CUSTOM' : 'DEFAULT';

      var headerSiteUrl = document.getElementById('headerSiteUrl');
      if (headerSiteUrl) headerSiteUrl.textContent = 'https://' + data.user.handle + '.neocities.org';

      var fileInput = document.getElementById('avatarFileInput');
      if (fileInput) fileInput.value = '';
      selectedAvatarFile = null;
      isAvatarRemoved = false;

      appendTelemetryLog('[✓ PROFILE] Cyber identity updated to @' + data.user.handle);
      try {
        if (window.retroAudio && typeof window.retroAudio.playSuccess === 'function') {
          window.retroAudio.playSuccess();
        }
      } catch(e) {}

    } catch (err) {
      try {
        if (window.retroAudio && typeof window.retroAudio.playError === 'function') {
          window.retroAudio.playError();
        }
      } catch(e) {}
      alertBox.className = 'retro-alert retro-alert--error mb-3';
      alertTag.textContent = '[:> ERROR]:';
      alertMsg.textContent = err.message;
      alertBox.classList.remove('hidden');
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = '💾 UPDATE PROFILE & CALL-SIGN :>';
    }
  }

  async function loadSettings() {
    try {
      var res = await fetch('/api/settings');
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to load settings.');

      var s = data.settings;
      if (s.handle) {
        var handleInput = document.getElementById('settingsHandleInput');
        if (handleInput) handleInput.value = s.handle;
      }
      if (s.avatarPath) {
        var avatarPreview = document.getElementById('settingsAvatarPreview');
        if (avatarPreview) avatarPreview.src = s.avatarPath;
        var badge = document.getElementById('avatarStatusBadge');
        if (badge) badge.textContent = s.hasCustomAvatar ? 'CUSTOM' : 'DEFAULT';
      }
      if (s.siteName) document.getElementById('settingsSiteName').value = s.siteName;
      if (s.siteUrl) document.getElementById('settingsSiteUrl').value = s.siteUrl;
      if (s.deployPath !== undefined && s.deployPath !== null) {
        document.getElementById('settingsDeployPath').value = s.deployPath;
      }
      updateSiteUrlPreview();
      if (s.deploymentType) document.getElementById('settingsDeployType').value = s.deploymentType;
      document.getElementById('settingsAutoDeploy').checked = !!s.autoDeploy;

      var badge = document.getElementById('keyStatusBadge');
      var keyInput = document.getElementById('settingsApiKey');
      if (s.hasApiKey) {
        badge.textContent = '[✓ KEY ENCRYPTED IN DB]';
        badge.className = 'text-xs font-mono text-prompt font-bold';
        keyInput.value = s.maskedApiKey || '••••••••••••••••';
      } else {
        badge.textContent = '[!] NO API KEY CONFIGURED';
        badge.className = 'text-xs font-mono text-crimson font-bold';
        keyInput.value = '';
      }

      if (s.siteName) {
        document.getElementById('remoteSitename').textContent = s.siteName + '.neocities.org';
        var profileLink = document.getElementById('remoteProfileLink');
        profileLink.href = 'https://neocities.org/site/' + s.siteName;
      }
      if (s.lastDeployedAt) {
        var durationLabel = document.getElementById('deployDurationLabel');
        var d = new Date(s.lastDeployedAt);
        durationLabel.textContent = 'LAST SYNC: ' + d.toLocaleDateString();
      }
    } catch (err) {
      appendTelemetryLog('Failed to load settings: ' + err.message, true);
    }
  }

  async function handleSaveSettings(e) {
    e.preventDefault();
    if (window.retroAudio) window.retroAudio.playClick();

    var siteName = document.getElementById('settingsSiteName').value.trim();
    var siteUrl = document.getElementById('settingsSiteUrl').value.trim();
    var deployPath = document.getElementById('settingsDeployPath').value.trim();
    var apiKey = document.getElementById('settingsApiKey').value.trim();
    var deploymentType = document.getElementById('settingsDeployType').value;
    var autoDeploy = document.getElementById('settingsAutoDeploy').checked;
    var saveBtn = document.getElementById('saveSettingsBtn');

    saveBtn.disabled = true;
    saveBtn.textContent = 'ENCRYPTING & SAVING...';

    var alertBox = document.getElementById('settingsAlert');
    var alertTag = document.getElementById('settingsAlertTag');
    var alertMsg = document.getElementById('settingsAlertMsg');
    alertBox.classList.add('hidden');

    try {
      var res = await fetch('/api/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          siteName: siteName,
          siteUrl: siteUrl,
          deployPath: deployPath,
          apiKey: apiKey,
          deploymentType: deploymentType,
          autoDeploy: autoDeploy
        })
      });

      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to save settings.');

      alertBox.className = 'retro-alert retro-alert--success mb-3';
      alertTag.textContent = '[✓] VAULT UPDATED:';
      alertMsg.textContent = 'Hosting credentials encrypted with AES-256-GCM and saved to PostgreSQL.';
      alertBox.classList.remove('hidden');

      appendTelemetryLog('Saved deployment settings. Key encrypted in PostgreSQL database.');
      if (window.retroAudio) window.retroAudio.playSuccess();
      loadSettings();
    } catch (err) {
      if (window.retroAudio) window.retroAudio.playError();
      alertBox.className = 'retro-alert retro-alert--error mb-3';
      alertTag.textContent = '[:> ERROR]:';
      alertMsg.textContent = err.message;
      alertBox.classList.remove('hidden');
      appendTelemetryLog('Error saving settings: ' + err.message, true);
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = '💾 SAVE SETTINGS :>';
    }
  }

  async function testNeocitiesApiConnection() {
    if (window.retroAudio) window.retroAudio.playClick();
    var testBtn = document.getElementById('testConnectionBtn');
    var apiKey = document.getElementById('settingsApiKey').value.trim();
    var indicator = document.getElementById('remoteNodeIndicator');

    testBtn.disabled = true;
    testBtn.textContent = 'PROBING...';
    indicator.textContent = 'NEGOTIATING...';
    indicator.className = 'text-xs font-mono text-mac';

    appendTelemetryLog('Pinging Neocities REST API (https://neocities.org/api/info)...');

    try {
      var res = await fetch('/api/settings/test-neocities', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ apiKey: apiKey })
      });

      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Connection refused.');

      var info = data.info;
      indicator.textContent = 'ONLINE [VERIFIED]';
      indicator.className = 'text-xs font-mono text-prompt font-bold';

      document.getElementById('remoteSitename').textContent = info.sitename + '.neocities.org';
      document.getElementById('remoteViews').textContent = Number(info.views).toLocaleString();
      document.getElementById('remoteHits').textContent = Number(info.hits).toLocaleString();
      document.getElementById('remoteLastUpdated').textContent = info.last_updated ? new Date(info.last_updated).toLocaleString() : 'N/A';
      document.getElementById('remoteProfileLink').href = 'https://neocities.org/site/' + info.sitename;

      appendTelemetryLog('Verified site "' + info.sitename + '" | Views: ' + info.views + ' | Hits: ' + info.hits);
      if (window.retroAudio) window.retroAudio.playSuccess();
    } catch (err) {
      indicator.textContent = 'AUTH FAILED';
      indicator.className = 'text-xs font-mono text-crimson font-bold';
      appendTelemetryLog('Neocities probe failed: ' + err.message, true);
      if (window.retroAudio) window.retroAudio.playError();
      alert('Neocities API Test Failed: ' + err.message);
    } finally {
      testBtn.disabled = false;
      testBtn.textContent = '🧪 TEST CONNECTION';
    }
  }

  async function triggerNeocitiesDeployment() {
    try {
      if (window.retroAudio && typeof window.retroAudio.playShutter === 'function') {
        window.retroAudio.playShutter();
      }
    } catch(e) {}
    var deployBtn = document.getElementById('deployNowBtn');
    var durationLabel = document.getElementById('deployDurationLabel');

    deployBtn.disabled = true;
    deployBtn.textContent = '🚀 COMPILING & UPLOADING TO NEOCITIES...';
    durationLabel.textContent = 'TRANSMITTING...';

    appendTelemetryLog('Preparing personal 11ty static compilation for user...');

    try {
      appendTelemetryLog('Invoking Eleventy static compiler pipeline...');
      appendTelemetryLog('Packaging Sharp WebP assets and paginated photo pages...');
      appendTelemetryLog('Connecting to Neocities API upload stream (28.8k baud)...');

      var res = await fetch('/api/deploy/neocities', {
        method: 'POST'
      });

      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Neocities deployment rejected.');

      appendTelemetryLog('[✓ SUCCESS] ' + data.filesCount + ' files uploaded to Neocities in ' + data.durationMs + 'ms!');
      appendTelemetryLog('Live static gallery deployed to ' + (data.siteUrl || 'Neocities'));
      durationLabel.textContent = 'DEPLOYED (' + data.durationMs + 'ms)';

      if (window.retroAudio) window.retroAudio.playSuccess();
      loadSettings();
    } catch (err) {
      durationLabel.textContent = 'FAILED';
      appendTelemetryLog('Deployment error: ' + err.message, true);
      if (window.retroAudio) window.retroAudio.playError();
      alert('Neocities Deployment Error: ' + err.message);
    } finally {
      deployBtn.disabled = false;
      deployBtn.textContent = '🚀 DEPLOY TO NEOCITIES NOW :>';
    }
  }

  async function openEditModalById(id) {
    if (window.retroAudio) window.retroAudio.playClick();
    try {
      var res = await fetch('/api/posts/' + id);
      var data = await res.json();
      if (!res.ok || !data.ok || !data.post) {
        throw new Error(data.error || 'Could not load post data.');
      }
      var post = data.post;
      document.getElementById('editPostId').value = post.id;
      document.getElementById('editCaptionInput').value = post.caption || '';
      document.getElementById('editFilterSelect').value = post.filterApplied || 'none';

      var alertBox = document.getElementById('editModalAlert');
      alertBox.classList.add('hidden');

      var dialog = document.getElementById('editModalDialog');
      if (dialog && typeof dialog.showModal === 'function') {
        dialog.showModal();
      }
    } catch (err) {
      try {
        if (window.retroAudio && typeof window.retroAudio.playError === 'function') {
          window.retroAudio.playError();
        }
      } catch(e) {}
      alert('Error opening edit dialog: ' + err.message);
    }
  }

  function closeEditModal() {
    try {
      if (window.retroAudio && typeof window.retroAudio.playClick === 'function') {
        window.retroAudio.playClick();
      }
    } catch(e) {}
    var dialog = document.getElementById('editModalDialog');
    if (dialog && dialog.open) {
      dialog.close();
    }
  }

  async function handleSaveEditPost(e) {
    e.preventDefault();
    var id = document.getElementById('editPostId').value;
    var caption = document.getElementById('editCaptionInput').value.trim();
    var filterApplied = document.getElementById('editFilterSelect').value;
    var saveBtn = document.getElementById('editSaveBtn');

    saveBtn.disabled = true;
    saveBtn.textContent = 'SAVING...';
    try {
      if (window.retroAudio && typeof window.retroAudio.playClick === 'function') {
        window.retroAudio.playClick();
      }
    } catch(e) {}

    try {
      var res = await fetch('/api/posts/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          caption: caption,
          filterApplied: filterApplied
        })
      });

      var data = await res.json();
      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Failed to update post.');
      }

      // Update DOM card
      var captionEl = document.getElementById('manage-caption-' + id);
      if (captionEl) captionEl.textContent = caption;

      var filterEl = document.getElementById('manage-filter-' + id);
      if (filterEl) filterEl.textContent = 'shader: ' + filterApplied;

      var imgEl = document.getElementById('manage-img-' + id);
      if (imgEl) {
        imgEl.className = 'max-h-full max-w-full object-contain filter-' + filterApplied;
      }

      try {
        if (window.retroAudio && typeof window.retroAudio.playSuccess === 'function') {
          window.retroAudio.playSuccess();
        }
      } catch(e) {}
      closeEditModal();

    } catch (err) {
      try {
        if (window.retroAudio && typeof window.retroAudio.playError === 'function') {
          window.retroAudio.playError();
        }
      } catch(e) {}
      var alertBox = document.getElementById('editModalAlert');
      var tag = document.getElementById('editModalAlertTag');
      var msg = document.getElementById('editModalAlertMsg');
      alertBox.className = 'retro-alert retro-alert--error mb-3';
      tag.textContent = '[:> ERROR]:';
      msg.textContent = err.message;
      alertBox.classList.remove('hidden');
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = '💾 SAVE CHANGES :>';
    }
  }

  async function confirmDeletePost(id) {
    if (!confirm('[:> SECURITY WARNING]\nPermanently delete transmission from PostgreSQL database and disk?')) {
      return;
    }

    if (window.retroAudio) window.retroAudio.playClick();

    try {
      var res = await fetch('/api/posts/' + id, { method: 'DELETE' });
      var data = await res.json();

      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Failed to delete transmission.');
      }

      // Remove card from DOM
      var card = document.getElementById('manage-post-' + id);
      if (card) {
        card.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.95)';
        setTimeout(function() {
          card.remove();
          // Update counters
          var badge = document.getElementById('manageCountBadge');
          var total = document.getElementById('manageTotalCount');
          var current = parseInt(badge ? badge.textContent : '1', 10);
          if (badge) badge.textContent = Math.max(0, current - 1);
          if (total) total.textContent = Math.max(0, current - 1);
        }, 200);
      }

      if (window.retroAudio) window.retroAudio.playSuccess();

    } catch (err) {
      if (window.retroAudio) window.retroAudio.playError();
      alert('Delete failed: ' + err.message);
    }
  }

  async function triggerStaticRebuild() {
    var btn = document.getElementById('rebuildStaticBtn');
    var alertBox = document.getElementById('rebuildAlert');
    var tag = document.getElementById('rebuildAlertTag');
    var msg = document.getElementById('rebuildAlertMsg');

    btn.disabled = true;
    btn.textContent = '🔄 COMPILING 11TY...';
    if (window.retroAudio) window.retroAudio.playClick();

    try {
      var res = await fetch('/api/build-static', { method: 'POST' });
      var data = await res.json();

      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Compilation failed.');
      }

      alertBox.className = 'retro-alert retro-alert--success mb-3';
      tag.textContent = '[✓] 11TY COMPILED:';
      msg.textContent = data.postsCount + ' photos generated in ' + data.durationMs + 'ms -> dist/static-gallery';
      alertBox.classList.remove('hidden');

      if (window.retroAudio) window.retroAudio.playSuccess();
    } catch (err) {
      if (window.retroAudio) window.retroAudio.playError();
      alertBox.className = 'retro-alert retro-alert--error mb-3';
      tag.textContent = '[:> BUILD ERROR]:';
      msg.textContent = err.message;
      alertBox.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = '🔄 Rebuild 11ty Static Site';
    }
  }

  // Native HTML5 <dialog> Event Handlers (Esc key & light dismiss)
  document.addEventListener('DOMContentLoaded', function () {
    var dialog = document.getElementById('editModalDialog');
    if (dialog) {
      // Play retro audio when dismissed natively via Esc
      dialog.addEventListener('cancel', function () {
        if (window.retroAudio) window.retroAudio.playClick();
      });

      // Light-dismiss: close when clicking on backdrop
      dialog.addEventListener('click', function (e) {
        if (e.target !== dialog) return;
        var rect = dialog.getBoundingClientRect();
        var isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          closeEditModal();
        }
      });
    }
  });
</script>
