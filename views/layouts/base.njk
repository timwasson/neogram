<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title | default('Neogram - 90s Retro Social Publishing Engine') }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=VT323&display=swap" rel="stylesheet">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#000000">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Neogram">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="stylesheet" href="/css/neogram.css">
    <link rel="stylesheet" href="/embed/neogram-embed.css">
    <script src="/js/retroAudio.js?v=2.2.0"></script>
    {% block head %}{% endblock %}
  </head>
  <body>
    <!-- Vintage Terminal Marquee Banner with System Prompt :> -->
    <div class="terminal-marquee-bar">
      <div class="animate-marquee">
        :&gt; NEOGRAM UNIX WORKSTATION // HYBRID MAC-SYSTEM7 + BSD-X11 + STATIC RETRO WEB ARCHITECTURE // BLOCKY 8-BIT SPRITES // NO SAAS SLOP // 28.8K V.34 DIAL-UP OK // SYSTEM PROMPT READY_
      </div>
    </div>

    <!-- Classic Mac OS Pinstripes Title Accent -->
    <div class="mac-pinstripes"></div>

    <!-- 3-Zone Retro Top Navigation Bar -->
    <header class="retro-topnav">
      <div class="flex items-center gap-2">
        <a href="/" class="retro-brand" onclick="if(window.retroAudio) retroAudio.playClick();">
          <div class="retro-brand__icon">:&gt;</div>
          <span class="tracking-wider text-base font-bold">
            NEOGRAM <span class="text-xs text-mac">:&gt; v2.0_unix</span>
          </span>
        </a>
      </div>

      <!-- Dynamic Nav Links (Logged In vs Logged Out) -->
      <nav class="retro-navlinks">
        {% if currentUser %}
          <!-- Authenticated Primary Workstation Tabs with Static Hash Links -->
          <a
            href="/#upload"
            id="tabUploadBtn"
            class="pixel-btn pixel-btn--yellow font-bold text-xs"
            onclick="switchDashboardTab('upload', event)"
          >
            <span>↑</span> <span>Upload</span>
          </a>
          <a
            href="/#edit"
            id="tabManageBtn"
            class="pixel-btn font-bold text-xs"
            onclick="switchDashboardTab('manage', event)"
          >
            <span>✎&#xFE0E;</span> <span>Edit</span>
          </a>
          <a
            href="/#settings"
            id="tabSettingsBtn"
            class="pixel-btn font-bold text-xs"
            onclick="switchDashboardTab('settings', event)"
          >
            <span>⚙&#xFE0E;</span> <span>Settings</span>
          </a>
          <a
            href="/#embeds"
            id="tabEmbedsBtn"
            class="pixel-btn font-bold text-xs"
            onclick="switchDashboardTab('embeds', event)"
          >
            <span>⎘</span> <span>Embeds</span>
          </a>
        {% else %}
          <!-- Public Informational Options (When Logged Out) -->
          <a href="/" class="pixel-btn {% if activeView == 'dashboard' %}pixel-btn--active{% endif %}" onclick="if(window.retroAudio) retroAudio.playClick();">
            <span>💾</span> <span>About Neogram</span>
          </a>
          <a href="/embed/embed.js" target="_blank" class="pixel-btn" onclick="if(window.retroAudio) retroAudio.playClick();">
            <span>💻</span> <span>Embed Specs</span>
          </a>
          <a href="/api/health" target="_blank" class="pixel-btn" onclick="if(window.retroAudio) retroAudio.playClick();">
            <span>📡</span> <span>Network Status</span>
          </a>
        {% endif %}
      </nav>

      <div class="flex items-center gap-1">
        <!-- PWA Install Prompt Button -->
        <button type="button" id="pwaInstallBtn" class="pixel-btn pixel-btn--green pixel-btn--sm hidden" title="Install Neogram Workstation PWA to your device">
          <span>💾 INSTALL APP :&gt;</span>
        </button>

        {% if currentUser %}
          <!-- User Station Account Menu Dropdown -->
          <div class="retro-user-menu" id="retroUserMenu">
            <button
              type="button"
              id="userMenuBtn"
              class="pixel-btn pixel-btn--sm flex items-center gap-1.5 font-bold text-xs"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="userDropdownMenu"
              title="Station Account Menu (@{{ currentUser.handle }})"
            >
              <span class="text-prompt">●</span>
              <span id="navUserHandle" class="truncate max-w-24 sm:max-w-36">@{{ currentUser.handle }}</span>
              <span class="text-xs" id="userMenuCaret">▾</span>
            </button>

            <!-- Dropdown Menu Window -->
            <div
              id="userDropdownMenu"
              class="retro-user-dropdown pixel-box hidden"
              role="region"
              aria-label="User station details"
            >
              <!-- Dropdown Header -->
              <div class="window-header flex items-center justify-between text-xs py-1 px-2.5">
                <div class="flex items-center gap-1.5">
                  <span>👤</span>
                  <span class="font-bold uppercase tracking-wider text-xs">STATION IDENTITY</span>
                </div>
                <span class="text-xs text-prompt font-mono" id="dropdownUserUin" title="Immutable ICQ Static Node ID">
                  #{{ currentUser.uin or '100101' }}
                </span>
              </div>

              <!-- Dropdown Body -->
              <div class="p-3 flex flex-col gap-2.5 text-xs font-mono">
                <!-- User Handle & UIN row -->
                <div class="flex items-center justify-between gap-2 border-b border-main pb-2">
                  <span class="text-white font-bold text-sm tracking-wide truncate" id="dropdownUserHandle">
                    @{{ currentUser.handle }}
                  </span>
                  <span class="pixel-badge pixel-badge--cyan text-xxs font-bold shrink-0">
                    UIN: #{{ currentUser.uin or '100101' }}
                  </span>
                </div>

                <!-- Email / Phone Identifier -->
                <div class="flex flex-col gap-0.5">
                  <span class="text-muted text-xxs uppercase tracking-wider">LOGIN / CONTACT:</span>
                  <span class="text-prompt font-bold truncate select-all" id="dropdownUserEmail" title="{{ currentUser.email }}">
                    {{ currentUser.email }}
                  </span>
                </div>

                <!-- Static Host -->
                <div class="flex flex-col gap-0.5">
                  <span class="text-muted text-xxs uppercase tracking-wider">STATIC HOST:</span>
                  <a
                    href="{{ currentUser.siteUrl or 'https://' + currentUser.handle + '.neocities.org' }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-mac hover:underline truncate select-all flex items-center gap-1 font-bold"
                    id="dropdownSiteUrl"
                    title="Open host in new window"
                  >
                    <span class="truncate">{{ currentUser.siteUrl or 'https://' + currentUser.handle + '.neocities.org' }}</span>
                    <span class="text-xxs shrink-0">↗</span>
                  </a>
                </div>

                <!-- Appearance / Theme Selector Row -->
                <div class="flex items-center justify-between gap-2 pt-2 border-t border-main">
                  <span class="text-muted text-xxs uppercase tracking-wider">APPEARANCE:</span>
                  <button
                    type="button"
                    id="themeToggleBtn"
                    class="pixel-btn pixel-btn--sm text-xs py-0.5 px-2 flex items-center gap-1.5"
                    title="Toggle Dark / Light Mode"
                  >
                    <span id="themeLabel" class="text-xs">☾</span>
                    <span id="themeTextLabel" class="text-xxs font-mono font-bold uppercase">DARK MODE</span>
                  </button>
                </div>

                <!-- Action Buttons: Settings & Logout -->
                <div class="flex flex-col gap-1.5 pt-2 border-t border-main">
                  <a
                    href="/#settings"
                    id="dropdownSettingsLink"
                    class="pixel-btn pixel-btn--sm text-xs justify-center w-full"
                    onclick="if(typeof switchDashboardTab==='function'){switchDashboardTab('settings', event);} if(typeof toggleUserMenu==='function'){toggleUserMenu(false);} if(window.retroAudio) retroAudio.playClick();"
                  >
                    <span>⚙&#xFE0E;</span> <span>Station Settings</span>
                  </a>

                  <a
                    href="/logout"
                    id="dropdownLogoutBtn"
                    class="pixel-btn pixel-btn--danger pixel-btn--sm text-xs justify-center w-full font-bold"
                    onclick="if(window.retroAudio) retroAudio.playClick();"
                  >
                    <span>✕</span> <span>LOGOUT</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        {% else %}
          <!-- Theme Toggle (Guest Mode) -->
          <button
            type="button"
            id="themeToggleBtn"
            class="pixel-btn pixel-btn--sm"
            title="Toggle Dark / Light CRT Mode"
          >
            <span id="themeLabel" class="text-sm">☾</span>
          </button>
          <a href="/login" class="pixel-btn pixel-btn--yellow font-bold {% if activeView == 'login' %}pixel-btn--active{% endif %}" onclick="if(window.retroAudio) retroAudio.playClick();">
            <span>🔑 LOGIN :&gt;</span>
          </a>
        {% endif %}
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col pb-12">
      {% block content %}{% endblock %}
    </main>

    <!-- Retro Unix / Workstation Taskbar -->
    <footer class="retro-taskbar">
      <div class="flex items-center gap-2">
        <a href="/login" class="pixel-btn pixel-btn--sm bg-black text-prompt" onclick="if(window.retroAudio) retroAudio.playClick();">
          <span>:&gt; EXEC</span>
        </a>
        <div class="retro-taskbar__panel text-xs">
          <span>VIEW:</span>
          <span class="font-bold text-mac uppercase">
            {{ activeView | default('LOGIN') }}
          </span>
        </div>
        <div class="retro-taskbar__panel text-xs">
          <span>PORT:</span>
          <span class="font-bold">4000 (SECURE)</span>
        </div>
      </div>

      <!-- Right: System Tray with BSD/X11, COM2, and PC-Style Volume/Mute Control -->
      <div class="flex items-center gap-1.5">
        <div class="retro-taskbar__panel text-xs font-mono">
          <span class="text-prompt font-bold">● BSD/X11</span>
          <span class="text-muted">|</span>
          {% if currentUser %}
            <span class="text-prompt font-bold">AUTH: @{{ currentUser.handle }}</span>
          {% else %}
            <span>AUTH: AWAITING_CARRIER</span>
          {% endif %}
          <span class="text-muted">|</span>
          <span id="taskbarCom2Panel">COM2: 28.8k V.34</span>
        </div>

        <!-- PC-Style Systray Volume / Audio Control Button -->
        <button
          type="button"
          id="soundToggleBtn"
          class="retro-taskbar__tray-btn"
          title="PC Audio System: Click to mute/unmute 8-bit sound"
          aria-label="Toggle audio volume"
        >
          <span id="soundLabel" class="text-xs font-bold">♫</span>
          <span id="soundTextLabel" class="text-xxs font-mono font-bold uppercase">AUDIO: ON</span>
        </button>
      </div>
    </footer>

    <!-- Client-side Audio & Theme Helper -->
    <script>
      (function() {
        var soundBtn = document.getElementById('soundToggleBtn');
        var soundLabel = document.getElementById('soundLabel');
        var soundTextLabel = document.getElementById('soundTextLabel');
        var themeBtn = document.getElementById('themeToggleBtn');
        var themeLabel = document.getElementById('themeLabel');
        var themeTextLabel = document.getElementById('themeTextLabel');

        // Function to update sound UI elements
        function updateSoundUI(isOn) {
          if (window.retroAudio) window.retroAudio.enabled = isOn;
          if (soundLabel) soundLabel.textContent = isOn ? '♫' : '⊘';
          if (soundTextLabel) soundTextLabel.textContent = isOn ? 'AUDIO: ON' : 'MUTED';
          if (soundBtn) {
            soundBtn.title = isOn ? 'PC Audio: ON (Click to Mute)' : 'PC Audio: MUTED (Click to Unmute)';
            if (isOn) {
              soundBtn.classList.remove('is-muted');
            } else {
              soundBtn.classList.add('is-muted');
            }
          }
        }

        // Restore sound setting if previously saved
        var soundOn = localStorage.getItem('neogram_sound') !== 'muted';
        updateSoundUI(soundOn);

        if (soundBtn) {
          soundBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            soundOn = !soundOn;
            localStorage.setItem('neogram_sound', soundOn ? 'enabled' : 'muted');
            updateSoundUI(soundOn);
            if (soundOn && window.retroAudio && typeof window.retroAudio.playClick === 'function') {
              window.retroAudio.playClick();
            }
          });
        }

        // Function to update theme UI elements
        function updateThemeUI(isDark) {
          if (isDark) {
            document.documentElement.classList.add('dark');
            if (themeLabel) themeLabel.textContent = '☾';
            if (themeTextLabel) themeTextLabel.textContent = 'DARK MODE';
          } else {
            document.documentElement.classList.remove('dark');
            if (themeLabel) themeLabel.textContent = '☼';
            if (themeTextLabel) themeTextLabel.textContent = 'LIGHT MODE';
          }
        }

        // Restore theme setting
        var savedTheme = localStorage.getItem('neogram_theme');
        var isDarkMode = savedTheme !== 'light';
        updateThemeUI(isDarkMode);

        if (themeBtn) {
          themeBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            if (window.retroAudio && typeof window.retroAudio.playClick === 'function') {
              window.retroAudio.playClick();
            }
            var currentlyDark = document.documentElement.classList.contains('dark');
            var nextDark = !currentlyDark;
            localStorage.setItem('neogram_theme', nextDark ? 'dark' : 'light');
            updateThemeUI(nextDark);
          });
        }
      })();
    </script>

    <!-- User Account Dropdown Controller -->
    {% if currentUser %}
    <script>
      (function() {
        var menuBtn = document.getElementById('userMenuBtn');
        var dropdown = document.getElementById('userDropdownMenu');
        var caret = document.getElementById('userMenuCaret');
        if (!menuBtn || !dropdown) return;

        function toggleMenu(force) {
          var isCurrentlyOpen = !dropdown.classList.contains('hidden');
          var shouldOpen = typeof force === 'boolean' ? force : !isCurrentlyOpen;

          if (shouldOpen) {
            dropdown.classList.remove('hidden');
            menuBtn.setAttribute('aria-expanded', 'true');
            menuBtn.classList.add('pixel-btn--active');
            if (caret) caret.textContent = '▴';
          } else {
            dropdown.classList.add('hidden');
            menuBtn.setAttribute('aria-expanded', 'false');
            menuBtn.classList.remove('pixel-btn--active');
            if (caret) caret.textContent = '▾';
          }
        }

        window.toggleUserMenu = toggleMenu;

        menuBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          if (window.retroAudio) window.retroAudio.playClick();
          toggleMenu();
        });

        // Close when clicking anywhere outside
        document.addEventListener('click', function(e) {
          if (!dropdown.classList.contains('hidden')) {
            if (!dropdown.contains(e.target) && !menuBtn.contains(e.target)) {
              toggleMenu(false);
            }
          }
        });

        // Close on Escape key
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !dropdown.classList.contains('hidden')) {
            toggleMenu(false);
            menuBtn.focus();
          }
        });
      })();
    </script>
    {% endif %}

    {% if currentUser %}
      <!-- Floating NIM Dock Trigger Button -->
      <button type="button" id="aimDockBtn" class="pixel-btn pixel-btn--yellow aim-dock-btn" title="Open Neogram Instant Messenger (NIM)">
        <span>🗨</span>
        <span>NIM Messenger</span>
        <span id="aimOnlineCountBadge" class="pixel-badge text-xs">...</span>
      </button>

      <!-- Floating NIM Window -->
      <div id="aimMessengerWindow" class="aim-window hidden">
        <!-- Titlebar -->
        <div class="aim-window__header">
          <div class="flex items-center gap-1.5 overflow-hidden">
            <span>🗨</span>
            <span class="truncate">NIM 97 // NEOGRAM MESSENGER</span>
          </div>
          <div class="flex items-center gap-1">
            <button type="button" id="aimPopoutBtn" class="aim-window__btn-sm" title="Pop out in separate window">↗</button>
            <button type="button" id="aimMinimizeBtn" class="aim-window__btn-sm" title="Minimize">_</button>
          </div>
        </div>

        <!-- Window Body -->
        <div class="aim-window__body">
          <!-- VIEW 1: BUDDY LIST -->
          <div id="aimBuddiesView" class="flex-1 flex flex-col overflow-hidden gap-2">
            <!-- User Status Bar -->
            <div class="aim-window__user-bar">
              <div class="flex items-center justify-between">
                <span class="font-bold text-prompt">@{{ currentUser.handle }}</span>
                <select id="aimUserStatusSelect" class="border border-main text-xs font-mono bg-window cursor-pointer p-0.5">
                  <option value="online">🟢 Online</option>
                  <option value="away">🟡 Away</option>
                </select>
              </div>
              <input type="text" id="aimUserAwayMsg" placeholder="Status / Away message..." class="text-xs p-1 border border-main bg-window font-mono" maxlength="100" />
            </div>

            <!-- Scrollable Buddies List -->
            <div class="aim-window__buddies-container">
              <div class="aim-window__buddy-section-title">Online Buddies (🟢)</div>
              <div id="aimBuddiesList" class="flex flex-col gap-1">
                <div class="text-xs text-muted p-1">Connecting to NIM network...</div>
              </div>

              <div class="aim-window__buddy-section-title">Offline Buddies (⚪)</div>
              <div id="aimOfflineBuddiesList" class="flex flex-col gap-1">
                <div class="text-xs text-muted p-1">...</div>
              </div>
            </div>

            <!-- Bottom Utilities -->
            <div class="flex items-center justify-between border-t border-main pt-1.5 text-xs font-mono">
              <button type="button" id="aimExportLogsBtn" class="pixel-btn text-xs py-0.5 px-2" title="Export all chat logs as JSON file">
                <span>💾 Export Logs</span>
              </button>
              <button type="button" id="aimClearLogsBtn" class="text-muted hover:text-crimson text-xs underline" title="Clear local browser logs">
                [Clear Local]
              </button>
            </div>
          </div>

          <!-- VIEW 2: DIRECT MESSAGE CHAT -->
          <div id="aimImView" class="aim-window__im-view hidden">
            <!-- Header with Back to Buddies Button -->
            <div class="flex items-center justify-between border-b border-main pb-1">
              <button type="button" id="aimBackToBuddiesBtn" class="aim-window__btn-sm">
                &lt; Buddies
              </button>
              <div class="flex items-center gap-1 font-bold text-xs truncate max-w-40">
                <span id="aimImStatusDot">🟢</span>
                <span id="aimImTitle" class="truncate">@user</span>
              </div>
            </div>

            <!-- Buddy's Away Message -->
            <div id="aimImAwayBanner" class="aim-window__away-note hidden"></div>

            <!-- Chat Transcript (Rendered from LocalStorage) -->
            <div id="aimImTranscript" class="aim-window__transcript crt-scanlines">
              <!-- Messages stream here -->
            </div>

            <!-- Typing indicator -->
            <div id="aimImTyping" class="aim-window__typing"></div>

            <!-- Input Form -->
            <form id="aimImForm" class="aim-window__input-row">
              <input type="text" id="aimImInput" placeholder="Type message..." maxlength="1000" autocomplete="off" />
              <button type="submit" class="pixel-btn pixel-btn--yellow font-bold text-xs py-1 px-3">
                <span>Send</span>
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- AIM Messenger Client Engine -->
      <script src="/js/aimMessenger.js"></script>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          if (window.AimClient) {
            window.AimClient.init('{{ currentUser.handle }}');
          }
        });
      </script>

      <!-- Retro Mobile Bottom Navigation Bar (Screens < 768px) -->
      <nav class="retro-mobile-nav" id="retroMobileNav" aria-label="Mobile Navigation">
        <a
          href="/#upload"
          id="mobileTabUploadBtn"
          class="retro-mobile-nav__item is-active"
          onclick="switchDashboardTab('upload', event)"
        >
          <span class="retro-mobile-nav__icon">📸</span>
          <span>Studio</span>
        </a>
        <a
          href="/#edit"
          id="mobileTabManageBtn"
          class="retro-mobile-nav__item"
          onclick="switchDashboardTab('manage', event)"
        >
          <span class="retro-mobile-nav__icon">📁</span>
          <span>Archive</span>
        </a>
        <a
          href="/#settings"
          id="mobileTabSettingsBtn"
          class="retro-mobile-nav__item"
          onclick="switchDashboardTab('settings', event)"
        >
          <span class="retro-mobile-nav__icon">⚙️</span>
          <span>Config</span>
        </a>
        <a
          href="/#embeds"
          id="mobileTabEmbedsBtn"
          class="retro-mobile-nav__item"
          onclick="switchDashboardTab('embeds', event)"
        >
          <span class="retro-mobile-nav__icon">⎘</span>
          <span>Embeds</span>
        </a>
        <button
          type="button"
          id="mobileTabAimBtn"
          class="retro-mobile-nav__item"
          title="Open Neogram Instant Messenger"
        >
          <span class="retro-mobile-nav__icon">💬</span>
          <span>NIM</span>
        </button>
      </nav>
    {% endif %}

    <!-- PWA Service Worker & Carrier Telemetry Engine -->
    <script src="/js/pwa.js"></script>

    {% block scripts %}{% endblock %}
  </body>
</html>
