  async function testNeocitiesApiConnection() {
    if (window.retroAudio) window.retroAudio.playClick();
    var testBtn = document.getElementById('testConnectionBtn');
    var apiKey = document.getElementById('settingsApiKey').value.trim();
    var sitename = document.getElementById('settingsSiteName').value.trim();
    var indicator = document.getElementById('remoteNodeIndicator');
    var deployType = document.getElementById('settingsDeployType').value;
    var providerName = deployType === 'github' ? 'GitHub' : (deployType === 'nekoweb' ? 'Nekoweb' : 'Neocities');
    var testEndpoint = deployType === 'github' ? '/api/settings/test-github' : (deployType === 'nekoweb' ? '/api/settings/test-nekoweb' : '/api/settings/test-neocities');

    testBtn.disabled = true;
    testBtn.textContent = 'PROBING...';
    indicator.textContent = 'NEGOTIATING...';
    indicator.className = 'text-xs font-mono text-mac';

    appendTelemetryLog('Pinging ' + providerName + ' REST API (' + testEndpoint + ')...');

    try {
      var bodyPayload = { apiKey: apiKey };
      if (deployType === 'github') {
        bodyPayload.repo = sitename;
      }

      var res = await fetch(testEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyPayload)
      });

      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Connection refused.');

      var info = data.info;
      indicator.textContent = 'ONLINE [VERIFIED]';
      indicator.className = 'text-xs font-mono text-prompt font-bold';

      if (deployType === 'github') {
        var repoTitle = info.fullName || (info.owner + '/' + (info.repo || ''));
        document.getElementById('remoteSitename').textContent = repoTitle;
        document.getElementById('remoteViews').textContent = info.isPrivate ? 'PRIVATE REPO' : 'PUBLIC REPO';
        document.getElementById('remoteHits').textContent = 'Branch: ' + (info.branch || 'gh-pages');
        document.getElementById('remoteLastUpdated').textContent = info.updatedAt ? new Date(info.updatedAt).toLocaleString() : 'N/A';
        document.getElementById('remoteProfileLink').href = info.pagesUrl || ('https://github.com/' + repoTitle);
        appendTelemetryLog('Verified GitHub repo "' + repoTitle + '" | Default branch: ' + info.defaultBranch);
      } else if (deployType === 'nekoweb') {
        var domain = info.domain || 'site';
        document.getElementById('remoteSitename').textContent = domain + (domain.includes('.') ? '' : '.nekoweb.org');
        document.getElementById('remoteViews').textContent = Number(info.views || 0).toLocaleString();
        document.getElementById('remoteHits').textContent = Number(info.followers || 0).toLocaleString() + ' followers';
        document.getElementById('remoteLastUpdated').textContent = info.last_updated ? new Date(info.last_updated).toLocaleString() : 'N/A';
        document.getElementById('remoteProfileLink').href = 'https://' + domain + (domain.includes('.') ? '' : '.nekoweb.org');
        appendTelemetryLog('Verified Nekoweb site "' + domain + '" | Views: ' + info.views);
      } else {
        document.getElementById('remoteSitename').textContent = info.sitename + '.neocities.org';
        document.getElementById('remoteViews').textContent = Number(info.views).toLocaleString();
        document.getElementById('remoteHits').textContent = Number(info.hits).toLocaleString();
        document.getElementById('remoteLastUpdated').textContent = info.last_updated ? new Date(info.last_updated).toLocaleString() : 'N/A';
        document.getElementById('remoteProfileLink').href = 'https://neocities.org/site/' + info.sitename;
        appendTelemetryLog('Verified site "' + info.sitename + '" | Views: ' + info.views + ' | Hits: ' + info.hits);
      }
      if (window.retroAudio) window.retroAudio.playSuccess();
    } catch (err) {
      indicator.textContent = 'AUTH FAILED';
      indicator.className = 'text-xs font-mono text-crimson font-bold';
      appendTelemetryLog(providerName + ' probe failed: ' + err.message, true);
      if (window.retroAudio) window.retroAudio.playError();
      alert(providerName + ' API Test Failed: ' + err.message);
    } finally {
      testBtn.disabled = false;
      testBtn.textContent = 'TEST CONNECTION';
    }
  }

