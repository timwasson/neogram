      if (desktopPushInput) desktopPushInput.checked = !!p.desktopPush;

      // Update push permission button state
      var pushBtn = document.getElementById('requestPushPermissionBtn');
      if (pushBtn && typeof Notification !== 'undefined') {
        if (Notification.permission === 'granted') {
          pushBtn.innerHTML = '<span>✓ PERMITTED</span>';
          pushBtn.className = 'pixel-btn pixel-btn--sm pixel-btn--green text-3xs font-bold shrink-0 self-center';
        } else if (Notification.permission === 'denied') {
          pushBtn.innerHTML = '<span>✕ BLOCKED IN BROWSER</span>';
          pushBtn.className = 'pixel-btn pixel-btn--sm pixel-btn--danger text-3xs font-bold shrink-0 self-center';
        }
      }
    } catch (err) {
      console.warn('[:> NOTIFY SETTINGS LOAD ERROR]', err);
    }
  }

  async function handleSaveNotificationSettings(e) {
    if (e) e.preventDefault();
    if (window.retroAudio) window.retroAudio.playClick();

    var saveBtn = document.getElementById('saveNotifySettingsBtn');
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = 'SYNCHRONIZING PROTOCOLS...';
    }

    var alertBox = document.getElementById('notifySettingsAlert');
    var alertTag = document.getElementById('notifySettingsAlertTag');
    var alertMsg = document.getElementById('notifySettingsAlertMsg');
    if (alertBox) alertBox.classList.add('hidden');

    try {
      var payload = {
        notifyNim: document.getElementById('notifyNimInput').checked,
        notifyFollow: document.getElementById('notifyFollowInput').checked,
        notifyCommentOwn: document.getElementById('notifyCommentOwnInput').checked,
        notifyCommentThread: document.getElementById('notifyCommentThreadInput').checked,
        notifyGuestbook: document.getElementById('notifyGuestbookInput').checked,
        notifyLike: document.getElementById('notifyLikeInput').checked,
        notifyFriendPost: document.getElementById('notifyFriendPostInput').checked,
        notifyDeploy: document.getElementById('notifyDeployInput').checked,
        soundEnabled: document.getElementById('notifySoundInput').checked,
        desktopPush: document.getElementById('notifyDesktopPushInput').checked,
      };

      var res = await fetch('/api/settings/notifications', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to update notification protocols.');

      if (alertBox && alertTag && alertMsg) {
        alertBox.className = 'retro-alert retro-alert--success mb-3';
        alertTag.textContent = '[✓] PROTOCOLS SAVED:';
        alertMsg.textContent = 'Cyberspace transmission filters updated. Alerts are active for this station.';
        alertBox.classList.remove('hidden');
      }

      if (window.retroAudio) window.retroAudio.playSuccess();
    } catch (err) {
      if (window.retroAudio) window.retroAudio.playError();
      if (alertBox && alertTag && alertMsg) {
        alertBox.className = 'retro-alert retro-alert--error mb-3';
        alertTag.textContent = '[:> ERROR]:';
        alertMsg.textContent = err.message;
        alertBox.classList.remove('hidden');
      }
    } finally {
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = '💾 SAVE NOTIFICATION PROTOCOLS :>';
      }
    }
  }

  function requestBrowserPushPermission() {
    if (window.retroAudio) window.retroAudio.playClick();
    if (typeof Notification === 'undefined') {
      alert('Desktop Push Notifications are not supported by this browser.');
      return;
    }

    Notification.requestPermission().then(function(permission) {
      var pushBtn = document.getElementById('requestPushPermissionBtn');
      var pushCheckbox = document.getElementById('notifyDesktopPushInput');

      if (permission === 'granted') {
        if (pushCheckbox) pushCheckbox.checked = true;
        if (pushBtn) {
          pushBtn.innerHTML = '<span>✓ PERMITTED</span>';
          pushBtn.className = 'pixel-btn pixel-btn--sm pixel-btn--green text-3xs font-bold shrink-0 self-center';
        }
        if (window.retroAudio) window.retroAudio.playSuccess();
        alert('Cyberspace alert carrier permitted! Click "Save Notification Protocols" to commit changes.');
      } else {
        if (pushBtn) {
          pushBtn.innerHTML = '<span>✕ BLOCKED IN BROWSER</span>';
          pushBtn.className = 'pixel-btn pixel-btn--sm pixel-btn--danger text-3xs font-bold shrink-0 self-center';
        }
      }
    });
  }

  function copyPostWebUrl(url, btn) {
    if (window.retroAudio) window.retroAudio.playClick();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(function() {
        if (btn) {
          var origHtml = btn.innerHTML;
          btn.innerHTML = '<span>✓ COPIED!</span>';
          btn.classList.add('pixel-btn--green');
          setTimeout(function() {
            btn.innerHTML = origHtml;
            btn.classList.remove('pixel-btn--green');
          }, 2000);
        }
      }).catch(function() {
        prompt('Copy live photo URL:', url);
      });
    } else {
      prompt('Copy live photo URL:', url);
    }
  }

  async function openEditModalById(id) {
    if (window.retroAudio) window.retroAudio.playClick();
    try {
      var res = await fetch('/api/posts/' + id);
      var data = await res.json();
      if (!res.ok || !data.ok || !data.post) {
        throw new Error(data.error || 'Could not load post data.');
      }
      var post = data.post;
      document.getElementById('editPostId').value = post.id;
      document.getElementById('editCaptionInput').value = post.caption || '';
      document.getElementById('editFilterSelect').value = post.filterApplied || 'none';

      var alertBox = document.getElementById('editModalAlert');
      alertBox.classList.add('hidden');

      var dialog = document.getElementById('editModalDialog');
      if (dialog && typeof dialog.showModal === 'function') {
        dialog.showModal();
      }
    } catch (err) {
      try {
        if (window.retroAudio && typeof window.retroAudio.playError === 'function') {
          window.retroAudio.playError();
        }
      } catch(e) {}
      alert('Error opening edit dialog: ' + err.message);
    }
  }

  function closeEditModal() {
    try {
      if (window.retroAudio && typeof window.retroAudio.playClick === 'function') {
        window.retroAudio.playClick();
      }
    } catch(e) {}
    var dialog = document.getElementById('editModalDialog');
    if (dialog && dialog.open) {
      dialog.close();
    }
  }

  async function handleSaveEditPost(e) {
    e.preventDefault();
    var id = document.getElementById('editPostId').value;
    var caption = document.getElementById('editCaptionInput').value.trim();
    var filterApplied = document.getElementById('editFilterSelect').value;
    var saveBtn = document.getElementById('editSaveBtn');

    saveBtn.disabled = true;
    saveBtn.textContent = 'SAVING...';
    try {
      if (window.retroAudio && typeof window.retroAudio.playClick === 'function') {
        window.retroAudio.playClick();
      }
    } catch(e) {}

    try {
      var res = await fetch('/api/posts/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          caption: caption,
          filterApplied: filterApplied
        })
      });

      var data = await res.json();
      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Failed to update post.');
      }

      // Update DOM card
      var captionEl = document.getElementById('manage-caption-' + id);
      if (captionEl) captionEl.textContent = caption;

      var filterEl = document.getElementById('manage-filter-' + id);
      if (filterEl) filterEl.textContent = 'shader: ' + filterApplied;

      var imgEl = document.getElementById('manage-img-' + id);
      if (imgEl) {
        imgEl.className = 'max-h-full max-w-full object-contain filter-' + filterApplied;
      }

      try {
        if (window.retroAudio && typeof window.retroAudio.playSuccess === 'function') {
          window.retroAudio.playSuccess();
        }
      } catch(e) {}
      closeEditModal();

    } catch (err) {
      try {
        if (window.retroAudio && typeof window.retroAudio.playError === 'function') {
          window.retroAudio.playError();
        }
      } catch(e) {}
      var alertBox = document.getElementById('editModalAlert');
      var tag = document.getElementById('editModalAlertTag');
      var msg = document.getElementById('editModalAlertMsg');
      alertBox.className = 'retro-alert retro-alert--error mb-3';
      tag.textContent = '[:> ERROR]:';
      msg.textContent = err.message;
      alertBox.classList.remove('hidden');
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = '💾 SAVE CHANGES :>';
    }
  }

  async function confirmDeletePost(id) {
    if (!confirm('[:> SECURITY WARNING]\nPermanently delete transmission from PostgreSQL database and disk?')) {
      return;
    }

    if (window.retroAudio) window.retroAudio.playClick();

    try {
      var res = await fetch('/api/posts/' + id, { method: 'DELETE' });
      var data = await res.json();

      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Failed to delete transmission.');
      }

      // Remove card from DOM
      var card = document.getElementById('manage-post-' + id);
      if (card) {
        card.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.95)';
        setTimeout(function() {
          card.remove();
          // Update counters
          var badge = document.getElementById('manageCountBadge');
          var total = document.getElementById('manageTotalCount');
          var current = parseInt(badge ? badge.textContent : '1', 10);
          if (badge) badge.textContent = Math.max(0, current - 1);
          if (total) total.textContent = Math.max(0, current - 1);
        }, 200);
      }

      if (window.retroAudio) window.retroAudio.playSuccess();

    } catch (err) {
      if (window.retroAudio) window.retroAudio.playError();
      alert('Delete failed: ' + err.message);
    }
  }

  var currentModPostId = null;

  async function openCommentsModalById(postId) {
    currentModPostId = postId;
    if (window.retroAudio) window.retroAudio.playClick();
    var list = document.getElementById('commentsModalList');
    list.innerHTML = '<div class="text-xs text-muted text-center py-4">Loading comments from static host...</div>';

    var dialog = document.getElementById('commentsModalDialog');
    if (dialog && typeof dialog.showModal === 'function') {
      dialog.showModal();
    }

    try {
      var res = await fetch('/api/posts/' + postId + '/comments');
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to load comments');

      var comments = data.comments || [];
      if (comments.length === 0) {
        list.innerHTML = '<div class="text-xs text-muted text-center py-4">:&gt; No comments found in this photo\'s self-hosted ledger.</div>';
        return;
      }

      list.innerHTML = '';
      comments.forEach(function(c) {
        var card = document.createElement('div');
        card.className = 'retro-card p-2 text-xs flex flex-col gap-1 border border-main bg-window';
        card.id = 'comment-card-' + c.id;
        var uinBadge = c.uin ? ' <span class="text-muted font-normal">[#' + c.uin + ']</span>' : '';
        var profileUrl = '/user/' + (c.userId || encodeURIComponent(c.author));
        var siteLink = c.siteUrl ? ' <a href="' + escapeHtml(c.siteUrl) + '" target="_blank" rel="noopener" class="text-xs" title="Visit personal website">🌐</a>' : '';
        var timeStr = '';
        if (c.timestamp) {
          try {
            var d = new Date(c.timestamp);
            timeStr = ' <span class="text-muted text-[10px] font-normal">(' + d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ', ' + d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) + ')</span>';
          } catch (_e) {}
        }

        card.innerHTML = 
          '<div class="flex items-center justify-between border-b border-main pb-1">' +
          '  <div class="flex items-center gap-1 font-bold flex-wrap">' +
          '    <span>' + (c.avatar || '💬') + '</span>' +
          '    <a href="' + escapeHtml(profileUrl) + '" target="_blank" class="text-mac underline" title="View profile on Neogram">@' + escapeHtml(c.author) + '</a>' + uinBadge + siteLink + timeStr +
          '  </div>' +
          '  <button type="button" onclick="purgeComment(\'' + escapeHtml(c.id) + '\')" class="pixel-btn pixel-btn--sm pixel-btn--red font-bold text-xs py-0.5 px-2" title="Purge from static host">' +
          '    <span>🗑️ Purge</span>' +
          '  </button>' +
          '</div>' +
          '<p class="p-1 font-mono text-xs whitespace-pre-wrap leading-relaxed">' + escapeHtml(c.text) + '</p>';
        list.appendChild(card);
      });
    } catch (err) {
      list.innerHTML = '<div class="text-xs text-crimson text-center py-4 font-bold">Error reading static comments: ' + escapeHtml(err.message) + '</div>';
    }
  }

  function closeCommentsModal() {
    if (window.retroAudio) window.retroAudio.playClick();
    var dialog = document.getElementById('commentsModalDialog');
    if (dialog && dialog.open) dialog.close();
  }

  async function purgeComment(commentId) {
    if (!currentModPostId) return;
    if (!confirm('[:> Confirm purge: Delete this comment permanently from your static host JSON file?]')) {
      return;
    }
    if (window.retroAudio) window.retroAudio.playClick();

    try {
      var res = await fetch('/api/posts/' + currentModPostId + '/comments/' + commentId, {
        method: 'DELETE'
      });
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to purge comment');

      var card = document.getElementById('comment-card-' + commentId);
      if (card) card.remove();

      var countEl = document.getElementById('post-comment-count-' + currentModPostId);
      if (countEl) {
        var curr = Math.max(0, parseInt(countEl.textContent || '0', 10) - 1);
        countEl.textContent = curr;
      }

      if (window.retroAudio) window.retroAudio.playSuccess();
    } catch (err) {
      if (window.retroAudio) window.retroAudio.playError();
      alert('Error purging comment: ' + err.message);
    }
  }

  window.openCommentsModalById = openCommentsModalById;
  window.closeCommentsModal = closeCommentsModal;
  window.purgeComment = purgeComment;

  async function triggerStaticRebuild() {
    var btn = document.getElementById('rebuildStaticBtn');
    var alertBox = document.getElementById('rebuildAlert');
    var tag = document.getElementById('rebuildAlertTag');
    var msg = document.getElementById('rebuildAlertMsg');

    btn.disabled = true;
    btn.textContent = '🔄 COMPILING 11TY...';
    if (window.retroAudio) window.retroAudio.playClick();

    try {
      var res = await fetch('/api/build-static', { method: 'POST' });
      var data = await res.json();

      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Compilation failed.');
      }

      alertBox.className = 'retro-alert retro-alert--success mb-3';
      tag.textContent = data.deployed ? '[✓] 11TY DEPLOYED:' : '[✓] 11TY COMPILED:';
      msg.textContent = data.deployed
        ? (data.filesCount + ' files uploaded live to ' + (data.siteUrl || 'Neocities') + ' in ' + data.durationMs + 'ms')
        : (data.postsCount + ' photos generated in ' + data.durationMs + 'ms -> dist/static-gallery');
      alertBox.classList.remove('hidden');

      if (window.retroAudio) window.retroAudio.playSuccess();
    } catch (err) {
      if (window.retroAudio) window.retroAudio.playError();
      alertBox.className = 'retro-alert retro-alert--error mb-3';
      tag.textContent = '[:> BUILD ERROR]:';
      msg.textContent = err.message;
      alertBox.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = '🔄 Rebuild 11ty Static Site';
    }
  }

  // Native HTML5 <dialog> Event Handlers (Esc key & light dismiss)
  document.addEventListener('DOMContentLoaded', function () {
    var dialog = document.getElementById('editModalDialog');
    if (dialog) {
      // Play retro audio when dismissed natively via Esc
      dialog.addEventListener('cancel', function () {
        if (window.retroAudio) window.retroAudio.playClick();
      });

      // Light-dismiss: close when clicking on backdrop
      dialog.addEventListener('click', function (e) {
        if (e.target !== dialog) return;
        var rect = dialog.getBoundingClientRect();
        var isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          closeEditModal();
        }
      });
    }
  });
</script>
{% endif %}
{% endblock %}
