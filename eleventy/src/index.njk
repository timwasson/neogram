---
layout: layouts/base.njk
title: Static Photo Stream
rootPath: .
---
{% set rel = rootPath or '.' %}

<!-- ==============================================================
     INSTAGRAM-STYLE PROFILE HEADER
     ============================================================== -->
<section class="neogram-profile" data-author="{{ site.author | upper }}">
  <div class="neogram-profile__avatar-frame">
    <img
      src="{% if site.avatarUrl and site.avatarUrl.indexOf('/') == 0 %}{{ rel }}{{ site.avatarUrl }}{% else %}{{ site.avatarUrl or (rel + '/icons/default-avatar.svg') }}{% endif %}"
      alt="@{{ site.author }}"
      class="neogram-profile__avatar"
      onerror="this.onerror=null;this.src='{{ rel }}/icons/default-avatar.svg';"
    />
  </div>

  <div class="neogram-profile__info">
    <div class="neogram-profile__header">
      <h1 class="neogram-profile__handle">@{{ site.author }}</h1>
      <div class="neogram-profile__actions">
        <a href="{{ rel }}/friends/" class="neogram-btn neogram-btn--sm">
          <span>Friends Grid</span>
        </a>
        <button
          type="button"
          id="staticFriendBtn"
          onclick="handleStaticFriendToggle()"
          class="neogram-btn neogram-btn--green neogram-btn--sm"
          style="display: none;"
        >
          <span id="staticFriendBtnText">+ Add Friend</span>
        </button>
      </div>
    </div>

    <div class="neogram-profile__stats">
      <span class="neogram-profile__stat"><strong>{{ posts.length }}</strong> posts</span>
    </div>

    {% if site.description %}
      <p class="neogram-profile__description">{{ site.description }}</p>
    {% endif %}

    {% if site.baseSiteUrl and site.baseSiteUrl != site.neocitiesUrl %}
      <a href="{{ site.baseSiteUrl }}" target="_blank" rel="noopener noreferrer" class="neogram-profile__link">
        {{ site.baseSiteUrl }} ↗
      </a>
    {% endif %}
  </div>
</section>

<!-- ==============================================================
     STATIC PHOTO GRID
     ============================================================== -->
{% if posts.length == 0 %}
  <div class="neogram-empty">
    <div class="neogram-empty__title">[:&gt; NO PHOTOS BROADCAST TO STATIC REPO YET]</div>
    <p class="neogram-empty__desc">
      Log into your Neogram Workstation to upload your first photograph and trigger the 11ty build pipeline.
    </p>
    <div class="neogram-empty__action">
      <a href="{{ site.apiUrl or 'http://localhost:4000' }}" class="neogram-btn neogram-btn--green neogram-btn--lg">
        <span>Open Neogram Creator Studio</span>
      </a>
    </div>
  </div>
{% else %}
  <div class="neogram-grid">
    {% for post in posts %}
      <article class="neogram-card">
        <!-- Thumbnail Viewport with CRT & Filter Shaders -->
        {% if post.photos and post.photos.length > 1 %}
          <div class="neogram-slider neogram-slider--card">
            <div class="neogram-slider__track" tabindex="0" role="region" aria-label="Photo carousel slider">
              {% for pic in post.photos %}
                <a href="{{ rel }}/photos/{{ post.id }}/" class="neogram-slider__slide" id="card-{{ post.id }}-{{ loop.index }}" title="{{ post.caption }}">
                  <img
                    src="{{ (pic.thumbnailPath or pic.imagePath) | mediaUrl(rel) }}"
                    alt="{{ post.caption }} ({{ loop.index }}/{{ post.photos.length }})"
                    class="neogram-slider__image filter-{{ post.filterApplied or 'none' }}"
                    loading="lazy"
                    onerror="this.classList.add('neogram-img--broken'); if(this.parentElement) this.parentElement.classList.add('has-broken-image');"
                  />
                </a>
              {% endfor %}
            </div>
            <div class="neogram-slider__nav" aria-label="Slide navigation dots">
              {% for pic in post.photos %}
                <a href="#card-{{ post.id }}-{{ loop.index }}" class="neogram-slider__dot" aria-label="Slide {{ loop.index }} of {{ post.photos.length }}"></a>
              {% endfor %}
            </div>
            <div class="neogram-slider__counter">
              <span class="neogram-badge neogram-badge--cyan">⧉ {{ post.photos.length }}</span>
            </div>
          </div>
        {% else %}
          <a href="{{ rel }}/photos/{{ post.id }}/" class="neogram-card__media" title="{{ post.caption }}">
            <img
              src="{{ (post.thumbnailPath or post.imagePath) | mediaUrl(rel) }}"
              alt="{{ post.caption }}"
              class="neogram-card__image filter-{{ post.filterApplied or 'none' }}"
              loading="lazy"
              onerror="this.classList.add('neogram-img--broken'); if(this.parentElement) this.parentElement.classList.add('has-broken-image');"
            />
          </a>
        {% endif %}

        <!-- Metadata & Caption Card Body -->
        <div class="neogram-card__body">
          <div class="neogram-card__content">
            <div class="neogram-card__meta">
              {% if post.location %}
                <span class="neogram-card__location">{{ post.location }}</span>
              {% endif %}
              <span class="neogram-card__date">{{ post.createdAt | formatDate }}</span>
            </div>

            {% if post.caption %}
              <p class="neogram-card__caption">
                {{ post.caption }}
              </p>
            {% endif %}
          </div>

          <div class="neogram-card__footer">
            <span class="neogram-card__likes">
              <strong>{{ post.likes or 0 }}</strong> likes
            </span>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
{% endif %}

<!-- Friend / Follow Static Bridge Script -->
<script>
  (function () {
    var API_BASE = '{{ site.apiUrl or "http://localhost:4000" }}';
    var STATION_AUTHOR = '{{ site.author }}';
    // ---- Cyber-Pass verification: the Neogram server is the ONLY authority for who is signed in ----
    var NG_PASS_API = (function () { try { return new URL(API_BASE, window.location.href).origin; } catch (_e) { return window.location.origin; } })();
    function ngIsTrustedPassOrigin(o) { return o === window.location.origin || o === NG_PASS_API; }
    function ngVerifyPass(token, cb) {
      if (typeof token !== 'string' || !/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(token) || !window.fetch) { cb(null); return; }
      fetch(NG_PASS_API + '/api/pass/verify', { headers: { Authorization: 'Bearer ' + token } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) { cb(d && d.ok && d.handle ? { token: token, handle: String(d.handle), uin: d.uin || null, avatar: d.avatar || '', verified: true } : null); })
        .catch(function () { cb(null); });
    }
    function ngStoredPass() {
      try { var raw = localStorage.getItem('neogram_pass'); return raw && raw.charAt(0) === '{' ? JSON.parse(raw) : null; } catch (_e) { return null; }
    }
    function ngSavePass(v) { try { localStorage.setItem('neogram_pass', JSON.stringify(v)); } catch (_e) {} }
    function ngTakeHashPassToken() {
      if (!window.location.hash || window.location.hash.indexOf('neogram_pass=') === -1) return '';
      var token = '';
      try {
        var parsed = JSON.parse(decodeURIComponent(window.location.hash.split('neogram_pass=')[1].split('&')[0]));
        token = parsed && typeof parsed.token === 'string' ? parsed.token : '';
      } catch (_e) {}
      try {
        if (window.history && window.history.replaceState) {
          var cleanHash = window.location.hash.replace(/#?neogram_pass=[^&]*&?/, '').replace(/^&/, '');
          window.history.replaceState(null, '', window.location.pathname + window.location.search + (cleanHash ? '#' + cleanHash : ''));
        }
      } catch (_e) {}
      return token;
    }
    // A #neogram_pass link can be crafted by anyone (login CSRF): verify it server-side, and ask before it
    // signs this browser in as a different identity than the one already stored.
    function ngAdoptHashPass(onAdopted) {
      var token = ngTakeHashPassToken();
      if (!token) return;
      ngVerifyPass(token, function (v) {
        if (!v) return;
        var cur = ngStoredPass();
        var same = cur && cur.verified && cur.handle === v.handle;
        if (!same && !window.confirm('Sign in to this site as @' + v.handle + ' with your Neogram Cyber-Pass?' + (cur && cur.handle ? '\n\nThis replaces @' + cur.handle + '.' : ''))) return;
        ngSavePass(v);
        if (onAdopted) onAdopted(v);
      });
    }
    // Passes delivered by the Neogram popup / extension: still stored only as the server vouches for them
    function ngAdoptMessagePass(token, onAdopted) {
      ngVerifyPass(token, function (v) {
        if (!v) return;
        ngSavePass(v);
        if (onAdopted) onAdopted(v);
      });
    }
    // Passes stored before verification existed (or planted by an old link) are re-checked once
    function ngRevalidateStoredPass(onChange) {
      var raw = null;
      try { raw = localStorage.getItem('neogram_pass'); } catch (_e) {}
      if (!raw) return;
      var cur = ngStoredPass();
      if (cur && cur.verified) return;
      var token = cur ? cur.token : raw;
      ngVerifyPass(token, function (v) {
        if (v) ngSavePass(v); else { try { localStorage.removeItem('neogram_pass'); } catch (_e) {} }
        if (onChange) onChange(v);
      });
    }
    // ---- end Cyber-Pass verification ----
    var friendBtn = document.getElementById('staticFriendBtn');
    var friendText = document.getElementById('staticFriendBtnText');
    var isFriendState = false;

    function getPass() {
      try {
        var raw = localStorage.getItem('neogram_pass');
        return raw ? JSON.parse(raw) : null;
      } catch (e) {
        return null;
      }
    }

    async function checkFriendStatus() {
      var pass = getPass();
      if (!pass || !pass.handle) {
        // Show "Add Friend" for logged out visitors (will open Cyber-Pass modal)
        if (friendBtn) {
          friendBtn.style.display = 'inline-flex';
          friendText.textContent = '+ Add Friend';
        }
        return;
      }

      // If own station, do not show Add Friend
      if (pass.handle.toLowerCase() === STATION_AUTHOR.toLowerCase()) {
        if (friendBtn) friendBtn.style.display = 'none';
        return;
      }

      if (friendBtn) friendBtn.style.display = 'inline-flex';

      try {
        var headers = {};
        if (pass.token) headers['Authorization'] = 'Bearer ' + pass.token;
        var res = await fetch(API_BASE + '/api/users/' + encodeURIComponent(STATION_AUTHOR) + '/friend-status', {
          headers: headers,
          credentials: 'omit'
        });
        var data = await res.json();
        if (data.ok) {
          isFriendState = !!data.isFriend;
          updateButtonUI();
        }
      } catch (err) {
        console.warn('[:> FRIEND STATUS CHECK]', err);
      }
    }

    function updateButtonUI() {
      if (!friendBtn || !friendText) return;
      if (isFriendState) {
        friendBtn.classList.remove('neogram-btn--green');
        friendBtn.classList.add('neogram-btn--yellow');
        friendText.textContent = '✓ Friends (Unfriend)';
      } else {
        friendBtn.classList.remove('neogram-btn--yellow');
        friendBtn.classList.add('neogram-btn--green');
        friendText.textContent = '+ Add Friend';
      }
    }

    window.handleStaticFriendToggle = async function () {
      if (window.retroAudio) window.retroAudio.playClick();
      var pass = getPass();
      if (!pass || !pass.token) {
        // Pop up Cyber-Pass login modal
        var origin = encodeURIComponent(window.location.origin);
        var popupUrl = API_BASE + '/auth/connect?origin=' + origin;
        window.open(popupUrl, 'neogram_auth', 'width=440,height=480,menubar=no,toolbar=no,location=no');
        return;
      }

      var method = isFriendState ? 'DELETE' : 'POST';
      try {
        var res = await fetch(API_BASE + '/api/users/' + encodeURIComponent(STATION_AUTHOR) + '/follow', {
          method: method,
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + pass.token
          }
        });
        if (res.status === 401) {
          // Friend-list changes need a full Neogram session (a Cyber-Pass only covers likes, comments,
          // guestbook & pager): finish the action on the station's neogram.club profile.
          window.open(API_BASE + '/user/' + encodeURIComponent(STATION_AUTHOR), '_blank', 'noopener');
          return;
        }
        var data = await res.json();
        if (data.ok) {
          if (window.retroAudio) window.retroAudio.playSuccess();
          isFriendState = !isFriendState;
          updateButtonUI();
        } else {
          alert('[:> FRIEND FAULT] ' + (data.error || 'Could not update friend status'));
        }
      } catch (e) {
        alert('[:> NETWORK ERROR] ' + e.message);
      }
    };

    // Listen for Cyber-Pass handshake if opened in popup
    window.addEventListener('message', function (e) {
      if (!ngIsTrustedPassOrigin(e.origin)) return;
      if (e.data && (e.data.type === 'NEOGRAM_CYBER_PASS' || e.data.type === 'NEOGRAM_EXTENSION_PASS')) {
        ngAdoptMessagePass(e.data.token, checkFriendStatus);
      }
    });

    // Check for Smart Handoff / Mobile Cyber-Pass payload in URL hash
    function ingestPassFromHash() {
      ngAdoptHashPass(function () { checkFriendStatus(); });
    }
    ngRevalidateStoredPass(function () { checkFriendStatus(); });

    document.addEventListener('DOMContentLoaded', function () {
      ingestPassFromHash();
      checkFriendStatus();
    });
    ingestPassFromHash();
    checkFriendStatus();
  })();
</script>
