{% extends "layouts/base.njk" %}

{% block content %}
<div class="max-w-xl w-full mx-auto p-4 flex-1 flex items-center justify-center">
  <div class="pixel-box text-center p-6 w-full">
    <div class="font-pixel text-2xl text-crimson mb-3">
      404
    </div>
    <h2 class="font-mono text-lg mb-3">
      FILE NOT FOUND IN SECTOR
    </h2>
    {% if message %}
      <div class="retro-alert retro-alert--error font-mono text-xs mb-4">
        {{ message }}
      </div>
    {% else %}
      <p class="text-sm text-muted mb-5 leading-normal">
        There's nothing at <code class="text-code">{{ url }}</code>. The link may be old or mistyped.
      </p>
    {% endif %}
    <a href="/" class="pixel-btn pixel-btn--yellow font-bold" onclick="if(window.retroAudio) retroAudio.playClick();">
      &lt; Go to the homepage
    </a>
  </div>
</div>
{% endblock %}
