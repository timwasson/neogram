  var selectedAvatarFile = null;
  var isAvatarRemoved = false;

  function handleAvatarFileChange(e) {
    var file = e.target.files && e.target.files[0];
    if (!file) return;

    if (!file.type || !file.type.startsWith('image/')) {
      alert('Selected file must be an image format (PNG, JPEG, GIF, WebP).');
      return;
    }

    selectedAvatarFile = file;
    isAvatarRemoved = false;

    var reader = new FileReader();
    reader.onload = function(evt) {
      var preview = document.getElementById('settingsAvatarPreview');
      if (preview) preview.src = evt.target.result;
      var badge = document.getElementById('avatarStatusBadge');
      if (badge) badge.textContent = 'NEW (UNSAVED)';
    };
    reader.readAsDataURL(file);

    try {
      if (window.retroAudio && typeof window.retroAudio.playShutter === 'function') {
        window.retroAudio.playShutter();
      }
    } catch(e) {}
  }

