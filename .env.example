# Neogram Environment Configuration

PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# PostgreSQL Database (Local or Managed on DigitalOcean)
DATABASE_URL=postgres://neogram:neogram_secret@localhost:5432/neogram
POSTGRES_PASSWORD= # Required by docker-compose; must match password in DATABASE_URL

# Security Keys
# Generate strong 48-byte hex secrets with: openssl rand -hex 48
JWT_SECRET=
ENCRYPTION_SECRET=
# Key rotation window: keeps previous secret readable while re-encrypting with current
ENCRYPTION_SECRET_PREVIOUS=

# SysOp & Security Guards
# Comma-separated emails granted administrator access to /admin and /api/admin
ADMIN_EMAILS=sysop@yourdomain.com
# Dev only: echoes OTP code in API response and console. Ignored when NODE_ENV=production.
ALLOW_DEMO_OTP=false

# ==============================================================================
# Transactional Auth Dispatches (Email & SMS)
# In development, OTP codes log to console only when ALLOW_DEMO_OTP=true.
# In production, valid provider credentials are required.
# ==============================================================================

# Resend Email Delivery (Free Tier: 3,000 emails/month at resend.com)
RESEND_API_KEY=
EMAIL_FROM="Neogram <auth@yourdomain.com>"

# Twilio SMS Delivery ($1.15/mo phone number + $0.0079/text at twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15551234567

# ==============================================================================
# Web Push Protocols (iOS PWA & Desktop Background Alerts)
# If left empty, Neogram auto-generates a persistent keypair on startup.
# ==============================================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sysop@neogram.club
