              <pre class="docs-code-pre" id="codeFeedFetch">&lt;!-- Container for recent photos --&gt;
&lt;div id="neogram-feed"&gt;Loading photos...&lt;/div&gt;

&lt;script&gt;
  (async function() {
    // Feed fields are user-written text: build DOM nodes with textContent, never innerHTML.
    const safeUrl = (u) =&gt; (typeof u === 'string' &amp;&amp; /^https?:\/\//i.test(u) ? u : '');
    const el = document.getElementById('neogram-feed');
    try {
      const res = await fetch('{{ appUrl }}/api/users/{{ stationHandle }}/feed.json');
      const data = await res.json();
      el.textContent = '';
      if (!data.items || data.items.length === 0) {
        el.textContent = 'No photos yet.';
        return;
      }
      for (const post of data.items) {
        const card = document.createElement('div');
        card.style.cssText = 'border: 2px solid #000; margin-bottom: 12px; padding: 8px; background: #fff;';
        const img = document.createElement('img');
        img.src = safeUrl(post.thumbnailUrl || post.image);
        img.alt = post.caption || 'Photo';
        img.style.cssText = 'max-width: 100%; display: block;';
        const caption = document.createElement('p');
        caption.style.cssText = 'font-family: monospace; font-size: 11px; margin-top: 6px;';
        caption.textContent = post.caption || '';
        card.append(img, caption);
        el.appendChild(card);
      }
    } catch (err) {
      console.error(err);
    }
  })();
&lt;/script&gt;</pre>
