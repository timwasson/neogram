{% block scripts %}
{% if currentUser %}
<script>
  var currentFilter = 'crt';
  var selectedFiles = [];
  var selectedFile = null;

  function triggerFileInput(e) {
    if (e) {
      e.stopPropagation();
    }
    if (window.retroAudio) window.retroAudio.playClick();
    var input = document.getElementById('imageFileInput');
    if (input) input.click();
  }

  function triggerCameraInput(e) {
    triggerFileInput(e);
  }

  function setFilter(filter) {
    if (window.retroAudio) window.retroAudio.playClick();
    currentFilter = filter;

    var buttons = document.querySelectorAll('#filterGrid .filter-btn');
    buttons.forEach(function(btn) {
      if (btn.getAttribute('data-filter') === filter) {
        btn.classList.add('is-active');
      } else {
        btn.classList.remove('is-active');
      }
    });

    var previewImg = document.getElementById('previewImg');
    if (previewImg) {
      previewImg.className = 'preview-viewport__img filter-' + filter;
    }
  }

  function isImageFile(file) {
    if (!file) return false;
    if (file.type && file.type.startsWith('image/')) return true;
    var ext = (file.name || '').split('.').pop().toLowerCase();
    return ['jpg', 'jpeg', 'png', 'webp', 'gif', 'bmp', 'avif', 'svg'].indexOf(ext) !== -1;
  }

  function renderMultiPhotoStrip() {
    var stripEl = document.getElementById('multiPhotoStrip');
    if (!stripEl) return;
    if (selectedFiles.length <= 1) {
      stripEl.innerHTML = '';
      stripEl.classList.add('hidden');
      return;
    }

    stripEl.innerHTML = '';
    stripEl.classList.remove('hidden');

    selectedFiles.forEach(function(file, index) {
      var thumbBtn = document.createElement('button');
      thumbBtn.type = 'button';
      thumbBtn.className = 'pixel-btn pixel-btn--sm flex items-center gap-1 text-xs';
      thumbBtn.title = 'Preview ' + file.name + ' (' + (index + 1) + '/' + selectedFiles.length + ')';
      thumbBtn.innerHTML = '<span>#' + (index + 1) + '</span>';
      thumbBtn.onclick = function(e) {
        e.stopPropagation();
        var reader = new FileReader();
        reader.onload = function(ev) {
          var previewImg = document.getElementById('previewImg');
          if (previewImg) previewImg.src = ev.target.result;
          var nameSpan = document.getElementById('selectedFileName');
          if (nameSpan) nameSpan.textContent = file.name + ' (' + (index + 1) + '/' + selectedFiles.length + ')';
        };
        reader.readAsDataURL(file);
      };
      stripEl.appendChild(thumbBtn);
    });
  }

  function loadFiles(fileList) {
    if (!fileList || fileList.length === 0) return;
    var rawFiles = Array.from(fileList).filter(isImageFile);

    if (rawFiles.length === 0) {
      try {
        if (window.retroAudio && typeof window.retroAudio.playError === 'function') {
          window.retroAudio.playError();
        }
      } catch(e) {}
      showAlert('error', '[:> INVALID FILE]:', 'Selected files must be valid image formats (JPEG, PNG, WebP, GIF, BMP).');
      return;
    }

    if (rawFiles.length > 5) {
      showAlert('warning', '[:> PHOTO LIMIT EXCEEDED]:', 'Galleries are limited to 5 photos maximum. The first 5 photos have been loaded.');
      rawFiles = rawFiles.slice(0, 5);
    }

    selectedFiles = rawFiles;
    selectedFile = selectedFiles[0];

    try {
      if (window.retroAudio && typeof window.retroAudio.playShutter === 'function') {
        window.retroAudio.playShutter();
      }
    } catch(e) {}

    var reader = new FileReader();
    reader.onload = function(event) {
      var previewImg = document.getElementById('previewImg');
      var uploadDropzone = document.getElementById('uploadDropzone');
      var previewContainer = document.getElementById('previewContainer');
      var nameSpan = document.getElementById('selectedFileName');
      var sizeSpan = document.getElementById('selectedFileSize');

      if (previewImg) previewImg.src = event.target.result;

      var totalSize = selectedFiles.reduce(function(sum, f) { return sum + f.size; }, 0);
      if (nameSpan) {
        if (selectedFiles.length === 1) {
          nameSpan.textContent = selectedFiles[0].name;
        } else {
          nameSpan.textContent = selectedFiles.length + ' photos selected';
        }
      }
      if (sizeSpan) sizeSpan.textContent = '(' + (totalSize / 1024).toFixed(1) + ' KB total)';

      renderMultiPhotoStrip();

      // In-place swap: Hide upload dropzone, show live preview
      if (uploadDropzone) uploadDropzone.classList.add('hidden');
      if (previewContainer) previewContainer.classList.remove('hidden');
    };
    reader.onerror = function(err) {
      console.error('FileReader error:', err);
      showAlert('error', '[:> READ ERROR]:', 'Could not read image file from local device.');
    };
    reader.readAsDataURL(selectedFiles[0]);
  }

  function loadFile(file) {
    loadFiles([file]);
  }

  function handleFileInputChange(e) {
    if (e.target.files && e.target.files.length > 0) {
      loadFiles(e.target.files);
    }
  }

  function handleFileDrop(e) {
    e.preventDefault();
    e.stopPropagation();
    var dropEl = document.getElementById('uploadDropzone');
    var prevEl = document.getElementById('previewContainer');
    if (dropEl) dropEl.classList.remove('is-dragover');
    if (prevEl) prevEl.classList.remove('is-dragover');

    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      loadFiles(e.dataTransfer.files);
    }
  }

  function clearSelectedPhoto() {
    selectedFiles = [];
    selectedFile = null;
    var previewImg = document.getElementById('previewImg');
    var uploadDropzone = document.getElementById('uploadDropzone');
    var previewContainer = document.getElementById('previewContainer');
    var imageFileInput = document.getElementById('imageFileInput');
    var stripEl = document.getElementById('multiPhotoStrip');

    if (previewImg) previewImg.src = '';
    if (imageFileInput) imageFileInput.value = '';
    if (stripEl) {
      stripEl.innerHTML = '';
      stripEl.classList.add('hidden');
    }

    // In-place swap: Hide live preview, restore upload dropzone
    if (previewContainer) previewContainer.classList.add('hidden');
    if (uploadDropzone) uploadDropzone.classList.remove('hidden');

    try {
      if (window.retroAudio && typeof window.retroAudio.playClick === 'function') {
        window.retroAudio.playClick();
      }
    } catch(e) {}
  }

  // Setup input change listeners and drag-and-drop
  window.addEventListener('DOMContentLoaded', function() {
    var fileInput = document.getElementById('imageFileInput');
    if (fileInput) {
      fileInput.addEventListener('change', function(e) {
        if (e.target.files && e.target.files.length > 0) {
          loadFiles(e.target.files);
        }
      });
    }

    // Attach drag & drop listeners
    ['uploadDropzone', 'previewContainer'].forEach(function(id) {
      var el = document.getElementById(id);
      if (!el) return;

      el.addEventListener('dragenter', function(e) {
        e.preventDefault();
        e.stopPropagation();
        el.classList.add('is-dragover');
      });

      el.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.stopPropagation();
        e.dataTransfer.dropEffect = 'copy';
        el.classList.add('is-dragover');
      });

      el.addEventListener('dragleave', function(e) {
        e.preventDefault();
        e.stopPropagation();
        el.classList.remove('is-dragover');
      });

      el.addEventListener('drop', function(e) {
        e.preventDefault();
        e.stopPropagation();
        el.classList.remove('is-dragover');
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
          loadFiles(e.dataTransfer.files);
        }
      });
    });
  });

  function showAlert(type, tag, msg, actionHtml) {
    var box = document.getElementById('publishAlert');
    var tagEl = document.getElementById('publishAlertTag');
    var msgEl = document.getElementById('publishAlertMsg');
    box.className = 'retro-alert is-visible retro-alert--' + type;
    tagEl.textContent = tag;
    msgEl.textContent = msg;
    var actionsEl = document.getElementById('publishAlertActions');
    if (actionsEl) {
      if (actionHtml) {
        actionsEl.innerHTML = actionHtml;
        actionsEl.classList.remove('hidden');
      } else {
        actionsEl.innerHTML = '';
        actionsEl.classList.add('hidden');
      }
    }
  }

  function hideAlert() {
    var box = document.getElementById('publishAlert');
    box.className = 'retro-alert';
    var actionsEl = document.getElementById('publishAlertActions');
    if (actionsEl) {
      actionsEl.innerHTML = '';
      actionsEl.classList.add('hidden');
    }
  }

  async function handlePublishPost(e) {
    e.preventDefault();
    hideAlert();
    var previewImg = document.getElementById('previewImg');
    var hasImg = Boolean(selectedFile || (previewImg && previewImg.src && previewImg.src.length > 50));

    if (!hasImg) {
      if (window.retroAudio) window.retroAudio.playError();
      showAlert('error', '[:> NO PHOTO SELECTED]:', 'Please select or snap a photo from your device before transmitting.');
      return;
    }

    var publishBtn = document.getElementById('publishBtn');
    var logBox = document.getElementById('transmissionLog');
    var logText = document.getElementById('transmissionText');
    var captionInput = document.getElementById('captionInput');
    var caption = captionInput ? captionInput.value : '';

    publishBtn.disabled = true;
    publishBtn.style.opacity = '0.5';
    logBox.classList.remove('hidden');

    try {
      if (window.retroAudio && typeof window.retroAudio.playDialupBeep === 'function') {
        window.retroAudio.playDialupBeep();
      }
    } catch(e) {}

    function logStep(text, delay) {
      return new Promise(function(resolve) {
        setTimeout(function() {
          logText.textContent = text;
          resolve();
        }, delay);
      });
    }

    // Check if device is offline (PWA offline buffering)
    if (!navigator.onLine && window.NeogramPWA) {
      window.NeogramPWA.bufferOfflinePost({
        caption: caption,
        filterApplied: currentFilter,
        imageBase64: previewImg.src
      }, function(err, id) {
        publishBtn.disabled = false;
        publishBtn.style.opacity = '1';
        logBox.classList.add('hidden');
        if (err) {
          showAlert('error', '[:> OFFLINE BUFFER FAULT]:', err.message);
        } else {
          showAlert(
            'success',
            '[✓] OFFLINE SNAPSHOT BUFFERED:',
            'Carrier offline. Photo saved to device IndexedDB ledger. Will auto-sync when carrier re-connects!'
          );
          try {
            if (window.retroAudio && typeof window.retroAudio.playSuccess === 'function') {
              window.retroAudio.playSuccess();
            }
          } catch(e) {}
        }
      });
      return;
    }

    try {
      await logStep('[:> init_ppp_link /dev/ttyS0 --baud 28800]', 400);
      await logStep('[:> carrier detected: V.34 protocol handshake... [OK]]', 600);
      var fileCount = selectedFiles.length || (selectedFile ? 1 : 0);
      await logStep('[:> sharp_compress_image: creating 1200px webp & 400px thumbnail' + (fileCount > 1 ? 's for ' + fileCount + ' photos' : '') + ']', 500);

      var formData = new FormData();
      formData.append('caption', caption);
      formData.append('filterApplied', currentFilter);

      var uploadSiteIdInput = document.getElementById('uploadSiteId');
      if (uploadSiteIdInput && uploadSiteIdInput.value) {
        formData.append('siteId', uploadSiteIdInput.value);
      }

      if (selectedFiles.length > 0) {
        for (var i = 0; i < selectedFiles.length; i++) {
          formData.append('imageFiles', selectedFiles[i]);
        }
        if (selectedFiles.length === 1) {
          formData.append('imageFile', selectedFiles[0]);
        }
      } else if (selectedFile) {
        formData.append('imageFile', selectedFile);
      } else {
        // If no file selected, pass the current preview image source
        formData.append('imageBase64', previewImg.src);
      }

      var res = await fetch('/api/posts', {
        method: 'POST',
        body: formData
      });

      var data = await res.json().catch(function() { return {}; });

      if (!res.ok || !data.ok) {
        var errorMsg = (typeof data.error === 'string' && data.error)
          ? data.error
          : ((data.error && typeof data.error.message === 'string' && data.error.message)
            || (typeof data.message === 'string' && data.message)
            || 'Carrier transmission failed.');
        throw new Error(errorMsg);
      }

      await logStep('[:> TRANSMISSION SUCCESSFUL] Photo compiled and published live!', 500);

      try {
        if (window.retroAudio && typeof window.retroAudio.playSuccess === 'function') {
          window.retroAudio.playSuccess();
        }
      } catch(e) {}

      var pubSite = data.site || null;
      var baseSite = pubSite && pubSite.siteUrl ? pubSite.siteUrl : '{{ activeSite.siteUrl if activeSite and activeSite.siteUrl else (currentUser.siteUrl or "") }}';
      var userHandle = '{{ currentUser.handle or "" }}';
      var deployFolder = pubSite && pubSite.deployPath !== undefined ? pubSite.deployPath : '{{ activeSite.deployPath if activeSite else (currentUser.deployPath or "neogram") }}';
      var isSandbox = Boolean(data.isSandbox);
      var finalHost = baseSite || (userHandle ? ('https://' + userHandle + '.neocities.org') : '');
      var photoUrl = (!isSandbox && finalHost && data.post && data.post.id) ? (finalHost.replace(/\/+$/, '') + (deployFolder ? ('/' + deployFolder) : '') + '/photos/' + data.post.id + '/') : '';
      var galleryUrl = (!isSandbox && finalHost) ? (finalHost.replace(/\/+$/, '') + (deployFolder ? ('/' + deployFolder + '/') : '/')) : '';
      var stationUrl = userHandle ? ('/user/' + userHandle) : '/user';

      var actions = '<div class="flex items-center gap-2 flex-wrap mt-2">';
      if (isSandbox) {
        actions += '<a href="' + stationUrl + '" target="_blank" rel="noopener noreferrer" class="pixel-btn pixel-btn--sm pixel-btn--green font-bold text-xs" onclick="if(window.retroAudio) retroAudio.playClick();">View Station Profile ↗</a>';
        actions += '<button type="button" onclick="switchDashboardTab(\'settings/hosting\', event)" class="pixel-btn pixel-btn--sm pixel-btn--yellow font-bold text-xs">Connect Neocities</button>';
      } else if (photoUrl) {
        actions += '<a href="' + photoUrl + '" target="_blank" rel="noopener noreferrer" class="pixel-btn pixel-btn--sm pixel-btn--green font-bold text-xs" onclick="if(window.retroAudio) retroAudio.playClick();">View Photo on Site ↗</a>';
        actions += '<button type="button" onclick="navigator.clipboard?.writeText(\'' + photoUrl + '\'); this.innerHTML=\'<span>✓ Copied Link!</span>\';" class="pixel-btn pixel-btn--sm pixel-btn--yellow font-bold text-xs">Copy Photo Link</button>';
      } else if (galleryUrl) {
        actions += '<a href="' + galleryUrl + '" target="_blank" rel="noopener noreferrer" class="pixel-btn pixel-btn--sm pixel-btn--green font-bold text-xs" onclick="if(window.retroAudio) retroAudio.playClick();">View Gallery on Site ↗</a>';
      }
      actions += '<a href="/#edit" onclick="window.location.href=\'/#edit\'; window.location.reload();" class="pixel-btn pixel-btn--sm text-xs font-bold">Open Archive →</a>';
      actions += '</div>';

      showAlert(
        'success',
        isSandbox ? '[✓] PHOTO TRANSMITTED TO YOUR STATION!' : '[✓] PHOTO PUBLISHED LIVE!',
        data.message || 'Your photograph has been processed with authentic retro shaders and deployed live to your personal static website.',
        actions
      );

      clearSelectedPhoto();
      if (captionInput) captionInput.value = '';

    } catch (err) {
      if (!navigator.onLine && window.NeogramPWA) {
        window.NeogramPWA.bufferOfflinePost({
          caption: caption,
          filterApplied: currentFilter,
          imageBase64: previewImg.src
        });
        showAlert('info', '[:> CARRIER DROPPED]:', 'Connection dropped during upload. Post saved to offline ledger.');
      } else {
        try {
          if (window.retroAudio && typeof window.retroAudio.playError === 'function') {
            window.retroAudio.playError();
          }
        } catch(e) {}
        showAlert('error', '[:> TRANSMISSION ERROR]:', err.message);
      }
    } finally {
      publishBtn.disabled = false;
      publishBtn.style.opacity = '1';
    }
  }

