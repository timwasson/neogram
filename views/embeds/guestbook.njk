<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    {% if customCssUrl %}
      <link rel="stylesheet" href="{{ customCssUrl }}">
    {% else %}
      <link rel="stylesheet" href="/css/guestbook/base.css">
      <link rel="stylesheet" href="/css/guestbook/{{ theme | default('win95') }}.css">
    {% endif %}
    <script src="/js/retroAudio.js?v=2.2.0"></script>
  </head>
  <body>
    <div class="neogram-guestbook">
      <!-- Signature Form -->
      <form id="guestbookForm" class="neogram-guestbook__form">
        <!-- Anti-bot honeypot field (hidden from legitimate visitors) -->
        <input type="text" name="website_hp" id="gbBotTrap" style="display:none !important; position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <!-- Inline Name & Login Controls -->
        <div class="neogram-guestbook__field neogram-guestbook__field--inline">
          <label for="gbVisitorName" class="neogram-guestbook__label">Name:</label>
          <input
            type="text"
            id="gbVisitorName"
            name="visitorName"
            maxlength="50"
            required
            autocomplete="name"
            autocorrect="off"
            spellcheck="false"
            class="neogram-guestbook__input"
            value="Guest"
          />
          <div class="neogram-guestbook__auth-inline">
            <span id="gbAuthDivider">| or</span>
            <button
              type="button"
              id="gbAuthBtn"
              class="neogram-guestbook__auth-link"
              onclick="handleAuthClick()"
            >
              login to Neogram
            </button>
          </div>
        </div>

        <!-- Message Field -->
        <div class="neogram-guestbook__field">
          <textarea
            id="gbMessage"
            name="message"
            rows="3"
            required
            placeholder="Write a message in the guestbook..."
            class="neogram-guestbook__textarea"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <div class="neogram-guestbook__actions">
          <button type="submit" id="gbSubmitBtn" class="neogram-guestbook__btn-submit">
            Sign Guestbook
          </button>
        </div>

        <div id="gbStatusMsg" class="neogram-guestbook__alert neogram-guestbook__hidden" role="status" aria-live="polite"></div>
      </form>

      <!-- Ledger of Signatures -->
      <div id="signaturesList" class="neogram-guestbook__ledger">
        {% for entry in entries %}
          <div class="neogram-guestbook__item">
            <div class="neogram-guestbook__item-header">
              {% if entry.isAnonymous %}
                <span class="neogram-guestbook__item-author">{{ entry.visitorName }}</span>
              {% else %}
                <a
                  href="/user/{{ entry.uin or entry.visitorName }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="neogram-guestbook__item-author-link"
                  title="View Station on Neogram"
                >
                  @{{ entry.visitorName }}
                </a>
                {% if entry.uin %}
                  <span class="neogram-guestbook__item-date">[#{{ entry.uin }}]</span>
                {% endif %}
              {% endif %}
              {% if entry.visitorNumber %}
                <span class="neogram-guestbook__item-date">[Visitor #{{ entry.visitorNumber }}]</span>
              {% endif %}
              <span class="neogram-guestbook__item-date">{{ entry.createdAt | formatDate }}</span>
            </div>
            <p class="neogram-guestbook__item-message">{{ entry.message }}</p>
          </div>
        {% else %}
          <div id="noEntriesMsg" class="neogram-guestbook__empty">
            No messages yet. Be the first to leave a note!
          </div>
        {% endfor %}
      </div>
    </div>

    <script>
      (function() {
        var allowAnonymous = {{ 'true' if allowAnonymous else 'false' }};

        function escapeHtml(str) {
          if (!str) return '';
          return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
        }

        // ---- Cyber-Pass verification: the Neogram server is the ONLY authority for who is signed in ----
        var NG_PASS_API = (function () { try { return new URL(window.location.origin, window.location.href).origin; } catch (_e) { return window.location.origin; } })();
        function ngIsTrustedPassOrigin(o) { return o === window.location.origin || o === NG_PASS_API; }
        function ngVerifyPass(token, cb) {
          if (typeof token !== 'string' || !/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(token) || !window.fetch) { cb(null); return; }
          fetch(NG_PASS_API + '/api/pass/verify', { headers: { Authorization: 'Bearer ' + token } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) { cb(d && d.ok && d.handle ? { token: token, handle: String(d.handle), uin: d.uin || null, avatar: d.avatar || '', verified: true } : null); })
            .catch(function () { cb(null); });
        }
        function ngStoredPass() {
          try { var raw = localStorage.getItem('neogram_pass'); return raw && raw.charAt(0) === '{' ? JSON.parse(raw) : null; } catch (_e) { return null; }
        }
        function ngSavePass(v) { try { localStorage.setItem('neogram_pass', JSON.stringify(v)); } catch (_e) {} }
        function ngTakeHashPassToken() {
          if (!window.location.hash || window.location.hash.indexOf('neogram_pass=') === -1) return '';
          var token = '';
          try {
            var parsed = JSON.parse(decodeURIComponent(window.location.hash.split('neogram_pass=')[1].split('&')[0]));
            token = parsed && typeof parsed.token === 'string' ? parsed.token : '';
          } catch (_e) {}
          try {
            if (window.history && window.history.replaceState) {
              var cleanHash = window.location.hash.replace(/#?neogram_pass=[^&]*&?/, '').replace(/^&/, '');
              window.history.replaceState(null, '', window.location.pathname + window.location.search + (cleanHash ? '#' + cleanHash : ''));
            }
          } catch (_e) {}
          return token;
        }
        // A #neogram_pass link can be crafted by anyone (login CSRF): verify it server-side, and ask before it
        // signs this browser in as a different identity than the one already stored.
        function ngAdoptHashPass(onAdopted) {
          var token = ngTakeHashPassToken();
          if (!token) return;
          ngVerifyPass(token, function (v) {
            if (!v) return;
            var cur = ngStoredPass();
            var same = cur && cur.verified && cur.handle === v.handle;
            if (!same && !window.confirm('Sign in to this site as @' + v.handle + ' with your Neogram Cyber-Pass?' + (cur && cur.handle ? '\n\nThis replaces @' + cur.handle + '.' : ''))) return;
            ngSavePass(v);
            if (onAdopted) onAdopted(v);
          });
        }
        // Passes delivered by the Neogram popup / extension: still stored only as the server vouches for them
        function ngAdoptMessagePass(token, onAdopted) {
          ngVerifyPass(token, function (v) {
            if (!v) return;
            ngSavePass(v);
            if (onAdopted) onAdopted(v);
          });
        }
        // Passes stored before verification existed (or planted by an old link) are re-checked once
        function ngRevalidateStoredPass(onChange) {
          var raw = null;
          try { raw = localStorage.getItem('neogram_pass'); } catch (_e) {}
          if (!raw) return;
          var cur = ngStoredPass();
          if (cur && cur.verified) return;
          var token = cur ? cur.token : raw;
          ngVerifyPass(token, function (v) {
            if (v) ngSavePass(v); else { try { localStorage.removeItem('neogram_pass'); } catch (_e) {} }
            if (onChange) onChange(v);
          });
        }
        // ---- end Cyber-Pass verification ----

        function getStoredPass() {
          // Only server-verified passes count as a signed-in identity
          var p = ngStoredPass();
          return p && p.verified ? p : null;
        }

        function renderGbAuthUI() {
          var pass = getStoredPass();
          var nameInput = document.getElementById('gbVisitorName');
          var authDivider = document.getElementById('gbAuthDivider');
          var authBtn = document.getElementById('gbAuthBtn');
          var submitBtn = document.getElementById('gbSubmitBtn');

          if (pass && pass.token) {
            if (nameInput) {
              nameInput.value = pass.handle;
              nameInput.disabled = false;
            }
            if (authDivider) authDivider.textContent = '| logged in as @' + pass.handle;
            if (authBtn) {
              authBtn.textContent = '[logout]';
              authBtn.title = 'Disconnect Cyber-Pass session';
            }
            if (submitBtn) submitBtn.disabled = false;
          } else {
            if (allowAnonymous) {
              if (nameInput && (nameInput.value === '' || nameInput.value === 'visitor')) {
                nameInput.value = 'Guest';
              }
              if (nameInput) nameInput.disabled = false;
              if (authDivider) authDivider.textContent = '| or';
              if (authBtn) {
                authBtn.textContent = 'login to Neogram';
                authBtn.title = 'Connect Neogram Cyber-Pass';
              }
              if (submitBtn) submitBtn.disabled = false;
            } else {
              if (nameInput) {
                nameInput.value = '';
                nameInput.placeholder = 'Login required';
                nameInput.disabled = true;
              }
              if (authDivider) authDivider.textContent = '|';
              if (authBtn) {
                authBtn.textContent = 'login to Neogram to sign';
                authBtn.title = 'Connect Neogram Cyber-Pass to sign';
              }
            }
          }
        }

        window.handleAuthClick = function() {
          var pass = getStoredPass();
          if (pass && pass.token) {
            window.disconnectGbPass();
          } else {
            window.openGbPassModal();
          }
        };

        window.disconnectGbPass = function() {
          try {
            localStorage.removeItem('neogram_pass');
          } catch (_err) {}
          if (window.retroAudio) retroAudio.playClick();
          var nameInput = document.getElementById('gbVisitorName');
          if (nameInput) nameInput.value = 'Guest';
          renderGbAuthUI();
        };

        window.openGbPassModal = function() {
          if (window.retroAudio) retroAudio.playClick();
          var origin = encodeURIComponent(window.location.origin);
          window.open(
            '/auth/connect?origin=' + origin,
            'neogram_auth',
            'width=440,height=480,menubar=no,toolbar=no,location=no,status=no'
          );
        };

        window.addEventListener('message', function(e) {
          if (!ngIsTrustedPassOrigin(e.origin)) return;
          if (e.data && (e.data.type === 'NEOGRAM_CYBER_PASS' || e.data.type === 'NEOGRAM_EXTENSION_PASS')) {
            ngAdoptMessagePass(e.data.token, function () {
              renderGbAuthUI();
              if (window.retroAudio) retroAudio.playSuccess();
            });
          }
        });

        // Ingest Smart Handoff / Mobile Cyber-Pass from hash if loaded in parent or direct URL
        ngAdoptHashPass(function () { renderGbAuthUI(); });
        ngRevalidateStoredPass(function () { renderGbAuthUI(); });

        renderGbAuthUI();

        var form = document.getElementById('guestbookForm');
        var submitBtn = document.getElementById('gbSubmitBtn');
        var statusMsg = document.getElementById('gbStatusMsg');
        var list = document.getElementById('signaturesList');
        var noEntries = document.getElementById('noEntriesMsg');

        form.addEventListener('submit', async function(e) {
          e.preventDefault();

          var botTrap = document.getElementById('gbBotTrap');
          if (botTrap && botTrap.value) {
            // Silently abort if honeypot was populated
            return;
          }

          var pass = getStoredPass();
          var isAnon = !pass || !pass.token;

          if (isAnon && !allowAnonymous) {
            window.openGbPassModal();
            return;
          }

          var nameInput = document.getElementById('gbVisitorName');
          var finalName = nameInput ? nameInput.value.trim() : '';
          if (!finalName) {
            finalName = isAnon ? 'Guest' : pass.handle;
          }

          var messageInput = document.getElementById('gbMessage');
          var messageText = messageInput ? messageInput.value.trim() : '';
          if (!messageText) {
            alert('Please enter a message.');
            if (messageInput) messageInput.focus();
            return;
          }

          if (window.retroAudio) retroAudio.playClick();

          submitBtn.disabled = true;
          submitBtn.textContent = 'Posting...';
          statusMsg.className = 'neogram-guestbook__alert neogram-guestbook__hidden';

          var payload = {
            visitorName: finalName,
            message: messageText,
          };

          var headers = { 'Content-Type': 'application/json' };
          if (!isAnon && pass.token) {
            headers['Authorization'] = 'Bearer ' + pass.token;
          }

          var slugPart = '{{ siteSlug }}' ? ('/' + encodeURIComponent('{{ siteSlug }}')) : '';

          try {
            var res = await fetch('/api/guestbook/{{ handle }}' + slugPart, {
              method: 'POST',
              headers: headers,
              body: JSON.stringify(payload),
            });

            var data = await res.json();
            if (!res.ok || !data.ok) {
              throw new Error(data.error || 'Failed to submit signature');
            }

            if (window.retroAudio) retroAudio.playSuccess();

            statusMsg.textContent = '✓ Message posted to the guestbook!';
            statusMsg.className = 'neogram-guestbook__alert';
            statusMsg.classList.remove('neogram-guestbook__hidden');

            if (messageInput) messageInput.value = '';

            // Prepend new signature to list
            if (noEntries) noEntries.remove();
            var card = document.createElement('div');
            card.className = 'neogram-guestbook__item';

            var authorHtml = '';
            if (data.entry && data.entry.isAnonymous) {
              authorHtml = '<span class="neogram-guestbook__item-author">' + escapeHtml(data.entry.visitorName) + '</span>';
            } else {
              // Prefer the identity the server attached to the entry; a hash-ingested pass is unverified input
              var authorName = (data.entry && data.entry.visitorName) || (pass ? pass.handle : finalName);
              var rawUin = (data.entry && data.entry.uin) || (pass && pass.uin);
              var safeUin = /^\d{1,12}$/.test(String(rawUin || '')) ? String(rawUin) : '';
              var uinBadge = safeUin ? ' <span class="neogram-guestbook__item-date">[#' + safeUin + ']</span>' : '';
              var authorTarget = safeUin ? safeUin : encodeURIComponent(authorName);
              authorHtml = '<a href="/user/' + authorTarget + '" target="_blank" rel="noopener noreferrer" class="neogram-guestbook__item-author-link">@' + escapeHtml(authorName) + '</a>' + uinBadge;
            }
            var visitorBadge = (data.entry && data.entry.visitorNumber) ? ' <span class="neogram-guestbook__item-date">[Visitor #' + (parseInt(data.entry.visitorNumber, 10) || 0) + ']</span>' : '';

            card.innerHTML =
              '<div class="neogram-guestbook__item-header">' +
                authorHtml +
                visitorBadge +
                '<span class="neogram-guestbook__item-date">Just now</span>' +
              '</div>' +
              '<p class="neogram-guestbook__item-message">' + escapeHtml(payload.message) + '</p>';
            list.insertBefore(card, list.firstChild);

          } catch (err) {
            if (window.retroAudio) retroAudio.playError();
            statusMsg.textContent = 'Error: ' + err.message;
            statusMsg.className = 'neogram-guestbook__alert neogram-guestbook__alert--error';
            statusMsg.classList.remove('neogram-guestbook__hidden');
          } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Sign Guestbook';
          }
        });
      })();
    </script>
  </body>
</html>
