{% extends "layouts/base.njk" %}

{% block content %}
<div class="max-w-6xl mx-auto p-4 w-full font-mono">

  <!-- Top Breadcrumb & Profile Link -->
  <div class="flex items-center justify-between mb-4 flex-wrap gap-2 text-xs">
    <div class="flex items-center gap-2 text-muted flex-wrap">
      <span class="text-prompt font-bold">:&gt; DOCS_CYBERSPACE.HLP</span>
      <span>/</span>
      <span>STATION_MANUAL_v2.0</span>
      {% if isAuthenticated %}
        <span class="pixel-badge pixel-badge--cyan text-xxs font-bold">UIN #{{ stationUin }} (@{{ stationHandle }})</span>
      {% else %}
        <span class="pixel-badge text-xxs">GUEST_MODE</span>
      {% endif %}
    </div>
    <div class="flex items-center gap-2">
      <a href="/" class="pixel-btn pixel-btn--sm text-xs py-0.5 px-3" onclick="if(window.retroAudio) retroAudio.playClick();">
        <span>[&lt; Back to Neogram]</span>
      </a>
    </div>
  </div>

  <!-- Master Documentation Window Frame -->
  <div class="pixel-box mb-6">
    <!-- Window Header -->
    <div class="window-header flex items-center justify-between p-2">
      <div class="flex items-center gap-2">
        <span></span>
        <span class="font-bold text-xs">HELP.HLP — Neogram documentation</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="pixel-badge pixel-badge--green text-xxs font-bold">ONLINE // CARRIER 33.6K</span>
      </div>
    </div>

    <!-- Pinstripes -->
    <div class="mac-pinstripes"></div>

    <div class="p-4 flex flex-col gap-5">

      <!-- Terminal Welcome Banner -->
      <div class="p-3 bg-black border border-main text-xs space-y-2">
        <div class="flex items-center justify-between text-muted text-xxs uppercase font-bold tracking-wider">
          <span>PUBLISHING &amp; WIDGET MANUAL</span>
          <span>REVISION: 2.0.4-PROD</span>
        </div>
        <p class="text-prompt leading-relaxed m-0">
          Welcome to the <strong>Neogram documentation</strong>. Neogram lets you post photos from your phone to your own static website (Neocities, Nekoweb or GitHub Pages) as a retro photo gallery, and add hit counters, guestbooks, comments and a chat widget to any page you control.
        </p>
        <div class="flex items-center gap-3 text-xxs text-muted pt-1 border-t border-main flex-wrap">
          <span><strong>YOUR PHOTOS:</strong> stored on your site, not ours</span>
          <span><strong>YOUR SITE:</strong> Neogram only writes inside its own folder</span>
          <span><strong>YOUR UIN:</strong> #{{ stationUin }} (never changes)</span>
        </div>
      </div>

      <!-- Main Layout: Sidebar Navigation & Content Pane -->
      <div class="docs-layout">

        <!-- LEFT COLUMN: Topic Navigation Menu -->
        <aside class="docs-sidebar">
          <div class="text-xs font-bold text-muted uppercase tracking-wider mb-1 flex items-center justify-between">
            <span>TOPIC INDEX:</span>
            <span class="text-xxs text-prompt">[SELECT TOPIC]</span>
          </div>

          <button
            type="button"
            id="tabBtn-quickstart"
            class="docs-topic-btn {% if activeTopic == 'quickstart' %}is-active{% endif %}"
            onclick="switchDocTopic('quickstart')"
          >
            <span>Quickstart &amp; FAQs</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-neocities"
            class="docs-topic-btn {% if activeTopic == 'neocities' %}is-active{% endif %}"
            onclick="switchDocTopic('neocities')"
          >
            <span>Neocities Setup</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-sites"
            class="docs-topic-btn {% if activeTopic == 'sites' %}is-active{% endif %}"
            onclick="switchDocTopic('sites')"
          >
            <span>Multiple sites</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-counter"
            class="docs-topic-btn {% if activeTopic == 'counter' %}is-active{% endif %}"
            onclick="switchDocTopic('counter')"
          >
            <span>Dynamic Hit Counter</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-guestbook"
            class="docs-topic-btn {% if activeTopic == 'guestbook' %}is-active{% endif %}"
            onclick="switchDocTopic('guestbook')"
          >
            <span>Visitor Guestbook</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-pager"
            class="docs-topic-btn {% if activeTopic == 'pager' %}is-active{% endif %}"
            onclick="switchDocTopic('pager')"
          >
            <span>Site Pager / Chat Widget</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-feeds"
            class="docs-topic-btn {% if activeTopic == 'feeds' %}is-active{% endif %}"
            onclick="switchDocTopic('feeds')"
          >
            <span>Feeds &amp; Comments</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-headless"
            class="docs-topic-btn {% if activeTopic == 'headless' %}is-active{% endif %}"
            onclick="switchDocTopic('headless')"
          >
            <span>Headless API &amp; JSON</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-pipeline"
            class="docs-topic-btn {% if activeTopic == 'pipeline' %}is-active{% endif %}"
            onclick="switchDocTopic('pipeline')"
          >
            <span>Publishing Pipeline</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-styling"
            class="docs-topic-btn {% if activeTopic == 'styling' %}is-active{% endif %}"
            onclick="switchDocTopic('styling')"
          >
            <span>BEM Theming &amp; CSS</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-chat"
            class="docs-topic-btn {% if activeTopic == 'chat' %}is-active{% endif %}"
            onclick="switchDocTopic('chat')"
          >
            <span>NIM Chat &amp; Extension</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-friends"
            class="docs-topic-btn {% if activeTopic == 'friends' %}is-active{% endif %}"
            onclick="switchDocTopic('friends')"
          >
            <span>Friends &amp; Static Grid</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-security"
            class="docs-topic-btn {% if activeTopic == 'security' %}is-active{% endif %}"
            onclick="switchDocTopic('security')"
          >
            <span>Security &amp; privacy</span>
            <span class="text-xxs">›</span>
          </button>

          <!-- Raw Markdown Files Box -->
          <div class="mt-4 p-3 bg-window border border-main text-xs flex flex-col gap-2">
            <span class="font-bold text-xxs uppercase tracking-wider text-muted">DOCUMENTATION REPO FILES:</span>
            <div class="flex flex-col gap-1 text-xxs">
              <a href="/docs/neocities-setup.md" class="text-mac underline truncate">neocities-setup.md</a>
              <a href="/docs/multi-site-setup.md" class="text-mac underline truncate">multi-site-setup.md</a>
              <a href="/docs/embeds.md" class="text-mac underline truncate">embeds.md</a>
              <a href="/docs/publishing-pipeline.md" class="text-mac underline truncate">publishing-pipeline.md</a>
              <a href="/docs/custom-styling.md" class="text-mac underline truncate">custom-styling.md</a>
              <a href="/docs/buddylist-chat.md" class="text-mac underline truncate">buddylist-chat.md</a>
              <a href="/docs/friends.md" class="text-mac underline truncate">friends.md</a>
            </div>
          </div>
        </aside>

        <!-- RIGHT COLUMN: Topic Content Panes -->
        <div class="docs-content">

          <!-- ========================================================= -->
          <!-- TOPIC 0: 5-MINUTE QUICKSTART & COMMON FAQS               -->
          <!-- ========================================================= -->
          <section id="docSection-quickstart" class="docs-section-pane flex flex-col gap-6 {% if activeTopic != 'quickstart' %}hidden{% endif %}">
            
            <div class="border-b-2 border-main pb-2">
              <div class="flex items-center gap-2">
                <span class="text-xl"></span>
                <h1 class="text-base font-bold text-prompt m-0 uppercase">5-minute quickstart &amp; FAQ</h1>
              </div>
              <p class="text-xs text-muted mt-1 m-0">
                New to Neogram or static publishing? Here is everything you need to know to get your photo gallery online and your widgets embedded in 5 minutes flat.
              </p>
            </div>

            <!-- Quickstart Card -->
            <div class="retro-card p-4 m-0 flex flex-col gap-3">
              <div class="window-header flex items-center justify-between">
                <span>QUICKSTART.BAT</span>
                <span class="text-xxs text-prompt">STEP-BY-STEP CHECKLIST</span>
              </div>

              <div class="flex flex-col gap-3 text-xs leading-relaxed">
                <!-- Step 1 -->
                <div class="p-3 bg-black border border-main flex items-start gap-3">
                  <span class="docs-step-badge">1</span>
                  <div>
                    <h3 class="font-bold text-prompt m-0 uppercase text-xs">Sign up</h3>
                    <p class="text-muted m-0 mt-1">
                      Enter your email or phone number on the sign-in page and we'll send you a 6-digit code. New accounts get a permanent numeric <strong>UIN</strong> (like an ICQ number) and an <strong>@handle</strong> you can change later.
                    </p>
                  </div>
                </div>

                <!-- Step 2 -->
                <div class="p-3 bg-black border border-main flex items-start gap-3">
                  <span class="docs-step-badge">2</span>
                  <div>
                    <h3 class="font-bold text-prompt m-0 uppercase text-xs">Snap, Filter &amp; Publish</h3>
                    <p class="text-muted m-0 mt-1">
                      Connect your Neocities, Nekoweb or GitHub Pages site first. Then in the <strong>↑ Upload Studio</strong>, snap a photo or pick one from your phone, choose a retro filter (like <em>CRT Phosphor</em> or <em>16-Color VGA</em>), write a caption and hit <strong>Publish</strong>. The photo goes straight to your site; Neogram doesn't keep a copy.
                    </p>
                  </div>
                </div>

                <!-- Step 3 -->
                <div class="p-3 bg-black border border-main flex items-start gap-3">
                  <span class="docs-step-badge">3</span>
                  <div>
                    <h3 class="font-bold text-prompt m-0 uppercase text-xs">Connecting your site</h3>
                    <p class="text-muted m-0 mt-1">
                      In <strong>Settings → Your websites</strong>, add your site, pick the provider (<strong>Neocities</strong>, <strong>Nekoweb</strong> or <strong>GitHub Pages</strong>) and paste your API key or token (found at <a href="https://neocities.org/settings#api_key" target="_blank" rel="noopener" class="text-mac underline font-bold">neocities.org/settings#api_key</a> or <a href="https://nekoweb.org/settings" target="_blank" rel="noopener" class="text-mac underline font-bold">nekoweb.org/settings</a>). Neogram builds your gallery and publishes your photos and JSON feeds to a <code>/neogram/</code> folder on your site. <em>(SFTP is planned.)</em>
                    </p>
                  </div>
                </div>

                <!-- Step 4 -->
                <div class="p-3 bg-black border border-main flex items-start gap-3">
                  <span class="docs-step-badge">4</span>
                  <div>
                    <h3 class="font-bold text-prompt m-0 uppercase text-xs">Paste Hit Counter &amp; Guestbook Widgets</h3>
                    <p class="text-muted m-0 mt-1">
                      In the <strong>Embeds</strong> tab, pick your favorite glowing LED or Nixie hit counter style and copy the 1-line HTML tag. Paste it anywhere inside your site's <code>index.html</code>!
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- FAQs Card: Addressing All Beginner Fears Directly -->
            <div class="retro-card p-4 m-0 flex flex-col gap-3">
              <div class="window-header flex items-center justify-between">
                <span>FAQ.HLP — Common questions</span>
                <span class="text-xxs text-prompt">ZERO-STRESS INDIE WEB</span>
              </div>

              <div class="space-y-3 text-xs leading-relaxed">
                <!-- Q1: Safety Guarantee -->
                <div class="p-3 bg-black border border-green space-y-1">
                  <div class="text-prompt font-bold flex items-center gap-2 text-xs">
                    <span></span>
                    <span>Q: Will Neogram overwrite or delete my existing Neocities website?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    <strong>No.</strong> Neogram only writes inside its own folder (<code>/neogram/</code> by default) and refuses to delete anything outside it. Your homepage (<code>index.html</code>), styles, blog posts and other files are left alone.
                  </p>
                </div>

                <!-- Q2: Mobile Camera -->
                <div class="p-3 bg-black border border-main space-y-1">
                  <div class="text-mac font-bold flex items-center gap-2 text-xs">
                    <span></span>
                    <span>Q: Can I snap and publish photos directly from my mobile phone?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    <strong>Yes!</strong> Neogram is a full Progressive Web App (PWA). You can open it in Safari or Chrome on iOS or Android, or tap <strong>[INSTALL APP]</strong> in the top navigation bar to add it to your home screen. Tap the camera button to snap directly from your phone.
                  </p>
                </div>

                <!-- Q3: Coding requirements -->
                <div class="p-3 bg-black border border-main space-y-1">
                  <div class="text-mac font-bold flex items-center gap-2 text-xs">
                    <span></span>
                    <span>Q: Do I have to know JavaScript or complex coding?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    <strong>Not at all!</strong> If you know basic HTML, that's more than enough. Neogram builds the complete photo gallery HTML for you automatically. To add the hit counter or visitor guestbook to your own pages, just copy and paste the single provided <code>&lt;img&gt;</code> or <code>&lt;iframe&gt;</code> tag.
                  </p>
                </div>

                <!-- Q4: UIN vs Handle -->
                <div class="p-3 bg-black border border-main space-y-1">
                  <div class="text-mac font-bold flex items-center gap-2 text-xs">
                    <span></span>
                    <span>Q: What's the difference between my UIN and my @handle?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    Your UIN (#{{ stationUin }}) is a permanent number, like an old ICQ number. It never changes. Use it in your hit counter and guestbook embeds so you can change your <code>@handle</code> later without breaking them.
                  </p>
                </div>

                <!-- Q5: Data Ownership & Leaving -->
                <div class="p-3 bg-black border border-main space-y-1">
                  <div class="text-mac font-bold flex items-center gap-2 text-xs">
                    <span></span>
                    <span>Q: What happens if I ever stop using Neogram?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    Everything Neogram published stays on your site: the HTML pages, WebP images and comment files. Neogram doesn't keep copies of your photos, so there's nothing to get back from us.
                  </p>
                </div>

                <!-- Q6: Where to paste -->
                <div class="p-3 bg-black border border-main space-y-1">
                  <div class="text-mac font-bold flex items-center gap-2 text-xs">
                    <span></span>
                    <span>Q: Where exactly do I paste the widget code on my site?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    Log in to your Neocities dashboard, click <strong>Edit</strong> on your <code>index.html</code> (or any other page), scroll to where you want the widget to appear (for example, in your footer or right before <code>&lt;/body&gt;</code>), paste the snippet, and hit <strong>Save</strong>. It goes live immediately!
                  </p>
                </div>

                <!-- Q7: Multi-Site Management -->
                <div class="p-3 bg-black border border-main space-y-1">
                  <div class="text-mac font-bold flex items-center gap-2 text-xs">
                    <span></span>
                    <span>Q: Can I publish to multiple different websites or Neocities accounts?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    <strong>Yes!</strong> Neogram supports full <strong>Multi-Site Architecture</strong>. You can mount as many independent static sites as you like from the Settings tab. Each site has its own API key, deploy folder, and separate hit counters and guestbooks. You can switch between them in 1 click from the top taskbar without logging out.
                  </p>
                </div>
              </div>
            </div>

            <!-- Expandable Under the Hood for Nerds Accordion -->
            <details class="pixel-box p-4 bg-window font-mono text-xs cursor-pointer">
              <summary class="font-bold text-mac uppercase tracking-wider flex items-center justify-between text-xs select-none">
                <span class="flex items-center gap-2">
                  <span>🤓</span>
                  <span>[+] UNDER THE HOOD FOR NERDS (Architecture &amp; Security Specs)</span>
                </span>
                <span class="pixel-badge pixel-badge--cyan text-xxs font-bold">EXPAND :&gt;</span>
              </summary>

              <div class="pt-4 flex flex-col gap-4 border-t border-main mt-3">
                <!-- Data Flow Pipeline Diagram -->
                <div class="p-3 bg-black border border-main space-y-2">
                  <div class="text-prompt font-bold uppercase tracking-wider text-xxs">DATA FLOW PIPELINE</div>
                  <div class="p-2.5 border border-muted bg-surface-sunken text-prompt font-mono text-xs overflow-x-auto leading-relaxed select-all">
[Mobile / Workstation Photo] ──&gt; [Sharp WebP Transform] ──&gt; [Eleventy Build] ──&gt; [Upload to your host] ──&gt; [Delete Neogram's copy]
                  </div>
                  <p class="text-muted text-xs m-0">
                    Neogram never acts as a permanent media host. When you upload, photos are optimized, published directly to your personal static site, and local temporary files are immediately erased from the server.
                  </p>
                </div>

                <!-- Hardware-Grade AES-256-GCM Encryption Box -->
                <div class="p-3 bg-black border border-main space-y-2">
                  <div class="text-amber font-bold uppercase tracking-wider text-xxs flex items-center justify-between">
                    <span>SECURITY &amp; CREDENTIAL VAULT (CRYPTO v2)</span>
                    <span class="pixel-badge pixel-badge--green text-xxs font-bold">AES-256-GCM + SCRYPT</span>
                  </div>
                  <div class="p-2.5 border border-muted bg-surface-sunken text-prompt font-mono text-xs overflow-x-auto leading-relaxed select-all">
[Plaintext API Key] ──&gt; [scrypt KDF + AES-256-GCM] ──&gt; [NGv2 Envelope in PostgreSQL] ──&gt; [Never in Client DOM]
                  </div>
                  <p class="text-muted text-xs m-0">
                    Hosting API keys and static deployment credentials are encrypted at rest using authenticated <strong>AES-256-GCM with unique 96-bit initialization vectors and scrypt key derivation</strong>. The <code>NGv2</code> envelope supports zero-downtime key rotation windows via <code>ENCRYPTION_SECRET_PREVIOUS</code>. Credentials are decrypted strictly in memory during an API upload and are never rendered in client DOM, logs, or error responses.
                  </p>
                </div>

                <!-- Cyber-Pass SSO & Scoped Token Handshake -->
                <div class="p-3 bg-black border border-main space-y-2">
                  <div class="text-cyan font-bold uppercase tracking-wider text-xxs flex items-center justify-between">
                    <span>SCOPED CYBER-PASS HANDSHAKE</span>
                    <span class="pixel-badge pixel-badge--cyan text-xxs font-bold">1-HOUR SCOPED PASS</span>
                  </div>
                  <div class="p-2.5 border border-muted bg-surface-sunken text-prompt font-mono text-xs overflow-x-auto leading-relaxed select-all">
[Static Site Embed] ──&gt; [/auth/connect Consent Screen] ──&gt; [Scoped 1h Pass Token] ──&gt; [Social Actions Only]
                  </div>
                  <p class="text-muted text-xs m-0">
                    Third-party static sites authenticate visitors using an explicit consent screen at <code>/auth/connect</code>. Tokens are issued with a strict <code>scope: "pass"</code> (1-hour TTL) that allows social interactions (likes, comments, guestbook, pager) but cannot alter settings, passwords, or station configurations. Exact-origin <code>postMessage</code> and hash-fragment transports ensure zero cross-site cookie leaks.
                  </p>
                </div>

                <!-- SSRF & Edge Network Security -->
                <div class="p-3 bg-black border border-main space-y-2">
                  <div class="text-prompt font-bold uppercase tracking-wider text-xxs flex items-center justify-between">
                    <span>SSRF GUARD &amp; ATOMIC STORAGE</span>
                    <span class="pixel-badge pixel-badge--yellow text-xxs font-bold">SAFE-GET + MUTEX</span>
                  </div>
                  <div class="p-2.5 border border-muted bg-surface-sunken text-prompt font-mono text-xs overflow-x-auto leading-relaxed select-all">
[Outbound WAN Fetch] ──&gt; [Socket Lookup IP Filter] ──&gt; [Private/Cloud Metadata Blocked] ──&gt; [Atomic Write Mutex]
                  </div>
                  <p class="text-muted text-xs m-0">
                    All outbound fetches of members' feeds use <code>safeGet</code> with socket-level IP address verification to block DNS rebinding and internal network probing (loopback, RFC 1918, link-local, and cloud metadata). Static JSON updates serialize through an in-memory Mutex and write via atomic file renames, preventing corrupt or truncated data feeds.
                  </p>
                </div>
              </div>
            </details>

            <!-- Jump to Technical Guides -->
            <div class="p-3 bg-window border border-main text-xs flex items-center justify-between flex-wrap gap-2">
              <span class="text-muted">Ready to dive deeper into custom styling or API configurations?</span>
              <button type="button" class="pixel-btn pixel-btn--yellow text-xs font-bold py-1 px-3" onclick="switchDocTopic('neocities')">
                <span>Neocities Setup Guide →</span>
              </button>
            </div>

          </section>

          <!-- ========================================================= -->
          <!-- TOPIC 1: NEOCITIES SETUP GUIDE                            -->
          <!-- ========================================================= -->
          <section id="docSection-neocities" class="docs-section-pane flex flex-col gap-6 {% if activeTopic != 'neocities' %}hidden{% endif %}">
            
            <div class="border-b-2 border-main pb-2">
              <div class="flex items-center gap-2">
                <span class="text-xl"></span>
                <h1 class="text-base font-bold text-prompt m-0 uppercase">Neocities Static Hosting &amp; Setup Guide</h1>
              </div>
              <p class="text-xs text-muted mt-1 m-0">
                Connect your Neocities site so Neogram can publish your photo gallery to it.
              </p>
            </div>

            <!-- Your-files-are-safe Box -->
            <div class="p-3 bg-black border border-main text-xs space-y-1">
              <div class="text-prompt font-bold uppercase tracking-wider text-xxs">YOUR OTHER FILES ARE SAFE</div>
              <p class="text-muted text-xs m-0">
                Neogram publishes into a <code>/neogram/</code> folder on your Neocities site and never touches your homepage (<code>index.html</code>), styles or other files. Setup takes a few minutes:
              </p>
            </div>

            <!-- Step by Step Walkthrough -->
            <div class="flex flex-col gap-4">
              
              <!-- STEP 1 -->
              <div class="retro-card p-4 m-0 flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <span class="docs-step-badge">1</span>
                  <h3 class="font-bold text-xs uppercase text-prompt m-0">Obtain your Neocities API Key</h3>
                </div>
                <p class="text-xs leading-relaxed text-main m-0">
                  Log in to your account at <a href="https://neocities.org" target="_blank" rel="noopener noreferrer" class="text-mac underline font-bold">neocities.org</a>, then navigate to your site settings at <a href="https://neocities.org/settings#api_key" target="_blank" rel="noopener noreferrer" class="text-mac underline font-bold">neocities.org/settings#api_key</a>. Scroll down to the <strong>API Key</strong> section and copy your token string.
                </p>
                <div class="p-2 bg-window border border-main text-xxs text-muted font-mono">
                  KEY TOKEN EXAMPLE: <code>0123456789abcdef0123456789abcdef</code> (Keep this key private!)
                </div>
              </div>

              <!-- STEP 2 -->
              <div class="retro-card p-4 m-0 flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <span class="docs-step-badge">2</span>
                  <h3 class="font-bold text-xs uppercase text-prompt m-0">Add your site in Neogram</h3>
                </div>
                <p class="text-xs leading-relaxed text-main m-0">
