---
pagination:
  data: posts
  size: 1
  alias: post
permalink: "photos/{{ post.id }}/index.html"
layout: "layouts/base.njk"
eleventyComputed:
  title: "Photo by @{{ post.author }}"
---

<!-- Back Link to Static Gallery Grid -->
<div class="neogram-nav-back">
  <a href="{{ '/' | url }}" class="neogram-btn neogram-btn--yellow">
    <span>← BACK TO PHOTO GALLERY GRID</span>
  </a>
</div>

<article class="neogram-detail">
  <header class="neogram-detail__header">
    <div class="neogram-detail__title">
      <span>💾</span>
      <span>[:&gt; {{ post.id }}.bitmap]</span>
    </div>
    <div class="neogram-detail__status">
      <span class="neogram-detail__status-shader">SHADER: {{ post.filterApplied or 'RAW' }}</span>
      <span class="neogram-detail__status-sub">100% BITMAP</span>
    </div>
  </header>

  <div class="neogram-detail__body">
    <div class="neogram-detail__layout">

      <!-- LEFT: Full Resolution Photo Viewport -->
      <div class="neogram-detail__media-col">
        <div class="neogram-detail__viewport">
          <img
            src="{{ post.imagePath | url }}"
            alt="{{ post.caption }}"
            class="neogram-detail__image filter-{{ post.filterApplied or 'none' }}"
          />
        </div>

        <!-- Tag row -->
        <div class="neogram-detail__tags">
          {% if post.mood %}
            <span class="neogram-badge neogram-badge--cyan">{{ post.mood }}</span>
          {% endif %}
          {% if post.webring %}
            <span class="neogram-badge neogram-badge--magenta">ring: {{ post.webring }}</span>
          {% endif %}
          {% if post.location %}
            <span class="neogram-badge neogram-badge--amber">loc: {{ post.location }}</span>
          {% endif %}
        </div>
      </div>

      <!-- RIGHT: Metadata & Centralized Comment Ledger -->
      <div class="neogram-detail__info-col">
        <!-- Author & Caption -->
        <div class="neogram-detail__author-box">
          <div class="neogram-detail__author-meta">
            <span class="neogram-detail__author-handle">@{{ post.author }}</span>
            <span class="neogram-detail__author-date">{{ post.createdAt | formatDate }}</span>
          </div>
          <p class="neogram-detail__caption">
            {{ post.caption }}
          </p>
        </div>

        <!-- Reactions Bar -->
        <div class="neogram-detail__reactions">
          <button
            type="button"
            id="likeBtn"
            onclick="handleLikePost('{{ post.id }}')"
            class="neogram-btn"
          >
            <span>❤️ LIKE (<span id="likeCount">{{ post.likes or 0 }}</span>)</span>
          </button>

          <button
            type="button"
            onclick="handleRadicalPost()"
            class="neogram-btn"
          >
            <span>⚡ RADICAL</span>
          </button>

          <button
            type="button"
            onclick="handleBookmarkPost()"
            class="neogram-btn"
          >
            <span>💾 BOOKMARK</span>
          </button>
        </div>

        <!-- Centralized Comments Ledger -->
        <section class="neogram-comments">
          <header class="neogram-comments__header">
            <span class="neogram-comments__title">💬 COMMENT LEDGER (<span id="commentCount">{{ post.comments.length or 0 }}</span>)</span>
            <span class="neogram-comments__status">LIVE SYNC</span>
          </header>

          <!-- Comments Scroll Container -->
          <div id="commentsLedger" class="neogram-comments__ledger">
            {% if not post.comments or post.comments.length == 0 %}
              <div id="emptyCommentsNotice" class="neogram-comments__empty">
                [:&gt; No visitor comments recorded on static ledger yet. Be the first to leave your mark.]
              </div>
            {% else %}
              {% for comment in post.comments %}
                <div class="neogram-comments__item">
                  <div class="neogram-comments__item-header">
                    <span class="neogram-comments__item-author">{{ comment.avatar or '💬' }} @{{ comment.author }}</span>
                    <span class="neogram-comments__item-time">{{ comment.timestamp | formatDate }}</span>
                  </div>
                  <p class="neogram-comments__item-body">{{ comment.text }}</p>
                </div>
              {% endfor %}
            {% endif %}
          </div>

          <!-- Add Comment Form (Posts to Neogram Backend) -->
          <form id="commentForm" onsubmit="handleStaticCommentSubmit(event, '{{ post.id }}')" class="neogram-comments__form">
            <div class="neogram-comments__form-row">
              <input
                type="text"
                id="commentAuthor"
                placeholder="Visitor Handle"
                value="visitor_surfer"
                required
                class="neogram-comments__input neogram-comments__input--author"
              />
              <input
                type="text"
                id="commentText"
                placeholder="Write a comment..."
                required
                class="neogram-comments__input neogram-comments__input--text"
              />
            </div>
            <button
              type="submit"
              id="commentSubmitBtn"
              class="neogram-btn neogram-btn--green neogram-comments__submit"
            >
              <span>COMMIT COMMENT TO LEDGER :&gt;</span>
            </button>
          </form>
        </section>

      </div>

    </div>
  </div>
</article>

<script>
  var API_BASE = '{{ site.apiUrl or "http://localhost:4000" }}';

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function handleLikePost(postId) {
    if (window.retroAudio) window.retroAudio.playClick();
    fetch(API_BASE + '/api/posts/' + postId + '/like', { method: 'POST' })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.ok) {
          var el = document.getElementById('likeCount');
          if (el) el.textContent = data.likes;
          if (window.retroAudio) window.retroAudio.playSuccess();
        }
      })
      .catch(function(err) {
        console.error('Like error:', err);
      });
  }

  function handleRadicalPost() {
    if (window.retroAudio) window.retroAudio.playSuccess();
    alert('[:> RADICAL! Reaction broadcasted.]');
  }

  function handleBookmarkPost() {
    if (window.retroAudio) window.retroAudio.playClick();
    alert('[:> Photograph bookmarked to your local cache.]');
  }

  function handleStaticCommentSubmit(e, postId) {
    e.preventDefault();
    var authorInput = document.getElementById('commentAuthor');
    var textInput = document.getElementById('commentText');
    var submitBtn = document.getElementById('commentSubmitBtn');

    var author = authorInput.value.trim();
    var text = textInput.value.trim();
    if (!text) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'TRANSMITTING...';
    if (window.retroAudio) window.retroAudio.playClick();

    fetch(API_BASE + '/api/posts/' + postId + '/comments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ author: author, text: text })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'COMMIT COMMENT TO LEDGER :>';

      if (data.ok && data.comment) {
        textInput.value = '';
        var emptyNotice = document.getElementById('emptyCommentsNotice');
        if (emptyNotice) emptyNotice.remove();

        var ledger = document.getElementById('commentsLedger');
        var item = document.createElement('div');
        item.className = 'neogram-comments__item';
        var safeAuthor = escapeHtml(data.comment.author || author);
        var safeText = escapeHtml(data.comment.text || text);
        item.innerHTML = 
          '<div class="neogram-comments__item-header">' +
          '  <span class="neogram-comments__item-author">💬 @' + safeAuthor + '</span>' +
          '  <span class="neogram-comments__item-time">Just now</span>' +
          '</div>' +
          '<p class="neogram-comments__item-body">' + safeText + '</p>';
        ledger.appendChild(item);
        ledger.scrollTop = ledger.scrollHeight;

        var countEl = document.getElementById('commentCount');
        if (countEl) countEl.textContent = parseInt(countEl.textContent || '0', 10) + 1;

        if (window.retroAudio) window.retroAudio.playSuccess();
      } else {
        alert('Comment could not be posted: ' + (data.error || 'Server error'));
      }
    })
    .catch(function(err) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'COMMIT COMMENT TO LEDGER :>';
      alert('Network error while committing comment.');
    });
  }
</script>
