---
layout: layouts/base.njk
title: Static Photo Stream
---

<!-- ==============================================================
     STATIC GALLERY BANNER (Retro 90s Geocities/Cyber Homage)
     ============================================================== -->
<section class="neogram-banner">
  <div class="neogram-banner__header">
    <div class="neogram-banner__title">
      <span>⚡</span>
      <span>[:&gt; {{ site.title }}]</span>
    </div>
    <div class="neogram-banner__status">
      <span>● NEOCITIES STATIC STREAM</span>
    </div>
  </div>

  <div class="neogram-banner__body">
    <div class="neogram-banner__info">
      <p class="neogram-banner__desc">{{ site.description }}</p>
      <p class="neogram-banner__node">
        Broadcast node: <code>{{ site.neocitiesUrl }}</code> · Formatted for Netscape &amp; Modern Browsers
      </p>
    </div>

    <div class="neogram-banner__actions">
      <span class="neogram-badge neogram-badge--cyan">{{ posts.length }} PHOTOS ARCHIVED</span>
      <a href="{{ site.apiUrl or 'http://localhost:4000' }}" target="_blank" class="neogram-btn neogram-btn--yellow neogram-btn--sm">
        <span>📸 Upload New Photo :&gt;</span>
      </a>
    </div>
  </div>
</section>

<!-- ==============================================================
     STATIC PHOTO GRID
     ============================================================== -->
{% if posts.length == 0 %}
  <div class="neogram-empty">
    <div class="neogram-empty__icon">📡</div>
    <div class="neogram-empty__title">[:&gt; NO PHOTOS BROADCAST TO STATIC REPO YET]</div>
    <p class="neogram-empty__desc">
      Log into your Neogram Workstation to upload your first photograph and trigger the 11ty build pipeline.
    </p>
    <div class="neogram-empty__action">
      <a href="{{ site.apiUrl or 'http://localhost:4000' }}" class="neogram-btn neogram-btn--green neogram-btn--lg">
        <span>🚀 Open Neogram Creator Studio</span>
      </a>
    </div>
  </div>
{% else %}
  <div class="neogram-grid">
    {% for post in posts %}
      <article class="neogram-card">
        <!-- Card Window Header -->
        <div class="neogram-card__header">
          <span class="neogram-card__author">@{{ post.author }}</span>
          <span class="neogram-card__shader">{{ post.filterApplied or 'RAW' }}</span>
        </div>

        <!-- Thumbnail Viewport with CRT & Filter Shaders -->
        <a href="{{ ('/photos/' + post.id + '/') | url }}" class="neogram-card__media">
          <img
            src="{{ (post.thumbnailPath or post.imagePath) | url }}"
            alt="{{ post.caption }}"
            class="neogram-card__image filter-{{ post.filterApplied or 'none' }}"
            loading="lazy"
          />
          <div class="neogram-card__overlay">
            <span class="neogram-btn neogram-btn--yellow neogram-btn--sm neogram-card__overlay-btn">
              <span>👁️ VIEW &amp; COMMENT</span>
            </span>
          </div>
        </a>

        <!-- Metadata & Caption Card Body -->
        <div class="neogram-card__body">
          <div class="neogram-card__content">
            <div class="neogram-card__meta">
              <span class="neogram-card__location">{{ post.location or 'Earth // Cyberspace' }}</span>
              <span class="neogram-card__date">{{ post.createdAt | formatDate }}</span>
            </div>

            <p class="neogram-card__caption">
              {{ post.caption }}
            </p>
          </div>

          <!-- Tags & Actions Footer -->
          <div>
            <div class="neogram-card__tags">
              {% if post.mood %}
                <span class="neogram-badge neogram-badge--cyan">{{ post.mood }}</span>
              {% endif %}
              {% if post.webring %}
                <span class="neogram-badge neogram-badge--magenta">ring: {{ post.webring }}</span>
              {% endif %}
            </div>

            <div class="neogram-card__footer">
              <span class="neogram-card__likes">
                ❤️ <strong>{{ post.likes or 0 }}</strong> likes
              </span>
              <a href="{{ ('/photos/' + post.id + '/') | url }}" class="neogram-btn neogram-btn--yellow neogram-btn--sm">
                <span>View Details :&gt;</span>
              </a>
            </div>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
{% endif %}
