<!-- Client-side Topic Switcher & Copy Helper -->
<script>
  function switchDocTopic(topic) {
    if (window.retroAudio) retroAudio.playClick();

    // 1. Update Buttons
    var buttons = document.querySelectorAll('.docs-topic-btn');
    buttons.forEach(function(btn) {
      btn.classList.remove('is-active');
    });
    var targetBtn = document.getElementById('tabBtn-' + topic);
    if (targetBtn) targetBtn.classList.add('is-active');

    // 2. Update Content Panes
    var panes = document.querySelectorAll('.docs-section-pane');
    panes.forEach(function(pane) {
      pane.classList.add('hidden');
    });
    var targetPane = document.getElementById('docSection-' + topic);
    if (targetPane) targetPane.classList.remove('hidden');

    // 3. Update URL without reloading
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', '/docs?topic=' + topic);
    }
  }

  function switchDocCounterStyle(style) {
    if (window.retroAudio) retroAudio.playClick();
    var img = document.getElementById('docCounterPreviewImg');
    var label = document.getElementById('docCounterUrlLabel');
    var base = '{{ appUrl }}/counter/{{ stationHandle }}.svg?style=' + style;
    if (img) img.src = base;
    if (label) label.textContent = base;
  }

  function copyDocSnippet(btnId, codeId) {
    if (window.retroAudio) retroAudio.playClick();
    var codeEl = document.getElementById(codeId);
    var btnEl = document.getElementById(btnId);
    if (!codeEl || !btnEl) return;

    var text = codeEl.innerText || codeEl.textContent;
    navigator.clipboard.writeText(text).then(function() {
      var originalText = btnEl.innerHTML;
      btnEl.innerHTML = '<span>✓ COPIED!</span>';
      btnEl.classList.remove('pixel-btn--blue');
      btnEl.classList.add('pixel-btn--green');

      setTimeout(function() {
        btnEl.innerHTML = originalText;
        btnEl.classList.remove('pixel-btn--green');
        btnEl.classList.add('pixel-btn--blue');
      }, 2000);
    }).catch(function(err) {
      console.error('Failed to copy to clipboard', err);
    });
  }

  // Handle URL query parameters or initial load
  (function() {
    var params = new URLSearchParams(window.location.search);
    var topic = params.get('topic');
    if (topic && document.getElementById('docSection-' + topic)) {
      switchDocTopic(topic);
    }
  })();
</script>
