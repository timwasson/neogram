  async function handleSaveProfile(e) {
    e.preventDefault();
    try {
      if (window.retroAudio && typeof window.retroAudio.playClick === 'function') {
        window.retroAudio.playClick();
      }
    } catch(e) {}

    var handleInput = document.getElementById('settingsHandleInput');
    var rawHandle = handleInput ? handleInput.value.trim().toLowerCase().replace(/^@+/, '') : '';
    var saveBtn = document.getElementById('saveProfileBtn');
    var alertBox = document.getElementById('profileAlert');
    var alertTag = document.getElementById('profileAlertTag');
    var alertMsg = document.getElementById('profileAlertMsg');

    if (!rawHandle) {
      alertBox.className = 'retro-alert retro-alert--error mb-3';
      alertTag.textContent = '[:> ERROR]:';
      alertMsg.textContent = 'Please specify a call-sign / handle.';
      alertBox.classList.remove('hidden');
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'UPDATING CYBER IDENTITY...';
    alertBox.classList.add('hidden');

    try {
      var formData = new FormData();
      formData.append('handle', rawHandle);

      if (selectedAvatarFile) {
        formData.append('avatarFile', selectedAvatarFile);
      } else if (isAvatarRemoved) {
        formData.append('removeAvatar', 'true');
      }

      var res = await fetch('/api/settings/profile', {
        method: 'POST',
        body: formData
      });

      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to update cyber identity.');

      alertBox.className = 'retro-alert retro-alert--success mb-3';
      alertTag.textContent = '[✓] IDENTITY UPDATED:';
      alertMsg.textContent = 'Call-sign @' + data.user.handle + ' and avatar image updated across the station!';
      alertBox.classList.remove('hidden');

      // Update UI elements across dashboard live
      var navHandle = document.getElementById('navUserHandle');
      if (navHandle) navHandle.textContent = '@' + data.user.handle;

      var headerHandle = document.getElementById('headerUserHandle');
      if (headerHandle) headerHandle.textContent = '@' + data.user.handle;

      var dropdownHandle = document.getElementById('dropdownUserHandle');
      if (dropdownHandle) dropdownHandle.textContent = '@' + data.user.handle;

      var avatarPreview = document.getElementById('settingsAvatarPreview');
      if (avatarPreview) avatarPreview.src = data.user.avatarPath;

      var badge = document.getElementById('avatarStatusBadge');
      if (badge) badge.textContent = data.user.hasCustomAvatar ? 'CUSTOM' : 'DEFAULT';

      var headerSiteUrl = document.getElementById('headerSiteUrl');
      if (headerSiteUrl) headerSiteUrl.textContent = 'https://' + data.user.handle + '.neocities.org';

      var dropdownSiteUrl = document.getElementById('dropdownSiteUrl');
      if (dropdownSiteUrl) {
        var newSiteUrl = 'https://' + data.user.handle + '.neocities.org';
        dropdownSiteUrl.href = newSiteUrl;
        var siteText = dropdownSiteUrl.querySelector('span');
        if (siteText) siteText.textContent = newSiteUrl;
      }

      var fileInput = document.getElementById('avatarFileInput');
      if (fileInput) fileInput.value = '';
      selectedAvatarFile = null;
      isAvatarRemoved = false;

      appendTelemetryLog('[✓ PROFILE] Cyber identity updated to @' + data.user.handle);
      try {
        if (window.retroAudio && typeof window.retroAudio.playSuccess === 'function') {
          window.retroAudio.playSuccess();
        }
      } catch(e) {}

    } catch (err) {
      try {
        if (window.retroAudio && typeof window.retroAudio.playError === 'function') {
          window.retroAudio.playError();
        }
      } catch(e) {}
      alertBox.className = 'retro-alert retro-alert--error mb-3';
      alertTag.textContent = '[:> ERROR]:';
      alertMsg.textContent = err.message;
      alertBox.classList.remove('hidden');
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = '💾 UPDATE PROFILE & CALL-SIGN :>';
    }
  }

