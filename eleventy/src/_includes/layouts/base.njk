<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{{ title or site.title }} - 90s Retro Static Gallery</title>
  <meta name="description" content="{{ site.description }}">
  
  {% set rel = rootPath or '.' %}
  <!-- Retro Favicon & Touch Icons -->
  <link rel="icon" type="image/x-icon" href="{{ rel }}/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ rel }}/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ rel }}/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ rel }}/apple-touch-icon.png">

  <!-- Neogram Retro Framework (Pure Sass, Zero Tailwind) -->
  <link rel="stylesheet" href="{{ rel }}/css/neogram.css">
  <link rel="stylesheet" href="{{ rel }}/embed/neogram-embed.css">
  {% if site.customCssUrl %}
  <link rel="stylesheet" href="{{ site.customCssUrl }}">
  {% endif %}
</head>
<body class="neogram-site">

  <!-- ==============================================================
       PAGE CONTENT CONTAINER
       ============================================================== -->
  <main class="neogram-site__main">
    {{ content | safe }}
  </main>

  <!-- Retro Audio Engine -->
  <script src="{{ rel }}/js/retroAudio.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Audio click handler for retro buttons
      if (window.retroAudio) {
        document.querySelectorAll('.neogram-btn, .pixel-btn, .filter-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            window.retroAudio.playClick();
          });
        });
      }

      // Theme toggle support
      var toggleBtn = document.getElementById('themeToggleBtn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function () {
          var isDark = document.body.classList.toggle('dark');
          var icon = toggleBtn.querySelector('span');
          if (icon) icon.textContent = isDark ? 'Theme: Dark' : 'Theme: Light';
          if (window.retroAudio) window.retroAudio.playClick();
        });
      }
    });
  </script>

  <!-- Optional Neogram Embed Layer -->
  <script src="{{ rel }}/embed/embed.js" async></script>
  {% if site.chatWidgetEnabled %}
  <!-- Neogram Retro Pager Chat Widget -->
  <script src="{{ rel }}/embed/pager.js" data-station="{{ site.author }}" data-api="{{ site.apiUrl }}" data-auto-init="true" async></script>
  {% endif %}
</body>
</html>
