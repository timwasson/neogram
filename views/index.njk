  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function sanitizeUrl(url) {
    if (!url) return '';
    var clean = String(url).trim();
    if (/^https?:\/\//i.test(clean)) {
      return clean;
    }
    return '';
  }

  async function loadGuestbookEntries() {
    var container = document.getElementById('gbSignaturesList');
    var badge = document.getElementById('gbCountBadge');
    if (!container) return;

    try {
      var slugPart = currentEmbedSiteSlug ? ('/' + encodeURIComponent(currentEmbedSiteSlug)) : '';
      var res = await fetch('/api/guestbook/' + userHandle + slugPart);
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to fetch');

      if (badge) badge.textContent = data.entries.length + ' SIGNATURES';

      if (data.entries.length === 0) {
        container.innerHTML = '<div class="text-center py-4 text-xs text-muted">:&gt; No signatures recorded yet. Share your guestbook link!</div>';
        return;
      }

      var html = '';
      data.entries.forEach(function(entry) {
        var safeUrl = sanitizeUrl(entry.visitorWebsite);
        var site = safeUrl ? '<div class="text-xs"><a href="' + escapeHtml(safeUrl) + '" target="_blank" rel="noopener noreferrer" class="text-mac underline">🌐 ' + escapeHtml(safeUrl) + '</a></div>' : '';
        html += '<div class="retro-card p-2 flex flex-col gap-1 text-xs border border-main">' +
          '<div class="flex items-center justify-between border-b border-main pb-1">' +
            '<div class="flex items-center gap-1.5">' +
              '<span>' + escapeHtml(entry.moodIcon || '😎') + '</span>' +
              '<span class="font-bold">' + escapeHtml(entry.visitorName) + '</span>' +
              '<span class="text-muted text-xs">(' + escapeHtml(entry.visitorLocation || 'Cyberspace') + ')</span>' +
            '</div>' +
            '<button type="button" onclick="deleteGuestbookEntry(\'' + escapeHtml(entry.id) + '\')" class="text-crimson font-bold text-xs hover:underline" title="Delete signature">[Delete]</button>' +
          '</div>' + site +
          '<div class="whitespace-pre-wrap p-1 text-xs font-mono bg-window">"' + escapeHtml(entry.message) + '"</div>' +
        '</div>';
      });

      container.innerHTML = html;
    } catch (e) {
      container.innerHTML = '<div class="text-center py-4 text-xs text-crimson">Failed to load signatures: ' + escapeHtml(e.message) + '</div>';
    }
  }

  async function deleteGuestbookEntry(id) {
    if (!confirm('Delete this visitor signature from your ledger?')) return;
    if (window.retroAudio) window.retroAudio.playClick();

    try {
      var res = await fetch('/api/guestbook/' + id, { method: 'DELETE' });
      var data = await res.json();
      if (data.ok) {
        if (window.retroAudio) window.retroAudio.playSuccess();
        loadGuestbookEntries();
      } else {
        alert(data.error || 'Failed to delete');
      }
    } catch (e) {
      alert(e.message);
    }
  }

  async function loadNetworkUsers() {
    var container = document.getElementById('networkUsersList');
    if (!container) return;

    try {
      var res = await fetch('/api/network/users');
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to fetch');

      if (data.users.length === 0) {
        container.innerHTML = '<div class="text-center py-4 text-xs text-muted">No other creators detected on BBS.</div>';
        return;
      }

      var html = '';
      data.users.forEach(function(u) {
        var actionBtn = '';
        if (u.isSelf) {
          actionBtn = '<span class="text-xs text-muted font-bold">[YOU]</span>';
        } else if (u.isFollowing) {
          actionBtn = '<button type="button" onclick="toggleFollowUser(\'' + escapeHtml(u.handle) + '\', true)" class="pixel-btn pixel-btn--yellow text-xs py-0.5 px-2">✓ Friends</button>';
        } else {
          actionBtn = '<button type="button" onclick="toggleFollowUser(\'' + escapeHtml(u.handle) + '\', false)" class="pixel-btn text-xs py-0.5 px-2">🤝 Add Friend</button>';
        }

        var safeSite = sanitizeUrl(u.siteUrl);
        var site = safeSite ? '<a href="' + escapeHtml(safeSite) + '" target="_blank" rel="noopener noreferrer" class="text-mac underline text-xs">🌐 Site</a>' : '';

        html += '<div class="retro-card p-2 flex items-center justify-between gap-2 border border-main text-xs">' +
          '<div class="flex items-center gap-2">' +
            '<span class="text-base">👾</span>' +
            '<div>' +
              '<div class="font-bold text-prompt">@' + escapeHtml(u.handle) + '</div>' +
              '<div class="text-muted text-xs">' + Number(u.postCount || 0) + ' photos • ' + Number(u.followersCount || 0) + ' followers ' + (site ? '• ' + site : '') + '</div>' +
            '</div>' +
          '</div>' +
          '<div>' + actionBtn + '</div>' +
        '</div>';
      });

      container.innerHTML = html;
    } catch (e) {
      container.innerHTML = '<div class="text-center py-4 text-xs text-crimson">Failed to load network: ' + e.message + '</div>';
    }
  }

  async function toggleFollowUser(handle, isFollowing) {
    if (window.retroAudio) window.retroAudio.playClick();
    try {
      var method = isFollowing ? 'DELETE' : 'POST';
      var res = await fetch('/api/users/' + handle + '/follow', { method: method });
      var data = await res.json();
      if (data.ok) {
        if (window.retroAudio) window.retroAudio.playSuccess();
        loadNetworkUsers();
      } else {
        alert(data.error || 'Failed to update follow state');
      }
    } catch (e) {
      alert(e.message);
    }
  }

  function appendTelemetryLog(text, isError, linkUrl) {
    var consoleEl = document.getElementById('telemetryConsole');
    if (!consoleEl) return;
    var line = document.createElement('div');
    if (isError) line.className = 'text-crimson font-bold';
    line.textContent = '[:> ' + new Date().toLocaleTimeString() + '] ' + text;
    if (linkUrl) {
      var a = document.createElement('a');
      a.href = linkUrl;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.className = 'text-yellow font-bold underline ml-1 hover:text-white';
      a.textContent = '[LAUNCH GALLERY ↗]';
      line.appendChild(a);
    }
    consoleEl.appendChild(line);
    consoleEl.scrollTop = consoleEl.scrollHeight;
  }

  function updateSiteUrlPreview() {
    var sitename = document.getElementById('settingsSiteName').value.trim();
    var urlInput = document.getElementById('settingsSiteUrl');
    var deployPathInput = document.getElementById('settingsDeployPath');
