  async function loadCounterSettings() {
    try {
      var res = await fetch('/api/counter');
      if (!res.ok) return;
      var data = await res.json();
      if (data.ok && data.counter) {
        currentCounterStyle = data.counter.style || 'green_led';
        var badge = document.getElementById('counterHitsBadge');
        if (badge) badge.textContent = 'HITS: ' + data.counter.hits;
        highlightActiveCounterStyle(currentCounterStyle);
        updateCounterPreview(data.counter.hits, currentCounterStyle);
      }
    } catch (e) {
      console.error('Failed to load counter:', e);
    }
  }

  function highlightActiveCounterStyle(style) {
    var btnMap = {
      'green_led': 'btnStyleGreenLed',
      'red_nixie': 'btnStyleRedNixie',
      'odometer': 'btnStyleOdometer',
      'blue_vfd': 'btnStyleBlueVfd'
    };
    Object.keys(btnMap).forEach(function(s) {
      var btn = document.getElementById(btnMap[s]);
      if (btn) {
        if (s === style) {
          btn.classList.add('pixel-btn--yellow');
        } else {
          btn.classList.remove('pixel-btn--yellow');
        }
      }
    });
  }

  var currentEmbedSiteSlug = '{{ activeSite.slug if activeSite else "" }}';
  var currentEmbedSiteId = '{{ activeSite.id if activeSite else "" }}';

  function handleEmbedSiteChange(siteId) {
    if (window.retroAudio) window.retroAudio.playClick();
    var select = document.getElementById('embedSiteSelect');
    if (!select) return;
    var opt = select.options[select.selectedIndex];
    var slug = opt ? opt.getAttribute('data-slug') : '';
    var name = opt ? opt.getAttribute('data-name') : 'Primary Site';
    currentEmbedSiteSlug = slug;
    currentEmbedSiteId = siteId;

    var targetLabel = document.getElementById('embedTargetLabel');
    if (targetLabel) targetLabel.textContent = name;

    updateCounterPreview(null, currentCounterStyle);
    selectGuestbookSkin(currentGuestbookSkin);

    var feedDisplay = document.getElementById('feedUrlDisplay');
    var feedLink = document.getElementById('feedUrlLink');
    var feedPath = '/api/users/' + userHandle + '/feed.json' + (slug ? ('?siteSlug=' + encodeURIComponent(slug)) : '');
    if (feedDisplay) feedDisplay.textContent = feedPath;
    if (feedLink) feedLink.href = feedPath;

    loadGuestbookEntries();
  }
  window.handleEmbedSiteChange = handleEmbedSiteChange;

  function updateCounterPreview(hits, style) {
    var img = document.getElementById('counterLiveSvg');
    var label = document.getElementById('counterLiveUrlLabel');
    var snippet = document.getElementById('counterCodeSnippet');
    var slugPart = currentEmbedSiteSlug ? ('/' + currentEmbedSiteSlug) : '';
    var url = '/counter/' + userHandle + slugPart + '.svg?style=' + style + '&t=' + Date.now();
    var fullUrl = window.location.origin + '/counter/' + userHandle + slugPart + '.svg?style=' + style;
    if (img) img.src = url;
    if (label) label.textContent = '/counter/' + userHandle + slugPart + '.svg?style=' + style;
    if (snippet) {
      snippet.textContent = '<!-- Neogram Dynamic Web Hit Counter -->\n<!-- Paste anywhere inside your page\'s HTML (e.g. before </body>) -->\n<div class="neogram-counter">\n  <img src="' + fullUrl + '" alt="Visitor Counter" />\n</div>';
    }
  }

  async function selectCounterStyle(style) {
    if (window.retroAudio) window.retroAudio.playClick();
    currentCounterStyle = style;
    highlightActiveCounterStyle(style);
    updateCounterPreview(null, style);
    try {
      var queryParam = currentEmbedSiteId ? ('?siteId=' + encodeURIComponent(currentEmbedSiteId)) : '';
      await fetch('/api/counter' + queryParam, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ style: style, siteId: currentEmbedSiteId })
      });
    } catch (e) {
      console.error(e);
    }
  }

  async function simulateHit(amount) {
    if (window.retroAudio) {
      if (amount > 1) window.retroAudio.playDialupBeep();
      else window.retroAudio.playCounterTick();
    }
    try {
      var queryParam = currentEmbedSiteId ? ('?siteId=' + encodeURIComponent(currentEmbedSiteId)) : '';
      var res = await fetch('/api/counter' + queryParam, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'increment', amount: amount, style: currentCounterStyle, siteId: currentEmbedSiteId })
      });
      var data = await res.json();
      if (data.ok) {
        var badge = document.getElementById('counterHitsBadge');
        if (badge) badge.textContent = 'HITS: ' + data.hits;
        updateCounterPreview(data.hits, currentCounterStyle);
      }
    } catch (e) {
      console.error(e);
    }
  }

  async function resetCounter() {
    if (!confirm('Reset hit counter back to 000001?')) return;
    if (window.retroAudio) window.retroAudio.playClick();
    try {
      var queryParam = currentEmbedSiteId ? ('?siteId=' + encodeURIComponent(currentEmbedSiteId)) : '';
      var res = await fetch('/api/counter' + queryParam, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'reset', style: currentCounterStyle, siteId: currentEmbedSiteId })
      });
      var data = await res.json();
      if (data.ok) {
        var badge = document.getElementById('counterHitsBadge');
        if (badge) badge.textContent = 'HITS: 1';
        updateCounterPreview(1, currentCounterStyle);
      }
    } catch (e) {
      console.error(e);
    }
  }

