{% extends "layouts/base.njk" %}

{% block content %}
<div class="max-w-6xl mx-auto p-4 w-full font-mono">

  <!-- Top Breadcrumb & Station Link -->
  <div class="flex items-center justify-between mb-4 flex-wrap gap-2 text-xs">
    <div class="flex items-center gap-2 text-muted">
      <span class="text-prompt font-bold">:&gt; DOCS_CYBERSPACE.HLP</span>
      <span>/</span>
      <span>STATION_MANUAL_v2.0</span>
      {% if isAuthenticated %}
        <span class="pixel-badge pixel-badge--cyan text-xxs font-bold">NODE: #{{ stationUin }} (@{{ stationHandle }})</span>
      {% else %}
        <span class="pixel-badge text-xxs">GUEST_MODE</span>
      {% endif %}
    </div>
    <div class="flex items-center gap-2">
      <a href="/" class="pixel-btn pixel-btn--sm text-xs py-0.5 px-3" onclick="if(window.retroAudio) retroAudio.playClick();">
        <span>[ &lt; Return to Workstation ]</span>
      </a>
    </div>
  </div>

  <!-- Master Documentation Window Frame -->
  <div class="pixel-box mb-6">
    <!-- Window Header -->
    <div class="window-header flex items-center justify-between p-2">
      <div class="flex items-center gap-2">
        <span>📖</span>
        <span class="font-bold text-xs">[:&gt; NEOGRAM_DOCUMENTATION_CENTER.HLP — Station Manual &amp; Static Embed Specs]</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="pixel-badge pixel-badge--green text-xxs font-bold">ONLINE // CARRIER 33.6K</span>
      </div>
    </div>

    <!-- Pinstripes -->
    <div class="mac-pinstripes"></div>

    <div class="p-4 flex flex-col gap-5">

      <!-- Terminal Welcome Banner -->
      <div class="p-3 bg-black border border-main text-xs space-y-2">
        <div class="flex items-center justify-between text-muted text-[10px] uppercase font-bold tracking-wider">
          <span>STATIC PUBLISHING ENGINE &amp; SOCIAL WIDGET MANUAL</span>
          <span>REVISION: 2.0.4-PROD</span>
        </div>
        <p class="text-prompt leading-relaxed m-0">
          Welcome to the <strong>Neogram Cyberspace Documentation</strong>. Neogram bridges mobile-first photo publishing with 90s web nostalgia, enabling creators to snap photos, compile isolated static galleries, and embed interactive hit counters, visitor guestbooks, and comment ledgers onto personal static websites (Neocities, GitHub Pages, or self-hosted servers).
        </p>
        <div class="flex items-center gap-3 text-xxs text-muted pt-1 border-t border-main flex-wrap">
          <span>🔒 <strong>ZERO RETENTION:</strong> 0 MB local media storage</span>
          <span>🛡️ <strong>SAFE SUBDIRECTORIES:</strong> Non-destructive root protection</span>
          <span>🔢 <strong>PERMANENT ANCHOR:</strong> Immutable numeric UIN (#{{ stationUin }})</span>
        </div>
      </div>

      <!-- Main Layout: Sidebar Navigation & Content Pane -->
      <div class="docs-layout">

        <!-- LEFT COLUMN: Topic Navigation Menu -->
        <aside class="docs-sidebar">
          <div class="text-xs font-bold text-muted uppercase tracking-wider mb-1 flex items-center justify-between">
            <span>TOPIC INDEX:</span>
            <span class="text-xxs text-prompt">[SELECT TOPIC]</span>
          </div>

          <button
            type="button"
            id="tabBtn-quickstart"
            class="docs-topic-btn {% if activeTopic == 'quickstart' %}is-active{% endif %}"
            onclick="switchDocTopic('quickstart')"
          >
            <span>⚡ Quickstart &amp; FAQs</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-neocities"
            class="docs-topic-btn {% if activeTopic == 'neocities' %}is-active{% endif %}"
            onclick="switchDocTopic('neocities')"
          >
            <span>🚀 Neocities Setup</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-sites"
            class="docs-topic-btn {% if activeTopic == 'sites' %}is-active{% endif %}"
            onclick="switchDocTopic('sites')"
          >
            <span>💾 Multi-Site Targets</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-counter"
            class="docs-topic-btn {% if activeTopic == 'counter' %}is-active{% endif %}"
            onclick="switchDocTopic('counter')"
          >
            <span>🔢 Dynamic Hit Counter</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-guestbook"
            class="docs-topic-btn {% if activeTopic == 'guestbook' %}is-active{% endif %}"
            onclick="switchDocTopic('guestbook')"
          >
            <span>✍️ Visitor Guestbook</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-feeds"
            class="docs-topic-btn {% if activeTopic == 'feeds' %}is-active{% endif %}"
            onclick="switchDocTopic('feeds')"
          >
            <span>📡 Feeds &amp; Comments</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-headless"
            class="docs-topic-btn {% if activeTopic == 'headless' %}is-active{% endif %}"
            onclick="switchDocTopic('headless')"
          >
            <span>⚡ Headless API &amp; JSON</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-pipeline"
            class="docs-topic-btn {% if activeTopic == 'pipeline' %}is-active{% endif %}"
            onclick="switchDocTopic('pipeline')"
          >
            <span>⚙️ Publishing Pipeline</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-styling"
            class="docs-topic-btn {% if activeTopic == 'styling' %}is-active{% endif %}"
            onclick="switchDocTopic('styling')"
          >
            <span>🎨 BEM Theming &amp; CSS</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-chat"
            class="docs-topic-btn {% if activeTopic == 'chat' %}is-active{% endif %}"
            onclick="switchDocTopic('chat')"
          >
            <span>💬 NIM Chat &amp; Extension</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-friends"
            class="docs-topic-btn {% if activeTopic == 'friends' %}is-active{% endif %}"
            onclick="switchDocTopic('friends')"
          >
            <span>🤝 Friends &amp; Static Grid</span>
            <span class="text-xxs">›</span>
          </button>

          <button
            type="button"
            id="tabBtn-security"
            class="docs-topic-btn {% if activeTopic == 'security' %}is-active{% endif %}"
            onclick="switchDocTopic('security')"
          >
            <span>🛡️ Cyberspace Security</span>
            <span class="text-xxs">›</span>
          </button>

          <!-- Raw Markdown Files Box -->
          <div class="mt-4 p-3 bg-window border border-main text-xs flex flex-col gap-2">
            <span class="font-bold text-xxs uppercase tracking-wider text-muted">DOCUMENTATION REPO FILES:</span>
            <div class="flex flex-col gap-1 text-xxs">
              <a href="/docs/neocities-setup.md" class="text-mac underline truncate">📄 neocities-setup.md</a>
              <a href="/docs/multi-site-setup.md" class="text-mac underline truncate">📄 multi-site-setup.md</a>
              <a href="/docs/embeds.md" class="text-mac underline truncate">📄 embeds.md</a>
              <a href="/docs/publishing-pipeline.md" class="text-mac underline truncate">📄 publishing-pipeline.md</a>
              <a href="/docs/custom-styling.md" class="text-mac underline truncate">📄 custom-styling.md</a>
              <a href="/docs/buddylist-chat.md" class="text-mac underline truncate">📄 buddylist-chat.md</a>
              <a href="/docs/friends.md" class="text-mac underline truncate">📄 friends.md</a>
            </div>
          </div>
        </aside>

        <!-- RIGHT COLUMN: Topic Content Panes -->
        <div class="docs-content">

          <!-- ========================================================= -->
          <!-- TOPIC 0: 5-MINUTE QUICKSTART & COMMON FAQS               -->
          <!-- ========================================================= -->
          <section id="docSection-quickstart" class="docs-section-pane flex flex-col gap-6 {% if activeTopic != 'quickstart' %}hidden{% endif %}">
            
            <div class="border-b-2 border-main pb-2">
              <div class="flex items-center gap-2">
                <span class="text-xl">⚡</span>
                <h1 class="text-base font-bold text-prompt m-0 uppercase">5-Minute Station Quickstart &amp; Cyberspace FAQs</h1>
              </div>
              <p class="text-xs text-muted mt-1 m-0">
                New to Neogram or static publishing? Here is everything you need to know to get your photo gallery online and your widgets embedded in 5 minutes flat.
              </p>
            </div>

            <!-- Quickstart Card -->
            <div class="retro-card p-4 m-0 flex flex-col gap-3">
              <div class="window-header flex items-center justify-between">
                <span>[:&gt; 5_MINUTE_QUICKSTART.BAT]</span>
                <span class="text-xxs text-prompt">STEP-BY-STEP CHECKLIST</span>
              </div>

              <div class="flex flex-col gap-3 text-xs leading-relaxed">
                <!-- Step 1 -->
                <div class="p-3 bg-black border border-main flex items-start gap-3">
                  <span class="docs-step-badge">1</span>
                  <div>
                    <h3 class="font-bold text-prompt m-0 uppercase text-xs">Claim Your Station Identity</h3>
                    <p class="text-muted m-0 mt-1">
                      Enter your email or phone on the login terminal to receive a 6-digit key. New stations are commissioned automatically with an immutable <strong>Node UIN</strong> (like an ICQ number) and a custom <strong>@handle</strong> call-sign.
                    </p>
                  </div>
                </div>

                <!-- Step 2 -->
                <div class="p-3 bg-black border border-main flex items-start gap-3">
                  <span class="docs-step-badge">2</span>
                  <div>
                    <h3 class="font-bold text-prompt m-0 uppercase text-xs">Snap, Filter &amp; Publish (Sandbox or Live)</h3>
                    <p class="text-muted m-0 mt-1">
                      In the <strong>↑ Upload Studio</strong>, snap a photo on your phone or upload an image. Pick an authentic retro filter (like <em>CRT Phosphor</em> or <em>16-Color VGA</em>), write a caption, and hit <strong>Transmit</strong>. Neogram immediately publishes your photo to your public station profile (<code>/user/@yourhandle</code>) even before connecting external hosting!
                    </p>
                  </div>
                </div>

                <!-- Step 3 -->
                <div class="p-3 bg-black border border-main flex items-start gap-3">
                  <span class="docs-step-badge">3</span>
                  <div>
                    <h3 class="font-bold text-prompt m-0 uppercase text-xs">Sync Live to Your Personal Neocities or Nekoweb Site</h3>
                    <p class="text-muted m-0 mt-1">
                      Whenever you're ready to host your gallery on your own static site, head to <strong>⚙ Settings</strong>. Select your provider (<strong>Neocities</strong> or <strong>Nekoweb</strong>) and paste your API key (found at <a href="https://neocities.org/settings#api_key" target="_blank" rel="noopener" class="text-mac underline font-bold">neocities.org/settings#api_key</a> or <a href="https://nekoweb.org/settings" target="_blank" rel="noopener" class="text-mac underline font-bold">nekoweb.org/settings</a>). Neogram will compile 11ty and push your photos and JSON feeds live! <em>(GitHub Pages and SFTP adapters arriving in v1.1)</em>.
                    </p>
                  </div>
                </div>

                <!-- Step 4 -->
                <div class="p-3 bg-black border border-main flex items-start gap-3">
                  <span class="docs-step-badge">4</span>
                  <div>
                    <h3 class="font-bold text-prompt m-0 uppercase text-xs">Paste Hit Counter &amp; Guestbook Widgets</h3>
                    <p class="text-muted m-0 mt-1">
                      In the <strong>⎘ Embeds</strong> tab, pick your favorite glowing LED or Nixie hit counter style and copy the 1-line HTML tag. Paste it anywhere inside your site's <code>index.html</code>!
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- FAQs Card: Addressing All Beginner Fears Directly -->
            <div class="retro-card p-4 m-0 flex flex-col gap-3">
              <div class="window-header flex items-center justify-between">
                <span>[:&gt; STATION_FAQ.HLP — Common Questions &amp; Safety Guarantees]</span>
                <span class="text-xxs text-prompt">ZERO-STRESS INDIE WEB</span>
              </div>

              <div class="space-y-3 text-xs leading-relaxed">
                <!-- Q1: Safety Guarantee -->
                <div class="p-3 bg-black border border-green space-y-1">
                  <div class="text-prompt font-bold flex items-center gap-2 text-xs">
                    <span>🛡️</span>
                    <span>Q: Will Neogram overwrite or delete my existing Neocities website?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    <strong>Never!</strong> Neogram operates under a strict <strong>Root Site Non-Destruction Invariant</strong>. By default, it publishes strictly inside an isolated subfolder (<code>/neogram/</code>). Your existing homepage (<code>index.html</code>), custom styling, blog posts, fan pages, and images are 100% untouched.
                  </p>
                </div>

                <!-- Q2: Mobile Camera -->
                <div class="p-3 bg-black border border-main space-y-1">
                  <div class="text-mac font-bold flex items-center gap-2 text-xs">
                    <span>📱</span>
                    <span>Q: Can I snap and publish photos directly from my mobile phone?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    <strong>Yes!</strong> Neogram is a full Progressive Web App (PWA). You can open it in Safari or Chrome on iOS or Android, or tap <strong>[💾 INSTALL APP]</strong> in the top navigation bar to add it to your home screen. Tap the camera button to snap directly from your phone.
                  </p>
                </div>

                <!-- Q3: Coding requirements -->
                <div class="p-3 bg-black border border-main space-y-1">
                  <div class="text-mac font-bold flex items-center gap-2 text-xs">
                    <span>💻</span>
                    <span>Q: Do I have to know JavaScript or complex coding?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    <strong>Not at all!</strong> If you know basic HTML, that's more than enough. Neogram builds the complete photo gallery HTML for you automatically. To add the hit counter or visitor guestbook to your own pages, just copy and paste the single provided <code>&lt;img&gt;</code> or <code>&lt;iframe&gt;</code> tag.
                  </p>
                </div>

                <!-- Q4: Node UIN vs Handle -->
                <div class="p-3 bg-black border border-main space-y-1">
                  <div class="text-mac font-bold flex items-center gap-2 text-xs">
                    <span>🔢</span>
                    <span>Q: What is a Node UIN vs. my @handle?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    Think of your Node UIN (#{{ stationUin }}) like your permanent ICQ number. It is an immutable numeric identity. Your hit counters and guestbooks use this permanent ID so that you can change your <code>@handle</code> call-sign anytime without breaking any widgets on your website.
                  </p>
                </div>

                <!-- Q5: Data Ownership & Leaving -->
                <div class="p-3 bg-black border border-main space-y-1">
                  <div class="text-mac font-bold flex items-center gap-2 text-xs">
                    <span>🔒</span>
                    <span>Q: What happens if I ever stop using Neogram?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    You own 100% of your data. The static HTML pages, WebP images, and comment files remain on your Neocities host forever. You are never locked into our servers, and Neogram stores zero photos permanently.
                  </p>
                </div>

                <!-- Q6: Where to paste -->
                <div class="p-3 bg-black border border-main space-y-1">
                  <div class="text-mac font-bold flex items-center gap-2 text-xs">
                    <span>📋</span>
                    <span>Q: Where exactly do I paste the widget code on my site?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    Log in to your Neocities dashboard, click <strong>Edit</strong> on your <code>index.html</code> (or any other page), scroll to where you want the widget to appear (for example, in your footer or right before <code>&lt;/body&gt;</code>), paste the snippet, and hit <strong>Save</strong>. It goes live immediately!
                  </p>
                </div>

                <!-- Q7: Multi-Site Management -->
                <div class="p-3 bg-black border border-main space-y-1">
                  <div class="text-mac font-bold flex items-center gap-2 text-xs">
                    <span>💾</span>
                    <span>Q: Can I publish to multiple different websites or Neocities accounts?</span>
                  </div>
                  <p class="text-muted m-0 pl-5">
                    <strong>Yes!</strong> Neogram supports full <strong>Multi-Site Architecture</strong>. You can mount as many independent static sites as you like from the Settings tab. Each site has its own API key, deploy folder, and separate hit counters and guestbooks. You can switch between them in 1 click from the top taskbar without logging out.
                  </p>
                </div>
              </div>
            </div>

            <!-- Jump to Technical Guides -->
            <div class="p-3 bg-window border border-main text-xs flex items-center justify-between flex-wrap gap-2">
              <span class="text-muted">Ready to dive deeper into custom styling or API configurations?</span>
              <button type="button" class="pixel-btn pixel-btn--yellow text-xs font-bold py-1 px-3" onclick="switchDocTopic('neocities')">
                <span>🚀 Neocities Setup Guide →</span>
              </button>
            </div>

          </section>

          <!-- ========================================================= -->
          <!-- TOPIC 1: NEOCITIES SETUP GUIDE                            -->
          <!-- ========================================================= -->
          <section id="docSection-neocities" class="docs-section-pane flex flex-col gap-6 {% if activeTopic != 'neocities' %}hidden{% endif %}">
            
            <div class="border-b-2 border-main pb-2">
              <div class="flex items-center gap-2">
                <span class="text-xl">🚀</span>
                <h1 class="text-base font-bold text-prompt m-0 uppercase">Neocities Static Hosting &amp; Setup Guide</h1>
              </div>
              <p class="text-xs text-muted mt-1 m-0">
                Connect your personal Neocities site to enable automated publishing, isolated gallery compilation, and live media uploads.
              </p>
            </div>

            <!-- Flow Overview Box -->
            <div class="p-3 bg-black border border-main text-xs space-y-2">
              <div class="text-mac font-bold uppercase tracking-wider text-xxs">DATA FLOW PIPELINE</div>
              <div class="p-2 border border-muted bg-surface-sunken text-prompt font-mono text-xs overflow-x-auto leading-relaxed">
[Mobile / Workstation Photo] ──&gt; [Sharp WebP Transform] ──&gt; [Eleventy Build] ──&gt; [Neocities API Upload] ──&gt; [Local Purge: 0 MB]
              </div>
              <p class="text-muted text-xs m-0">
                Neogram never acts as a permanent media host. When you upload, photos are optimized, published directly to your Neocities account, and local files are immediately erased from the server.
              </p>
            </div>

            <!-- Step by Step Walkthrough -->
            <div class="flex flex-col gap-4">
              
              <!-- STEP 1 -->
              <div class="retro-card p-4 m-0 flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <span class="docs-step-badge">1</span>
                  <h3 class="font-bold text-xs uppercase text-prompt m-0">Obtain your Neocities API Key</h3>
                </div>
                <p class="text-xs leading-relaxed text-main m-0">
                  Log in to your account at <a href="https://neocities.org" target="_blank" rel="noopener noreferrer" class="text-mac underline font-bold">neocities.org</a>, then navigate to your site settings at <a href="https://neocities.org/settings#api_key" target="_blank" rel="noopener noreferrer" class="text-mac underline font-bold">neocities.org/settings#api_key</a>. Scroll down to the <strong>API Key</strong> section and copy your token string.
                </p>
                <div class="p-2 bg-window border border-main text-xxs text-muted font-mono">
                  KEY TOKEN EXAMPLE: <code>0123456789abcdef0123456789abcdef</code> (Keep this key private!)
                </div>
              </div>

              <!-- STEP 2 -->
              <div class="retro-card p-4 m-0 flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <span class="docs-step-badge">2</span>
                  <h3 class="font-bold text-xs uppercase text-prompt m-0">Configure Station Settings in Neogram</h3>
                </div>
                <p class="text-xs leading-relaxed text-main m-0">
                  In the top workstation navigation bar, click <strong>⚙ Settings</strong>. Scroll to the window titled <strong>[:&gt; CYBER_HOSTING.SYS — STATIC DEPLOY PIPELINE]</strong> and enter your hosting credentials:
                </p>
                <ul class="list-disc list-inside text-xs space-y-1 text-muted pl-2">
                  <li><strong>Hosting Provider:</strong> <code>Neocities API (Primary)</code></li>
                  <li><strong>Neocities API Key:</strong> Paste your API key token (encrypted in PostgreSQL with AES-256-GCM)</li>
                  <li><strong>Site Subdomain:</strong> Enter your Neocities subdomain (e.g. <code>{{ stationHandle }}</code>)</li>
                  <li><strong>Target Subfolder (`deploy_path`):</strong> <code>neogram</code> (Default safe subfolder)</li>
                  <li><strong>Auto-Deploy on Transmit:</strong> Check this box to push updates automatically whenever you post</li>
                </ul>
              </div>

              <!-- STEP 3 -->
              <div class="retro-card p-4 m-0 flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <span class="docs-step-badge">3</span>
                  <h3 class="font-bold text-xs uppercase text-prompt m-0">Safe Subdirectory Invariant (Root Protection)</h3>
                </div>
                <div class="docs-callout docs-callout--tip m-0">
                  <strong>ROOT SITE NON-DESTRUCTION GUARANTEE:</strong><br />
                  Neogram defaults to publishing under <code>/neogram/</code>. Your existing homepage (<code>index.html</code>), custom styling, blog posts, and fan listings on Neocities are <strong>never overwritten or modified</strong>.
                </div>
                <p class="text-xs text-muted m-0">
                  Your photo gallery will be live at: <a href="https://{{ stationHandle }}.neocities.org/neogram/" target="_blank" class="text-mac underline font-bold">https://{{ stationHandle }}.neocities.org/neogram/</a>
                </p>
              </div>

              <!-- STEP 4 -->
              <div class="retro-card p-4 m-0 flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <span class="docs-step-badge">4</span>
                  <h3 class="font-bold text-xs uppercase text-prompt m-0">Verify Connection &amp; Test</h3>
                </div>
                <p class="text-xs leading-relaxed text-main m-0">
                  Click the <strong>[ 🔌 Test Neocities Connection ]</strong> button. Neogram will ping the Neocities API and verify your site. Once confirmed, click <strong>[ 💾 SAVE HOSTING CONFIG ]</strong>.
                </p>
                <p class="text-xs leading-relaxed text-muted m-0">
                  Now, whenever you snap or upload a photo in the <strong>↑ Upload Studio</strong>, your photo will automatically be compiled and deployed live!
                </p>
              </div>

            </div>

            <!-- Hosting Providers & Architecture -->
            <div class="p-3 bg-window border border-main text-xs space-y-1">
              <span class="font-bold text-xxs uppercase tracking-wider text-prompt">OFFICIALLY SUPPORTED HOSTING PROVIDERS:</span>
              <p class="text-muted m-0">
                Neogram natively supports direct REST API deployments to both <strong>Neocities</strong> and <strong>Nekoweb</strong>. Additional modular adapters for <strong>GitHub Pages (Git PAT commits)</strong> and universal <strong>SFTP / SSH</strong> are arriving in upcoming releases.
              </p>
            </div>

          </section>

          <!-- ========================================================= -->
          <!-- TOPIC 1.5: MULTI-SITE ARCHITECTURE (1 USER : N SITES)      -->
          <!-- ========================================================= -->
          <section id="docSection-sites" class="docs-section-pane flex flex-col gap-6 {% if activeTopic != 'sites' %}hidden{% endif %}">
            
            <div class="border-b-2 border-main pb-2">
              <div class="flex items-center gap-2">
                <span class="text-xl">💾</span>
                <h1 class="text-base font-bold text-prompt m-0 uppercase">Multi-Site Architecture (1 User : N Sites)</h1>
              </div>
              <p class="text-xs text-muted mt-1 m-0">
                Publish to multiple independent static targets (e.g. personal homepages, fan shrines, art blogs, retro portfolios) from a single authenticated creator identity without logging out.
              </p>
            </div>

            <!-- Conceptual Architecture Card -->
            <div class="retro-card p-4 m-0 flex flex-col gap-3">
              <div class="window-header flex items-center justify-between">
