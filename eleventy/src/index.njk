---
layout: layouts/base.njk
title: Static Photo Stream
---

<!-- ==============================================================
     STATIC GALLERY BANNER (Retro 90s Geocities/Cyber Homage)
     ============================================================== -->
<div class="pixel-box mb-6">
  <div class="window-header">
    <div class="flex items-center gap-2">
      <span>⚡</span>
      <span class="font-bold">[:&gt; {{ site.title }}]</span>
    </div>
    <div class="flex items-center gap-2 text-xs">
      <span class="text-prompt font-bold">● NEOCITIES STATIC STREAM</span>
    </div>
  </div>

  <div class="p-4 bg-window">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
      <div>
        <p class="font-bold text-sm text-mac mb-1">{{ site.description }}</p>
        <p class="text-muted">
          Broadcast node: <code class="text-prompt">{{ site.neocitiesUrl }}</code> · Formatted for Netscape &amp; Modern Browsers
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="pixel-badge pixel-badge--cyan font-bold">{{ posts.length }} PHOTOS ARCHIVED</span>
        <a href="{{ site.apiUrl or 'http://localhost:4000' }}" target="_blank" class="pixel-btn pixel-btn--yellow pixel-btn--sm">
          <span>📸 Upload New Photo :&gt;</span>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- ==============================================================
     STATIC PHOTO GRID
     ============================================================== -->
{% if posts.length == 0 %}
  <div class="pixel-box p-8 text-center bg-window">
    <div class="text-3xl mb-3">📡</div>
    <div class="font-bold text-mac text-sm mb-2">[:&gt; NO PHOTOS BROADCAST TO STATIC REPO YET]</div>
    <p class="text-muted text-xs mb-4">
      Log into your Neogram Workstation to upload your first photograph and trigger the 11ty build pipeline.
    </p>
    <a href="{{ site.apiUrl or 'http://localhost:4000' }}" class="pixel-btn pixel-btn--green text-xs font-bold py-2 px-4">
      <span>🚀 Open Neogram Creator Studio</span>
    </a>
  </div>
{% else %}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for post in posts %}
      <article class="pixel-box flex flex-col transition-transform hover:-translate-y-1 bg-window">
        <!-- Card Window Header -->
        <div class="window-header flex items-center justify-between text-xs">
          <span class="truncate font-bold">@{{ post.author }}</span>
          <span class="text-prompt text-xs font-bold uppercase">{{ post.filterApplied or 'RAW' }}</span>
        </div>

        <!-- Thumbnail Viewport with CRT & Filter Shaders -->
        <a href="{{ ('/photos/' + post.id + '/') | url }}" class="block bg-black p-1 h-56 flex items-center justify-center overflow-hidden relative group crt-scanlines">
          <img
            src="{{ post.thumbnailPath or post.imagePath }}"
            alt="{{ post.caption }}"
            class="max-h-full max-w-full object-contain filter-{{ post.filterApplied or 'none' }} group-hover:scale-105 transition-transform duration-150"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
            <span class="pixel-btn pixel-btn--yellow text-xs font-bold py-1 px-3">
              <span>👁️ VIEW &amp; COMMENT</span>
            </span>
          </div>
        </a>

        <!-- Metadata & Caption Card Body -->
        <div class="p-4 flex-1 flex flex-col justify-between text-xs">
          <div>
            <div class="flex items-center justify-between text-muted text-xs mb-2">
              <span>{{ post.location or 'Earth // Cyberspace' }}</span>
              <span>{{ post.createdAt | formatDate }}</span>
            </div>

            <p class="line-clamp-2 leading-relaxed text-main mb-3">
              {{ post.caption }}
            </p>
          </div>

          <!-- Tags & Actions Footer -->
          <div>
            <div class="flex flex-wrap gap-1 mb-3">
              {% if post.mood %}
                <span class="pixel-badge pixel-badge--cyan">{{ post.mood }}</span>
              {% endif %}
              {% if post.webring %}
                <span class="pixel-badge pixel-badge--magenta">ring: {{ post.webring }}</span>
              {% endif %}
            </div>

            <div class="flex items-center justify-between pt-2 border-t border-main">
              <span class="text-xs text-muted">
                ❤️ <strong class="text-main">{{ post.likes or 0 }}</strong> likes
              </span>
              <a href="{{ ('/photos/' + post.id + '/') | url }}" class="pixel-btn pixel-btn--sm pixel-btn--yellow font-bold">
                <span>View Details :&gt;</span>
              </a>
            </div>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
{% endif %}
