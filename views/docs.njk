              <pre class="docs-code-pre" id="codeSampleJs">&lt;!-- Drop this into index.html on your Neocities or personal static website --&gt;
&lt;div id="app"&gt;
  &lt;div id="profile-container"&gt;&lt;/div&gt;
  &lt;div id="gallery-container"&gt;Loading photos from self-hosted feed...&lt;/div&gt;
&lt;/div&gt;

&lt;style&gt;
  #app { font-family: monospace; max-width: 900px; margin: 0 auto; padding: 20px; }
  .profile-header { display: flex; align-items: center; gap: 16px; border: 2px solid #000; padding: 16px; background: #ffffcc; margin-bottom: 24px; }
  .profile-avatar { width: 64px; height: 64px; border: 2px solid #000; image-rendering: pixelated; }
  .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
  .photo-card { border: 2px solid #000; box-shadow: 4px 4px 0 #000; background: #fff; display: flex; flex-col; overflow: hidden; }
  .photo-img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; border-bottom: 2px solid #000; }
  .photo-body { padding: 12px; font-size: 13px; }
  .action-btn { background: #ffff00; border: 2px solid #000; padding: 4px 10px; font-weight: bold; cursor: pointer; font-family: monospace; }
  .action-btn:hover { background: #00ff66; }
  .comments-list { margin-top: 8px; border-top: 1px dashed #ccc; padding-top: 8px; font-size: 11px; }
  .comment-input { width: 100%; box-sizing: border-box; padding: 4px; font-family: monospace; margin-top: 4px; border: 1px solid #000; }
&lt;/style&gt;

&lt;script&gt;
// Replace with your self-hosted feed URL or relative path if hosted on the same site:
const FEED_URL = 'https://{{ stationHandle }}.neocities.org/{{ deployPath }}/feed.json';
const NEOGRAM = '{{ appUrl }}';

// SECURITY: every field in feed.json is user-written text (captions, handles, comments).
// Build elements with textContent and only allow http(s) URLs. Never use innerHTML or inline
// onclick="...${value}..." strings with feed data, or a caption can run script on your site.
function h(tag, props, ...children) {
  const node = document.createElement(tag);
  Object.assign(node, props || {});
  for (const child of children) node.append(child == null ? '' : child);
  return node;
}
const safeUrl = (u) =&gt; (typeof u === 'string' &amp;&amp; /^https?:\/\//i.test(u) ? u : '');

// Cyber-Pass saved by Neogram on this site (needed to comment); null for anonymous visitors
function getPass() {
  try { const p = JSON.parse(localStorage.getItem('neogram_pass') || 'null'); return p &amp;&amp; p.verified ? p : null; } catch (e) { return null; }
}

async function initNeogramApp() {
  const profileEl = document.getElementById('profile-container');
  const galleryEl = document.getElementById('gallery-container');

  try {
    const res = await fetch(FEED_URL);
    if (!res.ok) throw new Error('HTTP ' + res.status + ' loading feed');
    const data = await res.json();
    const user = data.user || {};

    // 1. Render User Profile Header
    const profileLink = h('a', { href: NEOGRAM + '/user/' + encodeURIComponent(user.uin || user.handle || ''), target: '_blank', rel: 'noopener', className: 'action-btn' }, 'Add Friend on Neogram');
    profileEl.replaceChildren(
      h('div', { className: 'profile-header' },
        h('img', { src: safeUrl(user.avatarUrl), alt: user.handle || '', className: 'profile-avatar' }),
        h('div', {},
          h('h2', { style: 'margin: 0;' }, '@' + (user.handle || 'member') + ' ', h('span', { style: 'font-size: 12px; color: #666;' }, '[UIN #' + (user.uin || '?') + ']')),
          h('p', { style: 'margin: 4px 0; color: #444;' }, user.statusMessage || ''),
          profileLink
        )
      )
    );

    // 2. Render Photos Grid
    if (!data.posts || data.posts.length === 0) {
      galleryEl.textContent = 'No photos in this feed yet.';
      return;
    }

    const grid = h('div', { className: 'photo-grid' });
    for (const post of data.posts) {
      const likesCount = h('span', {}, String(parseInt(post.likes, 10) || 0));
      const likeBtn = h('button', { className: 'action-btn', type: 'button' }, likesCount, ' Likes');
      likeBtn.addEventListener('click', () =&gt; likePhoto(likesCount, safeUrl(post.actions &amp;&amp; post.actions.likeUrl)));

      const commentsList = h('div', { className: 'comments-list' });
      for (const c of post.comments || []) {
        commentsList.append(h('div', {}, h('strong', {}, '@' + (c.author || 'visitor') + ': '), c.text || c.body || ''));
      }
      const textInput = h('input', { type: 'text', placeholder: 'Write a comment...', className: 'comment-input', required: true });
      const form = h('form', { style: 'margin-top: 6px;' },
        textInput,
        h('button', { type: 'submit', className: 'action-btn', style: 'margin-top: 4px; width: 100%;' }, 'Post Comment')
      );
      form.addEventListener('submit', (event) =&gt; submitComment(event, commentsList, textInput, safeUrl(post.actions &amp;&amp; post.actions.commentUrl)));

      grid.append(
        h('div', { className: 'photo-card' },
          h('img', { src: safeUrl(post.thumbnailUrl), alt: post.caption || 'Photo', className: 'photo-img', loading: 'lazy' }),
          h('div', { className: 'photo-body' },
            h('p', { style: 'margin: 0 0 8px 0; font-weight: bold;' }, post.caption || ':&gt; Snapshot'),
            h('div', { style: 'display: flex; justify-content: space-between; align-items: center; font-size: 11px; margin-bottom: 8px;' },
              h('span', {}, new Date(post.createdAt).toLocaleDateString()),
              likeBtn
            ),
            h('details', {},
              h('summary', { style: 'cursor: pointer; font-size: 11px;' }, 'Comments (' + (post.comments || []).length + ')'),
              commentsList,
              form
            )
          )
        )
      );
    }
    galleryEl.replaceChildren(grid);
  } catch (err) {
    galleryEl.replaceChildren(h('p', { style: 'color: red;' }, 'Failed to load self-hosted feed: ' + err.message));
  }
}

// 3. Like Photo Action
async function likePhoto(countEl, likeUrl) {
  if (!likeUrl) return;
  const current = parseInt(countEl.textContent, 10) || 0;
  countEl.textContent = String(current + 1); // Optimistic bump
  try {
    const res = await fetch(likeUrl, { method: 'POST' });
    const json = await res.json();
    if (json.likes) countEl.textContent = String(parseInt(json.likes, 10) || 0);
  } catch (err) {
    console.warn('Like failed:', err);
  }
}

// 4. Submit Comment Action (requires a Neogram Cyber-Pass on this site)
async function submitComment(event, commentsList, textInput, commentUrl) {
  event.preventDefault();
  const pass = getPass();
  const body = textInput.value.trim();
  if (!body || !commentUrl) return;
  if (!pass) {
    alert('Connect your Neogram Cyber-Pass to comment.');
    return;
  }

  const status = h('em', { style: 'color: #888;' }, ' (sending...)');
  const tempComment = h('div', {}, h('strong', {}, '@' + pass.handle + ': '), body, status);
  commentsList.appendChild(tempComment);

  try {
    const res = await fetch(commentUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + pass.token },
      body: JSON.stringify({ body: body })
    });
    status.textContent = res.ok ? '' : ' (failed)';
    if (res.ok) textInput.value = '';
  } catch (err) {
    status.textContent = ' (error)';
  }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', initNeogramApp);
&lt;/script&gt;</pre>
