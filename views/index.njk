  function switchNetworkSubTab(subTab, skipHash) {
    var valid = ['feed', 'friends', 'directory'];
    if (valid.indexOf(subTab) === -1) subTab = 'feed';
    currentNetworkSubTab = subTab;

    valid.forEach(function(key) {
      var btn = document.getElementById('networkSubBtn-' + key);
      var pane = document.getElementById('networkSubPane-' + key);
      if (btn) {
        if (key === subTab) {
          btn.classList.add('is-active');
          btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
        } else {
          btn.classList.remove('is-active');
        }
      }
      if (pane) {
        if (key === subTab) pane.classList.remove('hidden');
        else pane.classList.add('hidden');
      }
    });

    if (!skipHash) {
      var hashStr = subTab === 'feed' ? '#feed' : ('#network/' + subTab);
      if (window.location.hash !== hashStr) {
        if (history.pushState) history.pushState(null, '', hashStr);
        else window.location.hash = hashStr;
      }
    }
  }
