<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{{ title or site.title }} - 90s Retro Static Gallery</title>
  <meta name="description" content="{{ site.description }}">
  
  <!-- Neogram Retro Framework (Pure Sass, Zero Tailwind) -->
  <link rel="stylesheet" href="{{ '/css/neogram.css' | url }}">
  <link rel="stylesheet" href="{{ '/embed/neogram-embed.css' | url }}">
  {% if site.customCssUrl %}
  <link rel="stylesheet" href="{{ site.customCssUrl }}">
  {% endif %}
</head>
<body class="neogram-site">

  <!-- ==============================================================
       TOP RETRO SYSTEM BAR (Mac System 7 / Win95 Styled)
       ============================================================== -->
  <header class="neogram-site__taskbar">
    <div class="neogram-site__branding">
      <span class="neogram-site__logo">🍎</span>
      <span class="neogram-site__title">NEOGRAM STATIC ARCHIVE</span>
      <span class="neogram-site__tag">[:&gt; ELEVENTY GENERATED]</span>
    </div>

    <div class="neogram-site__nav">
      <a href="{{ '/' | url }}" class="neogram-btn neogram-btn--sm">
        <span>🏠 Gallery Grid</span>
      </a>
      <a href="{{ '/friends/' | url }}" class="neogram-btn neogram-btn--sm">
        <span>👥 Friends Grid</span>
      </a>
      <a href="{{ site.apiUrl or 'http://localhost:4000' }}" target="_blank" class="neogram-btn neogram-btn--yellow neogram-btn--sm">
        <span>🔑 Neogram Studio</span>
      </a>
      <button type="button" id="themeToggleBtn" class="neogram-btn neogram-btn--sm" title="Toggle Theme Skin">
        <span>☾ Theme</span>
      </button>
    </div>
  </header>

  <!-- ==============================================================
       PAGE CONTENT CONTAINER
       ============================================================== -->
  <main class="neogram-site__main">
    {{ content | safe }}
  </main>

  <!-- ==============================================================
       STATIC SITE RETRO FOOTER
       ============================================================== -->
  <footer class="neogram-site__footer">
    <div class="neogram-site__footer-inner">
      <div class="neogram-site__footer-info">
        <div class="neogram-site__footer-host">STATIC HOST: <span class="neogram-site__footer-url">{{ site.neocitiesUrl }}</span></div>
        <div class="neogram-site__footer-sub">Built with 11ty (Eleventy) &amp; Neogram Sharp Publishing Pipeline</div>
      </div>

      <!-- Retro 88x31 Badges -->
      <div class="neogram-site__footer-badges">
        <span class="neogram-badge neogram-badge--cyan">11TY STATIC</span>
        <span class="neogram-badge neogram-badge--green">NEOCITIES READY</span>
        <span class="neogram-badge neogram-badge--magenta">800x600 BEST</span>
        <span class="neogram-badge neogram-badge--amber">NETSCAPE 4.0</span>
      </div>
    </div>
  </footer>

  <!-- Retro Audio Engine -->
  <script src="{{ '/js/retroAudio.js' | url }}"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Audio click handler for retro buttons
      if (window.retroAudio) {
        document.querySelectorAll('.neogram-btn, .pixel-btn, .filter-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            window.retroAudio.playClick();
          });
        });
      }

      // Theme toggle support
      var toggleBtn = document.getElementById('themeToggleBtn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function () {
          var isDark = document.body.classList.toggle('dark');
          var icon = toggleBtn.querySelector('span');
          if (icon) icon.textContent = isDark ? '☾ Theme' : '☼ Theme';
          if (window.retroAudio) window.retroAudio.playClick();
        });
      }
    });
  </script>

  <!-- Optional Neogram Embed Layer -->
  <script src="{{ '/embed/embed.js' | url }}" async></script>
</body>
</html>
