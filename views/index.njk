  async function handleProvisionSite(e) {
    e.preventDefault();
    if (window.retroAudio) window.retroAudio.playClick();
    var name = document.getElementById('newSiteName').value.trim();
    var slug = document.getElementById('newSiteSlug').value.trim();
    var deploymentType = document.getElementById('newSiteDeployType').value;
    var siteUrl = document.getElementById('newSiteUrl').value.trim();
    var deployPath = document.getElementById('newSiteDeployPath').value.trim();
    var apiKey = document.getElementById('newSiteApiKey').value.trim();
