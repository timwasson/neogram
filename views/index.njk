  function filterManagePosts(siteId) {
    if (window.retroAudio) window.retroAudio.playClick();
    var allBtn = document.getElementById('filterSiteAllBtn');
    if (allBtn) {
      if (siteId === 'all') allBtn.classList.add('pixel-btn--yellow');
      else allBtn.classList.remove('pixel-btn--yellow');
    }
    document.querySelectorAll('[id^="filterSiteBtn-"]').forEach(function(btn) {
      if (btn.id === 'filterSiteBtn-' + siteId) btn.classList.add('pixel-btn--yellow');
      else btn.classList.remove('pixel-btn--yellow');
    });

    var postCards = document.querySelectorAll('#managePostsList [data-site-id]');
    var visibleCount = 0;
    postCards.forEach(function(card) {
      var itemSiteId = card.getAttribute('data-site-id');
      if (siteId === 'all' || itemSiteId === siteId) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    var totalCount = document.getElementById('manageTotalCount');
    if (totalCount) totalCount.textContent = visibleCount;
  }
  window.filterManagePosts = filterManagePosts;

  function toggleProvisionForm(force) {
    if (window.retroAudio) window.retroAudio.playClick();
    if (force === true && typeof switchSettingsSubTab === 'function') {
      switchSettingsSubTab('sites', true);
    }
    var container = document.getElementById('provisionFormContainer');
    var caret = document.getElementById('provisionFormCaret');
    if (!container) {
      if (force === true) {
        setTimeout(function() { document.getElementById('newSiteName')?.focus(); }, 60);
      }
      return;
    }
    var isOpen = !container.classList.contains('hidden');
    var shouldOpen = typeof force === 'boolean' ? force : !isOpen;
    if (shouldOpen) {
      container.classList.remove('hidden');
      if (caret) caret.textContent = '▴';
      document.getElementById('newSiteName')?.focus();
    } else {
      container.classList.add('hidden');
      if (caret) caret.textContent = '▾';
    }
  }
  window.toggleProvisionForm = toggleProvisionForm;

