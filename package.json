{
  "name": "neogram",
  "description": "90s retro social publishing engine and PWA for personal static sites",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,SASS\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run sass:watch\"",
    "dev:server": "tsx watch --watch server --watch eleventy --watch .env server/index.ts",
    "sass:build": "sass src/styles/main.scss public/css/neogram.css --no-source-map",
    "sass:watch": "sass src/styles/main.scss public/css/neogram.css --watch --no-source-map",
    "build:static": "tsx -e \"import { buildStaticGallery } from './server/services/staticBuilder'; buildStaticGallery().then(() => process.exit(0)).catch(err => { console.error(err); process.exit(1); });\"",
    "build:11ty": "npx @11ty/eleventy --config=eleventy/eleventy.config.js",
    "start:server": "tsx server/index.ts",
    "extension:sync": "node -e \"const fs = require('fs'); fs.mkdirSync('extension/shared', { recursive: true }); fs.copyFileSync('public/css/neogram.css', 'extension/shared/neogram.css'); fs.copyFileSync('public/js/retroAudio.js', 'extension/shared/retroAudio.js'); console.log('[:> EXTENSION] Shared assets synced.');\"",
    "extension:package": "npm run extension:sync && cd extension && zip -r ../neogram-aim-extension.zip . -x '*.DS_Store*'",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "build": "npm run sass:build && npm run build:static && npm run extension:sync",
    "lint": "tsc --noEmit",
    "test": "tsx server/tests/smokeTest.ts",
    "test:security": "tsx --test server/tests/security.integration.test.ts",
    "test:unit": "tsx --test server/tests/units.test.ts",
    "test:avatar": "tsx server/tests/profileAvatarTest.ts",
    "test:bot-static": "tsx server/tests/staticSiteBotMonitorTest.ts",
    "test:social-security": "tsx server/tests/socialAndSecurityTest.ts",
    "test:browser": "tsx server/tests/browserMultiResTest.ts",
    "test:browser:ui": "tsx --test server/tests/browser.ui.test.ts",
    "test:multiphoto": "tsx server/tests/multiPhotoGalleryTest.ts",
    "test:load": "tsx server/tests/loadAndConcurrencyTest.ts",
    "test:live-hosts": "tsx server/tests/liveHostVerificationTest.ts",
    "test:github": "tsx server/tests/githubPublisherTest.ts",
    "test:fleet": "tsx scripts/test-fleet-network.ts",
    "db:sync-prod": "tsx scripts/sync-db.ts",
    "test:all": "npm test && npm run test:security && npm run test:unit && npm run test:avatar && npm run test:fleet && npm run test:github && npm run test:multiphoto && npm run test:social-security && npm run test:bot-static && npm run test:browser"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@types/archiver": "^8.0.0",
    "@types/multer": "^2.3.0",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nunjucks": "^3.2.4",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "resend": "^6.34.1",
    "sharp": "^0.35.5",
    "twilio": "^6.2.0",
    "web-push": "^4.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "sass": "^1.105.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
